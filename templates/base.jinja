<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ project.name if project else "SD Commerce" }}{% endblock %}</title>
  <meta name="description" content="{% block meta_description %}{% endblock %}">

  {% set _site_css = site_css_href() %}
  {% if _site_css %}
  <link rel="stylesheet" href="{{ _site_css }}">
  {% else %}
  <script src="https://cdn.tailwindcss.com"></script>
  {% endif %}

  {# Self-hosted fonts — no fonts.googleapis.com / fonts.gstatic.com round trip. #}
  <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ static('site/fonts/inter-400.woff2') }}">
  <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ static('site/fonts/inter-600.woff2') }}">
  <style>
    @font-face{font-family:'Inter';font-style:normal;font-weight:400;font-display:swap;src:url("{{ static('site/fonts/inter-400.woff2') }}") format("woff2")}
    @font-face{font-family:'Inter';font-style:normal;font-weight:500;font-display:swap;src:url("{{ static('site/fonts/inter-500.woff2') }}") format("woff2")}
    @font-face{font-family:'Inter';font-style:normal;font-weight:600;font-display:swap;src:url("{{ static('site/fonts/inter-600.woff2') }}") format("woff2")}
    @font-face{font-family:'Inter';font-style:normal;font-weight:700;font-display:swap;src:url("{{ static('site/fonts/inter-700.woff2') }}") format("woff2")}
    @font-face{font-family:'Space Grotesk';font-style:normal;font-weight:500;font-display:swap;src:url("{{ static('site/fonts/space-grotesk-500.woff2') }}") format("woff2")}
    @font-face{font-family:'Space Grotesk';font-style:normal;font-weight:600;font-display:swap;src:url("{{ static('site/fonts/space-grotesk-600.woff2') }}") format("woff2")}
    @font-face{font-family:'Space Grotesk';font-style:normal;font-weight:700;font-display:swap;src:url("{{ static('site/fonts/space-grotesk-700.woff2') }}") format("woff2")}
  </style>

  <script src="{{ static('shopfront/vendor/htmx-2.0.4.min.js') }}" defer></script>
  <script src="{{ static('shopfront/vendor/alpine-3.14.3.min.js') }}" defer></script>
  {% block head %}{% endblock %}
</head>
<body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
  {% block body %}{% endblock %}
</body>
</html>
