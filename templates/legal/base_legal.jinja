{% extends "base.jinja" %}
{# Shared shell for /privacy/ and /terms/. Plain, fast, indexable. #}

{% block meta_description %}{{ meta }}{% endblock %}

{% block body %}
<div class="bg-white font-sans text-slate-900">
  <header class="border-b border-slate-200/70">
    <div class="mx-auto flex h-16 max-w-3xl items-center justify-between px-5">
      <a href="/" class="font-display text-lg font-bold tracking-tight">shop<span class="text-brand-600">inaday</span></a>
      <nav class="flex items-center gap-5 text-sm font-medium text-slate-600">
        <a href="{{ url('privacy') }}" class="hover:text-slate-900 {{ 'text-slate-900' if active == 'privacy' }}">Privacy</a>
        <a href="{{ url('terms') }}" class="hover:text-slate-900 {{ 'text-slate-900' if active == 'terms' }}">Terms</a>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-3xl px-5 py-12 sm:py-16">
    <h1 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{% block heading %}{% endblock %}</h1>
    <p class="mt-2 text-sm text-slate-500">Last updated: {{ updated }}</p>
    <div class="mt-8 space-y-4 leading-relaxed text-slate-700
                [&_h2]:mt-10 [&_h2]:font-display [&_h2]:text-xl [&_h2]:font-bold [&_h2]:text-slate-900
                [&_ul]:list-disc [&_ul]:space-y-1.5 [&_ul]:pl-6 [&_a]:text-brand-700 [&_a]:underline">
      {% block content %}{% endblock %}
    </div>
  </main>

  <footer class="border-t border-slate-200 py-6 text-center text-xs text-slate-400">
    &copy; {{ now_year }} {{ entity }} ·
    <a href="{{ url('privacy') }}" class="hover:text-slate-600">Privacy</a> ·
    <a href="{{ url('terms') }}" class="hover:text-slate-600">Terms</a>
  </footer>
</div>
{% endblock %}
