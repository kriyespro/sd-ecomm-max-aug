{#- Storefront wordmark: the uploaded logo, or the store name as a fallback.
    Rendered inside the skin's existing <a>/<span> so it inherits type styles. -#}
{%- if store_logo -%}
<img src="{{ store_logo }}" alt="{{ store.name }}" class="inline-block h-[42px] w-auto max-w-[62vw] object-contain align-middle sm:max-w-none lg:h-11">
{%- else -%}
{{ store.name }}
{%- endif -%}
