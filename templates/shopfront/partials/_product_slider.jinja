{# A home page product rail (Featured/New arrivals/Best sellers): a
   horizontal, swipeable single row instead of a tall wrapping grid — the
   first `products_per_row` cards are visible, the rest slide into view
   (touch swipe on any screen; ‹ › arrows on desktop once there's more than
   one row's worth). ThemeSettings.products_shown caps how many are loaded
   at all; the view already slices the list before it reaches this macro.

   Left ungated on an empty `products` list (matches every skin's prior
   behaviour of still rendering the section/heading around an empty grid)
   — the caller decides whether to skip the whole section. #}
{% macro product_slider(products, ref, gap='gap-x-6') %}
<div x-data class="relative">
  <div x-ref="{{ ref }}"
       class="flex {{ gap }} overflow-x-auto pb-1 snap-x snap-mandatory scroll-smooth [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    {% for p in products %}
    <div class="w-1/2 flex-none snap-start md:w-1/3 {{ 'lg:w-1/6' if products_per_row == 6 else 'lg:w-1/5' if products_per_row == 5 else 'lg:w-1/3' if products_per_row == 3 else 'lg:w-1/4' }}">
      {% include "shopfront/partials/_card.jinja" %}
    </div>
    {% endfor %}
  </div>
  {% if products | length > products_per_row %}
  <button type="button" aria-label="Previous"
          @click="$refs.{{ ref }}.scrollBy({left: -$refs.{{ ref }}.clientWidth, behavior: 'smooth'})"
          class="absolute -left-3 top-[38%] z-10 hidden h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-paper text-ink shadow ring-1 ring-line hover:bg-line/40 lg:flex">‹</button>
  <button type="button" aria-label="Next"
          @click="$refs.{{ ref }}.scrollBy({left: $refs.{{ ref }}.clientWidth, behavior: 'smooth'})"
          class="absolute -right-3 top-[38%] z-10 hidden h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-paper text-ink shadow ring-1 ring-line hover:bg-line/40 lg:flex">›</button>
  {% endif %}
</div>
{% endmacro %}
