{# KAANIDHI2.0 — built from scratch (not a thin override of skins/default):
   every page below ships its own full template, none fall back to
   skins/default/. Deep maroon (#501116) on warm cream/white, a single
   geometric sans (Jost) for both body and headings with a Parisienne script
   wordmark, circular category tiles, rounded-xl cards, pill buttons,
   single-row logo-left header, rotating-style announcement bar, WhatsApp
   float + back-to-top. Visual source: nidhika2.0/ static reference pages,
   cross-checked against the live nidhikajewels.com storefront. #}
<!doctype html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ store.name }}{% endblock %}</title>
  <meta name="description" content="{% block meta %}{{ store.name }} — shop online.{% endblock %}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {% set _skincss = skin_css_href(skin_slug) %}
  {% if _skincss %}<link rel="preload" as="style" href="{{ _skincss }}">{% else %}<link rel="preconnect" href="https://cdn.tailwindcss.com" crossorigin>{% endif %}
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700;800&family=Parisienne&display=swap" rel="stylesheet">
  {% if _skincss %}
  <link rel="stylesheet" href="{{ _skincss }}">
  {% else %}
  <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
  <script>
    tailwind.config = {
      theme: { extend: {
        fontFamily: { display: ['"Jost"', 'system-ui', 'sans-serif'], sans: ['"Jost"', 'system-ui', 'sans-serif'], script: ['"Parisienne"', 'cursive'] },
        colors: {
          paper: '#ffffff', panel: '#ffffff', cream: '#fffaf7', ink: '#1c1a1a', mute: '#6b6868',
          line: '#ece5e3', accent: '{{ accent or "#501116" }}', 'accent-dark': '#350a0d',
          'accent-soft': '#f5e9ea', gold: '#8c3942', teal: '#108474', dark: '#141414',
        },
        letterSpacing: { luxe: '0.16em' },
        borderRadius: { xl: '10px', '2xl': '14px' },
      }},
    };
  </script>
  {% endif %}
  <script src="{{ static('shopfront/vendor/htmx-2.0.4.min.js') }}" defer></script>
  <script defer src="{{ static('shopfront/vendor/alpine-3.14.3.min.js') }}"></script>
  <script defer src="{{ static('site/password-toggle.js') }}"></script>
  <script>
    document.addEventListener('htmx:configRequest', function (e) {
      var m = document.cookie.match(/(?:^|;\s*)csrftoken=([^;]+)/);
      if (m) e.detail.headers['X-CSRFToken'] = decodeURIComponent(m[1]);
    });
  </script>
  <style>
    :root { --accent: {{ (accent or '#501116') | rgb_channels }}; --gold: 140 57 66; }
    [x-cloak] { display: none !important; }
    body { background:#fffaf7; color:#1c1a1a; font-family:"Jost",system-ui,sans-serif; -webkit-font-smoothing:antialiased; }
    h1,h2,h3,.font-display { font-family:"Jost",system-ui,sans-serif; font-weight:700; letter-spacing:.01em; }
    .font-script { font-family:"Parisienne",cursive; }
    a { color:inherit; }
    img { max-width:100%; height:auto; display:block; }
    .cv-auto { content-visibility:auto; contain-intrinsic-size:auto 720px; }
    .card-img { transition: transform .6s cubic-bezier(.2,.6,.2,1); }
    .group:hover .card-img { transform: scale(1.045); }
    .htmx-request .htmx-hide { opacity: .4; pointer-events: none; }
    #grid.htmx-request { opacity: .45; transition: opacity .2s; }
    #suggest.htmx-request { opacity: .6; }
    .v2-rule { height:2px; width:52px; background:#501116; border-radius:2px; }
  </style>
  {% block head %}{% endblock %}
</head>
<body class="min-h-screen bg-paper font-sans text-ink antialiased"
      x-data="shop()" @keydown.escape="cartOpen=false; searchOpen=false; quickOpen=false; menuOpen=false"
      @cart-open.window="cartOpen=true; quickOpen=false" @toast.window="pushToast($event.detail)"
      @open-quick.window="quickOpen=true">

  {# ============ ANNOUNCEMENT ============ #}
  {% if announcement %}
  <div class="bg-accent px-4 py-2.5 text-center text-[11px] font-semibold uppercase tracking-luxe text-white sm:text-[12px]">
    {{ announcement.heading }}
    {% if announcement.cta_url %}<a href="{{ announcement.cta_url }}" class="ml-2 underline underline-offset-2 hover:no-underline">{{ announcement.cta_label or 'Shop' }}</a>{% endif %}
  </div>
  {% endif %}

  {# ============ HEADER — single row, always solid: logo left, nav inline
     right of it, icons far right. No transparent hero-overlay state — matches
     the live redesign, not the earlier center-logo/overlay header. ============ #}
  <header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-md">
    <div class="mx-auto flex max-w-7xl items-center gap-6 px-5 py-3.5 lg:px-8">
      <button class="shrink-0 lg:hidden" @click="menuOpen=true" aria-label="Menu">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>

      <a href="{{ url('shopfront:home') }}" class="min-w-0 shrink-0 truncate font-script text-2xl leading-none text-accent sm:text-3xl lg:text-[2.1rem]">
        {% include "shopfront/partials/_brand.jinja" %}
      </a>

      <nav class="hidden flex-1 items-center gap-7 text-[12.5px] font-semibold uppercase tracking-luxe lg:flex">
        <a href="{{ url('shopfront:shop') }}" class="hover:text-accent">Shop</a>
        {% for it in primary_nav %}
        {% if it.children %}
        <div class="relative group py-2">
          <a href="{{ it.url }}"{% if it.new_tab %} target="_blank" rel="noopener"{% endif %} class="flex items-center gap-1 hover:text-accent"><span{{ ed_nav(it) }}>{{ it.label }}</span>
            <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
          </a>
          <div class="invisible absolute left-0 top-full z-40 min-w-48 rounded-xl border border-line bg-paper p-2 normal-case tracking-normal opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100">
            {% for c in it.children %}
            <a href="{{ c.url }}"{% if c.new_tab %} target="_blank" rel="noopener"{% endif %} class="block rounded-lg px-3 py-1.5 text-[13px] font-medium normal-case hover:bg-cream hover:text-accent"><span{{ ed_nav(c) }}>{{ c.label }}</span></a>
            {% endfor %}
          </div>
        </div>
        {% else %}
        <a href="{{ it.url }}"{% if it.new_tab %} target="_blank" rel="noopener"{% endif %} class="hover:text-accent"><span{{ ed_nav(it) }}>{{ it.label }}</span></a>
        {% endif %}
        {% endfor %}
      </nav>

      <div class="ml-auto flex shrink-0 items-center gap-4 lg:gap-5">
        <button @click="searchOpen = !searchOpen" aria-label="Search" class="hover:text-accent">
          <svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="m20 20-3.5-3.5"/></svg>
        </button>
        <a href="{{ url('shopfront:account') }}" aria-label="Account" class="hidden hover:text-accent sm:block">
          <svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.4"/><path stroke-linecap="round" d="M5 20c1.6-3.6 4.4-5.4 7-5.4s5.4 1.8 7 5.4"/></svg>
        </a>
        <a href="{{ url('shopfront:wishlist') }}" aria-label="Wishlist" class="hover:text-accent">
          <svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path d="M12 21s-7-4.5-9.5-9C1 8.5 3 5 6.5 5 9 5 12 7.5 12 7.5S15 5 17.5 5C21 5 23 8.5 21.5 12 19 16.5 12 21 12 21Z"/></svg>
        </a>
        <button @click="cartOpen=true" class="relative hover:text-accent" aria-label="Cart">
          <svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path d="M6 7h12l-1 13H7L6 7Z"/><path stroke-linecap="round" d="M9 7a3 3 0 0 1 6 0"/></svg>
          <span id="cart-count" class="absolute -right-2.5 -top-2 grid h-4 min-w-4 place-items-center rounded-full bg-accent px-1 text-[10px] font-semibold text-white {{ '' if cart_count else 'hidden' }}">{{ cart_count }}</span>
        </button>
      </div>
    </div>

    {# search bar + live suggestions #}
    <div x-show="searchOpen" x-cloak x-transition @click.outside="searchOpen=false" class="border-t border-line bg-paper px-5 py-4 lg:px-8">
      <div class="relative mx-auto max-w-2xl">
        <form action="{{ url('shopfront:shop') }}" method="get" class="flex items-center gap-3">
          <input name="q" autofocus placeholder="Search products…" autocomplete="off"
                 hx-get="{{ url('shopfront:search_suggest') }}" hx-trigger="input changed delay:250ms" hx-target="#suggest"
                 class="w-full border-b border-line bg-transparent pb-2 text-sm outline-none placeholder:text-mute focus:border-accent">
          <button class="text-[12px] font-semibold uppercase tracking-luxe text-accent">Go</button>
        </form>
        <div id="suggest" class="absolute inset-x-0 top-full z-50"></div>
      </div>
    </div>
  </header>

  {# mobile menu #}
  <div x-show="menuOpen" x-cloak class="fixed inset-0 z-50 lg:hidden">
    <div class="absolute inset-0 bg-ink/35" @click="menuOpen=false"></div>
    <nav class="absolute left-0 top-0 h-full w-72 bg-paper p-6" x-transition:enter-start="-translate-x-full" x-transition:enter="transition duration-300">
      <button @click="menuOpen=false" class="mb-6 text-mute">✕</button>
      <a href="{{ url('shopfront:shop') }}" class="block py-2 text-sm font-semibold uppercase tracking-luxe">Shop</a>
      {% for it in primary_nav %}
      <a href="{{ it.url }}"{% if it.new_tab %} target="_blank" rel="noopener"{% endif %} class="block py-2 text-sm font-semibold uppercase tracking-luxe"><span{{ ed_nav(it) }}>{{ it.label }}</span></a>
      {% for c in it.children %}
      <a href="{{ c.url }}"{% if c.new_tab %} target="_blank" rel="noopener"{% endif %} class="block py-1.5 pl-4 text-sm text-mute"><span{{ ed_nav(c) }}>{{ c.label }}</span></a>
      {% endfor %}
      {% endfor %}
      <a href="{{ url('shopfront:account') }}" class="mt-4 block border-t border-line py-3 text-sm">Account</a>
      <a href="{{ url('shopfront:wishlist') }}" class="block py-2 text-sm">Wishlist</a>
      <a href="{{ url('shopfront:track') }}" class="block py-2 text-sm">Track order</a>
    </nav>
  </div>

  {% if messages %}
  <div class="mx-auto max-w-7xl px-5 pt-5 lg:px-8">
    {% for m in messages %}
    <div class="mb-2 rounded-xl px-4 py-3 text-sm {{ 'bg-emerald-50 text-emerald-800' if 'success' in m.tags else 'bg-rose-50 text-rose-700' if 'error' in m.tags else 'bg-stone-100 text-stone-700' }}">{{ m }}</div>
    {% endfor %}
  </div>
  {% endif %}

  <main>{% block content %}{% endblock %}</main>

  {# ============ SHARED "WHY KAANIDHI2.0" STRIP — fixed chrome, every page ============ #}
  <section class="bg-dark py-10">
    <div class="mx-auto max-w-7xl px-5 lg:px-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
      {% set _why = benefit_items if benefit_items else [
        {'icon': '◷', 'title': 'Support 24/7', 'description': "We're available 24/7 to assist you"},
        {'icon': '✓', 'title': 'High-Quality Brand', 'description': 'Designed with exceptional craftsmanship'},
        {'icon': '⚑', 'title': 'Free Shipping', 'description': 'On orders above ₹1500 · no hidden fees'},
        {'icon': '◈', 'title': '100% Payment Secure', 'description': 'Fully secure, hassle-free returns'},
      ] %}
      {% for item in _why[:4] %}
      <div class="flex items-center gap-3 text-left sm:flex-col sm:text-center">
        <span{{ ed('benefit', item, 'icon') }} class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-white/10 text-lg text-[#e7909a] sm:mx-auto sm:mb-1">{{- item.icon or '✦' -}}</span>
        <div>
          <p{{ ed('benefit', item, 'title') }} class="text-[12px] font-semibold uppercase leading-tight text-white">{{- item.title -}}</p>
          {% if item.description %}<p{{ ed('benefit', item, 'description') }} class="mt-0.5 text-[11px] leading-snug text-white/55">{{- item.description -}}</p>{% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </section>

  {# ============ NEWSLETTER + BRAND IMAGE BANNER — fixed, every page ============ #}
  <section class="bg-cream">
    <div class="mx-auto grid max-w-7xl items-center gap-8 px-5 py-12 lg:grid-cols-2 lg:px-8">
      <div class="relative h-64 overflow-hidden rounded-2xl sm:h-80">
        {% set _ni = store_logo or '' %}
        <img src="{{ _ni | media_src(900, 700, store.name) }}" alt="{{ store.name }}" loading="lazy" decoding="async" class="h-full w-full object-cover">
        <div class="absolute inset-0 bg-gradient-to-t from-accent-dark/70 via-transparent to-transparent"></div>
        <div class="absolute inset-x-0 bottom-6 text-center">
          <p class="font-script text-3xl text-white">{{ store.name }}</p>
          <p class="mt-1 text-[10px] uppercase tracking-luxe text-white/80">The upgrade your jewellery needed</p>
        </div>
      </div>
      <div>
        <h2 class="font-display text-3xl text-accent">Join the {{ store.name }} Circle</h2>
        <p class="mt-2 text-sm text-mute">New drops, styling inspiration &amp; exclusive offers — straight to your inbox.</p>
        <form class="mt-5 flex max-w-md overflow-hidden rounded-full border border-line bg-white" @submit.prevent="pushToast({msg:'Thanks — check your inbox', kind:'success'})">
          <input type="email" required placeholder="Enter your email" class="w-full border-0 px-5 py-3 text-sm focus:outline-none focus:ring-0">
          <button class="shrink-0 bg-accent px-5 text-[12px] font-semibold uppercase tracking-luxe text-white hover:bg-accent-dark">Join the Circle</button>
        </form>
        {% if store_profile and store_profile.social_links %}
        <div class="mt-5 flex items-center gap-4">
          {% for label, href in store_profile.social_links %}
          <a href="{{ href }}" target="_blank" rel="noopener" aria-label="{{ label }}" title="{{ label }}" class="text-accent/70 transition hover:text-accent">
            <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              {% if label == 'Instagram' %}<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/>
              {% elif label == 'Facebook' %}<path d="M14 8h2V5h-2a4 4 0 0 0-4 4v2H8v3h2v6h3v-6h2.5l.5-3H13V9a1 1 0 0 1 1-1z"/>
              {% elif label == 'YouTube' %}<rect x="2.5" y="6" width="19" height="12" rx="3"/><path d="m10 9 5 3-5 3z" fill="currentColor"/>
              {% else %}<path d="M4 4l16 16M20 4 4 20"/>
              {% endif %}
            </svg>
          </a>
          {% endfor %}
        </div>
        {% endif %}
      </div>
    </div>
  </section>

  {# ============ FOOTER — About/Company/Customer-Service on charcoal, maroon bottom bar ============ #}
  <footer class="bg-dark pt-2 text-white/80">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-10 px-5 pb-10 pt-10 lg:grid-cols-5 lg:px-8">
      <div class="col-span-2 lg:col-span-1">
        <p class="text-[11px] font-semibold uppercase tracking-luxe text-white/50">About Our Brand</p>
        <p class="font-script mt-2 text-3xl text-white">{{ store.name }}</p>
        {% include "shopfront/partials/_footer_contact.jinja" %}
      </div>
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-luxe text-white/50">Contact</p>
        <ul class="mt-4 space-y-2 text-sm">
          {% if store_profile and store_profile.support_phone %}<li><a href="tel:{{ store_profile.support_phone }}" class="hover:text-white">{{ store_profile.support_phone }}</a></li>{% endif %}
          {% if store_profile and store_profile.support_email %}<li><a href="mailto:{{ store_profile.support_email }}" class="hover:text-white">{{ store_profile.support_email }}</a></li>{% endif %}
          {% if store_profile and store_profile.address %}<li class="whitespace-pre-line">{{ store_profile.address }}</li>{% endif %}
        </ul>
      </div>
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-luxe text-white/50">Quick Links</p>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href="{{ url('shopfront:track') }}" class="hover:text-white">Track your order</a></li>
          <li><a href="{{ url('shopfront:wishlist') }}" class="hover:text-white">Wishlist</a></li>
          {% for p in footer_pages %}<li><a href="{{ url('shopfront:page', kwargs={'slug': p.slug}) }}" class="hover:text-white">{{ p.title }}</a></li>{% endfor %}
        </ul>
      </div>
      <div class="col-span-2 lg:col-span-2">
        <p class="text-[11px] font-semibold uppercase tracking-luxe text-white/50">Customer Service</p>
        <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2 text-sm sm:grid-cols-3">
          {% for c in categories[:9] %}<li><a href="{{ url('shopfront:shop') }}?category={{ c.slug }}" class="hover:text-white">{{ c.name }}</a></li>{% endfor %}
          <li><a href="{{ url('shopfront:shop') }}" class="font-medium text-[#e7909a] hover:underline">Shop All</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-white/10">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-8 gap-y-2 px-5 py-4 text-[11px] text-white/50 lg:px-8">
        <span>PAN India Delivery</span><span>Secure Payments</span><span>Easy Return Support</span>{% if store_profile and store_profile.whatsapp_link %}<span>WhatsApp Support</span>{% endif %}
      </div>
    </div>
    <div class="bg-accent py-3 text-center text-[11px] text-white/85">{{ store_profile.copyright_text if store_profile and store_profile.copyright_text else '© ' ~ store.name ~ '™. All rights reserved.' }}{% if store_profile and store_profile.gstin %} · GSTIN {{ store_profile.gstin }}{% endif %}</div>
  </footer>

  {% if store_profile and store_profile.whatsapp_link %}
  <a href="{{ store_profile.whatsapp_link }}" target="_blank" rel="noopener" aria-label="WhatsApp us"
     class="fixed bottom-20 right-5 z-40 flex h-12 w-12 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition hover:bg-[#1ebe5b]">
    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.64-1.03-5.13-2.9-6.99A9.82 9.82 0 0 0 12.04 2Zm0 1.67c2.19 0 4.24.85 5.79 2.4a8.2 8.2 0 0 1 2.4 5.83c0 4.53-3.68 8.22-8.2 8.22a8.2 8.2 0 0 1-4.17-1.14l-.3-.18-3.12.82.83-3.04-.2-.31a8.16 8.16 0 0 1-1.26-4.37c0-4.53 3.69-8.23 8.23-8.23Z"/></svg>
  </a>
  {% endif %}
  <button type="button" x-data="{ show: false }" @scroll.window="show = window.scrollY > 500" x-show="show" x-cloak @click="window.scrollTo({top:0, behavior:'smooth'})"
          aria-label="Back to top" class="fixed bottom-5 right-5 z-40 flex h-10 w-10 items-center justify-center rounded-full bg-accent text-white shadow-lg transition hover:bg-accent-dark">↑</button>

  {# ============ CART DRAWER ============ #}
  <div x-show="cartOpen" x-cloak class="fixed inset-0 z-50">
    <div class="absolute inset-0 bg-ink/40" x-transition.opacity @click="cartOpen=false"></div>
    <aside class="absolute right-0 top-0 flex h-full w-full max-w-md flex-col bg-paper shadow-2xl"
           x-transition:enter="transition duration-300" x-transition:enter-start="translate-x-full">
      <div class="flex items-center justify-between border-b border-line px-6 py-5">
        <p class="font-display text-lg text-accent">Your Bag</p>
        <button @click="cartOpen=false" class="text-mute hover:text-ink">✕</button>
      </div>
      <div id="cart-drawer-body" hx-get="{{ url('shopfront:cart_drawer') }}" hx-trigger="cart-open from:body" class="flex-1 overflow-y-auto">
        {% include "shopfront/partials/_cart_drawer.jinja" %}
      </div>
    </aside>
  </div>

  {# ============ QUICK VIEW ============ #}
  <div x-show="quickOpen" x-cloak class="fixed inset-0 z-50 flex items-start justify-center overflow-y-auto p-4 sm:p-10">
    <div class="fixed inset-0 bg-ink/45" x-transition.opacity @click="quickOpen=false"></div>
    <div id="quickview-body" class="relative w-full max-w-3xl rounded-2xl bg-paper shadow-2xl" x-transition></div>
  </div>

  {# ============ TOASTS ============ #}
  <div class="pointer-events-none fixed bottom-6 right-6 z-[60] space-y-2">
    <template x-for="t in toasts" :key="t.id">
      <div x-transition class="pointer-events-auto min-w-[220px] rounded-xl bg-accent px-4 py-3 text-sm text-white shadow-xl"
           :class="t.kind === 'error' && 'bg-rose-700'">
        <span x-text="t.msg"></span>
      </div>
    </template>
  </div>

  <script>
    function shop() {
      return {
        cartOpen: false, menuOpen: false, searchOpen: false, quickOpen: false, toasts: [],
        pushToast(d) {
          const id = Date.now() + Math.random();
          this.toasts.push({ id, msg: d.msg || 'Done', kind: d.kind || 'info' });
          setTimeout(() => { this.toasts = this.toasts.filter(t => t.id !== id); }, 2600);
        },
      };
    }
  </script>
  {% block scripts %}{% endblock %}
</body>
</html>
