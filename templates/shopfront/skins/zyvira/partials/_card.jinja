{# product card — expects `p` (Product). Matches the live theme's
   product-grid-list card: hover photo-swap, a discount-% badge top-left,
   and a wishlist circle (bottom-left) + "Add to Bag" pill (bottom-right)
   overlaid directly on the photo — not hover-only. Star row always shows,
   even at 0 reviews, same as the live cards. #}
{% set imgs = p.images.all() | list %}
{% set img = imgs[0] if imgs else none %}
{% set img2 = imgs[1] if imgs|length > 1 else none %}
{% set _pct = ((1 - (p.current_price / p.price)) * 100) | round | int if (p.on_sale and p.price) else 0 %}
<article{{ ed_product(p) }} class="group relative">
  <a href="{{ url('shopfront:product', kwargs={'slug': p.slug}) }}" class="block overflow-hidden rounded-xl bg-cream">
    <div class="relative aspect-square overflow-hidden rounded-xl">
      <img src="{{ (img.image if img else none) | media_src(1000, 1000, 'Product photo') }}"
           {% if img and img.srcset %}srcset="{{ img.srcset }}" sizes="(min-width:1024px) 25vw, (min-width:640px) 33vw, 50vw"{% endif %}
           {% if img and img.width %}width="{{ img.width }}" height="{{ img.height }}"{% endif %}
           alt="{{ (img.alt if img else '') or p.title }}" loading="lazy" decoding="async"
           class="card-img h-full w-full object-cover">
      {% if img2 %}
      <img src="{{ img2.image | media_src(1000, 1000, 'Product photo') }}" alt="" loading="lazy" decoding="async"
           class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 group-hover:opacity-100">
      {% endif %}
    </div>
  </a>

  {% if p.on_sale %}<span class="absolute left-3 top-3 rounded-lg bg-accent px-2.5 py-1.5 text-[11px] font-medium leading-none text-cream">Sale{% if _pct > 0 %} {{ _pct }}%{% endif %}</span>
  {% elif p.is_new_arrival %}<span class="absolute left-3 top-3 rounded-lg bg-gold px-2.5 py-1.5 text-[11px] font-medium leading-none text-white">New</span>{% endif %}

  {# wishlist — plain circle, bottom-left, always visible (matches the live cards) #}
  <div class="absolute left-3 bottom-3">
    {% set wl_slug = p.slug %}{% set wl_active = false %}{% set wb_style = 'icon' %}
    {% include "shopfront/partials/_wishlist_btn.jinja" %}
  </div>

  {# add to bag — pill, bottom-right, always visible #}
  <form hx-post="{{ url('shopfront:cart_add') }}" hx-swap="none" class="absolute right-3 bottom-3">
    <input type="hidden" name="product" value="{{ p.slug }}">
    <button class="rounded-full bg-white/95 px-4 py-2 text-[11px] font-semibold uppercase tracking-luxe text-accent shadow-sm backdrop-blur transition-colors hover:bg-accent hover:text-white">
      Add to Bag
    </button>
  </form>

  <div class="mt-3">
    <a href="{{ url('shopfront:product', kwargs={'slug': p.slug}) }}"{{ ed('product', p, 'title') }} class="block font-display text-lg leading-tight text-ink hover:text-accent">{{ p.title }}</a>
    <p class="mt-0.5 text-xs text-gold">{{ '★' * (p.rating_avg | round | int) if p.rating_count else '☆☆☆☆☆' }}<span class="text-mute"> ({{ p.rating_count or 0 }})</span></p>
    <p{{ ed_money(p) }} class="mt-1 text-sm">
      {% if p.on_sale %}
      <span class="font-semibold text-accent">{{ p.current_price | money }}</span>
      <span class="ml-1 text-mute line-through">{{ p.price | money }}</span>
      {% else %}
      <span class="font-semibold text-ink">{{ p.price | money }}</span>
      {% endif %}
    </p>
  </div>
</article>
