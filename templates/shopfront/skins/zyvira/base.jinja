{# Zyvira skin — deep wine (#570517) + warm gold (#cea452) on cream/white,
   DM Serif Display over Kumbh Sans. Pill buttons, 10px-rounded photo cards,
   gold announcement bar, centred logo-left header with a separate nav row,
   maroon footer base. Ships base + home + shop + product + card + grid;
   every other page (cart/checkout/account/order/track/page/wishlist)
   inherits from skins/default/. #}
<!doctype html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ store.name }}{% endblock %}</title>
  <meta name="description" content="{% block meta %}{{ store.name }} — shop online.{% endblock %}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {% set _skincss = skin_css_href(skin_slug) %}
  {% if _skincss %}<link rel="preload" as="style" href="{{ _skincss }}">{% else %}<link rel="preconnect" href="https://cdn.tailwindcss.com" crossorigin>{% endif %}
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Kumbh+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  {% if _skincss %}
  <link rel="stylesheet" href="{{ _skincss }}">
  {% else %}
  <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
  <script>
    tailwind.config = {
      theme: { extend: {
        fontFamily: { display: ['"DM Serif Display"', 'Georgia', 'serif'], sans: ['"Kumbh Sans"', 'system-ui', 'sans-serif'] },
        colors: {
          paper: '#ffffff', panel: '#ffffff', cream: '#f8f7f3', ink: '#1c1a1a', mute: '#746b6b',
          line: '#e8e2e2', accent: '{{ accent or "#570517" }}', 'accent-soft': '#f3e3e7', gold: '#cea452',
        },
        letterSpacing: { luxe: '0.2em' },
        borderRadius: { xl: '10px', '2xl': '14px' },
      }},
    };
  </script>
  {% endif %}
  <script src="{{ static('shopfront/vendor/htmx-2.0.4.min.js') }}" defer></script>
  <script defer src="{{ static('shopfront/vendor/alpine-3.14.3.min.js') }}"></script>
  <script defer src="{{ static('site/password-toggle.js') }}"></script>
  <script>
    document.addEventListener('htmx:configRequest', function (e) {
      var m = document.cookie.match(/(?:^|;\s*)csrftoken=([^;]+)/);
      if (m) e.detail.headers['X-CSRFToken'] = decodeURIComponent(m[1]);
    });
  </script>
  <style>
    :root { --accent: {{ (accent or '#570517') | rgb_channels }}; --gold: 206 164 82; }
    [x-cloak] { display: none !important; }
    body { background:#ffffff; color:#1c1a1a; font-family:"Kumbh Sans",system-ui,sans-serif; -webkit-font-smoothing:antialiased; }
    h1,h2,h3,.font-display { font-family:"DM Serif Display",Georgia,serif; }
    a { color:inherit; }
    img { max-width:100%; height:auto; display:block; }
    .cv-auto { content-visibility:auto; contain-intrinsic-size:auto 720px; }
    .card-img { transition: transform .6s cubic-bezier(.2,.6,.2,1); }
    .group:hover .card-img { transform: scale(1.045); }
    .htmx-request .htmx-hide { opacity: .4; pointer-events: none; }
    #grid.htmx-request { opacity: .45; transition: opacity .2s; }
    #suggest.htmx-request { opacity: .6; }
    .zy-rule { height:1px; background:linear-gradient(90deg,transparent,rgba(206,164,82,.6),transparent); }
  </style>
  {% block head %}{% endblock %}
</head>
<body class="min-h-screen bg-paper font-sans text-ink antialiased"
      x-data="shop()" @keydown.escape="cartOpen=false; searchOpen=false; quickOpen=false; menuOpen=false"
      @cart-open.window="cartOpen=true; quickOpen=false" @toast.window="pushToast($event.detail)"
      @open-quick.window="quickOpen=true">

  {# ============ ANNOUNCEMENT — gold bar ============ #}
  {% if announcement %}
  <div class="bg-gold px-4 py-2.5 text-center text-[11px] font-semibold uppercase tracking-luxe text-accent sm:text-[12px]">
    {{ announcement.heading }}
    {% if announcement.cta_url %}<a href="{{ announcement.cta_url }}" class="ml-2 underline underline-offset-2 hover:no-underline">{{ announcement.cta_label or 'Shop' }}</a>{% endif %}
  </div>
  {% endif %}

  {# ============ HEADER — logo-left row, centred nav row beneath ============ #}
  <header x-data="{ scrolled: false }" @scroll.window="scrolled = window.scrollY > 10"
          :class="scrolled ? 'shadow-[0_1px_2px_rgba(28,26,26,.05),0_14px_30px_-20px_rgba(28,26,26,.3)]' : ''"
          class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-md transition-shadow">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3.5 lg:px-8">
      <button class="shrink-0 lg:hidden" @click="menuOpen=true" aria-label="Menu">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>

      <a href="{{ url('shopfront:home') }}" class="min-w-0 shrink truncate font-display text-xl tracking-wide text-accent sm:text-2xl lg:text-[1.75rem]">
        {% include "shopfront/partials/_brand.jinja" %}
      </a>

      <div class="flex shrink-0 items-center gap-4">
        <button @click="searchOpen = !searchOpen" aria-label="Search" class="hover:text-accent">
          <svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="m20 20-3.5-3.5"/></svg>
        </button>
        <a href="{{ url('shopfront:wishlist') }}" aria-label="Wishlist" class="hidden hover:text-accent sm:block">
          <svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M12 21s-7-4.5-9.5-9C1 8.5 3 5 6.5 5 9 5 12 7.5 12 7.5S15 5 17.5 5C21 5 23 8.5 21.5 12 19 16.5 12 21 12 21Z"/></svg>
        </a>
        <a href="{{ url('shopfront:account') }}" aria-label="Account" class="hover:text-accent">
          <svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path stroke-linecap="round" d="M4 20c0-4 3.6-6 8-6s8 2 8 6"/></svg>
        </a>
        <button @click="cartOpen=true" class="relative hover:text-accent" aria-label="Cart">
          <svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M6 7h12l-1 13H7L6 7Z"/><path stroke-linecap="round" d="M9 7a3 3 0 0 1 6 0"/></svg>
          <span id="cart-count" class="absolute -right-2.5 -top-2 grid h-4 min-w-4 place-items-center rounded-full bg-accent px-1 text-[10px] font-semibold text-white {{ '' if cart_count else 'hidden' }}">{{ cart_count }}</span>
        </button>
      </div>
    </div>

    {# nav row — centred, small-caps, hairline above/below #}
    <nav class="hidden border-t border-line/80 lg:block">
      <div class="mx-auto flex max-w-7xl items-center justify-center gap-8 px-5 py-2.5 text-[12.5px] font-semibold uppercase tracking-luxe lg:px-8">
        <a href="{{ url('shopfront:shop') }}" class="hover:text-accent">Shop All</a>
        {% for it in primary_nav %}
        {% if it.children %}
        <div class="relative group">
          <a href="{{ it.url }}"{% if it.new_tab %} target="_blank" rel="noopener"{% endif %} class="hover:text-accent"><span{{ ed_nav(it) }}>{{ it.label }}</span></a>
          <div class="invisible absolute left-1/2 top-full z-40 min-w-44 -translate-x-1/2 rounded-xl border border-line bg-paper p-2 normal-case tracking-normal opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100">
            {% for c in it.children %}
            <a href="{{ c.url }}"{% if c.new_tab %} target="_blank" rel="noopener"{% endif %} class="block rounded-lg px-3 py-1.5 text-[13px] font-medium normal-case hover:bg-cream hover:text-accent"><span{{ ed_nav(c) }}>{{ c.label }}</span></a>
            {% endfor %}
          </div>
        </div>
        {% else %}
        <a href="{{ it.url }}"{% if it.new_tab %} target="_blank" rel="noopener"{% endif %} class="hover:text-accent"><span{{ ed_nav(it) }}>{{ it.label }}</span></a>
        {% endif %}
        {% endfor %}
      </div>
    </nav>

    {# search bar + live suggestions #}
    <div x-show="searchOpen" x-cloak x-transition @click.outside="searchOpen=false" class="border-t border-line bg-paper px-5 py-4 lg:px-8">
      <div class="relative mx-auto max-w-2xl">
        <form action="{{ url('shopfront:shop') }}" method="get" class="flex items-center gap-3">
          <input name="q" autofocus placeholder="Search products…" autocomplete="off"
                 hx-get="{{ url('shopfront:search_suggest') }}" hx-trigger="input changed delay:250ms" hx-target="#suggest"
                 class="w-full border-b border-line bg-transparent pb-2 text-sm outline-none placeholder:text-mute focus:border-accent">
          <button class="text-[12px] font-semibold uppercase tracking-luxe text-accent">Go</button>
        </form>
        <div id="suggest" class="absolute inset-x-0 top-full z-50"></div>
      </div>
    </div>
  </header>

  {# mobile menu #}
  <div x-show="menuOpen" x-cloak class="fixed inset-0 z-50 lg:hidden">
    <div class="absolute inset-0 bg-ink/30" @click="menuOpen=false"></div>
    <nav class="absolute left-0 top-0 h-full w-72 bg-panel p-6" x-transition:enter-start="-translate-x-full" x-transition:enter="transition duration-300">
      <button @click="menuOpen=false" class="mb-6 text-mute">✕</button>
      <a href="{{ url('shopfront:shop') }}" class="block py-2 text-sm font-medium">Shop All</a>
      {% for it in primary_nav %}
      <a href="{{ it.url }}"{% if it.new_tab %} target="_blank" rel="noopener"{% endif %} class="block py-2 text-sm"><span{{ ed_nav(it) }}>{{ it.label }}</span></a>
      {% for c in it.children %}
      <a href="{{ c.url }}"{% if c.new_tab %} target="_blank" rel="noopener"{% endif %} class="block py-1.5 pl-4 text-sm text-mute"><span{{ ed_nav(c) }}>{{ c.label }}</span></a>
      {% endfor %}
      {% endfor %}
      <a href="{{ url('shopfront:account') }}" class="mt-4 block border-t border-line py-3 text-sm">Account</a>
    </nav>
  </div>

  {% if messages %}
  <div class="mx-auto max-w-7xl px-5 pt-5 lg:px-8">
    {% for m in messages %}
    <div class="mb-2 rounded-xl px-4 py-3 text-sm {{ 'bg-emerald-50 text-emerald-800' if 'success' in m.tags else 'bg-rose-50 text-rose-700' if 'error' in m.tags else 'bg-stone-100 text-stone-700' }}">{{ m }}</div>
    {% endfor %}
  </div>
  {% endif %}

  <main>{% block content %}{% endblock %}</main>

  {# ============ FOOTER — newsletter/social row, 4-col, maroon bottom bar ============ #}
  <footer class="mt-24 bg-cream">
    <div class="mx-auto max-w-7xl px-5 lg:px-8"><div class="zy-rule"></div></div>
    <div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:grid-cols-2 lg:grid-cols-4 lg:px-8">
      <div>
        <p class="font-display text-2xl text-accent">{{ store.name }}</p>
        {% include "shopfront/partials/_footer_contact.jinja" %}
      </div>
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-luxe text-mute">Shop</p>
        <ul class="mt-4 space-y-2 text-sm">
          {% for c in categories[:6] %}<li><a href="{{ url('shopfront:shop') }}?category={{ c.slug }}" class="text-ink/80 hover:text-accent">{{ c.name }}</a></li>{% endfor %}
        </ul>
      </div>
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-luxe text-mute">Help</p>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href="{{ url('shopfront:track') }}" class="text-ink/80 hover:text-accent">Track your order</a></li>
          <li><a href="{{ url('shopfront:wishlist') }}" class="text-ink/80 hover:text-accent">Wishlist</a></li>
          {% for p in footer_pages %}<li><a href="{{ url('shopfront:page', kwargs={'slug': p.slug}) }}" class="text-ink/80 hover:text-accent">{{ p.title }}</a></li>{% endfor %}
        </ul>
      </div>
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-luxe text-mute">Newsletter</p>
        <p class="mt-3 text-sm text-ink/70">Jewellery made for every mood, moment &amp; glow.</p>
        <form class="mt-4 flex items-center overflow-hidden rounded-full border border-line bg-paper pl-4" @submit.prevent="pushToast({msg:'Subscribed', kind:'success'})">
          <input placeholder="Email address" class="w-full bg-transparent py-2.5 text-sm outline-none placeholder:text-mute">
          <button class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-accent text-white" aria-label="Subscribe">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
        </form>
      </div>
    </div>
    <div class="bg-accent py-5 text-center text-[13px] text-white/90">{{ store_profile.copyright_text if store_profile and store_profile.copyright_text else '© ' ~ store.name ~ '™. All rights reserved.' }}{% if store_profile and store_profile.gstin %} · GSTIN {{ store_profile.gstin }}{% endif %}</div>
  </footer>

  {# ============ CART DRAWER ============ #}
  <div x-show="cartOpen" x-cloak class="fixed inset-0 z-50">
    <div class="absolute inset-0 bg-ink/40" x-transition.opacity @click="cartOpen=false"></div>
    <aside class="absolute right-0 top-0 flex h-full w-full max-w-md flex-col bg-panel shadow-2xl"
           x-transition:enter="transition duration-300" x-transition:enter-start="translate-x-full">
      <div class="flex items-center justify-between border-b border-line px-6 py-5">
        <p class="font-display text-lg text-accent">Your Bag</p>
        <button @click="cartOpen=false" class="text-mute hover:text-ink">✕</button>
      </div>
      <div id="cart-drawer-body" hx-get="{{ url('shopfront:cart_drawer') }}" hx-trigger="cart-open from:body" class="flex-1 overflow-y-auto">
        {% include "shopfront/partials/_cart_drawer.jinja" %}
      </div>
    </aside>
  </div>

  {# ============ QUICK VIEW ============ #}
  <div x-show="quickOpen" x-cloak class="fixed inset-0 z-50 flex items-start justify-center overflow-y-auto p-4 sm:p-10">
    <div class="fixed inset-0 bg-ink/45" x-transition.opacity @click="quickOpen=false"></div>
    <div id="quickview-body" class="relative w-full max-w-3xl rounded-2xl bg-panel shadow-2xl" x-transition></div>
  </div>

  {# ============ TOASTS ============ #}
  <div class="pointer-events-none fixed bottom-6 right-6 z-[60] space-y-2">
    <template x-for="t in toasts" :key="t.id">
      <div x-transition class="pointer-events-auto min-w-[220px] rounded-xl bg-accent px-4 py-3 text-sm text-white shadow-xl"
           :class="t.kind === 'error' && 'bg-rose-700'">
        <span x-text="t.msg"></span>
      </div>
    </template>
  </div>

  <script>
    function shop() {
      return {
        cartOpen: false, menuOpen: false, searchOpen: false, quickOpen: false, toasts: [],
        pushToast(d) {
          const id = Date.now() + Math.random();
          this.toasts.push({ id, msg: d.msg || 'Done', kind: d.kind || 'info' });
          setTimeout(() => { this.toasts = this.toasts.filter(t => t.id !== id); }, 2600);
        },
      };
    }
  </script>
  {% block scripts %}{% endblock %}
</body>
</html>
