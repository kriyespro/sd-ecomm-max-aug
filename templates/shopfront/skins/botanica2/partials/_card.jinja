{# Botanica 2.0 product card — expects `p` (Product) #}
{% set img = (p.images.all() | first) %}
{% set pct = (((p.price - p.current_price) / p.price) * 100) | round | int if (p.on_sale and p.price) else 0 %}
<article class="group relative flex flex-col rounded-2xl border border-line bg-panel p-3 b2-card b2-soft">
  <div class="relative">
    <a href="{{ url('shopfront:product', kwargs={'slug': p.slug}) }}" class="block overflow-hidden rounded-xl bg-line/40">
      <div class="aspect-[4/5] overflow-hidden">
        {% if img %}
        <img src="{{ img.image.url }}"
             {% if img.srcset %}srcset="{{ img.srcset }}" sizes="(min-width:1024px) 25vw, (min-width:640px) 33vw, 50vw"{% endif %}
             {% if img.width %}width="{{ img.width }}" height="{{ img.height }}"{% endif %}
             alt="{{ img.alt or p.title }}" loading="lazy" decoding="async"
             class="b2-img h-full w-full object-cover">
        {% else %}
        <div class="flex h-full items-center justify-center text-4xl text-accent/25">&#10047;</div>
        {% endif %}
      </div>
    </a>

    {% if p.on_sale %}
    <span class="absolute left-2.5 top-2.5 rounded-full bg-gold px-2.5 py-1 text-[10px] font-semibold uppercase tracking-luxe text-white">
      {% if pct %}-{{ pct }}%{% else %}Sale{% endif %}
    </span>
    {% elif p.is_new_arrival %}
    <span class="absolute left-2.5 top-2.5 rounded-full bg-accent px-2.5 py-1 text-[10px] font-semibold uppercase tracking-luxe text-paper">New</span>
    {% endif %}

    <button hx-get="{{ url('shopfront:quickview', kwargs={'slug': p.slug}) }}" hx-target="#quickview-body" hx-swap="innerHTML"
            @click="$dispatch('open-quick')" title="Quick view"
            class="absolute right-2.5 top-2.5 grid h-9 w-9 place-items-center rounded-full bg-paper/90 text-ink opacity-0 backdrop-blur transition-opacity group-hover:opacity-100 hover:bg-accent hover:text-paper">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
    </button>
  </div>

  <div class="flex flex-1 flex-col px-1 pt-3">
    <a href="{{ url('shopfront:product', kwargs={'slug': p.slug}) }}" class="font-display text-[15px] leading-tight text-ink hover:text-accent sm:text-base">{{ p.title }}</a>

    {% if p.rating_count %}
    <p class="mt-1 text-[11px] text-gold">{{ '★' * (p.rating_avg | round | int) }}<span class="text-mute"> ({{ p.rating_count }})</span></p>
    {% endif %}

    <div class="mt-2 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
      <span class="font-display text-lg text-ink">{{ p.current_price | money }}</span>
      {% if p.on_sale %}
      <span class="text-[13px] text-mute line-through">{{ p.price | money }}</span>
      {% if pct %}<span class="rounded-full bg-gold/10 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-luxe text-gold">Save {{ pct }}%</span>{% endif %}
      {% endif %}
    </div>

    <form hx-post="{{ url('shopfront:cart_add') }}" hx-swap="none" class="mt-3">
      <input type="hidden" name="product" value="{{ p.slug }}">
      <button class="w-full rounded-full border border-accent bg-transparent py-2.5 text-[11px] font-semibold uppercase tracking-luxe text-accent transition-colors hover:bg-accent hover:text-paper">
        Add to cart
      </button>
    </form>
  </div>
</article>
