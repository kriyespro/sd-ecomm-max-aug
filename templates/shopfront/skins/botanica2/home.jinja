{% extends "shopfront/base.jinja" %}
{% block title %}{{ store.name }} — Rooted in nature, made for you{% endblock %}

{% block content %}
{#
  ══════════════════════════════════════════════════════════════════════
  EDIT HOMEPAGE COPY HERE
  ══════════════════════════════════════════════════════════════════════
  trust_strip — the 4 badges just under the hero. Each row is
  ('Headline', 'sub-line'). Add / remove / reword freely; keep 3–4 for
  the layout to stay even.
#}
{% set trust_strip = [
  ('Free shipping',    'Orders over ₹999'),
  ('Cash on delivery', 'Across India'),
  ('7-day returns',    'No questions asked'),
  ('Clean formulas',   'No nasties, ever'),
] %}

{# ============ HERO — full-bleed image with overlay ============ #}
{% set hero_img = (hero_banner.image.url if (hero_banner and hero_banner.image)
                   else ((featured[0].images.all() | first).image.url if (featured and featured[0].images.all()) else '')) %}
<section class="relative isolate flex min-h-[72vh] items-end overflow-hidden bg-ink sm:min-h-[80vh] lg:min-h-[88vh]">
  <picture>
    {% if hero_banner and hero_banner.mobile_image %}<source media="(max-width: 640px)" srcset="{{ hero_banner.mobile_image.url }}">{% endif %}
    <img src="{{ hero_img | media_src(1600, 900, 'Hero banner') }}" alt="" fetchpriority="high" decoding="async" class="absolute inset-0 -z-10 h-full w-full object-cover">
  </picture>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/85 via-ink/40 to-ink/10"></div>

  <div class="mx-auto w-full max-w-7xl px-5 pb-12 pt-28 sm:pb-14 sm:pt-40 lg:px-8 lg:pb-20">
    <p class="flex items-center gap-3 text-[11px] font-semibold uppercase tracking-luxe text-gold">
      <span class="h-px w-8 shrink-0 bg-gold"></span><span class="min-w-0">{{ hero_banner.subheading if hero_banner else 'Clean, plant-powered wellness' }}</span>
    </p>
    <h1 class="mt-4 max-w-3xl font-display text-[2rem] leading-[1.08] text-paper sm:text-6xl sm:leading-[1.05] lg:text-7xl">
      {% if hero_banner and hero_banner.heading %}{{ hero_banner.heading }}{% else %}Rooted in nature,<br>made for the everyday.{% endif %}
    </h1>
    <p class="mt-5 max-w-md text-[15px] leading-relaxed text-paper/80">
      A considered edit of botanicals, tonics and rituals — formulated with what
      works, and nothing that doesn't.
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href="{{ hero_banner.cta_url if (hero_banner and hero_banner.cta_url) else url('shopfront:shop') }}"
         class="bg-paper px-7 py-3.5 text-center text-[11px] font-semibold uppercase tracking-luxe text-ink transition-colors hover:bg-accent hover:text-paper sm:px-9 sm:py-4">
        {{ hero_banner.cta_label if (hero_banner and hero_banner.cta_label) else 'Shop the collection' }}
      </a>
      <a href="{{ url('shopfront:shop') }}?sort=rating"
         class="border border-paper/60 px-7 py-3.5 text-center text-[11px] font-semibold uppercase tracking-luxe text-paper transition-colors hover:bg-paper hover:text-ink sm:px-9 sm:py-4">
        Best rated
      </a>
    </div>
  </div>
</section>

{# ============ TRUST STRIP ============ #}
<div class="border-y border-line bg-panel">
  <div class="mx-auto grid max-w-7xl grid-cols-2 divide-line sm:grid-cols-4 sm:divide-x">
    {% for t, s in trust_strip %}
    <div class="flex items-center gap-3 border-t border-line px-5 py-5 sm:border-t-0">
      <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-gold/40 bg-gold/10 text-gold">&#10022;</span>
      <div>
        <p class="text-[12px] font-semibold leading-tight text-ink">{{ t }}</p>
        <p class="mt-0.5 text-[10px] uppercase tracking-luxe text-mute">{{ s }}</p>
      </div>
    </div>
    {% endfor %}
  </div>
</div>

{# ============ SHOP BY CATEGORY — one row, up to 6 ============ #}
{% if cat_tiles %}
<section class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
  <div class="mb-9 flex flex-wrap items-end justify-between gap-x-4 gap-y-1">
    <h2 class="font-display text-2xl sm:text-3xl">Shop by category</h2>
    <a href="{{ url('shopfront:shop') }}" class="text-[11px] font-semibold uppercase tracking-luxe text-accent hover:underline">All products</a>
  </div>
  <div class="grid grid-cols-3 gap-4 sm:grid-cols-6 sm:gap-6">
    {% for t in cat_tiles %}
    <a href="{{ url('shopfront:shop') }}?category={{ t.category.slug }}" class="group text-center">
      <div class="mx-auto aspect-square w-full overflow-hidden rounded-full border border-line bg-line/40 b2-card">
        <img src="{{ t.image | media_src(800, 800, 'Category') }}" alt="{{ t.category.name }}" loading="lazy" decoding="async" class="b2-img h-full w-full object-cover">
      </div>
      <p class="mt-3 text-[12px] font-medium leading-tight text-ink group-hover:text-accent sm:text-[13px]">{{ t.category.name }}</p>
    </a>
    {% endfor %}
  </div>
</section>
{% endif %}

{# ============ PROMO BANNERS — placement "promo" ============ #}
{% for b in promo_banners %}
<section class="mx-auto max-w-7xl px-5 pt-4 lg:px-8">
  <a href="{{ b.cta_url or url('shopfront:shop') }}" class="group relative block overflow-hidden rounded-3xl bg-ink">
    <picture>
      {% if b.mobile_image %}<source media="(max-width: 640px)" srcset="{{ b.mobile_image.url }}">{% endif %}
      <img src="{{ b.image | media_src(1600, 600, 'Promo banner') }}" alt="{{ b.heading }}" loading="lazy" decoding="async"
           class="h-[280px] w-full object-cover transition-transform duration-700 group-hover:scale-105 sm:h-[380px]">
    </picture>
    {% if b.heading or b.subheading or b.cta_label %}
    <div class="absolute inset-0 flex flex-col items-start justify-center gap-3 bg-ink/30 p-6 sm:p-8 lg:p-14">
      {% if b.subheading %}<p class="text-[11px] font-semibold uppercase tracking-luxe text-paper/80">{{ b.subheading }}</p>{% endif %}
      {% if b.heading %}<h2 class="max-w-xl font-display text-2xl text-paper sm:text-3xl lg:text-4xl">{{ b.heading }}</h2>{% endif %}
      {% if b.cta_label %}<span class="mt-2 bg-paper px-7 py-3 text-[11px] font-semibold uppercase tracking-luxe text-ink transition-colors group-hover:bg-accent group-hover:text-paper">{{ b.cta_label }}</span>{% endif %}
    </div>
    {% endif %}
  </a>
</section>
{% endfor %}

{# ============ FEATURED ============ #}
<section class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
  <div class="mb-9 flex flex-wrap items-end justify-between gap-x-4 gap-y-1">
    <div>
      <p class="text-[11px] font-semibold uppercase tracking-luxe text-gold">Best sellers</p>
      <h2 class="mt-1 font-display text-2xl sm:text-3xl">Loved by the community</h2>
    </div>
    <a href="{{ url('shopfront:shop') }}" class="text-[11px] font-semibold uppercase tracking-luxe text-accent hover:underline">View all</a>
  </div>
  <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:gap-x-5 sm:gap-y-9 md:grid-cols-3 lg:grid-cols-4">
    {% for p in featured %}{% include "shopfront/partials/_card.jinja" %}{% endfor %}
  </div>
</section>

{# ============ BENEFIT BAND ============ #}
<section class="cv-auto bg-accent text-paper">
  <div class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
    <h2 class="text-center font-display text-2xl sm:text-3xl">Why it works</h2>
    <div class="mx-auto mt-3 h-px w-16 bg-paper/40"></div>
    <div class="mt-12 grid gap-10 sm:grid-cols-3">
      {% for t, d in [
        ('Whole-plant actives', 'Extracts kept close to their natural form so nothing useful is lost.'),
        ('Clinically guided', 'Doses that reflect the research — not what fits the label.'),
        ('Made to be used', 'Textures and rituals you will actually reach for every day.')] %}
      <div class="text-center">
        <span class="mx-auto grid h-11 w-11 place-items-center rounded-full border border-paper/40 text-lg">&#10022;</span>
        <p class="mt-4 font-display text-lg">{{ t }}</p>
        <p class="mt-2 text-sm leading-relaxed text-paper/75">{{ d }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{# ============ NEW ARRIVALS ============ #}
{% if new_arrivals %}
<section class="cv-auto mx-auto max-w-7xl px-5 py-16 lg:px-8">
  <div class="mb-9 flex flex-wrap items-end justify-between gap-x-4 gap-y-1">
    <h2 class="font-display text-2xl sm:text-3xl">New arrivals</h2>
    <a href="{{ url('shopfront:shop') }}?sort=new" class="text-[11px] font-semibold uppercase tracking-luxe text-accent hover:underline">View all</a>
  </div>
  <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:gap-x-5 sm:gap-y-9 md:grid-cols-3 lg:grid-cols-4">
    {% for p in new_arrivals %}{% include "shopfront/partials/_card.jinja" %}{% endfor %}
  </div>
</section>
{% endif %}

{# ============ TESTIMONIALS ============ #}
{% if testimonials %}
<section class="cv-auto border-y border-line bg-panel">
  <div class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
    <h2 class="mb-10 text-center font-display text-2xl sm:text-3xl">What people say</h2>
    <div class="grid gap-6 md:grid-cols-3">
      {% for r in testimonials %}
      <figure class="rounded-2xl border border-line bg-paper p-8 text-center b2-soft">
        <p class="text-gold">{{ '★' * r.rating }}</p>
        <blockquote class="mt-3 font-display text-lg leading-snug text-ink/85">“{{ r.body | truncate(140) }}”</blockquote>
        <figcaption class="mt-4 text-[11px] uppercase tracking-luxe text-mute">{{ r.author_name }} · {{ r.product.title }}</figcaption>
      </figure>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# ============ NEWSLETTER CTA ============ #}
<section class="mx-auto max-w-3xl px-5 py-20 text-center lg:px-8">
  <p class="text-[11px] font-semibold uppercase tracking-luxe text-gold">Join the ritual</p>
  <h2 class="mt-3 font-display text-3xl text-ink sm:text-4xl">Get 10% off your first order</h2>
  <p class="mt-3 text-sm text-mute">Slow beauty notes, restocks and members-only drops. No spam.</p>
  <form class="mx-auto mt-8 flex max-w-md items-center gap-2 border-b border-ink/25 pb-1"
        @submit.prevent="pushToast({msg:'Thanks — check your inbox', kind:'success'})">
    <input required type="email" placeholder="Email address" class="w-full bg-transparent py-2 text-sm outline-none placeholder:text-mute">
    <button class="shrink-0 bg-accent px-6 py-2.5 text-[11px] font-semibold uppercase tracking-luxe text-paper hover:bg-ink">Join</button>
  </form>
</section>

{# ============ POPUP BANNER — placement "popup"; once per visitor ============ #}
{% if popup_banner %}
<div x-data="{ open: false }"
     x-init="setTimeout(() => { try { if (!localStorage.getItem('sd_popup_{{ popup_banner.id }}')) open = true } catch (e) { open = true } }, 1200)"
     x-show="open" x-cloak
     class="fixed inset-0 z-[60] flex items-center justify-center bg-ink/60 p-4"
     @keydown.escape.window="open = false">
  <div class="relative w-full max-w-md overflow-hidden rounded-2xl bg-paper" @click.outside="open = false">
    <button type="button" aria-label="Close"
            @click="open = false; try { localStorage.setItem('sd_popup_{{ popup_banner.id }}', '1') } catch (e) {}"
            class="absolute right-3 top-3 z-10 grid h-8 w-8 place-items-center rounded-full bg-paper/80 text-lg text-ink hover:bg-paper">&times;</button>
    <a href="{{ popup_banner.cta_url or url('shopfront:shop') }}">
      {% if popup_banner.image %}<img src="{{ popup_banner.image.url }}" alt="{{ popup_banner.heading }}" class="w-full object-cover">{% endif %}
      {% if popup_banner.heading or popup_banner.subheading or popup_banner.cta_label %}
      <div class="p-6 text-center">
        {% if popup_banner.heading %}<h3 class="font-display text-2xl text-ink">{{ popup_banner.heading }}</h3>{% endif %}
        {% if popup_banner.subheading %}<p class="mt-2 text-sm text-mute">{{ popup_banner.subheading }}</p>{% endif %}
        {% if popup_banner.cta_label %}<span class="mt-4 inline-block bg-accent px-6 py-2.5 text-[11px] font-semibold uppercase tracking-luxe text-paper">{{ popup_banner.cta_label }}</span>{% endif %}
      </div>
      {% endif %}
    </a>
  </div>
</div>
{% endif %}
{% endblock %}
