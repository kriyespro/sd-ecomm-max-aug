{% extends "shopfront/base.jinja" %}
{% from "shopfront/partials/_heading.jinja" import heading_classes, align_class with context %}
{% from "shopfront/partials/_product_slider.jinja" import product_slider with context %}
{% block title %}{{ store.name }} — Rooted in nature, made for you{% endblock %}

{% block content %}
{#
  ══════════════════════════════════════════════════════════════════════
  EDIT HOMEPAGE COPY HERE
  ══════════════════════════════════════════════════════════════════════
  trust_strip — the 4 badges just under the hero. Each row is
  ('Headline', 'sub-line'). Add / remove / reword freely; keep 3–4 for
  the layout to stay even.
#}
{% set trust_strip = [
  ('Free shipping',    'Orders over ₹999'),
  ('Cash on delivery', 'Across India'),
  ('7-day returns',    'No questions asked'),
  ('Clean formulas',   'No nasties, ever'),
] %}

{# ============ HERO — full-bleed image with overlay ============ #}
{% set hero_img = (hero_banner.image.url if (hero_banner and hero_banner.image)
                   else ((featured[0].images.all() | first).image.url if (featured and featured[0].images.all()) else '')) %}
<section class="relative isolate overflow-hidden bg-ink">
  <picture>
    {% if hero_banner and hero_banner.mobile_image %}<source media="(max-width: 640px)" srcset="{{ hero_banner.mobile_image.url }}">{% endif %}
    <img src="{{ hero_img | media_src(1600, 520, 'Hero banner') }}" alt="" fetchpriority="high" decoding="async" class="block w-full h-auto">
  </picture>
  {% if not (hero_banner and hero_banner.hide_overlay) %}
  <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/40 to-ink/10"></div>
  {% endif %}

  {% if not (hero_banner and hero_banner.text_hidden and hero_banner.hide_cta) %}
  <div class="absolute inset-x-0 bottom-0 mx-auto w-full max-w-7xl px-5 py-3 sm:py-5 lg:px-8">
    {% if not (hero_banner and hero_banner.text_hidden) %}
    <p class="hidden items-center gap-2 text-[10px] font-semibold uppercase tracking-luxe text-gold sm:flex">
      <span class="h-px w-6 shrink-0 bg-gold"></span><span class="min-w-0">{{ hero_banner.subheading if hero_banner else 'Clean, plant-powered wellness' }}</span>
    </p>
    <h1 class="mt-1 max-w-xl font-display text-lg leading-tight text-paper sm:text-2xl lg:text-4xl">
      {% if hero_banner and hero_banner.heading %}{{ hero_banner.heading }}{% else %}Rooted in nature, made for the everyday.{% endif %}
    </h1>
    {% endif %}
    {% if not (hero_banner and hero_banner.hide_cta) %}
    <div class="mt-2 sm:mt-4">
      <a href="{{ hero_banner.cta_url if (hero_banner and hero_banner.cta_url) else url('shopfront:shop') }}"
         class="inline-block bg-paper px-4 py-1.5 text-[10px] font-semibold uppercase tracking-luxe text-ink transition-colors hover:bg-accent hover:text-paper sm:px-6 sm:py-2.5">
        {{ hero_banner.cta_label if (hero_banner and hero_banner.cta_label) else 'Shop the collection' }}
      </a>
    </div>
    {% endif %}
  </div>
  {% endif %}
</section>

{# ============ TRUST STRIP ============ #}
<div class="border-y border-line bg-panel">
  <div class="mx-auto grid max-w-7xl grid-cols-2 divide-line sm:grid-cols-4 sm:divide-x">
    {% for t, s in trust_strip %}
    <div class="flex items-center gap-3 border-t border-line px-5 py-5 sm:border-t-0">
      <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-gold/40 bg-gold/10 text-gold">&#10022;</span>
      <div>
        <p class="text-[12px] font-semibold leading-tight text-ink">{{ t }}</p>
        <p class="mt-0.5 text-[10px] uppercase tracking-luxe text-mute">{{ s }}</p>
      </div>
    </div>
    {% endfor %}
  </div>
</div>

{# ============ REORDERABLE HOMEPAGE SECTIONS (Theme → Homepage section order) ============
   Each is a self-contained macro so `section_order` (apps.cms.homepage_sections)
   can dispatch them in whatever sequence the merchant picked. An untouched
   store's `section_order` is this exact canonical order, so nothing changes
   until Theme settings is actually edited. #}

{% macro _section_categories() %}
{% if cat_tiles %}
<section class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
  <div class="mb-9 flex flex-wrap items-end justify-between gap-x-4 gap-y-1">
    <h2 class="flex-1 {{ heading_classes() }}">{{ section_titles.get('categories', 'Shop by category') }}</h2>
    <a href="{{ url('shopfront:shop') }}" class="text-[11px] font-semibold uppercase tracking-luxe text-accent hover:underline">All products</a>
  </div>
  <div class="{{ 'flex gap-4 overflow-x-auto pb-1 snap-x snap-mandatory scroll-smooth [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:grid sm:grid-cols-6 sm:gap-6 sm:overflow-visible' if category_mobile_slider else 'grid grid-cols-3 gap-4 sm:grid-cols-6 sm:gap-6' }}">
    {% for t in cat_tiles[:6] %}
    <a href="{{ url('shopfront:shop') }}?category={{ t.category.slug }}" class="group text-center {{ 'w-[30%] shrink-0 snap-start sm:w-auto' if category_mobile_slider }}">
      <div class="mx-auto aspect-square w-full overflow-hidden rounded-full border border-line bg-line/40 b2-card">
        <img src="{{ t.image | media_src(800, 800, 'Category') }}" alt="{{ t.category.name }}" loading="lazy" decoding="async" class="b2-img h-full w-full object-cover">
      </div>
      <p class="mt-3 text-[12px] font-medium leading-tight text-ink group-hover:text-accent sm:text-[13px]">{{ t.category.name }}</p>
    </a>
    {% endfor %}
  </div>
</section>
{% endif %}
{% endmacro %}

{% macro _section_promo() %}
{% for b in promo_banners %}
<section class="mx-auto max-w-7xl px-5 pt-4 lg:px-8">
  <a href="{{ b.cta_url or url('shopfront:shop') }}" class="group relative block aspect-[4/1] overflow-hidden rounded-3xl bg-ink">
    <picture>
      {% if b.mobile_image %}<source media="(max-width: 640px)" srcset="{{ b.mobile_image.url }}">{% endif %}
      <img src="{{ b.image | media_src(1600, 400, 'Promo banner') }}" alt="{{ '' if b.text_hidden else b.heading }}" loading="lazy" decoding="async"
           class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105">
    </picture>
    {% if not b.hide_overlay %}<div class="absolute inset-0 bg-ink/30"></div>{% endif %}
    {% if (not b.text_hidden and (b.subheading or b.heading)) or (not b.hide_cta and b.cta_label) %}
    <div class="absolute inset-0 flex flex-col items-start justify-center gap-3 p-6 sm:p-8 lg:p-14">
      {% if not b.text_hidden %}
      {% if b.subheading %}<p class="text-[11px] font-semibold uppercase tracking-luxe text-paper/80">{{ b.subheading }}</p>{% endif %}
      {% if b.heading %}<h2 class="max-w-xl font-display text-2xl text-paper sm:text-3xl lg:text-4xl">{{ b.heading }}</h2>{% endif %}
      {% endif %}
      {% if not b.hide_cta and b.cta_label %}<span class="mt-2 bg-paper px-7 py-3 text-[11px] font-semibold uppercase tracking-luxe text-ink transition-colors group-hover:bg-accent group-hover:text-paper">{{ b.cta_label }}</span>{% endif %}
    </div>
    {% endif %}
  </a>
</section>
{% endfor %}
{% endmacro %}

{% macro _section_featured() %}
<section class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
  <div class="mb-9 flex flex-wrap items-end justify-between gap-x-4 gap-y-1">
    <div class="flex-1">
      {% if not hide_featured_eyebrow %}
      <p class="{{ align_class() }} text-[11px] font-semibold uppercase tracking-luxe text-gold">{{ section_titles.get('featured_eyebrow', 'Best sellers') }}</p>
      {% endif %}
      <h2 class="mt-1 {{ heading_classes() }}">{{ section_titles.get('featured', 'Loved by the community') }}</h2>
    </div>
    <a href="{{ url('shopfront:shop') }}" class="text-[11px] font-semibold uppercase tracking-luxe text-accent hover:underline">View all</a>
  </div>
  {{ product_slider(featured, ref='featuredSlider', gap='gap-x-4 sm:gap-x-5') }}
</section>
{% endmacro %}

{% macro _section_benefits() %}
{% set _benefits = benefit_items if benefit_items else [
  {'icon': '✦', 'title': 'Whole-plant actives', 'description': 'Extracts kept close to their natural form so nothing useful is lost.'},
  {'icon': '✦', 'title': 'Clinically guided', 'description': 'Doses that reflect the research — not what fits the label.'},
  {'icon': '✦', 'title': 'Made to be used', 'description': 'Textures and rituals you will actually reach for every day.'},
] %}
<section class="cv-auto bg-accent text-paper">
  <div class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
    <h2 class="{{ heading_classes(default_align='text-center') }}">{{ section_titles.get('benefits', 'Why it works') }}</h2>
    <div class="mx-auto mt-3 h-px w-16 bg-paper/40"></div>
    <div class="mt-12 grid gap-10 sm:grid-cols-3">
      {% for item in _benefits %}
      <div class="text-center">
        <span class="mx-auto grid h-11 w-11 place-items-center rounded-full border border-paper/40 text-lg">{{ item.icon or '✦' }}</span>
        <p class="mt-4 font-display text-lg">{{ item.title }}</p>
        {% if item.description %}<p class="mt-2 text-sm leading-relaxed text-paper/75">{{ item.description }}</p>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endmacro %}

{% macro _section_new_arrivals() %}
{% if new_arrivals %}
<section class="cv-auto mx-auto max-w-7xl px-5 py-16 lg:px-8">
  <div class="mb-9 flex flex-wrap items-end justify-between gap-x-4 gap-y-1">
    <h2 class="flex-1 {{ heading_classes() }}">{{ section_titles.get('new_arrivals', 'New arrivals') }}</h2>
    <a href="{{ url('shopfront:shop') }}?sort=new" class="text-[11px] font-semibold uppercase tracking-luxe text-accent hover:underline">View all</a>
  </div>
  {{ product_slider(new_arrivals, ref='newArrivalsSlider', gap='gap-x-4 sm:gap-x-5') }}
</section>
{% endif %}
{% endmacro %}

{% macro _section_testimonials() %}
{% if testimonials %}
<section class="cv-auto border-y border-line bg-panel">
  <div class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
    <h2 class="mb-10 {{ heading_classes(default_align='text-center') }}">{{ section_titles.get('testimonials', 'What people say') }}</h2>
    <div class="grid gap-6 md:grid-cols-3">
      {% for r in testimonials %}
      <figure class="rounded-2xl border border-line bg-paper p-8 text-center b2-soft">
        <p class="text-gold">{{ '★' * r.rating }}</p>
        <blockquote class="mt-3 font-display text-lg leading-snug text-ink/85">“{{ r.body | truncate(140) }}”</blockquote>
        <figcaption class="mt-4 text-[11px] uppercase tracking-luxe text-mute">{{ r.author_name }} · {{ r.product.title }}</figcaption>
      </figure>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
{% endmacro %}

{% macro _section_newsletter() %}
<section class="mx-auto max-w-3xl px-5 py-20 text-center lg:px-8">
  <p class="text-[11px] font-semibold uppercase tracking-luxe text-gold">{{ section_titles.get('newsletter_eyebrow', 'Join the ritual') }}</p>
  <h2 class="mt-3 text-ink {{ heading_classes('text-3xl sm:text-4xl', 'text-center') }}">{{ section_titles.get('newsletter', 'Get 10% off your first order') }}</h2>
  <p class="mt-3 text-sm text-mute">Slow beauty notes, restocks and members-only drops. No spam.</p>
  <form class="mx-auto mt-8 flex max-w-md items-center gap-2 border-b border-ink/25 pb-1"
        @submit.prevent="pushToast({msg:'Thanks — check your inbox', kind:'success'})">
    <input required type="email" placeholder="Email address" class="w-full bg-transparent py-2 text-sm outline-none placeholder:text-mute">
    <button class="shrink-0 bg-accent px-6 py-2.5 text-[11px] font-semibold uppercase tracking-luxe text-paper hover:bg-ink">Join</button>
  </form>
</section>
{% endmacro %}

{% set _sections = {
  'categories': _section_categories, 'promo': _section_promo, 'featured': _section_featured,
  'benefits': _section_benefits, 'new_arrivals': _section_new_arrivals,
  'testimonials': _section_testimonials, 'newsletter': _section_newsletter,
} %}
{% for _key in section_order %}{% if _key in _sections %}{{ _sections[_key]() }}{% endif %}{% endfor %}

{# ============ POPUP BANNER — placement "popup"; once per visitor ============ #}
{% include "shopfront/partials/_ugc_shorts.jinja" %}

{% if popup_banner %}
<div x-data="{ open: false }"
     x-init="setTimeout(() => { try { if (!localStorage.getItem('sd_popup_{{ popup_banner.id }}')) open = true } catch (e) { open = true } }, 1200)"
     x-show="open" x-cloak
     class="fixed inset-0 z-[60] flex items-center justify-center bg-ink/60 p-4"
     @keydown.escape.window="open = false">
  <div class="relative w-full max-w-md overflow-hidden rounded-2xl bg-paper" @click.outside="open = false">
    <button type="button" aria-label="Close"
            @click="open = false; try { localStorage.setItem('sd_popup_{{ popup_banner.id }}', '1') } catch (e) {}"
            class="absolute right-3 top-3 z-10 grid h-8 w-8 place-items-center rounded-full bg-paper/80 text-lg text-ink hover:bg-paper">&times;</button>
    <a href="{{ popup_banner.cta_url or url('shopfront:shop') }}">
      {% if popup_banner.image %}<img src="{{ popup_banner.image.url }}" alt="{{ '' if popup_banner.text_hidden else popup_banner.heading }}" class="w-full object-cover">{% endif %}
      {% if not popup_banner.text_hidden and (popup_banner.heading or popup_banner.subheading) or (not popup_banner.hide_cta and popup_banner.cta_label) %}
      <div class="p-6 text-center">
        {% if not popup_banner.text_hidden %}
        {% if popup_banner.heading %}<h3 class="font-display text-2xl text-ink">{{ popup_banner.heading }}</h3>{% endif %}
        {% if popup_banner.subheading %}<p class="mt-2 text-sm text-mute">{{ popup_banner.subheading }}</p>{% endif %}
        {% endif %}
        {% if not popup_banner.hide_cta and popup_banner.cta_label %}<span class="mt-4 inline-block bg-accent px-6 py-2.5 text-[11px] font-semibold uppercase tracking-luxe text-paper">{{ popup_banner.cta_label }}</span>{% endif %}
      </div>
      {% endif %}
    </a>
  </div>
</div>
{% endif %}
{% endblock %}
