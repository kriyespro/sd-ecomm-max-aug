{# Festive product card — expects `p` (Product). Second image fades in on hover,
   discount % badge, always-visible Add to Bag. #}
{% set imgs = p.images.all() | list %}
{% set img = imgs[0] if imgs else none %}
{% set img2 = imgs[1] if imgs|length > 1 else none %}
<article class="group relative flex h-full flex-col">
  <a href="{{ url('shopfront:product', kwargs={'slug': p.slug}) }}" class="relative block overflow-hidden rounded-sm bg-accent-soft">
    <div class="relative aspect-[4/5] overflow-hidden">
      <img src="{{ (img.image if img else none) | media_src(1000, 1250, 'Product photo') }}"
           {% if img and img.srcset %}srcset="{{ img.srcset }}" sizes="(min-width:1024px) 25vw, (min-width:640px) 33vw, 50vw"{% endif %}
           {% if img and img.width %}width="{{ img.width }}" height="{{ img.height }}"{% endif %}
           alt="{{ (img.alt if img else '') or p.title }}" loading="lazy" decoding="async"
           class="h-full w-full object-cover transition-opacity duration-500 {{ 'group-hover:opacity-0' if img2 else '' }}">
      {% if img2 %}
      <img src="{{ img2.image | media_src(1000, 1250, 'Product photo') }}" alt="" loading="lazy" decoding="async"
           class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 group-hover:opacity-100">
      {% endif %}
    </div>
  </a>

  {% if p.on_sale and p.price and p.price > 0 %}
  <span class="fv-badge absolute left-0 top-3 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider">{{ (((p.price - p.current_price) / p.price) * 100) | round | int }}% off</span>
  {% elif p.is_new_arrival %}
  <span class="absolute left-0 top-3 bg-ink px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-paper">New</span>
  {% endif %}

  <button hx-get="{{ url('shopfront:quickview', kwargs={'slug': p.slug}) }}" hx-target="#quickview-body" hx-swap="innerHTML"
          @click="$dispatch('open-quick')" title="Quick view"
          class="absolute right-3 top-3 grid h-9 w-9 place-items-center rounded-full bg-white/90 text-ink opacity-0 shadow transition-opacity group-hover:opacity-100 hover:bg-accent hover:text-white">
    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
  </button>

  <div class="mt-3 flex-1">
    <a href="{{ url('shopfront:product', kwargs={'slug': p.slug}) }}" class="block text-[15px] font-medium leading-snug hover:text-accent">{{ p.title }}</a>
    <p class="mt-1 text-sm">
      {% if p.on_sale %}
      <span class="font-semibold text-accent">{{ p.current_price | money }}</span>
      <span class="ml-1.5 text-mute line-through">{{ p.price | money }}</span>
      {% else %}
      <span class="font-semibold">{{ p.price | money }}</span>
      {% endif %}
    </p>
    {% if p.rating_count %}
    <p class="mt-0.5 text-xs text-gold">{{ '★' * (p.rating_avg | round | int) }}<span class="text-mute"> ({{ p.rating_count }})</span></p>
    {% endif %}
  </div>

  <div class="mt-3 flex gap-1.5">
    <form hx-post="{{ url('shopfront:cart_add') }}" hx-swap="none" class="min-w-0 flex-1">
      <input type="hidden" name="product" value="{{ p.slug }}">
      <button class="w-full border border-accent py-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-accent transition-colors hover:bg-accent hover:text-white">
        Add to bag
      </button>
    </form>
    {% include "shopfront/partials/_whatsapp_enquiry_btn.jinja" %}
  </div>
</article>
