{% extends "shopfront/base.jinja" %}
{% block title %}Order {{ order.number }} · {{ store.name }}{% endblock %}

{% block content %}
<div class="mx-auto max-w-2xl px-5 py-16 text-center lg:px-8">
  <p class="font-display text-5xl text-accent">✓</p>
  <h1 class="mt-4 font-display text-3xl">Thank you</h1>
  <p class="mt-2 text-sm text-mute">Order <span class="font-medium text-ink">{{ order.number }}</span> · {{ order.get_status_display() }} · {{ order.get_payment_status_display() }}</p>

  <div class="mt-10 border-y border-line py-6 text-left">
    <table class="w-full text-sm">
      <tbody class="divide-y divide-line">
        {% for i in order.items.all() %}
        <tr>
          <td class="py-3">{{ i.quantity }} × {{ i.product_title }}{% if i.variant_name %} · {{ i.variant_name }}{% endif %}</td>
          <td class="py-3 text-right">{{ i.line_total | money }}</td>
        </tr>
        {% endfor %}
      </tbody>
      <tfoot>
        <tr><td class="pt-4 text-mute">Subtotal</td><td class="pt-4 text-right">{{ order.subtotal | money }}</td></tr>
        {% if order.discount_total and order.discount_total > 0 %}
        <tr><td class="text-emerald-700">Discount{% if order.coupon_code %} · {{ order.coupon_code }}{% endif %}</td><td class="text-right text-emerald-700">− {{ order.discount_total | money }}</td></tr>
        {% endif %}
        <tr><td class="text-mute">Shipping</td><td class="text-right">{{ order.shipping_total | money }}</td></tr>
        <tr><td class="text-mute">Tax</td><td class="text-right">{{ order.tax_total | money }}</td></tr>
        <tr class="font-display text-lg"><td class="pt-3">Total</td><td class="pt-3 text-right">{{ order.grand_total | money }}</td></tr>
      </tfoot>
    </table>
  </div>

  <div class="mt-8 text-left text-sm text-mute">
    <p class="font-medium text-ink">Delivering to</p>
    <p>{{ order.shipping_address.get('name') }}</p>
    <p>{{ order.shipping_address.get('line1') }}{% if order.shipping_address.get('line2') %}, {{ order.shipping_address.get('line2') }}{% endif %}</p>
    <p>{{ order.shipping_address.get('city') }}, {{ order.shipping_address.get('state') }} {{ order.shipping_address.get('postal_code') }} · {{ order.shipping_address.get('country') }}</p>
  </div>

  {% if wa_order_url %}
  <div class="mt-8 border border-[#25D366]/40 bg-[#25D366]/5 p-5 text-left">
    <p class="text-sm font-medium text-ink">One last step — send your order to us on WhatsApp.</p>
    <p class="mt-1 text-xs text-mute">Your order is saved. Tap the button and press Send in WhatsApp so we can confirm it and arrange payment.</p>
    <a id="wa-send" href="{{ wa_order_url }}" class="mt-3 inline-block bg-[#25D366] px-6 py-2.5 text-[11px] font-semibold uppercase tracking-luxe text-white hover:bg-[#1ebe5b]">Send order on WhatsApp</a>
  </div>
  {% if wa_auto_open %}
  <script>
    (function () {
      var key = "wa_sent_{{ order.number }}";
      try { if (sessionStorage.getItem(key)) return; sessionStorage.setItem(key, "1"); } catch (e) {}
      setTimeout(function () { window.location.href = document.getElementById("wa-send").href; }, 900);
    })();
  </script>
  {% endif %}
  {% endif %}

  {% if upi %}
  <div class="mt-8 border border-accent/40 bg-accent/5 p-5 text-left">
    <p class="text-sm font-semibold text-ink">Pay {{ order.grand_total | money }} by UPI</p>
    <div class="mt-4 flex flex-col items-center gap-4 sm:flex-row sm:items-start">
      {% if upi.qr_url or upi.qr_svg %}
      <img src="{{ upi.qr_url or upi.qr_svg }}" alt="UPI QR code" width="176" height="176" class="h-44 w-44 border border-line bg-white p-1">
      {% endif %}
      <div class="text-sm">
        <p class="text-mute">Scan the QR with any UPI app, or pay to:</p>
        <p class="mt-1 select-all font-mono text-base text-ink">{{ upi.upi_id }}</p>
        {% if upi.payee_name %}<p class="text-xs text-mute">{{ upi.payee_name }}</p>{% endif %}
        <a href="{{ upi.link }}" class="mt-3 inline-block bg-ink px-5 py-2.5 text-[11px] font-semibold uppercase tracking-luxe text-paper hover:bg-accent sm:hidden">Open UPI app</a>
        <p class="mt-3 text-xs text-mute">Amount {{ order.grand_total | money }} · note: Order {{ order.number }}</p>
      </div>
    </div>
    <form method="post" action="{{ url('shopfront:order_upi_reference', kwargs={'number': order.number}) }}" class="mt-5 border-t border-line pt-4">
      {{ csrf_input }}
      <label class="block text-xs font-medium text-ink" for="utr">After paying, enter the UPI reference / UTR number</label>
      <div class="mt-2 flex gap-2">
        <input id="utr" name="utr" value="{{ upi.utr }}" required minlength="8" maxlength="30" autocomplete="off"
               placeholder="e.g. 412345678901" class="w-full border border-line bg-transparent px-3 py-2.5 text-sm outline-none focus:border-accent">
        <button class="bg-ink px-5 text-[11px] font-semibold uppercase tracking-luxe text-paper hover:bg-accent">{{ 'Update' if upi.utr else 'Submit' }}</button>
      </div>
      <p class="mt-2 text-xs text-mute">{% if upi.utr %}Reference received — we'll confirm your payment shortly.{% else %}Your order is confirmed once the store verifies the payment.{% endif %}</p>
    </form>
  </div>
  {% endif %}

  {% if order.can_retry_payment %}
  <div class="mt-8 border border-rose-200 bg-rose-50 p-5 text-left">
    <p class="text-sm font-medium text-rose-700">Payment didn't complete.</p>
    <p class="mt-1 text-xs text-rose-600">This order is still waiting on payment — try again below.</p>
    <form method="post" action="{{ url('shopfront:order_pay_retry', kwargs={'number': order.number}) }}" class="mt-3">
      {{ csrf_input }}
      <button class="bg-ink px-6 py-2.5 text-[11px] font-semibold uppercase tracking-luxe text-paper hover:bg-accent">
        Retry payment
      </button>
    </form>
  </div>
  {% endif %}

  <a href="{{ url('shopfront:shop') }}" class="mt-10 inline-block bg-ink px-10 py-3.5 text-[11px] font-semibold uppercase tracking-luxe text-paper hover:bg-accent">Continue shopping</a>
</div>
{% endblock %}
