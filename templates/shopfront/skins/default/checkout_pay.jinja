{% extends "shopfront/base.jinja" %}
{% block title %}Completing payment · {{ store.name }}{% endblock %}

{% block content %}
<div class="mx-auto max-w-md px-5 py-20 text-center">
  <h1 class="font-display text-2xl">Completing your payment…</h1>
  <p class="mt-3 text-sm text-mute">
    A secure payment window should open in a moment. If it doesn’t, tap the button below.
  </p>
  <button id="pay-open" class="mt-6 border border-line px-6 py-2.5 text-sm hover:border-accent">
    Open payment window
  </button>
  <p id="pay-msg" class="mt-5 text-sm text-red-600"></p>
  <p class="mt-6 text-xs text-mute">
    Order <b>{{ order.number }}</b> is placed.
    <a href="{{ order_url }}" class="underline">View order</a>
  </p>
</div>

<script id="pay-data" type="application/json">{{ {
  "key": pay.key_id,
  "order_id": pay.razorpay_order_id,
  "amount": pay.amount,
  "currency": pay.currency,
  "name": pay.name,
  "prefill": pay.prefill,
  "payment_id": payment_id,
  "verify_url": verify_url,
  "order_url": order_url
} | tojson }}</script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
(function () {
  var d = JSON.parse(document.getElementById("pay-data").textContent);
  var msg = document.getElementById("pay-msg");

  function finish() { window.location.href = d.order_url; }

  function openCheckout() {
    if (!window.Razorpay) {
      msg.textContent = "Couldn’t load the payment library. Pay from the order page instead.";
      return;
    }
    var rzp = new Razorpay({
      key: d.key,
      order_id: d.order_id,
      amount: d.amount,
      currency: d.currency,
      name: d.name,
      prefill: d.prefill || {},
      handler: function (resp) {
        fetch(d.verify_url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            payment_id: d.payment_id,
            razorpay_payment_id: resp.razorpay_payment_id,
            razorpay_order_id: resp.razorpay_order_id,
            razorpay_signature: resp.razorpay_signature
          })
        }).then(finish, finish);
      },
      modal: {
        ondismiss: function () {
          msg.textContent = "Payment cancelled. You can still pay from the order page.";
        }
      }
    });
    rzp.on("payment.failed", function () {
      msg.textContent = "Payment failed. Try again, or pay from the order page.";
    });
    rzp.open();
  }

  document.getElementById("pay-open").addEventListener("click", openCheckout);
  openCheckout();
})();
</script>
{% endblock %}
