{% extends "shopfront/base.jinja" %}
{% block title %}Referrals · {{ store.name }}{% endblock %}

{% block content %}
<div class="mx-auto max-w-4xl px-5 py-16 lg:px-8">
  <h1 class="font-display text-3xl sm:text-4xl">Refer &amp; earn</h1>

  {% if not user.is_authenticated %}
  <p class="mt-4 text-sm text-mute">
    <a href="{{ url('shopfront:login') }}" class="underline hover:text-ink">Sign in</a>
    to become a referrer and start earning.
  </p>

  {% elif not referral_program or not referral_program.is_active %}
  <p class="mt-4 text-sm text-mute">This store hasn't turned on its referral program yet.</p>

  {% elif not referrer %}
  <p class="mt-4 text-sm text-ink/75">
    Share your own link and earn a commission on every order it brings this store.
  </p>
  <form method="post" action="{{ url('shopfront:referral_join') }}" class="mt-6">
    {{ csrf_input }}
    <button class="border border-ink px-6 py-3.5 text-[11px] font-semibold uppercase tracking-luxe hover:bg-ink hover:text-paper">
      Become a referrer
    </button>
  </form>

  {% else %}
  <div class="mt-6 border border-line bg-panel px-5 py-4">
    <p class="text-[11px] uppercase tracking-wide text-mute">Your referral code</p>
    <p class="mt-1 font-mono text-lg">{{ referrer.code }}</p>
    <p class="mt-3 text-[11px] uppercase tracking-wide text-mute">Your referral link</p>
    <p class="mt-1 break-all font-mono text-sm text-accent">{{ request.build_absolute_uri('/') }}?ref={{ referrer.code }}</p>
  </div>

  <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3">
    {% for label, value in [
      ('Clicks', clicks), ('Orders', orders), ('Sales', sales | money),
      ('Pending', pending | money), ('Approved', approved | money), ('Paid', paid | money),
    ] %}
    <div class="border border-line px-4 py-3">
      <p class="text-[10px] uppercase tracking-wide text-mute">{{ label }}</p>
      <p class="mt-1 text-lg font-medium">{{ value }}</p>
    </div>
    {% endfor %}
  </div>

  <section class="mt-10">
    <h2 class="mb-4 text-[12px] font-semibold uppercase tracking-luxe text-mute">Recent referrals</h2>
    <div class="divide-y divide-line border-y border-line">
      {% for c in recent_commissions %}
      <div class="flex flex-wrap items-center justify-between gap-2 py-3 text-sm">
        <span class="font-medium">{{ c.order.number }}</span>
        <span class="text-mute">{{ c.order_amount | money }}</span>
        <span class="font-medium">{{ c.commission_amount | money }}</span>
        <span class="text-[11px] uppercase tracking-wide text-mute">{{ c.get_status_display() }}</span>
      </div>
      {% else %}
      <p class="py-6 text-sm text-mute">No referrals yet — share your link to get started.</p>
      {% endfor %}
    </div>
  </section>
  {% endif %}
</div>
{% endblock %}
