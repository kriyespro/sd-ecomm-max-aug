{% extends "shopfront/base.jinja" %}
{% block title %}{{ page.seo_title or page.title }} · {{ store.name }}{% endblock %}

{% block content %}
<article class="mx-auto max-w-3xl px-5 py-16 lg:px-8">
  <h1 class="font-display text-3xl sm:text-4xl">{{ page.title }}</h1>
  {% if page.excerpt %}<p class="mt-3 text-lg text-mute">{{ page.excerpt }}</p>{% endif %}
  <div class="prose prose-stone mt-8 max-w-none text-[15px] leading-relaxed text-ink/80">
    {{ page.body | safe }}
  </div>
</article>
{% endblock %}
