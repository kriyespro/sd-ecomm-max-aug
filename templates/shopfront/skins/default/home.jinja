{% extends "shopfront/base.jinja" %}
{% block title %}{{ store.name }} — Fine everyday jewellery{% endblock %}

{% block content %}
{# HERO — full-bleed image with overlay #}
{% set hero_img = (hero_banner.image.url if (hero_banner and hero_banner.image)
                   else ((featured[0].images.all() | first).image.url if (featured and featured[0].images.all()) else '')) %}
<section class="relative isolate flex min-h-[78vh] items-end overflow-hidden bg-ink">
  {% if hero_img %}
  <img src="{{ hero_img }}" alt="" fetchpriority="high" decoding="async" class="absolute inset-0 -z-10 h-full w-full object-cover">
  {% endif %}
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/85 via-ink/35 to-ink/10"></div>

  <div class="mx-auto w-full max-w-7xl px-5 pb-16 pt-40 lg:px-8 lg:pb-24">
    <p class="text-[11px] font-semibold uppercase tracking-luxe text-paper/70">
      {{ hero_banner.subheading if hero_banner else 'New season' }}
    </p>
    <h1 class="mt-4 max-w-2xl font-display text-5xl leading-[1.04] text-paper sm:text-6xl lg:text-7xl">
      {{ hero_banner.heading if hero_banner else 'Considered essentials, made to last.' }}
    </h1>
    <p class="mt-5 max-w-md text-[15px] leading-relaxed text-paper/80">
      A tightly edited collection — designed to be worn every day, not saved for later.
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href="{{ hero_banner.cta_url if (hero_banner and hero_banner.cta_url) else url('shopfront:shop') }}"
         class="bg-paper px-9 py-4 text-[11px] font-semibold uppercase tracking-luxe text-ink transition-colors hover:bg-accent hover:text-paper">
        {{ hero_banner.cta_label if (hero_banner and hero_banner.cta_label) else 'Shop the collection' }}
      </a>
      <a href="{{ url('shopfront:shop') }}?sort=rating"
         class="border border-paper/60 px-9 py-4 text-[11px] font-semibold uppercase tracking-luxe text-paper transition-colors hover:bg-paper hover:text-ink">
        Best rated
      </a>
    </div>
  </div>
</section>

{# CATEGORIES #}
{% if cat_tiles %}
<section class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
  <h2 class="mb-8 font-display text-3xl">Shop by category</h2>
  <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
    {% for t in cat_tiles %}
    <a href="{{ url('shopfront:shop') }}?category={{ t.category.slug }}" class="group relative block aspect-[3/2] overflow-hidden bg-line/40">
      {% if t.image %}<img src="{{ t.image }}" alt="{{ t.category.name }}" loading="lazy" decoding="async" class="card-img h-full w-full object-cover">{% endif %}
      <div class="absolute inset-0 bg-ink/25 transition-colors group-hover:bg-ink/35"></div>
      <span class="absolute inset-0 flex items-center justify-center font-display text-2xl text-paper">{{ t.category.name }}</span>
    </a>
    {% endfor %}
  </div>
</section>
{% endif %}

{# FEATURED #}
<section class="mx-auto max-w-7xl px-5 pb-8 lg:px-8">
  <div class="mb-8 flex items-end justify-between">
    <h2 class="font-display text-3xl">Featured</h2>
    <a href="{{ url('shopfront:shop') }}" class="text-[12px] font-semibold uppercase tracking-luxe text-accent hover:underline">View all</a>
  </div>
  <div class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-3 lg:grid-cols-4">
    {% for p in featured %}{% include "shopfront/partials/_card.jinja" %}{% endfor %}
  </div>
</section>

{# NEW ARRIVALS #}
{% if new_arrivals %}
<section class="cv-auto mx-auto max-w-7xl px-5 py-16 lg:px-8">
  <h2 class="mb-8 font-display text-3xl">New arrivals</h2>
  <div class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-3 lg:grid-cols-4">
    {% for p in new_arrivals %}{% include "shopfront/partials/_card.jinja" %}{% endfor %}
  </div>
</section>
{% endif %}

{# TESTIMONIALS #}
{% if testimonials %}
<section class="cv-auto mx-auto max-w-7xl px-5 py-16 lg:px-8">
  <h2 class="mb-10 text-center font-display text-3xl">What people say</h2>
  <div class="grid gap-8 md:grid-cols-3">
    {% for r in testimonials %}
    <figure class="border border-line bg-panel p-8 text-center">
      <p class="text-accent">{{ '★' * r.rating }}</p>
      <blockquote class="mt-3 font-display text-lg leading-snug text-ink/85">“{{ r.body | truncate(140) }}”</blockquote>
      <figcaption class="mt-4 text-xs uppercase tracking-luxe text-mute">{{ r.author_name }} · {{ r.product.title }}</figcaption>
    </figure>
    {% endfor %}
  </div>
</section>
{% endif %}

{# VALUE PROPS #}
<section class="cv-auto border-y border-line bg-panel">
  <div class="mx-auto grid max-w-7xl gap-8 px-5 py-14 text-center sm:grid-cols-3 lg:px-8">
    {% for t, d in [('Free shipping', 'On all orders over ₹999'), ('Cash on delivery', 'Available across India'), ('7-day returns', 'Easy, no-questions returns')] %}
    <div>
      <p class="font-display text-xl">{{ t }}</p>
      <p class="mt-1 text-sm text-mute">{{ d }}</p>
    </div>
    {% endfor %}
  </div>
</section>
{% endblock %}
