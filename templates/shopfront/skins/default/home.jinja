{% extends "shopfront/base.jinja" %}
{% from "shopfront/partials/_heading.jinja" import heading_classes with context %}
{% from "shopfront/partials/_product_slider.jinja" import product_slider with context %}
{% from "shopfront/partials/_hero_video.jinja" import hero_video %}
{% block title %}{{ store.name }} — Fine everyday jewellery{% endblock %}

{% block content %}
{# HERO — full-bleed image with overlay #}
{% set hero_img = (hero_banner.image.url if (hero_banner and hero_banner.image)
                   else ((featured[0].images.all() | first).image.url if (featured and featured[0].images.all()) else '')) %}
<section class="relative isolate overflow-hidden bg-ink">
  {% if hero_banner and hero_banner.video_youtube_id %}
  {{ hero_video(hero_banner.video_youtube_id) }}
  {% else %}
  <picture>
    {% if hero_banner and hero_banner.mobile_image %}<source media="(max-width: 640px)" srcset="{{ hero_banner.mobile_image.url }}">{% endif %}
    <img src="{{ hero_img | media_src(1600, 520, 'Hero banner') }}" alt="" fetchpriority="high" decoding="async" class="block w-full h-auto">
  </picture>
  {% endif %}
  {% if not (hero_banner and hero_banner.hide_overlay) %}
  <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/35 to-ink/10"></div>
  {% endif %}

  {% if not (hero_banner and hero_banner.text_hidden and hero_banner.hide_cta) %}
  <div class="absolute inset-x-0 bottom-0 mx-auto w-full max-w-7xl px-5 py-3 sm:py-5 lg:px-8">
    {% if not (hero_banner and hero_banner.text_hidden) %}
    <p class="hidden text-[10px] font-semibold uppercase tracking-luxe text-paper/70 sm:block">
      {{ hero_banner.subheading if hero_banner else 'New season' }}
    </p>
    <h1 class="mt-1 max-w-xl font-display text-lg leading-tight text-paper sm:text-2xl lg:text-4xl">
      {{ hero_banner.heading if hero_banner else 'Considered essentials, made to last.' }}
    </h1>
    {% endif %}
    {% if not (hero_banner and hero_banner.hide_cta) %}
    <div class="mt-2 sm:mt-4">
      <a href="{{ hero_banner.cta_url if (hero_banner and hero_banner.cta_url) else url('shopfront:shop') }}"
         class="inline-block bg-paper px-4 py-1.5 text-[10px] font-semibold uppercase tracking-luxe text-ink transition-colors hover:bg-accent hover:text-paper sm:px-6 sm:py-2.5">
        {{ hero_banner.cta_label if (hero_banner and hero_banner.cta_label) else 'Shop the collection' }}
      </a>
    </div>
    {% endif %}
  </div>
  {% endif %}
</section>

{# ============ REORDERABLE HOMEPAGE SECTIONS (Theme → Homepage section order) ============
   Each is a self-contained macro so `section_order` (apps.cms.homepage_sections)
   can dispatch them in whatever sequence the merchant picked. An untouched
   store's `section_order` is this exact canonical order, so nothing changes
   until Theme settings is actually edited. #}

{% macro _section_promo() %}
{% for b in promo_banners %}
<section class="mx-auto max-w-7xl px-5 pt-14 lg:px-8">
  <a href="{{ b.cta_url or url('shopfront:shop') }}" class="group relative block aspect-[4/1] overflow-hidden bg-ink">
    <picture>
      {% if b.mobile_image %}<source media="(max-width: 640px)" srcset="{{ b.mobile_image.url }}">{% endif %}
      <img src="{{ b.image | media_src(1600, 400, 'Promo banner') }}" alt="{{ '' if b.text_hidden else b.heading }}" loading="lazy" decoding="async"
           class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105">
    </picture>
    {% if not b.hide_overlay %}<div class="absolute inset-0 bg-ink/30"></div>{% endif %}
    {% if (not b.text_hidden and (b.subheading or b.heading)) or (not b.hide_cta and b.cta_label) %}
    <div class="absolute inset-0 flex flex-col items-start justify-center gap-3 p-8 lg:p-14">
      {% if not b.text_hidden %}
      {% if b.subheading %}<p class="text-[11px] font-semibold uppercase tracking-luxe text-paper/80">{{ b.subheading }}</p>{% endif %}
      {% if b.heading %}<h2 class="max-w-xl font-display text-3xl text-paper sm:text-4xl">{{ b.heading }}</h2>{% endif %}
      {% endif %}
      {% if not b.hide_cta and b.cta_label %}<span class="mt-2 bg-paper px-7 py-3 text-[11px] font-semibold uppercase tracking-luxe text-ink transition-colors group-hover:bg-accent group-hover:text-paper">{{ b.cta_label }}</span>{% endif %}
    </div>
    {% endif %}
  </a>
</section>
{% endfor %}
{% endmacro %}

{% macro _section_categories() %}
{% if cat_tiles %}
<section class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
  <h2 class="mb-8 {{ heading_classes('text-3xl') }}">{{ section_titles.get('categories', 'Shop by category') }}</h2>
  <div class="{{ 'flex gap-4 overflow-x-auto pb-1 snap-x snap-mandatory scroll-smooth [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden md:grid md:grid-cols-3 md:overflow-visible' if category_mobile_slider else 'grid grid-cols-2 gap-4 md:grid-cols-3' }}">
    {% for t in cat_tiles[:6] %}
    <a href="{{ url('shopfront:shop') }}?category={{ t.category.slug }}" class="group relative block aspect-[3/2] overflow-hidden bg-line/40 {{ 'w-[45%] shrink-0 snap-start md:w-auto' if category_mobile_slider }}">
      <img src="{{ t.image | media_src(900, 600, 'Category') }}" alt="{{ t.category.name }}" loading="lazy" decoding="async" class="card-img h-full w-full object-cover">
      <div class="absolute inset-0 bg-ink/25 transition-colors group-hover:bg-ink/35"></div>
      <span class="absolute inset-0 flex items-center justify-center px-2 text-center font-display text-lg leading-tight text-paper sm:text-2xl">{{ t.category.name }}</span>
    </a>
    {% endfor %}
  </div>
</section>
{% endif %}
{% endmacro %}

{% macro _section_featured() %}
<section class="mx-auto max-w-7xl px-5 pb-8 lg:px-8">
  <div class="mb-8 flex items-end justify-between">
    <h2 class="flex-1 {{ heading_classes('text-3xl') }}">{{ section_titles.get('featured', 'Featured') }}</h2>
    <a href="{{ url('shopfront:shop') }}" class="text-[12px] font-semibold uppercase tracking-luxe text-accent hover:underline">View all</a>
  </div>
  {{ product_slider(featured, ref='featuredSlider', gap='gap-x-6') }}
</section>
{% endmacro %}

{% macro _section_new_arrivals() %}
{% if new_arrivals %}
<section class="cv-auto mx-auto max-w-7xl px-5 py-16 lg:px-8">
  <h2 class="mb-8 {{ heading_classes('text-3xl') }}">{{ section_titles.get('new_arrivals', 'New arrivals') }}</h2>
  {{ product_slider(new_arrivals, ref='newArrivalsSlider', gap='gap-x-6') }}
</section>
{% endif %}
{% endmacro %}

{% macro _section_testimonials() %}
{% if testimonials %}
<section class="cv-auto mx-auto max-w-7xl px-5 py-16 lg:px-8">
  <h2 class="mb-10 {{ heading_classes('text-3xl', 'text-center') }}">{{ section_titles.get('testimonials', 'What people say') }}</h2>
  <div class="grid gap-8 md:grid-cols-3">
    {% for r in testimonials %}
    <figure class="border border-line bg-panel p-8 text-center">
      <p class="text-accent">{{ '★' * r.rating }}</p>
      <blockquote class="mt-3 font-display text-lg leading-snug text-ink/85">“{{ r.body | truncate(140) }}”</blockquote>
      <figcaption class="mt-4 text-xs uppercase tracking-luxe text-mute">{{ r.author_name }} · {{ r.product.title }}</figcaption>
    </figure>
    {% endfor %}
  </div>
</section>
{% endif %}
{% endmacro %}

{% set _sections = {
  'promo': _section_promo, 'categories': _section_categories, 'featured': _section_featured,
  'new_arrivals': _section_new_arrivals, 'testimonials': _section_testimonials,
} %}
{% for _key in section_order %}{% if _key in _sections %}{{ _sections[_key]() }}{% endif %}{% endfor %}

{# VALUE PROPS #}
<section class="cv-auto border-y border-line bg-panel">
  <div class="mx-auto grid max-w-7xl gap-8 px-5 py-14 text-center sm:grid-cols-3 lg:px-8">
    {% for t, d in [('Free shipping', 'On all orders over ₹999'), ('Cash on delivery', 'Available across India'), ('7-day returns', 'Easy, no-questions returns')] %}
    <div>
      <p class="font-display text-xl">{{ t }}</p>
      <p class="mt-1 text-sm text-mute">{{ d }}</p>
    </div>
    {% endfor %}
  </div>
</section>

{% include "shopfront/partials/_ugc_shorts.jinja" %}

{# POPUP BANNER — placement "popup"; shown once per visitor (localStorage) #}
{% if popup_banner %}
<div x-data="{ open: false }"
     x-init="setTimeout(() => { try { if (!localStorage.getItem('sd_popup_{{ popup_banner.id }}')) open = true } catch (e) { open = true } }, 1200)"
     x-show="open" x-cloak
     class="fixed inset-0 z-[60] flex items-center justify-center bg-ink/60 p-4"
     @keydown.escape.window="open = false">
  <div class="relative w-full max-w-md overflow-hidden bg-paper" @click.outside="open = false">
    <button type="button" aria-label="Close"
            @click="open = false; try { localStorage.setItem('sd_popup_{{ popup_banner.id }}', '1') } catch (e) {}"
            class="absolute right-3 top-3 z-10 grid h-8 w-8 place-items-center bg-paper/80 text-lg text-ink hover:bg-paper">&times;</button>
    <a href="{{ popup_banner.cta_url or url('shopfront:shop') }}">
      {% if popup_banner.image %}<img src="{{ popup_banner.image.url }}" alt="{{ '' if popup_banner.text_hidden else popup_banner.heading }}" class="w-full object-cover">{% endif %}
      {% if not popup_banner.text_hidden and (popup_banner.heading or popup_banner.subheading) or (not popup_banner.hide_cta and popup_banner.cta_label) %}
      <div class="p-6 text-center">
        {% if not popup_banner.text_hidden %}
        {% if popup_banner.heading %}<h3 class="font-display text-2xl text-ink">{{ popup_banner.heading }}</h3>{% endif %}
        {% if popup_banner.subheading %}<p class="mt-2 text-sm text-mute">{{ popup_banner.subheading }}</p>{% endif %}
        {% endif %}
        {% if not popup_banner.hide_cta and popup_banner.cta_label %}<span class="mt-4 inline-block bg-ink px-6 py-2.5 text-[11px] font-semibold uppercase tracking-luxe text-paper">{{ popup_banner.cta_label }}</span>{% endif %}
      </div>
      {% endif %}
    </a>
  </div>
</div>
{% endif %}
{% endblock %}
