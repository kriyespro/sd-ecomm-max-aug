{% extends "shopfront/base.jinja" %}
{% block title %}Shop · {{ store.name }}{% endblock %}

{% block content %}
<div class="mx-auto max-w-7xl px-5 py-6 lg:py-10 lg:px-8">
  <div class="lg:flex lg:items-center lg:gap-6">
    <header class="mb-3 sm:mb-4 lg:mb-0 lg:shrink-0">
      <h1 class="text-[11px] font-semibold uppercase tracking-luxe text-ink">
        {% if active_category %}{% for c in all_categories %}{% if c.slug == active_category %}{{ c.name }}{% endif %}{% endfor %}
        {% elif query %}“{{ query }}”
        {% else %}Shop all{% endif %}
        <span class="ml-1 font-normal normal-case text-mute" id="result-count">({{ result_count }} piece{{ 's' if result_count != 1 }})</span>
      </h1>
    </header>

    {# compact, unlabelled filter bar — placeholders/selected options carry the meaning;
       sits beside the heading at lg+ instead of its own stacked block #}
    <form id="filters" hx-get="{{ url('shopfront:shop') }}" hx-target="#grid" hx-push-url="true"
          hx-trigger="change, input changed delay:450ms"
          hx-indicator="#grid"
          class="mb-4 flex flex-wrap items-center gap-1.5 border-y border-line py-2
                 sm:mb-6 sm:grid sm:grid-cols-2 sm:gap-3 sm:py-2.5
                 lg:mb-0 lg:flex lg:w-auto lg:flex-nowrap lg:gap-2 lg:border-y-0 lg:py-0">
      {% set _fld = "w-full border border-line bg-transparent px-2.5 py-1.5 text-sm outline-none focus:border-accent" %}

      <div class="basis-full sm:basis-auto lg:w-40">
        <input type="search" name="q" value="{{ query }}" aria-label="Search" placeholder="Search products…" class="{{ _fld }}">
      </div>
      <div class="min-w-0 flex-1 sm:flex-none lg:w-36">
        <select name="category" aria-label="Category" class="{{ _fld }}">
          <option value="">All categories</option>
          {% for c in all_categories %}<option value="{{ c.slug }}" {{ 'selected' if c.slug == active_category }}>{{ c.name }}</option>{% endfor %}
        </select>
      </div>
      <div class="min-w-0 flex-1 sm:flex-none lg:w-32">
        <select name="sort" aria-label="Sort" class="{{ _fld }}">
          {% for v, t in [('new','Newest'),('price_asc','Price: low to high'),('price_desc','Price: high to low'),('rating','Top rated'),('name','Name')] %}
          <option value="{{ v }}" {{ 'selected' if v == sort }}>{{ t }}</option>{% endfor %}
        </select>
      </div>
      <div class="basis-full sm:basis-auto">
        <div class="flex items-center gap-2">
          <input name="min" value="{{ price_min }}" inputmode="numeric" aria-label="Minimum price" placeholder="Min ₹" class="{{ _fld }} lg:w-16">
          <span class="text-mute">–</span>
          <input name="max" value="{{ price_max }}" inputmode="numeric" aria-label="Maximum price" placeholder="Max ₹" class="{{ _fld }} lg:w-16">
        </div>
      </div>
    </form>
  </div>

  {# CATEGORY BANNER — placement "category" bound to this category in /admin/cms/banners/ #}
  {% set _catban = category_banners.get(active_category) if active_category else none %}
  {% if _catban %}
  <a href="{{ _catban.cta_url or '' }}" class="group relative mt-6 mb-10 block aspect-[4/1] overflow-hidden bg-ink {{ 'pointer-events-none' if not _catban.cta_url }}">
    <picture>
      {% if _catban.mobile_image %}<source media="(max-width: 640px)" srcset="{{ _catban.mobile_image.url }}">{% endif %}
      <img src="{{ _catban.image | media_src(1600, 400, 'Category banner') }}" alt="{{ '' if _catban.text_hidden else _catban.heading }}" loading="lazy" decoding="async"
           class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105">
    </picture>
    {% if not _catban.hide_overlay %}<div class="absolute inset-0 bg-gradient-to-t from-ink/75 to-transparent"></div>{% endif %}
    {% if not _catban.text_hidden and (_catban.heading or _catban.subheading) %}
    <div class="absolute inset-0 flex flex-col justify-end gap-1 p-6">
      {% if _catban.heading %}<h2 class="font-display text-2xl text-paper">{{ _catban.heading }}</h2>{% endif %}
      {% if _catban.subheading %}<p class="text-sm text-paper/80">{{ _catban.subheading }}</p>{% endif %}
    </div>
    {% endif %}
  </a>
  {% endif %}

  <div id="grid" class="mt-6">
    {% include "shopfront/partials/_grid.jinja" %}
  </div>
</div>
{% endblock %}
