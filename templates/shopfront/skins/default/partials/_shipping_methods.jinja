{% if shipping_methods %}
{% for method, quote in shipping_methods %}
<label class="flex items-center justify-between border border-line px-4 py-3 text-sm has-[:checked]:border-accent">
  <span class="flex items-center gap-3">
    <input type="radio" name="shipping_method" value="{{ method.pk }}" {{ 'checked' if loop.first }}>
    <span>
      <span class="font-medium">{{ method.name }}</span>
      <span class="block text-xs text-mute">{{ method.estimate_label() }}{% if method.carrier %} · {{ method.carrier }}{% endif %}</span>
    </span>
  </span>
  <span class="font-medium">{{ 'Free' if quote == 0 else (quote | money) }}</span>
</label>
{% endfor %}
{% else %}
<p class="text-sm text-mute">No shipping options for that address yet.</p>
{% endif %}
