{% set items = cart.items.all() | list %}
{% if items %}
<div class="grid gap-12 lg:grid-cols-3">
  <div class="lg:col-span-2">
    <div class="divide-y divide-line border-y border-line">
      {% for i in items %}
      <div class="flex gap-5 py-6">
        {% set img = (i.product.images.all() | first) %}
        <a href="{{ url('shopfront:product', kwargs={'slug': i.product.slug}) }}" class="h-28 w-24 flex-shrink-0 overflow-hidden bg-line/40">
          {% if img %}<img src="{{ img.renditions.get('512') or img.image.url }}" alt="" loading="lazy" decoding="async" class="h-full w-full object-cover">{% endif %}
        </a>
        <div class="flex flex-1 flex-col">
          <a href="{{ url('shopfront:product', kwargs={'slug': i.product.slug}) }}" class="font-display text-lg hover:text-accent">{{ i.product.title }}</a>
          {% if i.variant %}<p class="text-xs text-mute">{{ i.variant.name or i.variant.sku }}</p>{% endif %}
          <p class="mt-1 text-sm text-mute">{{ i.unit_price | money }} each</p>

          <div class="mt-auto flex items-center gap-4 pt-3">
            <form hx-post="{{ url('shopfront:cart_update') }}" hx-target="#cart-page" hx-swap="innerHTML"
                  class="flex items-center border border-line">
              <input type="hidden" name="item" value="{{ i.pk }}">
              <button name="quantity" value="{{ i.quantity - 1 }}" class="px-3 py-1.5 text-mute hover:text-ink">−</button>
              <span class="w-8 border-x border-line py-1.5 text-center text-sm">{{ i.quantity }}</span>
              <button name="quantity" value="{{ i.quantity + 1 }}" class="px-3 py-1.5 text-mute hover:text-ink">+</button>
            </form>
            <form hx-post="{{ url('shopfront:cart_remove') }}" hx-target="#cart-page" hx-swap="innerHTML">
              <input type="hidden" name="item" value="{{ i.pk }}">
              <button class="text-[11px] uppercase tracking-luxe text-mute underline underline-offset-2 hover:text-rose-600">Remove</button>
            </form>
          </div>
        </div>
        <p class="font-display text-lg">{{ i.line_total | money }}</p>
      </div>
      {% endfor %}
    </div>
    <a href="{{ url('shopfront:shop') }}" class="mt-6 inline-block text-[12px] font-semibold uppercase tracking-luxe text-accent">← Continue shopping</a>
  </div>

  <aside class="h-fit border border-line bg-panel p-7">
    <p class="font-display text-xl">Summary</p>
    <div class="mt-5 space-y-2 text-sm">
      <div class="flex justify-between"><span class="text-mute">Subtotal</span><span>{{ cart.subtotal | money }}</span></div>
      <div class="flex justify-between"><span class="text-mute">Shipping</span><span class="text-mute">At checkout</span></div>
    </div>
    <div class="mt-4 flex justify-between border-t border-line pt-4 font-display text-lg">
      <span>Total</span><span>{{ cart.subtotal | money }}</span>
    </div>
    <a href="{{ url('shopfront:checkout') }}" class="mt-6 block bg-ink py-3.5 text-center text-[11px] font-semibold uppercase tracking-luxe text-paper hover:bg-accent">Proceed to checkout</a>
  </aside>
</div>
{% else %}
<div class="border-y border-line py-24 text-center">
  <p class="font-display text-2xl">Your bag is empty</p>
  <a href="{{ url('shopfront:shop') }}" class="mt-4 inline-block bg-ink px-8 py-3.5 text-[11px] font-semibold uppercase tracking-luxe text-paper hover:bg-accent">Shop the collection</a>
</div>
{% endif %}
