{% set rlist = reviews.all() | list if reviews else [] %}
<div class="grid gap-12 lg:grid-cols-3">
  <div>
    <h2 class="font-display text-2xl">Reviews</h2>
    {% if product.rating_count %}
    <div class="mt-3 flex items-end gap-3">
      <p class="font-display text-5xl leading-none">{{ product.rating_avg }}</p>
      <div>
        <p class="text-sm text-accent">{{ '★' * (product.rating_avg | round | int) }}<span class="text-line">{{ '★' * (5 - (product.rating_avg | round | int)) }}</span></p>
        <p class="text-xs text-mute">{{ product.rating_count }} review{{ 's' if product.rating_count != 1 }}</p>
      </div>
    </div>
    {% if rating_breakdown %}
    <div class="mt-4 space-y-1.5">
      {% for row in rating_breakdown %}
      <div class="flex items-center gap-2 text-xs text-mute">
        <span class="w-3">{{ row.stars }}</span>
        <span class="text-accent">★</span>
        <span class="h-1.5 flex-1 bg-line"><span class="block h-1.5 bg-accent" style="width: {{ row.pct }}%"></span></span>
        <span class="w-6 text-right">{{ row.count }}</span>
      </div>
      {% endfor %}
    </div>
    {% endif %}
    {% else %}
    <p class="mt-2 text-sm text-mute">No reviews yet. Be the first.</p>
    {% endif %}

    <form hx-post="{{ url('shopfront:review', kwargs={'slug': product.slug}) }}" hx-target="#reviews" hx-swap="outerHTML"
          class="mt-8 space-y-3 border-t border-line pt-6">
      <p class="text-[11px] font-semibold uppercase tracking-luxe text-mute">Write a review</p>
      <div class="flex flex-col gap-2 sm:flex-row">
        <input name="author_name" required placeholder="Name" class="w-full border border-line bg-transparent px-3 py-2 text-sm outline-none focus:border-accent">
        <input name="author_email" type="email" required placeholder="Email" class="w-full border border-line bg-transparent px-3 py-2 text-sm outline-none focus:border-accent">
      </div>
      <div x-data="{ r: 5, hover: 0 }" class="flex items-center gap-1">
        <input type="hidden" name="rating" :value="r">
        <template x-for="n in 5">
          <button type="button" @click="r = n" @mouseenter="hover = n" @mouseleave="hover = 0"
                  class="text-2xl leading-none transition-colors"
                  :class="(hover || r) >= n ? 'text-accent' : 'text-line'">★</button>
        </template>
      </div>
      <input name="title" placeholder="Headline" class="w-full border border-line bg-transparent px-3 py-2 text-sm outline-none focus:border-accent">
      <textarea name="body" rows="3" placeholder="Your thoughts…" class="w-full border border-line bg-transparent px-3 py-2 text-sm outline-none focus:border-accent"></textarea>
      <button class="bg-ink px-5 py-2.5 text-[11px] font-semibold uppercase tracking-luxe text-paper hover:bg-accent">Submit</button>
      {% if review_msg %}
      <p class="text-xs {{ 'text-emerald-700' if review_ok else 'text-rose-600' }}">{{ review_msg }}</p>
      {% endif %}
    </form>
  </div>

  <div class="space-y-6 lg:col-span-2">
    {% for r in rlist %}
    <div class="border-b border-line pb-6">
      <div class="flex items-center justify-between">
        <p class="text-sm text-accent">{{ '★' * r.rating }}<span class="text-line">{{ '★' * (5 - r.rating) }}</span></p>
        <span class="text-xs text-mute">{{ r.created_at.strftime('%b %Y') }}</span>
      </div>
      {% if r.title %}<p class="mt-2 break-words font-medium">{{ r.title }}</p>{% endif %}
      {% if r.body %}<p class="mt-1 break-words text-sm leading-relaxed text-ink/80">{{ r.body }}</p>{% endif %}
      <p class="mt-2 break-words text-xs text-mute">{{ r.author_name }}{% if r.is_verified_purchase %} · <span class="text-emerald-700">Verified purchase</span>{% endif %}</p>
      {% if r.admin_reply %}<p class="mt-2 break-words rounded bg-accent-soft px-3 py-2 text-xs text-ink/70">{{ store.name }}: {{ r.admin_reply }}</p>{% endif %}
    </div>
    {% else %}
    <p class="text-sm text-mute">No approved reviews to show.</p>
    {% endfor %}
  </div>
</div>
