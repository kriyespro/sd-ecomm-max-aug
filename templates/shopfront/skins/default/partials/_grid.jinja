<span id="result-count" hx-swap-oob="true">{{ result_count }} piece{{ 's' if result_count != 1 }}</span>

{% if products %}
<div class="grid grid-cols-2 gap-x-6 gap-y-12 md:grid-cols-3 lg:grid-cols-4">
  {% for p in products %}{% include "shopfront/partials/_card.jinja" %}{% endfor %}
</div>

{% if page_obj.has_other_pages() %}
<div class="mt-14 flex items-center justify-center gap-6 text-sm">
  {% if page_obj.has_previous() %}
  <a href="?{{ 'page=' ~ page_obj.previous_page_number() }}&category={{ active_category }}&q={{ query }}&sort={{ sort }}&min={{ price_min }}&max={{ price_max }}"
     hx-get="{{ url('shopfront:shop') }}?page={{ page_obj.previous_page_number() }}&category={{ active_category }}&q={{ query }}&sort={{ sort }}&min={{ price_min }}&max={{ price_max }}"
     hx-target="#grid" hx-push-url="true" class="text-[12px] font-semibold uppercase tracking-luxe text-accent">← Prev</a>
  {% endif %}
  <span class="text-mute">Page {{ page_obj.number }} of {{ page_obj.paginator.num_pages }}</span>
  {% if page_obj.has_next() %}
  <a href="?{{ 'page=' ~ page_obj.next_page_number() }}&category={{ active_category }}&q={{ query }}&sort={{ sort }}&min={{ price_min }}&max={{ price_max }}"
     hx-get="{{ url('shopfront:shop') }}?page={{ page_obj.next_page_number() }}&category={{ active_category }}&q={{ query }}&sort={{ sort }}&min={{ price_min }}&max={{ price_max }}"
     hx-target="#grid" hx-push-url="true" class="text-[12px] font-semibold uppercase tracking-luxe text-accent">Next →</a>
  {% endif %}
</div>
{% endif %}

{% else %}
<div class="py-24 text-center">
  <p class="font-display text-2xl">Nothing matches those filters</p>
  <a href="{{ url('shopfront:shop') }}" class="mt-3 inline-block text-[12px] font-semibold uppercase tracking-luxe text-accent">Clear all</a>
</div>
{% endif %}
