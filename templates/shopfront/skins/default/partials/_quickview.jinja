{% set imgs = product.images.all() | list %}
<button @click="quickOpen=false" class="absolute right-4 top-4 z-10 text-mute hover:text-ink">✕</button>
<div class="grid sm:grid-cols-2">
  <div class="aspect-square bg-line/40 sm:aspect-auto">
    {% if imgs %}<img src="{{ imgs[0].image.url }}" alt="{{ product.title }}" class="h-full w-full object-cover">{% endif %}
  </div>
  <div class="p-8">
    {% if product.brand %}<p class="text-[11px] font-semibold uppercase tracking-luxe text-mute">{{ product.brand.name }}</p>{% endif %}
    <h2 class="mt-1 font-display text-3xl leading-tight">{{ product.title }}</h2>
    <p class="mt-3 text-lg">
      {% if product.on_sale %}
      <span class="text-mute line-through">{{ product.price | money }}</span>
      <span class="ml-1 font-medium text-accent">{{ product.current_price | money }}</span>
      {% else %}<span class="font-medium">{{ product.price | money }}</span>{% endif %}
    </p>
    {% if product.rating_count %}<p class="mt-1 text-sm text-accent">{{ '★' * (product.rating_avg | round | int) }}<span class="text-mute"> ({{ product.rating_count }})</span></p>{% endif %}
    {% if available is not none and available <= 5 and available > 0 %}
    <p class="mt-2 text-xs font-medium text-rose-600">Only {{ available }} left</p>
    {% endif %}

    {% if product.short_description %}<p class="mt-4 text-sm leading-relaxed text-ink/75">{{ product.short_description }}</p>{% endif %}

    <form hx-post="{{ url('shopfront:cart_add') }}" hx-swap="none" class="mt-6 space-y-3">
      <input type="hidden" name="product" value="{{ product.slug }}">
      {% if variants %}
      <select name="variant" class="w-full border border-line bg-transparent px-3 py-2.5 text-sm outline-none focus:border-accent">
        {% for v in variants %}<option value="{{ v.pk }}">{{ v.name or v.sku }} — {{ v.effective_price | money }}</option>{% endfor %}
      </select>
      {% endif %}
      <button class="w-full bg-ink py-3.5 text-[11px] font-semibold uppercase tracking-luxe text-paper hover:bg-accent">Add to bag</button>
    </form>
    <a href="{{ url('shopfront:product', kwargs={'slug': product.slug}) }}" class="mt-3 block text-center text-[11px] font-semibold uppercase tracking-luxe text-accent hover:underline">Full details →</a>
  </div>
</div>
