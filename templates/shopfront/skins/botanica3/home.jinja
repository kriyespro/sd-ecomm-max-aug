{% extends "shopfront/base.jinja" %}
{% block title %}{{ store.name }} — Rooted in nature, made for you{% endblock %}

{% block content %}
{#
  ══════════════════════════════════════════════════════════════════════
  EDIT HOMEPAGE COPY HERE
  ══════════════════════════════════════════════════════════════════════
  trust_strip — the 4 badges just under the hero. Each row is
  ('Headline', 'sub-line').
#}
{% set trust_strip = [
  ('Free shipping',    'Orders over ₹999'),
  ('Cash on delivery', 'Across India'),
  ('7-day returns',    'No questions asked'),
  ('Clean formulas',   'No nasties, ever'),
] %}

{% macro category_row(heading='Shop by category', tiles=none, pad='py-6') %}
{% set rows = tiles if tiles is not none else cat_tiles %}
{% if rows %}
<section class="mx-auto max-w-7xl px-5 {{ pad }} lg:px-8">
  {% if show_category_headings %}
  <div class="mb-5 flex flex-wrap items-end justify-between gap-x-4 gap-y-1">
    <h2 class="font-display text-2xl sm:text-3xl">{{ heading }}</h2>
    <a href="{{ url('shopfront:shop') }}" class="text-[11px] font-semibold uppercase tracking-luxe text-accent hover:underline">All products</a>
  </div>
  {% endif %}
  <div class="grid grid-cols-3 gap-3 sm:grid-cols-4 sm:gap-4 lg:grid-cols-8">
    {% for t in rows[:8] %}
    <a href="{{ url('shopfront:shop') }}?category={{ t.category.slug }}" class="group text-center">
      <div class="mx-auto aspect-square w-full max-w-[300px] overflow-hidden rounded-xl border border-line bg-line/40 b2-card">
        <img src="{{ t.image | media_src(300, 300, 'Category') }}" alt="{{ t.category.name }}" width="300" height="300" loading="lazy" decoding="async" class="b2-img h-full w-full object-cover">
      </div>
      <p class="mt-2.5 text-[12px] font-medium leading-tight text-ink group-hover:text-accent">{{ t.category.name }}</p>
    </a>
    {% endfor %}
  </div>
</section>
{% endif %}
{% endmacro %}

{% macro promo_card(b) %}
<section class="cv-auto mx-auto max-w-7xl px-5 pt-4 lg:px-8">
  <a href="{{ b.cta_url or url('shopfront:shop') }}" class="group relative block overflow-hidden rounded-3xl bg-ink">
    <picture>
      {% if b.mobile_image %}<source media="(max-width: 640px)" srcset="{{ b.mobile_image.url }}">{% endif %}
      <img src="{{ b.image | media_src(1600, 600, 'Promo banner') }}" alt="{{ '' if b.text_hidden else b.heading }}" loading="lazy" decoding="async"
           class="h-[280px] w-full object-cover transition-transform duration-700 group-hover:scale-105 sm:h-[380px]">
    </picture>
    {% if not b.text_hidden and (b.heading or b.subheading or b.cta_label) %}
    <div class="absolute inset-0 flex flex-col items-start justify-center gap-3 bg-ink/30 p-6 sm:p-8 lg:p-14">
      {% if b.subheading %}<p class="text-[11px] font-semibold uppercase tracking-luxe text-paper/80">{{ b.subheading }}</p>{% endif %}
      {% if b.heading %}<h2 class="max-w-xl font-display text-2xl text-paper sm:text-3xl lg:text-4xl">{{ b.heading }}</h2>{% endif %}
      {% if b.cta_label %}<span class="mt-2 bg-paper px-7 py-3 text-[11px] font-semibold uppercase tracking-luxe text-ink transition-colors group-hover:bg-accent group-hover:text-paper">{{ b.cta_label }}</span>{% endif %}
    </div>
    {% endif %}
  </a>
</section>
{% endmacro %}

{# ============ CATEGORY — row ABOVE the hero ============ #}
{# Shows when the Theme toggle is on, or whenever a category is set to the
   top row. Uses the top-row categories if any, else all of them. #}
{% if category_above_hero or cat_tiles_top %}
{{ category_row('Browse the shop', cat_tiles_top or cat_tiles, pad='pt-2 pb-4') }}
{% endif %}

{# ============ HERO — slider (all live hero banners); height cut ~30% ============ #}
{% set slides = hero_slides %}
{% if slides %}
<section
  x-data="{ i: 0, n: {{ slides | length }}, timer: null, tx: 0,
            go(k){ this.i = (k + this.n) % this.n },
            play(){ if (this.n > 1) this.timer = setInterval(() => this.go(this.i + 1), 6500) },
            stop(){ clearInterval(this.timer) },
            swipe(dx){ if (Math.abs(dx) > 40) this.go(this.i + (dx < 0 ? 1 : -1)) } }"
  x-init="play()" @mouseenter="stop()" @mouseleave="play()"
  @touchstart.passive="stop(); tx = $event.touches[0].clientX"
  @touchend.passive="swipe($event.changedTouches[0].clientX - tx); play()"
  class="relative isolate overflow-hidden bg-ink">
  {% for b in slides %}
  <div x-show="i === {{ loop.index0 }}" x-transition:enter="transition-opacity duration-700" x-transition:enter-start="opacity-0"
       {% if not loop.first %}style="display:none"{% endif %}
       class="relative flex min-h-[50vh] items-end sm:min-h-[56vh] lg:min-h-[62vh]">
    <picture>
      {% if b.mobile_image %}<source media="(max-width: 640px)" srcset="{{ b.mobile_image.url }}">{% endif %}
      <img src="{{ b.image | media_src(1600, 760, 'Hero banner') }}" alt="{{ '' if b.text_hidden else b.heading }}"
           {{ 'fetchpriority=high' if loop.first else 'loading=lazy' }} width="1600" height="760" decoding="async"
           class="absolute inset-0 -z-10 h-full w-full object-cover">
    </picture>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/85 via-ink/40 to-ink/10"></div>

    {% if not b.text_hidden %}
    <div class="mx-auto w-full max-w-7xl px-5 pb-9 pt-16 sm:pb-12 sm:pt-32 lg:px-8 lg:pb-16">
      {% if b.subheading %}
      <p class="flex items-center gap-2.5 text-[10px] font-semibold uppercase tracking-luxe text-gold sm:gap-3 sm:text-[11px]">
        <span class="h-px w-6 shrink-0 bg-gold sm:w-8"></span><span class="min-w-0">{{ b.subheading }}</span>
      </p>
      {% endif %}
      {% if b.heading %}
      <h1 class="mt-3 max-w-3xl font-display text-[1.75rem] leading-[1.1] text-paper sm:mt-4 sm:text-5xl sm:leading-[1.05] lg:text-6xl">{{ b.heading }}</h1>
      {% endif %}
      {% if b.cta_label %}
      <div class="mt-6 sm:mt-8">
        <a href="{{ b.cta_url or url('shopfront:shop') }}"
           class="inline-block bg-paper px-6 py-3 text-[11px] font-semibold uppercase tracking-luxe text-ink transition-colors hover:bg-accent hover:text-paper sm:px-8 sm:py-3.5">
          {{ b.cta_label }}
        </a>
      </div>
      {% endif %}
    </div>
    {% endif %}
  </div>
  {% endfor %}

  {% if slides | length > 1 %}
  {# arrows: desktop only — mobile swipes and taps the dots #}
  <button type="button" @click="go(i - 1)" aria-label="Previous"
          class="absolute left-3 top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 place-items-center rounded-full bg-paper/80 text-ink hover:bg-paper sm:grid">‹</button>
  <button type="button" @click="go(i + 1)" aria-label="Next"
          class="absolute right-3 top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 place-items-center rounded-full bg-paper/80 text-ink hover:bg-paper sm:grid">›</button>
  <div class="absolute inset-x-0 bottom-3.5 z-10 flex justify-center gap-2 sm:bottom-4">
    {% for b in slides %}
    <button type="button" @click="go({{ loop.index0 }})" aria-label="Slide {{ loop.index }}"
            class="h-2 rounded-full bg-paper transition-all sm:h-1.5" :class="i === {{ loop.index0 }} ? 'w-7 opacity-100 sm:w-6' : 'w-2 opacity-50 sm:w-1.5'"></button>
    {% endfor %}
  </div>
  {% endif %}
</section>

{% else %}
{# no hero banner uploaded — default panel #}
<section class="relative isolate flex min-h-[50vh] items-end overflow-hidden bg-ink sm:min-h-[56vh] lg:min-h-[62vh]">
  <div class="absolute inset-0 -z-10 bg-gradient-to-br from-accent/40 to-ink"></div>
  <div class="mx-auto w-full max-w-7xl px-5 pb-9 pt-16 sm:pb-12 sm:pt-32 lg:px-8 lg:pb-16">
    <p class="flex items-center gap-2.5 text-[10px] font-semibold uppercase tracking-luxe text-gold sm:gap-3 sm:text-[11px]">
      <span class="h-px w-6 shrink-0 bg-gold sm:w-8"></span>Clean, plant-powered wellness
    </p>
    <h1 class="mt-3 max-w-3xl font-display text-[1.75rem] leading-[1.1] text-paper sm:mt-4 sm:text-5xl lg:text-6xl">Rooted in nature,<br>made for the everyday.</h1>
    <div class="mt-6 sm:mt-8">
      <a href="{{ url('shopfront:shop') }}" class="inline-block bg-paper px-8 py-3.5 text-[11px] font-semibold uppercase tracking-luxe text-ink transition-colors hover:bg-accent hover:text-paper">Shop the collection</a>
    </div>
  </div>
</section>
{% endif %}

{# ============ TRUST STRIP ============ #}
<div class="border-y border-line bg-panel">
  <div class="mx-auto grid max-w-7xl grid-cols-2 divide-line sm:grid-cols-4 sm:divide-x">
    {% for t, s in trust_strip %}
    <div class="flex items-center gap-3 border-t border-line px-5 py-5 sm:border-t-0">
      <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-gold/40 bg-gold/10 text-gold">&#10022;</span>
      <div>
        <p class="text-[12px] font-semibold leading-tight text-ink">{{ t }}</p>
        <p class="mt-0.5 text-[10px] uppercase tracking-luxe text-mute">{{ s }}</p>
      </div>
    </div>
    {% endfor %}
  </div>
</div>

{# ============ SHOP BY CATEGORY — below the hero (always) ============ #}
{{ category_row() }}

{# ============ SHOP BY BUDGET — up to 5 price-band tiles ============ #}
{% if budget_bands %}
<section class="cv-auto mx-auto max-w-7xl px-5 pb-4 lg:px-8">
  <div class="mb-9 flex flex-wrap items-end justify-between gap-x-4 gap-y-1">
    <h2 class="font-display text-2xl sm:text-3xl">Shop by budget</h2>
  </div>
  <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-5">
    {% for b in budget_bands[:5] %}
    <a href="{{ url('shopfront:shop') }}{{ ('?' ~ b.query) if b.query }}" class="group text-center">
      <div class="mx-auto aspect-square w-full max-w-[300px] overflow-hidden rounded-xl border border-line bg-line/40 b2-card">
        <img src="{{ (b.image.url if b.image else '') | media_src(300, 300, b.label) }}" alt="{{ b.label }}" width="300" height="300" loading="lazy" decoding="async" class="b2-img h-full w-full object-cover">
      </div>
      <p class="mt-2.5 text-[12px] font-medium leading-tight text-ink group-hover:text-accent">{{ b.label }}</p>
    </a>
    {% endfor %}
  </div>
</section>
{% endif %}

{# ============ PROMO BANNER — first one here ============ #}
{% for b in promo_banners[:1] %}{{ promo_card(b) }}{% endfor %}

{# ============ FEATURED ============ #}
<section class="cv-auto mx-auto max-w-7xl px-5 py-16 lg:px-8">
  <div class="mb-9 flex flex-wrap items-end justify-between gap-x-4 gap-y-1">
    <div>
      <p class="text-[11px] font-semibold uppercase tracking-luxe text-gold">Best sellers</p>
      <h2 class="mt-1 font-display text-2xl sm:text-3xl">Loved by the community</h2>
    </div>
    <a href="{{ url('shopfront:shop') }}" class="text-[11px] font-semibold uppercase tracking-luxe text-accent hover:underline">View all</a>
  </div>
  <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:gap-x-5 sm:gap-y-9 md:grid-cols-3 lg:grid-cols-4">
    {% for p in featured %}{% include "shopfront/partials/_card.jinja" %}{% endfor %}
  </div>
</section>

{# ============ BENEFIT BAND ============ #}
<section class="cv-auto bg-accent text-paper">
  <div class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
    <h2 class="text-center font-display text-2xl sm:text-3xl">Why it works</h2>
    <div class="mx-auto mt-3 h-px w-16 bg-paper/40"></div>
    <div class="mt-12 grid gap-10 sm:grid-cols-3">
      {% for t, d in [
        ('Whole-plant actives', 'Extracts kept close to their natural form so nothing useful is lost.'),
        ('Clinically guided', 'Doses that reflect the research — not what fits the label.'),
        ('Made to be used', 'Textures and rituals you will actually reach for every day.')] %}
      <div class="text-center">
        <span class="mx-auto grid h-11 w-11 place-items-center rounded-full border border-paper/40 text-lg">&#10022;</span>
        <p class="mt-4 font-display text-lg">{{ t }}</p>
        <p class="mt-2 text-sm leading-relaxed text-paper/75">{{ d }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{# ============ NEW ARRIVALS ============ #}
{% if new_arrivals %}
<section class="cv-auto mx-auto max-w-7xl px-5 py-16 lg:px-8">
  <div class="mb-9 flex flex-wrap items-end justify-between gap-x-4 gap-y-1">
    <h2 class="font-display text-2xl sm:text-3xl">New arrivals</h2>
    <a href="{{ url('shopfront:shop') }}?sort=new" class="text-[11px] font-semibold uppercase tracking-luxe text-accent hover:underline">View all</a>
  </div>
  <div class="grid grid-cols-2 gap-x-4 gap-y-8 sm:gap-x-5 sm:gap-y-9 md:grid-cols-3 lg:grid-cols-4">
    {% for p in new_arrivals %}{% include "shopfront/partials/_card.jinja" %}{% endfor %}
  </div>
</section>
{% endif %}

{# ============ TESTIMONIALS ============ #}
{% if testimonials %}
<section class="cv-auto border-y border-line bg-panel">
  <div class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
    <h2 class="mb-10 text-center font-display text-2xl sm:text-3xl">What people say</h2>
    <div class="grid gap-6 md:grid-cols-3">
      {% for r in testimonials %}
      <figure class="rounded-2xl border border-line bg-paper p-8 text-center b2-soft">
        <p class="text-gold">{{ '★' * r.rating }}</p>
        <blockquote class="mt-3 font-display text-lg leading-snug text-ink/85">“{{ r.body | truncate(140) }}”</blockquote>
        <figcaption class="mt-4 text-[11px] uppercase tracking-luxe text-mute">{{ r.author_name }} · {{ r.product.title }}</figcaption>
      </figure>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# ============ NEWSLETTER CTA ============ #}
<section class="cv-auto mx-auto max-w-3xl px-5 py-20 text-center lg:px-8">
  <p class="text-[11px] font-semibold uppercase tracking-luxe text-gold">Join the ritual</p>
  <h2 class="mt-3 font-display text-3xl text-ink sm:text-4xl">Get 10% off your first order</h2>
  <p class="mt-3 text-sm text-mute">Slow beauty notes, restocks and members-only drops. No spam.</p>
  <form class="mx-auto mt-8 flex max-w-md items-center gap-2 border-b border-ink/25 pb-1"
        @submit.prevent="pushToast({msg:'Thanks — check your inbox', kind:'success'})">
    <input required type="email" placeholder="Email address" class="w-full bg-transparent py-2 text-sm outline-none placeholder:text-mute">
    <button class="shrink-0 bg-accent px-6 py-2.5 text-[11px] font-semibold uppercase tracking-luxe text-paper hover:bg-ink">Join</button>
  </form>
</section>

{# ============ INSTAGRAM FEED ============ #}
{% if instagram_items %}
<section class="cv-auto mx-auto max-w-7xl px-5 py-16 lg:px-8">
  <div class="mb-9 text-center">
    <h2 class="font-display text-2xl sm:text-3xl">From our Instagram</h2>
    {% if store_profile and store_profile.instagram_url %}
    <a href="{{ store_profile.instagram_url }}" target="_blank" rel="noopener" class="mt-1 inline-block text-[11px] font-semibold uppercase tracking-luxe text-accent hover:underline">Follow us</a>
    {% endif %}
  </div>
  <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 sm:gap-3 lg:grid-cols-6">
    {% for it in instagram_items[:6] %}
    <a href="{{ it.href or '#' }}" {{ 'target=_blank rel=noopener' if it.href }} class="group relative block aspect-square overflow-hidden rounded-lg bg-line/40">
      <img src="{{ (it.image.url if it.image else '') | media_src(600, 600, 'Instagram') }}" alt="{{ it.caption }}" width="600" height="600" loading="lazy" decoding="async" class="b2-img h-full w-full object-cover">
      <span class="absolute inset-0 grid place-items-center bg-ink/0 text-paper opacity-0 transition group-hover:bg-ink/25 group-hover:opacity-100">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
      </span>
    </a>
    {% endfor %}
  </div>
</section>
{% endif %}

{# ============ PROMO BANNER — 2nd and later, just above the footer ============ #}
{% for b in promo_banners[1:] %}{{ promo_card(b) }}{% endfor %}

{% include "shopfront/partials/_ugc_shorts.jinja" %}

{# ============ POPUP BANNER — placement "popup"; once per visitor ============ #}
{% if popup_banner %}
<div x-data="{ open: false }"
     x-init="setTimeout(() => { try { if (!localStorage.getItem('sd_popup_{{ popup_banner.id }}')) open = true } catch (e) { open = true } }, 1200)"
     x-show="open" x-cloak
     class="fixed inset-0 z-[60] flex items-center justify-center bg-ink/60 p-4"
     @keydown.escape.window="open = false">
  <div class="relative w-full max-w-md overflow-hidden rounded-2xl bg-paper" @click.outside="open = false">
    <button type="button" aria-label="Close"
            @click="open = false; try { localStorage.setItem('sd_popup_{{ popup_banner.id }}', '1') } catch (e) {}"
            class="absolute right-3 top-3 z-10 grid h-8 w-8 place-items-center rounded-full bg-paper/80 text-lg text-ink hover:bg-paper">&times;</button>
    <a href="{{ popup_banner.cta_url or url('shopfront:shop') }}">
      {% if popup_banner.image %}<img src="{{ popup_banner.image.url }}" alt="{{ popup_banner.heading }}" class="w-full object-cover">{% endif %}
      {% if popup_banner.heading or popup_banner.subheading or popup_banner.cta_label %}
      <div class="p-6 text-center">
        {% if popup_banner.heading %}<h3 class="font-display text-2xl text-ink">{{ popup_banner.heading }}</h3>{% endif %}
        {% if popup_banner.subheading %}<p class="mt-2 text-sm text-mute">{{ popup_banner.subheading }}</p>{% endif %}
        {% if popup_banner.cta_label %}<span class="mt-4 inline-block bg-accent px-6 py-2.5 text-[11px] font-semibold uppercase tracking-luxe text-paper">{{ popup_banner.cta_label }}</span>{% endif %}
      </div>
      {% endif %}
    </a>
  </div>
</div>
{% endif %}
{% endblock %}
