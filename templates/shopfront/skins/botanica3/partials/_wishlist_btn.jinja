{# Botanica 3.0 wishlist toggle — compact icon (used on the product card and
   swapped in place by shopfront:wishlist_toggle). Expects `wl_slug` (or
   `product`), optional `wl_active` / `wl_need_login`. #}
{% set slug = wl_slug or (product.slug if product else '') %}
<form hx-post="{{ url('shopfront:wishlist_toggle') }}" hx-swap="outerHTML" class="inline-block">
  <input type="hidden" name="product" value="{{ slug }}">
  <button title="{% if wl_need_login %}Sign in to save{% elif wl_active %}Saved{% else %}Save to wishlist{% endif %}"
          aria-label="Save to wishlist"
          class="grid h-9 w-9 place-items-center rounded-full bg-paper/90 backdrop-blur transition-colors hover:bg-accent hover:text-paper
                 {{ 'text-accent' if wl_active else 'text-ink' }}
                 {# visible on touch; hover-reveal on desktop unless already saved #}
                 {{ '' if wl_active else 'lg:opacity-0 lg:group-hover:opacity-100' }}">
    <svg class="h-4 w-4" fill="{{ 'currentColor' if wl_active else 'none' }}" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
      <path d="M12 21s-7-4.5-9.5-9C1 8.5 3 5 6.5 5 9 5 12 7.5 12 7.5S15 5 17.5 5C21 5 23 8.5 21.5 12 19 16.5 12 21 12 21Z"/>
    </svg>
  </button>
</form>
