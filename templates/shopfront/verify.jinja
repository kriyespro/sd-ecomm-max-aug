{% extends "shopfront/base.jinja" %}
{% block title %}{{ page_title }} · {{ store.name }}{% endblock %}

{% block content %}
<section class="mx-auto max-w-3xl px-5 py-16 lg:px-8">
  <h1 class="font-display text-3xl sm:text-4xl">{{ page_title }}</h1>
  <p class="mt-3 text-mute">
    Enter the verification code from your certificate (or the lab certificate
    number) to confirm it was issued by {{ store.name }}.
  </p>

  <form method="get" action="{{ url('shopfront:verify') }}" class="mt-6 flex flex-wrap gap-3">
    <input name="code" value="{{ query }}" placeholder="e.g. K7M9QX2P" required
           class="flex-1 min-w-[14rem] rounded-lg border border-line bg-panel px-4 py-3 text-sm tracking-wider uppercase focus:border-accent focus:outline-none">
    <button class="rounded-lg bg-accent px-6 py-3 text-sm font-medium text-white">Verify</button>
  </form>

  {% if searched and not certificate %}
  <div class="mt-8 rounded-xl border border-line bg-panel p-6 text-center">
    <p class="text-lg">No certificate matches <span class="font-mono">{{ query }}</span>.</p>
    <p class="mt-1 text-sm text-mute">Check the code and try again.</p>
  </div>
  {% elif certificate %}
  <div class="mt-8 overflow-hidden rounded-xl border border-line bg-panel">
    <div class="flex items-center gap-2 border-b border-line bg-accent/5 px-6 py-4">
      <span class="text-accent">&#10003;</span>
      <p class="text-sm font-medium">Genuine — issued by {{ store.name }}</p>
    </div>
    <div class="p-6">
      <h2 class="font-display text-2xl">{{ certificate.title }}</h2>
      <p class="mt-1 text-sm text-mute">Verification code
        <span class="font-mono tracking-wider">{{ certificate.code }}</span></p>

      {% if certificate.spec_rows %}
      <dl class="mt-5 grid grid-cols-1 gap-x-8 gap-y-2 sm:grid-cols-2">
        {% for label, value in certificate.spec_rows %}
        <div class="flex justify-between border-b border-line/60 py-1.5 text-sm">
          <dt class="text-mute">{{ label }}</dt><dd class="font-medium">{{ value }}</dd>
        </div>
        {% endfor %}
      </dl>
      {% endif %}

      {% if certificate.notes %}<p class="mt-4 text-sm text-ink/80">{{ certificate.notes }}</p>{% endif %}

      {% if certificate.product and certificate.product.status == "active" %}
      <a href="{{ url('shopfront:product', kwargs={'slug': certificate.product.slug}) }}"
         class="mt-5 inline-block text-sm text-accent hover:underline">View the product &rarr;</a>
      {% endif %}

      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {% if certificate.image_front %}
        <a href="{{ certificate.image_front.url }}" target="_blank" rel="noopener">
          <img src="{{ certificate.image_front.url }}" alt="Certificate for {{ certificate.title }}"
               class="w-full rounded-lg border border-line">
        </a>
        {% endif %}
        {% if certificate.image_back %}
        <a href="{{ certificate.image_back.url }}" target="_blank" rel="noopener">
          <img src="{{ certificate.image_back.url }}" alt="Certificate (reverse)"
               class="w-full rounded-lg border border-line">
        </a>
        {% endif %}
      </div>
    </div>
  </div>
  {% endif %}
</section>
{% endblock %}
