{# Marketing site footer — shared by landing.jinja and pricing.jinja. Needs
   ``brand``, ``plans``, ``now_year`` in context. #}
{% from "marketing/_macros.jinja" import logo with context %}
<footer class="border-t border-slate-200 bg-white">
  <div class="mx-auto grid max-w-6xl gap-8 px-5 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      {{ logo() }}
      <p class="mt-2 text-sm text-slate-500">Hosted commerce for India.</p>
    </div>
    <div>
      <p class="text-xs font-600 uppercase tracking-wide text-slate-400">Product</p>
      <ul class="mt-3 space-y-2 text-sm text-slate-600">
        <li><a href="/#features" class="hover:text-slate-900">Features</a></li>
        <li><a href="/#domains" class="hover:text-slate-900">Custom domains</a></li>
        {% if plans %}<li><a href="{{ url('pricing') }}" class="hover:text-slate-900">Pricing</a></li>{% endif %}
      </ul>
    </div>
    <div>
      <p class="text-xs font-600 uppercase tracking-wide text-slate-400">Company</p>
      <ul class="mt-3 space-y-2 text-sm text-slate-600">
        <li><a href="/#compare" class="hover:text-slate-900">Why {{ brand.name }}</a></li>
        <li><a href="{{ url('partners') }}" class="hover:text-slate-900">Partner programme</a></li>
        <li><a href="{{ url('accounts:affiliate_join') }}" class="hover:text-slate-900">Become an affiliate</a></li>
        <li><a href="/#faq" class="hover:text-slate-900">FAQ</a></li>
      </ul>
    </div>
    <div>
      <p class="text-xs font-600 uppercase tracking-wide text-slate-400">Get started</p>
      <ul class="mt-3 space-y-2 text-sm text-slate-600">
        <li><a href="{{ url('accounts:login') }}" class="hover:text-slate-900">Sign in</a></li>
        <li><a href="{{ url('accounts:signup') }}" class="hover:text-slate-900">Start free trial</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-slate-100 py-6 text-center text-xs text-slate-400">
    &copy; {{ now_year }} {{ brand.name }} ·
    <a href="{{ url('privacy') }}" class="hover:text-slate-600">Privacy</a> ·
    <a href="{{ url('terms') }}" class="hover:text-slate-600">Terms</a>
  </div>
</footer>
