{# Shared marketing macros — logo + icon glyphs. Imported by landing.jinja,
   _nav.jinja, _footer.jinja, _pricing_section.jinja and pricing.jinja so the
   markup lives in exactly one place. #}

{% macro logo(dark=false) %}
{% if brand.logo %}
<span class="inline-flex items-center gap-2">
  <img src="{{ brand.logo }}" alt="{{ brand.name }}" class="h-7 w-auto">
  <span class="font-display text-lg font-700 tracking-tight {{ 'text-white' if dark else 'text-slate-900' }}">{{ brand.name }}</span>
</span>
{% elif brand.is_default and brand.name == 'shopinaday' %}
{# Legacy hand-tuned wordmark for the original platform brand only — any other
   brand.name (including another deployment's own "default" brand) falls
   through to the generic icon + plain name below. #}
<span class="inline-flex items-center gap-2">
  <svg class="h-7 w-7" viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <rect x="1.5" y="1.5" width="29" height="29" rx="9" fill="url(#g-brand)"/>
    <path d="M9 22V11.5L16 17l7-5.5V22" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  <span class="font-display text-lg font-700 tracking-tight {{ 'text-white' if dark else 'text-slate-900' }}">shop<span class="text-brand-{{ '300' if dark else '600' }}">inaday</span></span>
</span>
{% else %}
<span class="inline-flex items-center gap-2">
  <svg class="h-7 w-7" viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <rect x="1.5" y="1.5" width="29" height="29" rx="9" fill="url(#g-brand)"/>
    <path d="M9 22V11.5L16 17l7-5.5V22" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  <span class="font-display text-lg font-700 tracking-tight {{ 'text-white' if dark else 'text-slate-900' }}">{{ brand.name }}</span>
</span>
{% endif %}
{% endmacro %}

{% macro icon(name) %}
{# richer duotone glyphs: a faint currentColor fill + a crisp stroke, so they
   adapt to any text colour they're dropped into #}
<svg class="h-full w-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {% if name == 'bolt' %}
    <path d="M13 2 4 14h6l-1 8 9-12h-6z" fill="currentColor" fill-opacity=".14"/><path d="M13 2 4 14h6l-1 8 9-12h-6z"/>
  {% elif name == 'card' %}
    <rect x="2.5" y="5" width="19" height="14" rx="2.5" fill="currentColor" fill-opacity=".12"/><rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M2.5 9.5h19"/><path d="M6 15h4" stroke-width="2.2"/>
  {% elif name == 'globe' %}
    <circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity=".12"/><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.7 3 2.7 15 0 18M12 3c-2.7 3-2.7 15 0 18"/>
  {% elif name == 'grid' %}
    <rect x="3" y="3" width="7.5" height="7.5" rx="1.8" fill="currentColor" fill-opacity=".16"/><rect x="3" y="3" width="7.5" height="7.5" rx="1.8"/>
    <rect x="13.5" y="3" width="7.5" height="7.5" rx="1.8"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="1.8"/>
    <rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.8" fill="currentColor" fill-opacity=".16"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.8"/>
  {% elif name == 'sparkles' %}
    <path d="M12 3l1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6z" fill="currentColor" fill-opacity=".16"/>
    <path d="M12 3l1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6z"/><path d="M18.5 14.5l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/>
  {% elif name == 'plug' %}
    <path d="M7 9h10v2a5 5 0 0 1-10 0z" fill="currentColor" fill-opacity=".14"/><path d="M9 3v6M15 3v6M7 9h10v2a5 5 0 0 1-10 0zM12 16v5"/>
  {% elif name == 'check' %}
    <circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity=".12"/><path d="m8 12.5 2.5 2.5L16 9"/>
  {% elif name == 'shield' %}
    <path d="M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z" fill="currentColor" fill-opacity=".12"/><path d="M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z"/><path d="m9 12 2 2 4-4"/>
  {% elif name == 'chart' %}
    <path d="M4 4v16h16" /><path d="M8 15l3-4 3 2 4-6" /><circle cx="18" cy="7" r="1.4" fill="currentColor"/>
  {% elif name == 'rocket' %}
    <path d="M12 3c3 1.5 5 4.7 5 9 0 2.2-.7 3.5-1.5 4.5h-7C7.7 15.5 7 14.2 7 12c0-4.3 2-7.5 5-9z" fill="currentColor" fill-opacity=".14"/>
    <path d="M12 3c3 1.5 5 4.7 5 9 0 2.2-.7 3.5-1.5 4.5h-7C7.7 15.5 7 14.2 7 12c0-4.3 2-7.5 5-9z"/><circle cx="12" cy="10" r="1.6"/><path d="M9.5 17c-.8 1.2-1 2.5-1 4 1.3-.3 2.4-.9 3-1.8M14.5 17c.8 1.2 1 2.5 1 4-1.3-.3-2.4-.9-3-1.8"/>
  {% elif name == 'layers' %}
    <path d="M12 3l9 5-9 5-9-5z" fill="currentColor" fill-opacity=".14"/><path d="M12 3l9 5-9 5-9-5z"/><path d="M3 13l9 5 9-5M3 17l9 5 9-5"/>
  {% elif name == 'lock' %}
    <rect x="4.5" y="10" width="15" height="11" rx="2.5" fill="currentColor" fill-opacity=".12"/><rect x="4.5" y="10" width="15" height="11" rx="2.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>
  {% endif %}
</svg>
{% endmacro %}
