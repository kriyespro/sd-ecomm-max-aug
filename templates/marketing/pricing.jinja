{% extends "base.jinja" %}
{# Standalone, indexable pricing page — previously only an in-page #pricing
   anchor on landing.jinja (not independently crawlable/shareable). Reuses the
   same pricing section + nav/footer partials as the homepage. #}

{% block title %}{{ brand.name }} pricing — plans from ₹{{ from_price }}/mo{% if not from_price %}Simple, transparent pricing{% endif %}{% endblock %}
{% block meta_description %}{{ brand.name }} pricing: transparent monthly plans, no setup fee, cancel anytime from the dashboard. Compare features and pick the plan that fits your store.{% endblock %}

{% block head %}
{% if not site_css_href() %}
<script>
  tailwind.config = { theme: { extend: {
    fontFamily: { sans: ['Inter','ui-sans-serif','system-ui','sans-serif'], display: ['"Space Grotesk"','Inter','sans-serif'] },
    colors: { brand: { 50:'#eef2ff',100:'#e0e7ff',200:'#c7d2fe',300:'#a5b4fc',400:'#818cf8',500:'#6366f1',600:'#4f46e5',700:'#4338ca',800:'#3730a3',900:'#312e81' } },
  } } };
</script>
{% endif %}
<script type="application/ld+json">{{ pricing_jsonld|safe }}</script>
{% endblock %}

{% block body %}
<div class="bg-white font-sans text-slate-900">
  {% include "marketing/_nav.jinja" %}

  <section class="mx-auto max-w-4xl px-5 pt-16 text-center">
    <h1 class="font-display text-4xl font-700 tracking-tight sm:text-5xl">Simple, transparent pricing</h1>
    <p class="mx-auto mt-4 max-w-xl text-slate-600">No setup fee, no hidden charges. Switch plans or cancel anytime from the dashboard.</p>
  </section>

  {% include "marketing/_pricing_section.jinja" %}

  <section class="mx-auto max-w-6xl px-5 pb-20">
    <div class="reveal relative overflow-hidden rounded-3xl bg-gradient-to-br from-brand-600 to-violet-700 px-8 py-14 text-center text-white sm:px-16">
      <h2 class="font-display text-3xl font-700 tracking-tight sm:text-4xl">Start your ecommerce store in a day</h2>
      <p class="mx-auto mt-4 max-w-xl text-brand-100">Quick setup, custom domain, Razorpay checkout, full admin dashboard.</p>
      <a href="{{ url('accounts:signup') }}" class="mt-8 inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 font-600 text-brand-700 transition hover:-translate-y-0.5 hover:bg-brand-50">
        Start free trial
      </a>
    </div>
  </section>

  {% include "marketing/_footer.jinja" %}
</div>
{% endblock %}
