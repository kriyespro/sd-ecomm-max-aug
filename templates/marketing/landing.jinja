    </div>
  </section>

  {# ================= SPOTLIGHT: THEMES ================= #}
  <section class="mx-auto max-w-6xl overflow-hidden px-5 py-20">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div class="reveal">
        <p class="text-sm font-600 uppercase tracking-wide text-brand-600">Storefront</p>
        <h2 class="mt-2 font-display text-3xl font-700 tracking-tight sm:text-4xl">A shop your customers trust on sight</h2>
        <p class="mt-4 leading-relaxed text-slate-600">
          Pick from {{ stats.themes if stats and stats.themes else 'a range of' }} built-in themes — each a full storefront with
          product pages, quick view, search, wishlist, cart drawer and a mobile-first checkout. Switch themes anytime;
          your catalogue stays put.
        </p>
        <a href="{{ url('accounts:login') }}" class="mt-6 inline-flex items-center gap-1.5 text-sm font-600 text-brand-600 hover:text-brand-700">
          Browse themes in the dashboard
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
      <div class="reveal">
        <div class="grid grid-cols-3 gap-3">
          {% for s in skins[:9] %}
          <div class="card-sheen rounded-xl border border-slate-200 bg-white p-3 text-center shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
            <div class="mb-2 aspect-[4/3] overflow-hidden rounded-md ring-1 ring-slate-100">{{ wireframe(loop.index0) }}</div>
            <span class="text-xs font-500 text-slate-600">{{ s }}</span>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>

  {# ================= SPOTLIGHT: PAYMENTS ================= #}
  <section class="border-y border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div class="reveal order-2 lg:order-1">
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-lg">
            <div class="flex items-center justify-between border-b border-slate-100 pb-4">
              <span class="font-600 text-slate-800">Checkout</span>
              <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-600 text-emerald-700">
                <span class="h-3 w-3">{{ icon('shield') }}</span> Secure · Razorpay
              </span>
            </div>
            <div class="mt-4 space-y-3">
              <div class="flex justify-between text-sm"><span class="text-slate-500">Subtotal</span><span class="font-500">₹2,300</span></div>
              <div class="flex justify-between text-sm"><span class="text-slate-500">Shipping</span><span class="font-500">₹180</span></div>
              <div class="flex justify-between border-t border-slate-100 pt-3 text-sm font-700"><span>Total</span><span>₹2,480</span></div>
            </div>
            <div class="mt-4 grid grid-cols-4 gap-2">
              {% for m in ['UPI', 'Card', 'Netbank', 'Wallet'] %}
              <span class="flex flex-col items-center gap-1 rounded-lg border border-slate-200 py-2 text-center text-[11px] font-600 text-slate-600">
                <svg class="h-4 w-4 text-brand-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  {% if m == 'UPI' %}<rect x="4" y="4" width="7" height="7" rx="1"/><rect x="13" y="4" width="7" height="7" rx="1"/><rect x="4" y="13" width="7" height="7" rx="1"/><path d="M15 15h4v4"/>
                  {% elif m == 'Card' %}<rect x="2.5" y="6" width="19" height="12" rx="2"/><path d="M2.5 10h19"/>
                  {% elif m == 'Netbank' %}<path d="M4 10h16M6 10v7M10 10v7M14 10v7M18 10v7M3 20h18M12 3 4 8h16z"/>
                  {% else %}<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M16 12h.01M3 10h18"/>{% endif %}
                </svg>
                {{ m }}
              </span>
              {% endfor %}
            </div>
            <div class="mt-4 flex h-10 items-center justify-center gap-2 rounded-lg bg-brand-600 text-sm font-600 text-white">
              <span class="h-4 w-4">{{ icon('lock') }}</span> Pay ₹2,480
            </div>
          </div>
        </div>
        <div class="reveal order-1 lg:order-2">
          <p class="text-sm font-600 uppercase tracking-wide text-brand-600">Payments</p>
          <h2 class="mt-2 font-display text-3xl font-700 tracking-tight sm:text-4xl">Payments that just work in India</h2>
          <p class="mt-4 leading-relaxed text-slate-600">
            Connect your Razorpay account once. Customers pay by UPI, card, netbanking or wallet, and sellinaday
            reconciles every payment against its order — including captures, failures and refunds — so your
            dashboard is always the source of truth.
          </p>
          <ul class="mt-6 space-y-3 text-sm text-slate-700">
            <li class="flex gap-3"><span class="h-5 w-5 shrink-0 text-brand-600">{{ icon('check') }}</span> Webhook-verified payment status, not guesswork</li>
            <li class="flex gap-3"><span class="h-5 w-5 shrink-0 text-brand-600">{{ icon('check') }}</span> Refund from the order screen</li>
            <li class="flex gap-3"><span class="h-5 w-5 shrink-0 text-brand-600">{{ icon('check') }}</span> Coupons, shipping rules and taxes applied server-side</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {# ================= SPOTLIGHT: DASHBOARD ================= #}
  <section class="mx-auto max-w-6xl px-5 py-20">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div class="reveal">
        <p class="text-sm font-600 uppercase tracking-wide text-brand-600">Dashboard</p>
        <h2 class="mt-2 font-display text-3xl font-700 tracking-tight sm:text-4xl">Run the whole store from one screen</h2>
        <p class="mt-4 leading-relaxed text-slate-600">
          Mission Control is a single admin for catalogue, orders, customers, coupons, shipping zones, themes,
          domains and billing. Role-based access for staff, an audit log on every change, and nothing to
          self-host.
        </p>
        <div class="mt-6 grid grid-cols-2 gap-3 text-sm">
          {% for t in ['Orders & fulfilment', 'Catalogue & stock', 'Customers & segments', 'Coupons & campaigns', 'Shipping zones', 'Staff roles & audit log'] %}
