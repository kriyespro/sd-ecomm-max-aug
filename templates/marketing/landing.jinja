{% extends "base.jinja" %}

{% block title %}sellinaday — start your ecommerce store in a day{% endblock %}
{% block meta_description %}sellinaday is a hosted commerce platform for India: quick store setup, your own custom domain on HTTPS, Razorpay payments, and a full admin dashboard — no servers to run.{% endblock %}

{% block head %}
{# Fonts are self-hosted in base.jinja. The compiled site bundle carries the
   theme below; this inline config is only the dev / Play-CDN fallback and must
   stay in sync with tools/build_tailwind_site.py. #}
{% if not site_css_href() %}
<script>
  tailwind.config = {
    theme: {
      extend: {
        fontFamily: {
          sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'],
          display: ['"Space Grotesk"', 'Inter', 'sans-serif'],
        },
        colors: {
          brand: {
            50:'#eef2ff',100:'#e0e7ff',200:'#c7d2fe',300:'#a5b4fc',400:'#818cf8',
            500:'#6366f1',600:'#4f46e5',700:'#4338ca',800:'#3730a3',900:'#312e81',
          },
        },
        keyframes: {
          float: { '0%,100%': { transform: 'translateY(0)' }, '50%': { transform: 'translateY(-10px)' } },
          floatslow: { '0%,100%': { transform: 'translateY(0) rotate(0deg)' }, '50%': { transform: 'translateY(-16px) rotate(2deg)' } },
        },
        animation: {
          float: 'float 6s ease-in-out infinite',
          floatslow: 'floatslow 9s ease-in-out infinite',
        },
      },
    },
  };
</script>
{% endif %}
<style>
  html { scroll-behavior: smooth; }
  .reveal { opacity: 0; transform: translateY(18px); transition: opacity .6s ease, transform .6s ease; }
  .reveal.in { opacity: 1; transform: none; }

  /* layered aurora backdrop */
  .aurora {
    background:
      radial-gradient(42rem 42rem at 12% -12%, #e0e7ff 0%, transparent 60%),
      radial-gradient(36rem 36rem at 96% -4%, #ede9fe 0%, transparent 55%),
      radial-gradient(30rem 30rem at 50% 118%, #dbeafe 0%, transparent 60%);
  }
  .grid-mask {
    -webkit-mask-image: radial-gradient(60% 55% at 50% 30%, #000 0%, transparent 100%);
    mask-image: radial-gradient(60% 55% at 50% 30%, #000 0%, transparent 100%);
  }
  .ticker { animation: scrollx 28s linear infinite; }
  @keyframes scrollx { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  .card-sheen { position: relative; overflow: hidden; }
  .card-sheen::after {
    content: ""; position: absolute; inset: 0; transform: translateX(-100%);
    background: linear-gradient(110deg, transparent 30%, rgba(255,255,255,.55) 50%, transparent 70%);
  }
  .card-sheen:hover::after { animation: shimmer 1.1s ease; }
  @keyframes shimmer { to { transform: translateX(100%); } }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .reveal { opacity: 1; transform: none; transition: none; }
    .ticker, .animate-float, .animate-floatslow { animation: none !important; }
    .card-sheen::after { display: none; }
  }
</style>
{% endblock %}

{% block body %}

{# ========= shared SVG defs — gradients + patterns referenced across the page ========= #}
<svg width="0" height="0" class="absolute" aria-hidden="true">
  <defs>
    <linearGradient id="g-brand" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#6366f1"/><stop offset="0.55" stop-color="#7c3aed"/><stop offset="1" stop-color="#4f46e5"/>
    </linearGradient>
    <linearGradient id="g-brand-soft" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#a5b4fc"/><stop offset="1" stop-color="#c4b5fd"/>
    </linearGradient>
    <linearGradient id="g-sky" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#38bdf8"/><stop offset="1" stop-color="#6366f1"/>
    </linearGradient>
    <pattern id="p-dots" width="22" height="22" patternUnits="userSpaceOnUse">
      <circle cx="1.5" cy="1.5" r="1.5" fill="#c7d2fe"/>
    </pattern>
    <pattern id="p-grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M40 0H0V40" fill="none" stroke="#e2e8f0" stroke-width="1"/>
    </pattern>
    <filter id="f-blur" x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="34"/>
    </filter>
  </defs>
</svg>

{# ========= macros ========= #}
{% macro logo(dark=false) %}
<span class="inline-flex items-center gap-2">
  <svg class="h-7 w-7" viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <rect x="1.5" y="1.5" width="29" height="29" rx="9" fill="url(#g-brand)"/>
    <path d="M9 22V11.5L16 17l7-5.5V22" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  <span class="font-display text-lg font-700 tracking-tight {{ 'text-white' if dark else 'text-slate-900' }}">sell<span class="text-brand-{{ '300' if dark else '600' }}">inaday</span></span>
</span>
{% endmacro %}

{% macro icon(name) %}
{# richer duotone glyphs: a faint currentColor fill + a crisp stroke, so they
   adapt to any text colour they're dropped into #}
<svg class="h-full w-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {% if name == 'bolt' %}
    <path d="M13 2 4 14h6l-1 8 9-12h-6z" fill="currentColor" fill-opacity=".14"/><path d="M13 2 4 14h6l-1 8 9-12h-6z"/>
  {% elif name == 'card' %}
    <rect x="2.5" y="5" width="19" height="14" rx="2.5" fill="currentColor" fill-opacity=".12"/><rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M2.5 9.5h19"/><path d="M6 15h4" stroke-width="2.2"/>
  {% elif name == 'globe' %}
    <circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity=".12"/><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.7 3 2.7 15 0 18M12 3c-2.7 3-2.7 15 0 18"/>
  {% elif name == 'grid' %}
    <rect x="3" y="3" width="7.5" height="7.5" rx="1.8" fill="currentColor" fill-opacity=".16"/><rect x="3" y="3" width="7.5" height="7.5" rx="1.8"/>
    <rect x="13.5" y="3" width="7.5" height="7.5" rx="1.8"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="1.8"/>
    <rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.8" fill="currentColor" fill-opacity=".16"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.8"/>
  {% elif name == 'sparkles' %}
    <path d="M12 3l1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6z" fill="currentColor" fill-opacity=".16"/>
    <path d="M12 3l1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6z"/><path d="M18.5 14.5l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/>
  {% elif name == 'plug' %}
    <path d="M7 9h10v2a5 5 0 0 1-10 0z" fill="currentColor" fill-opacity=".14"/><path d="M9 3v6M15 3v6M7 9h10v2a5 5 0 0 1-10 0zM12 16v5"/>
  {% elif name == 'check' %}
    <circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity=".12"/><path d="m8 12.5 2.5 2.5L16 9"/>
  {% elif name == 'shield' %}
    <path d="M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z" fill="currentColor" fill-opacity=".12"/><path d="M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z"/><path d="m9 12 2 2 4-4"/>
  {% elif name == 'chart' %}
    <path d="M4 4v16h16" /><path d="M8 15l3-4 3 2 4-6" /><circle cx="18" cy="7" r="1.4" fill="currentColor"/>
  {% elif name == 'rocket' %}
    <path d="M12 3c3 1.5 5 4.7 5 9 0 2.2-.7 3.5-1.5 4.5h-7C7.7 15.5 7 14.2 7 12c0-4.3 2-7.5 5-9z" fill="currentColor" fill-opacity=".14"/>
    <path d="M12 3c3 1.5 5 4.7 5 9 0 2.2-.7 3.5-1.5 4.5h-7C7.7 15.5 7 14.2 7 12c0-4.3 2-7.5 5-9z"/><circle cx="12" cy="10" r="1.6"/><path d="M9.5 17c-.8 1.2-1 2.5-1 4 1.3-.3 2.4-.9 3-1.8M14.5 17c.8 1.2 1 2.5 1 4-1.3-.3-2.4-.9-3-1.8"/>
  {% elif name == 'layers' %}
    <path d="M12 3l9 5-9 5-9-5z" fill="currentColor" fill-opacity=".14"/><path d="M12 3l9 5-9 5-9-5z"/><path d="M3 13l9 5 9-5M3 17l9 5 9-5"/>
  {% elif name == 'lock' %}
    <rect x="4.5" y="10" width="15" height="11" rx="2.5" fill="currentColor" fill-opacity=".12"/><rect x="4.5" y="10" width="15" height="11" rx="2.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>
  {% endif %}
</svg>
{% endmacro %}

{# a tiny storefront wireframe — used in the theme spotlight #}
{% macro wireframe(seed) %}
<svg viewBox="0 0 120 90" class="h-full w-full" fill="none" aria-hidden="true">
  <rect width="120" height="90" rx="6" fill="#fff"/>
  <rect width="120" height="90" rx="6" fill="url(#g-brand)" opacity="0.05"/>
  <rect x="10" y="9" width="26" height="5" rx="2.5" fill="#c7d2fe"/>
  <circle cx="104" cy="11.5" r="3" fill="#e2e8f0"/><circle cx="94" cy="11.5" r="3" fill="#e2e8f0"/>
  {% if seed % 3 == 0 %}
  <rect x="10" y="22" width="100" height="26" rx="4" fill="url(#g-brand-soft)" opacity="0.6"/>
  {% for i in range(3) %}<rect x="{{ 10 + i*34 }}" y="54" width="30" height="24" rx="3" fill="#eef2ff"/>{% endfor %}
  {% elif seed % 3 == 1 %}
  {% for i in range(4) %}<rect x="{{ 10 + i*26 }}" y="22" width="22" height="30" rx="3" fill="#eef2ff"/>{% endfor %}
  {% for i in range(4) %}<rect x="{{ 10 + i*26 }}" y="58" width="16" height="4" rx="2" fill="#c7d2fe"/>{% endfor %}
  {% else %}
  <rect x="10" y="22" width="46" height="56" rx="4" fill="url(#g-brand-soft)" opacity="0.55"/>
  {% for i in range(3) %}<rect x="62" y="{{ 22 + i*20 }}" width="48" height="14" rx="3" fill="#eef2ff"/>{% endfor %}
  {% endif %}
</svg>
{% endmacro %}

<div class="bg-white font-sans text-slate-900">

  {# ================= NAV ================= #}
  <header class="sticky top-0 z-40 border-b border-slate-200/60 bg-white/75 backdrop-blur-lg">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
      <a href="/" class="shrink-0">{{ logo() }}</a>
      <nav class="hidden items-center gap-8 text-sm font-500 text-slate-600 md:flex">
        <a href="#features" class="hover:text-slate-900">Features</a>
        <a href="#how" class="hover:text-slate-900">How it works</a>
        <a href="#domains" class="hover:text-slate-900">Domains</a>
        <a href="#compare" class="hover:text-slate-900">Why sellinaday</a>
        {% if plans %}<a href="#pricing" class="hover:text-slate-900">Pricing</a>{% endif %}
        <a href="{{ url('partners') }}" class="hover:text-slate-900">Partners</a>
        <a href="#faq" class="hover:text-slate-900">FAQ</a>
      </nav>
      <div class="flex items-center gap-3 text-sm font-500">
        <a href="{{ url('accounts:login') }}" class="hidden text-slate-600 hover:text-slate-900 sm:block">Sign in</a>
        <a href="{{ url('accounts:login') }}" class="group inline-flex items-center gap-1.5 rounded-lg bg-slate-900 px-4 py-2 font-600 text-white transition hover:bg-slate-800">
          Open your store
          <svg class="h-4 w-4 transition group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </header>

  {# ================= HERO ================= #}
  <section class="aurora relative overflow-hidden">
    {# svg backdrop: grid + soft orbs #}
    <svg class="pointer-events-none absolute inset-0 -z-0 h-full w-full grid-mask" aria-hidden="true">
      <rect width="100%" height="100%" fill="url(#p-grid)"/>
    </svg>
    <svg class="pointer-events-none absolute -left-24 top-4 -z-0 h-[36rem] w-[36rem] opacity-70" aria-hidden="true">
      <circle cx="50%" cy="50%" r="180" fill="url(#g-brand)" filter="url(#f-blur)" opacity="0.35"/>
    </svg>
    <svg class="pointer-events-none absolute -right-32 -top-10 -z-0 h-[34rem] w-[34rem] opacity-70" aria-hidden="true">
      <circle cx="50%" cy="50%" r="170" fill="url(#g-sky)" filter="url(#f-blur)" opacity="0.3"/>
    </svg>

    <div class="relative mx-auto max-w-6xl px-5 pb-10 pt-20 text-center sm:pt-28">
      <a href="#how" class="mb-5 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-white/70 px-3 py-1 text-xs font-600 text-brand-700 shadow-sm backdrop-blur">
        <span class="inline-flex h-3.5 w-3.5">{{ icon('sparkles') }}</span>
        Hosted commerce for India · no servers to run
      </a>
      <h1 class="mx-auto max-w-3xl font-display text-4xl font-700 leading-[1.05] tracking-tight text-slate-900 sm:text-6xl">
        Start your ecommerce store
        <span class="bg-gradient-to-r from-brand-600 via-violet-600 to-brand-500 bg-clip-text text-transparent"> in a day</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-600">
        Quick store setup, your own custom domain on HTTPS, Razorpay payments, and a full
        admin dashboard — all in one place. You bring the products; sellinaday runs everything else.
      </p>
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="{{ url('accounts:login') }}" class="group inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-600 px-6 py-3 text-center font-600 text-white shadow-lg shadow-brand-600/25 transition hover:-translate-y-0.5 hover:bg-brand-500 sm:w-auto">
          <span class="inline-flex h-4 w-4">{{ icon('rocket') }}</span> Open your store
        </a>
        <a href="#features" class="w-full rounded-xl border border-slate-300 bg-white px-6 py-3 text-center font-600 text-slate-700 transition hover:bg-slate-50 sm:w-auto">
          See what's included
        </a>
      </div>
      <p class="mt-5 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-sm text-slate-500">
        <span class="inline-flex items-center gap-1.5"><span class="inline-flex h-4 w-4 text-emerald-500">{{ icon('lock') }}</span> HTTPS out of the box</span>
        <span class="text-slate-300">·</span> Razorpay checkout
        <span class="text-slate-300">·</span> connect a domain you already own
      </p>
    </div>

    {# ---- product mock ---- #}
    <div class="reveal relative mx-auto -mb-24 max-w-5xl px-5">
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl shadow-slate-900/10">
        <div class="flex items-center gap-2 border-b border-slate-100 bg-slate-50 px-4 py-3">
          <span class="h-3 w-3 rounded-full bg-rose-300"></span>
          <span class="h-3 w-3 rounded-full bg-amber-300"></span>
          <span class="h-3 w-3 rounded-full bg-emerald-300"></span>
          <div class="ml-3 flex flex-1 items-center gap-2 rounded-md bg-white px-3 py-1 text-left text-xs text-slate-400 ring-1 ring-slate-200">
            <svg class="h-3.5 w-3.5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
            https://shop.yourbrand.com
          </div>
        </div>
        <div class="grid gap-0 sm:grid-cols-[1fr_1.6fr]">
          <div class="hidden border-r border-slate-100 p-5 sm:block">
            <div class="mb-4 h-4 w-24 rounded bg-slate-200"></div>
            {% for w in [16, 12, 20, 14, 10] %}<div class="mb-2.5 h-3 rounded bg-slate-100" style="width: {{ w * 6 }}px"></div>{% endfor %}
            <div class="mt-6 rounded-lg bg-gradient-to-br from-brand-50 to-violet-50 p-3 ring-1 ring-brand-100">
              <div class="h-3 w-16 rounded bg-brand-200"></div>
              <div class="mt-2 h-6 w-24 rounded bg-brand-600/80"></div>
            </div>
          </div>
          <div class="p-5">
            <div class="mb-4 flex items-center justify-between">
              <div class="h-4 w-28 rounded bg-slate-200"></div>
              <div class="h-7 w-20 rounded-lg bg-slate-900"></div>
            </div>
            <div class="grid grid-cols-3 gap-3">
              {% for i in range(6) %}
              <div class="card-sheen rounded-lg">
                <div class="aspect-square rounded-lg bg-gradient-to-br from-slate-100 to-slate-200"></div>
                <div class="mt-2 h-2.5 w-4/5 rounded bg-slate-200"></div>
                <div class="mt-1.5 h-2.5 w-1/2 rounded bg-slate-100"></div>
              </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>

      {# floating order card with a tiny sparkline #}
      <div class="animate-float absolute -right-2 top-8 hidden w-60 rounded-xl border border-slate-200 bg-white p-4 shadow-xl sm:block">
        <div class="flex items-center justify-between">
          <p class="text-xs font-600 text-emerald-600">● New order</p>
          <p class="text-xs font-700 text-slate-800">₹2,480</p>
        </div>
        <svg viewBox="0 0 200 44" class="mt-2 h-11 w-full" fill="none" aria-hidden="true">
          <path d="M0 34 30 28 55 30 85 16 115 22 145 8 175 14 200 4" stroke="url(#g-brand)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M0 34 30 28 55 30 85 16 115 22 145 8 175 14 200 4V44H0z" fill="url(#g-brand)" fill-opacity="0.12"/>
        </svg>
        <p class="mt-1 text-xs text-slate-400">Paid via Razorpay (UPI) · ship to Pune</p>
      </div>
      {# floating "verified domain" chip #}
      <div class="animate-floatslow absolute -left-3 bottom-10 hidden w-52 rounded-xl border border-slate-200 bg-white p-3 shadow-xl lg:block">
        <div class="flex items-center gap-2">
          <span class="inline-flex h-6 w-6 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
          </span>
          <div class="text-xs">
            <p class="font-600 text-slate-800">Domain verified</p>
            <p class="text-slate-400">shop.yourbrand.com</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {# ================= STAT BAR ================= #}
  {% if stats and stats.stores %}
  <section class="border-y border-slate-200 bg-slate-50 pt-32">
    <div class="mx-auto grid max-w-4xl gap-6 px-5 py-10 text-center sm:grid-cols-3">
      {% for val, label, ic in [
        (stats.stores, 'stores on the platform', 'globe'),
        (stats.products, 'products listed', 'grid'),
        (stats.themes, 'storefront themes', 'sparkles'),
      ] %}
      <div>
        <div class="mx-auto mb-2 inline-flex h-9 w-9 items-center justify-center rounded-xl bg-white text-brand-600 shadow-sm ring-1 ring-slate-200">
          <span class="h-4 w-4">{{ icon(ic) }}</span>
        </div>
        <p class="font-display text-3xl font-700 text-slate-900">{{ val }}</p>
        <p class="mt-1 text-sm text-slate-500">{{ label }}</p>
      </div>
      {% endfor %}
    </div>
  </section>
  {% else %}
  <div class="pt-28"></div>
  {% endif %}

  {# ================= FEATURES ================= #}
  <section id="features" class="mx-auto max-w-6xl px-5 py-20">
    <div class="reveal mx-auto max-w-2xl text-center">
      <h2 class="font-display text-3xl font-700 tracking-tight sm:text-4xl">Everything a store needs, already wired</h2>
      <p class="mt-4 text-slate-600">No plugins to assemble. The pieces below ship together and talk to each other.</p>
    </div>
    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {% set feats = [
        ('bolt', 'Quick store setup', 'Add products, pick a theme, and your store is browsable the same day — no theme coding, no plugin hunting.'),
        ('card', 'Razorpay payments', 'Cards, UPI, netbanking and wallets through Razorpay. Orders and payment status stay in sync automatically.'),
        ('globe', 'Your own custom domain', 'Point a domain you own, verify with one DNS record, and it goes live on HTTPS — certificates handled for you.'),
        ('grid', 'Full admin dashboard', 'Catalogue, orders, customers, coupons, shipping, themes, domains and billing in one Mission Control panel.'),
        ('sparkles', 'Themes that look the part', 'Swappable storefront themes with product grid, quick view, search, wishlist and a slide-out cart.'),
        ('plug', 'Built-in REST API', 'The same store data behind a REST API, so a mobile app or headless frontend can plug straight in.'),
      ] %}
      {% for ic, title, body in feats %}
      <div class="reveal group relative overflow-hidden rounded-2xl border border-slate-200 p-6 transition hover:-translate-y-1 hover:border-brand-300 hover:shadow-lg hover:shadow-slate-200/60">
        <svg class="pointer-events-none absolute -right-6 -top-6 h-24 w-24 text-brand-100 opacity-0 transition-opacity group-hover:opacity-100" viewBox="0 0 96 96" fill="none" aria-hidden="true">
          <circle cx="48" cy="48" r="47" stroke="currentColor" stroke-width="2" stroke-dasharray="4 6"/>
        </svg>
        <div class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-brand-600 to-violet-600 p-2.5 text-white shadow-sm shadow-brand-600/30">
          {{ icon(ic) }}
        </div>
        <h3 class="font-600 text-slate-900">{{ title }}</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">{{ body }}</p>
      </div>
      {% endfor %}
    </div>
  </section>

  {# ================= HOW IT WORKS ================= #}
  <section id="how" class="border-y border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <div class="reveal mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-700 tracking-tight sm:text-4xl">Live in a day, in three steps</h2>
      </div>
      <div class="relative mt-14 grid gap-6 md:grid-cols-3">
        {# dashed connector behind the cards (md+) #}
        <svg class="pointer-events-none absolute inset-x-0 top-12 hidden h-8 w-full md:block" viewBox="0 0 900 32" fill="none" preserveAspectRatio="none" aria-hidden="true">
          <path d="M150 16H750" stroke="#c7d2fe" stroke-width="2" stroke-dasharray="2 8" stroke-linecap="round"/>
          <path d="M744 9l10 7-10 7" stroke="#a5b4fc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M444 9l10 7-10 7" stroke="#a5b4fc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {% set steps = [
          ('Add products, pick a look', 'Load the catalogue and choose a theme. Your store is browsable at its sellinaday address right away.'),
          ('Connect Razorpay & your domain', 'Drop in your Razorpay keys, add one DNS record for your domain, and sellinaday verifies it for you.'),
          ('Open for orders', 'Share the link. Customers check out with Razorpay; every order lands in your dashboard.'),
        ] %}
        {% for title, body in steps %}
