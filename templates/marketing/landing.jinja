    <div class="mx-auto max-w-6xl px-5 py-20">
      <div class="reveal mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-700 tracking-tight sm:text-4xl">Simple pricing</h2>
        <p class="mt-4 text-slate-600">Prices in INR. Switch or cancel anytime from the dashboard.</p>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {% for p in plans %}
        {% set popular = p.code == popular_code %}
        <div class="reveal relative flex flex-col rounded-2xl border bg-white p-6
          {% if popular %}border-brand-500 shadow-xl shadow-brand-600/10 ring-1 ring-brand-500{% else %}border-slate-200{% endif %}">
          {% if popular %}<span class="absolute -top-3 left-6 inline-flex items-center gap-1 rounded-full bg-gradient-to-r from-brand-600 to-violet-600 px-3 py-0.5 text-xs font-600 text-white">
            <span class="h-3 w-3">{{ icon('sparkles') }}</span> Most popular
          </span>{% endif %}
          <h3 class="font-display font-700 text-slate-900">{{ p.name }}</h3>
          {% if p.tagline %}<p class="mt-1 text-sm text-slate-500">{{ p.tagline }}</p>{% endif %}
          <p class="mt-4 font-display text-4xl font-700 text-slate-900">
            &#8377;{{ p.price_monthly|int }}<span class="text-sm font-400 text-slate-500">/mo</span>
          </p>
          {% if p.price_yearly %}<p class="mt-1 text-xs text-slate-400">or &#8377;{{ p.price_yearly|int }} billed yearly</p>{% endif %}
          {% if p.features %}
          <ul class="mt-5 space-y-2 text-sm text-slate-600">
            {% for f in p.features %}<li class="flex gap-2"><span class="h-4 w-4 shrink-0 text-brand-600">{{ icon('check') }}</span> {{ f }}</li>{% endfor %}
          </ul>
          {% endif %}
          <a href="{{ url('accounts:login') }}" class="mt-6 rounded-lg px-4 py-2 text-center text-sm font-600 transition
            {% if popular %}bg-brand-600 text-white hover:bg-brand-500{% else %}bg-slate-900 text-white hover:bg-slate-800{% endif %}">
            Choose {{ p.name }}
          </a>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {# ================= FAQ ================= #}
  <section id="faq" class="mx-auto max-w-3xl px-5 py-20">
    <div class="reveal text-center">
      <h2 class="font-display text-3xl font-700 tracking-tight sm:text-4xl">Questions</h2>
    </div>
    <div class="reveal mt-10 divide-y divide-slate-200 border-y border-slate-200">
      {% set faqs = [
        ('How fast can I actually launch?', 'If your product data and images are ready, a store can be live on your own domain the same day. The domain verification itself takes a few minutes after you add the DNS record.'),
        ('Do I need my own Razorpay account?', 'Yes — you connect your own Razorpay keys, so payouts go straight to your bank. sellinaday handles the integration, reconciliation and refunds.'),
        ('Can I use a domain I already own?', 'Yes. Add it in the dashboard, add one DNS record (A record or Cloudflare proxy), and it auto-verifies. HTTPS is managed for you.'),
        ('Can I move my theme or data later?', 'Themes are swappable at any time without touching your catalogue. Your store data is yours and exportable.'),
        ('Is there a REST API?', 'Yes. The same data behind the storefront is available over a REST API for mobile apps or a headless frontend.'),
      ] %}
      {% for q, a in faqs %}
      <details class="group py-4">
        <summary class="flex cursor-pointer list-none items-center justify-between font-600 text-slate-800">
          {{ q }}
          <span class="ml-4 inline-flex h-6 w-6 items-center justify-center rounded-full bg-slate-100 text-slate-500 transition group-open:rotate-45 group-open:bg-brand-600 group-open:text-white">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
          </span>
        </summary>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">{{ a }}</p>
      </details>
      {% endfor %}
    </div>
  </section>

  {# ================= CTA ================= #}
  <section class="mx-auto max-w-6xl px-5 pb-20">
    <div class="reveal relative overflow-hidden rounded-3xl bg-gradient-to-br from-brand-600 to-violet-700 px-8 py-14 text-center text-white sm:px-16">
      <svg class="pointer-events-none absolute inset-0 h-full w-full opacity-20" aria-hidden="true">
        <defs><pattern id="p-cta" width="28" height="28" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="2" fill="#fff"/></pattern></defs>
        <rect width="100%" height="100%" fill="url(#p-cta)"/>
      </svg>
      <div class="relative">
        <h2 class="font-display text-3xl font-700 tracking-tight sm:text-4xl">Start your ecommerce store in a day</h2>
        <p class="mx-auto mt-4 max-w-xl text-brand-100">Quick setup, custom domain, Razorpay checkout, full admin dashboard. Your customers never see the plumbing.</p>
        <a href="{{ url('accounts:login') }}" class="mt-8 inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 font-600 text-brand-700 transition hover:-translate-y-0.5 hover:bg-brand-50">
          <span class="h-4 w-4">{{ icon('rocket') }}</span> Open your store
        </a>
      </div>
    </div>
  </section>

  {# ================= FOOTER ================= #}
  <footer class="border-t border-slate-200 bg-white">
    <div class="mx-auto grid max-w-6xl gap-8 px-5 py-12 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        {{ logo() }}
        <p class="mt-2 text-sm text-slate-500">Hosted commerce for India.</p>
      </div>
      <div>
        <p class="text-xs font-600 uppercase tracking-wide text-slate-400">Product</p>
        <ul class="mt-3 space-y-2 text-sm text-slate-600">
          <li><a href="#features" class="hover:text-slate-900">Features</a></li>
          <li><a href="#domains" class="hover:text-slate-900">Custom domains</a></li>
          {% if plans %}<li><a href="#pricing" class="hover:text-slate-900">Pricing</a></li>{% endif %}
        </ul>
      </div>
      <div>
        <p class="text-xs font-600 uppercase tracking-wide text-slate-400">Company</p>
        <ul class="mt-3 space-y-2 text-sm text-slate-600">
          <li><a href="#compare" class="hover:text-slate-900">Why sellinaday</a></li>
          <li><a href="{{ url('partners') }}" class="hover:text-slate-900">Partner programme</a></li>
          <li><a href="#faq" class="hover:text-slate-900">FAQ</a></li>
