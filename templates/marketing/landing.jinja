          {% endfor %}
        </div>
      </div>
      <div class="reveal">
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-lg">
          <div class="flex items-center gap-2 border-b border-slate-100 bg-slate-50 px-4 py-3 text-xs font-600 text-slate-500">
            <span class="h-4 w-4 text-brand-500">{{ icon('chart') }}</span> Orders
          </div>
          <table class="w-full text-left text-xs">
            <thead class="text-slate-400">
              <tr>{% for h in ['Order', 'Customer', 'Total', 'Status'] %}<th class="px-4 py-2 font-500">{{ h }}</th>{% endfor %}</tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {% set rows = [
                ('#1042', 'A. Sharma', '₹2,480', 'Paid'),
                ('#1041', 'R. Iyer', '₹899', 'Shipped'),
                ('#1040', 'K. Menon', '₹5,120', 'Paid'),
                ('#1039', 'S. Gupta', '₹1,350', 'Refunded'),
              ] %}
              {% for o, c, t, s in rows %}
              <tr>
                <td class="px-4 py-2.5 font-600 text-slate-700">{{ o }}</td>
                <td class="px-4 py-2.5 text-slate-500">{{ c }}</td>
                <td class="px-4 py-2.5 text-slate-700">{{ t }}</td>
                <td class="px-4 py-2.5">
                  <span class="rounded-full px-2 py-0.5 font-600
                    {% if s == 'Paid' %}bg-emerald-50 text-emerald-700
                    {% elif s == 'Shipped' %}bg-blue-50 text-blue-700
                    {% else %}bg-slate-100 text-slate-600{% endif %}">{{ s }}</span>
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  {# ================= CUSTOM DOMAINS ================= #}
  <section id="domains" class="relative overflow-hidden border-y border-slate-200 bg-slate-900 text-white">
    <svg class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.15]" aria-hidden="true">
      <defs><pattern id="p-grid-dark" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M40 0H0V40" fill="none" stroke="#64748b" stroke-width="1"/></pattern></defs>
      <rect width="100%" height="100%" fill="url(#p-grid-dark)"/>
    </svg>
    <div class="relative mx-auto max-w-6xl px-5 py-20">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div class="reveal">
          <p class="text-sm font-600 uppercase tracking-wide text-brand-300">Custom domains</p>
          <h2 class="mt-2 font-display text-3xl font-700 tracking-tight sm:text-4xl">Your brand, your domain, on HTTPS</h2>
          <p class="mt-4 leading-relaxed text-slate-300">
            Add a hostname you own in the dashboard. Point one DNS record at the platform — or flip on the
            Cloudflare proxy — and sellinaday verifies it automatically, then serves it over HTTPS with a
            managed certificate. No installs, no renewals to track.
          </p>
          <ul class="mt-6 space-y-3 text-sm text-slate-300">
            <li class="flex gap-3"><span class="h-5 w-5 shrink-0 text-brand-300">{{ icon('check') }}</span> Verify by A record, TXT record, or Cloudflare proxy</li>
            <li class="flex gap-3"><span class="h-5 w-5 shrink-0 text-brand-300">{{ icon('check') }}</span> Auto-checked every few minutes — no support ticket</li>
            <li class="flex gap-3"><span class="h-5 w-5 shrink-0 text-brand-300">{{ icon('check') }}</span> HTTPS and renewals handled for you</li>
          </ul>
        </div>
        <div class="reveal rounded-2xl border border-white/10 bg-black/40 p-6 font-mono text-xs leading-relaxed text-slate-300 shadow-2xl">
          <p class="text-slate-500"># in your DNS provider</p>
          <p><span class="text-emerald-400">A</span>&nbsp;&nbsp;&nbsp;&nbsp;shop.yourbrand.com&nbsp;&nbsp;&rarr;&nbsp;&nbsp;the platform IP</p>
          <p class="mt-3 text-slate-500"># sellinaday, a minute later</p>
          <p class="flex items-center gap-2">
            <svg class="h-4 w-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
            <span class="text-emerald-400">verified</span>&nbsp;shop.yourbrand.com is live
          </p>
          <p class="mt-1 text-brand-300">https://shop.yourbrand.com/</p>
        </div>
      </div>
    </div>
  </section>

  {# ================= COMPARE ================= #}
  <section id="compare" class="mx-auto max-w-5xl px-5 py-20">
    <div class="reveal mx-auto max-w-2xl text-center">
      <h2 class="font-display text-3xl font-700 tracking-tight sm:text-4xl">Why sellinaday</h2>
      <p class="mt-4 text-slate-600">Skip the stack you'd otherwise stitch together yourself.</p>
    </div>
    <div class="reveal mt-12 overflow-x-auto">
      <table class="w-full min-w-[36rem] border-separate border-spacing-0 text-sm">
        <thead>
          <tr class="text-left text-slate-500">
            <th class="px-4 py-3 font-500">What you need</th>
            <th class="px-4 py-3 font-600 text-brand-700">sellinaday</th>
            <th class="px-4 py-3 font-500">Do-it-yourself</th>
          </tr>
        </thead>
        <tbody class="text-slate-700">
          {% set crows = [
            ('Storefront + checkout', 'Included, themeable', 'Build or buy a theme'),
            ('Razorpay integration', 'Wired, webhook-verified', 'Wire it and test edge cases'),
            ('Custom domain + HTTPS', 'One DNS record, auto', 'DNS, certs, renewals, nginx'),
            ('Admin dashboard', 'Included, role-based', 'Build CRUD + auth'),
            ('Hosting & scaling', 'Managed', 'Servers, backups, monitoring'),
            ('Time to launch', 'A day', 'Weeks'),
          ] %}
          {% for need, ours, diy in crows %}
          <tr>
            <td class="border-t border-slate-200 px-4 py-3 font-500">{{ need }}</td>
            <td class="border-t border-slate-200 bg-brand-50/50 px-4 py-3 font-500 text-slate-900">
              <span class="mr-1.5 inline-flex h-4 w-4 align-middle text-brand-600">{{ icon('check') }}</span>{{ ours }}
            </td>
            <td class="border-t border-slate-200 px-4 py-3 text-slate-500">{{ diy }}</td>
          </tr>
