          <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 font-display text-lg font-700 text-brand-600 ring-1 ring-brand-100">0{{ loop.index }}</span>
          <h3 class="mt-3 font-600 text-slate-900">{{ title }}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">{{ body }}</p>
