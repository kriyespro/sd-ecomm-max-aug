{% extends "control/base_control.jinja" %}
{% block page_title %}Blog{% endblock %}

{% block content %}
<div class="space-y-4">
  <div class="flex items-center justify-between">
    <h2 class="text-sm font-semibold text-slate-700">Blog posts</h2>
    <div class="flex gap-2">
      <a href="/blog/" target="_blank" rel="noopener" class="rounded-lg px-3 py-1.5 text-sm text-slate-600 hover:bg-slate-100">View live</a>
      <a href="{{ url('control:blog_create') }}" class="rounded-lg bg-slate-900 px-3 py-1.5 text-sm text-white hover:bg-slate-800">New post</a>
    </div>
  </div>
  <p class="text-xs text-slate-500">
    Marketing content for the platform site (not a tenant store). Categories, tags
    and authors are managed in <a href="/sd/blog/" target="_blank" rel="noopener" class="underline">Django admin</a>.
  </p>

  <div class="overflow-x-auto rounded-xl bg-white ring-1 ring-slate-200">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
        <tr><th class="px-4 py-2">Title</th><th class="px-4 py-2">Category</th>
          <th class="px-4 py-2">Author</th><th class="px-4 py-2">Published</th>
          <th class="px-4 py-2">Live</th><th class="px-4 py-2"></th></tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {% for p in posts %}
        <tr class="hover:bg-slate-50">
          <td class="px-4 py-2 font-medium text-slate-800">{{ p.title }}</td>
          <td class="px-4 py-2 text-slate-500">{{ p.category.name if p.category else "—" }}</td>
          <td class="px-4 py-2 text-slate-500">{{ p.author.name if p.author else "—" }}</td>
          <td class="px-4 py-2 text-slate-500">{{ p.published_at.date() if p.published_at else "—" }}</td>
          <td class="px-4 py-2">
            <span class="rounded px-2 py-0.5 text-xs {{ 'bg-emerald-100 text-emerald-700' if p.is_live else 'bg-slate-200 text-slate-600' }}">
              {{ "yes" if p.is_live else "no" }}</span>
          </td>
          <td class="px-4 py-2 text-right"><a href="{{ url('control:blog_edit', kwargs={'pk': p.pk}) }}" class="text-slate-600 hover:underline">Edit</a></td>
        </tr>
        {% else %}
        <tr><td colspan="6" class="px-4 py-6 text-center text-slate-400">No posts yet.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
