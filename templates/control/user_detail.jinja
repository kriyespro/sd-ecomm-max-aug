{% extends "control/base_control.jinja" %}
{% from "control/_forms.jinja" import render_form %}

{% block page_title %}{{ target.get_username() }}{% endblock %}

{% block content %}
<div class="max-w-2xl space-y-4">
  <a href="{{ url('control:users') }}" class="text-sm text-slate-500 hover:underline">← Users</a>

  <div class="rounded-xl bg-white p-6 ring-1 ring-slate-200">
    <h2 class="text-lg font-semibold">{{ target.get_full_name() or target.get_username() }}</h2>
    <dl class="mt-4 grid gap-x-4 gap-y-1 text-sm sm:grid-cols-3 sm:gap-y-3">
      <dt class="text-slate-400">Username</dt><dd class="mb-2 sm:col-span-2 sm:mb-0">{{ target.get_username() }}</dd>
      <dt class="text-slate-400">Email</dt><dd class="mb-2 break-all sm:col-span-2 sm:mb-0">{{ target.email or "—" }}</dd>
      <dt class="text-slate-400">Joined</dt><dd class="mb-2 sm:col-span-2 sm:mb-0">{{ target.date_joined.strftime("%b %d, %Y %H:%M") }}</dd>
      <dt class="text-slate-400">Last login</dt><dd class="mb-2 sm:col-span-2 sm:mb-0">{{ target.last_login.strftime("%b %d, %Y %H:%M") if target.last_login else "never" }}</dd>
      <dt class="text-slate-400">Phone</dt><dd class="mb-2 sm:col-span-2 sm:mb-0">{{ target.profile.phone or "—" }}</dd>
      <dt class="text-slate-400">Platform role</dt><dd class="mb-2 sm:col-span-2 sm:mb-0">{{ target.profile.get_platform_role_display() }}</dd>
      <dt class="text-slate-400">Staff / Super</dt><dd class="mb-2 sm:col-span-2 sm:mb-0">{{ target.is_staff }} / {{ target.is_superuser }}</dd>
      <dt class="text-slate-400">Banned</dt><dd class="sm:col-span-2">{{ target.profile.is_banned }}</dd>
    </dl>
  </div>

  <div class="rounded-xl bg-white p-6 ring-1 ring-slate-200">
    <h3 class="text-sm font-semibold text-slate-700">Platform role</h3>
    <p class="mt-1 text-xs text-slate-400">
      Assign this account as a Digital Growth Consultant (DGC) so they can
      create stores and earn commission, or a Platform Owner for full access.
    </p>
    <form method="post" action="{{ url('control:user_role_change', kwargs={'pk': target.pk}) }}"
          class="mt-3 flex flex-wrap items-end gap-2">
      {{ csrf_input }}
      <div class="w-64">{{ render_form(role_form) }}</div>
      <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">Update role</button>
    </form>
  </div>

  <div class="rounded-xl bg-white p-6 ring-1 ring-slate-200">
    <h3 class="text-sm font-semibold text-slate-700">Security</h3>
    <a href="{{ url('control:user_set_password', kwargs={'pk': target.pk}) }}"
       class="mt-2 inline-block rounded-lg border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-50">
      Reset password
    </a>
  </div>

  <div class="rounded-xl bg-white p-6 ring-1 ring-slate-200">
    <h3 class="text-sm font-semibold text-slate-700">Store memberships</h3>
    <ul class="mt-2 space-y-1 text-sm">
      {% for m in target.memberships.all() %}
      <li>{{ m.project.name }} — {{ m.get_role_display() }}{{ " (inactive)" if not m.is_active }}</li>
      {% else %}
      <li class="text-slate-400">None</li>
      {% endfor %}
    </ul>
  </div>
</div>
{% endblock %}
