{% extends "base.jinja" %}

{% block title %}{% block page_title %}Mission Control{% endblock %} · Mission Control{% endblock %}

{# The marketing-site pixels never belong on an operator's admin pages. #}
{% block platform_tracking %}{% endblock %}

{% block body %}
{# Mission Control colour scheme by the viewer's highest role:
   platform (superuser / Platform Owner) = indigo, DGC (Platform Manager) =
   orange, store owner = green, store manager = pink, staff = slate. #}
{% set _badge = {'platform':'Platform','dgc':'DGC','owner':'Owner','manager':'Manager','staff':''}[control_chrome_theme] %}
{% set _plat = control_platform_scope %}
{# Easy mode gets its own bright, lighter green sidebar — an unmissable
   at-a-glance cue distinct from every role's usual dark theme. #}
{% if control_easy_mode %}
{% set _hue = 'green' %}
{% set _side = 'bg-green-600' %}
{% set _side_hover = 'hover:bg-green-500' %}
{% set _side_active = 'bg-green-500 text-white' %}
{% set _side_border = 'border-green-500' %}
{% else %}
{% set _hue = {'platform':'indigo','dgc':'orange','owner':'emerald','manager':'rose','staff':'slate'}[control_chrome_theme] %}
{% set _side = 'bg-' ~ _hue ~ '-950' %}
{% set _side_hover = 'hover:bg-' ~ _hue ~ '-900' %}
{% set _side_active = 'bg-' ~ _hue ~ '-900 text-white' %}
{% set _side_border = 'border-' ~ _hue ~ '-900' %}
{% endif %}
<div x-data="{ sidebar: true, nav: false }" class="flex min-h-screen bg-{{ _hue }}-50">

  {# backdrop behind the mobile drawer #}
  <div x-show="nav" x-cloak @click="nav = false"
       class="fixed inset-0 z-30 bg-slate-900/50 lg:hidden"></div>

  {# --- Sidebar: off-canvas drawer below lg, static rail at lg+ --- #}
  <aside class="fixed inset-y-0 left-0 z-40 flex w-60 flex-col {{ _side }} text-slate-300
                transition-transform duration-200
                lg:static lg:z-auto lg:translate-x-0 lg:transition-[width]"
         :class="{
           '-translate-x-full': !nav, 'translate-x-0': nav,
           'lg:w-60': sidebar, 'lg:w-16': !sidebar
         }">
    <div class="flex h-14 items-center gap-2 px-4 font-semibold text-white">
      <span class="text-lg">⌘</span>
      <span x-show="sidebar" x-cloak>Mission Control</span>
    </div>
    {# Accordion nav: click a section header to open it; opening one closes the
       rest. The section containing the current page is open on load. In the
       collapsed icon rail (lg:w-16) every item shows regardless. #}
    <nav x-data="{ open: '{{ control_nav_active_key or (control_nav[0].key if control_nav else '') }}' }"
         class="flex-1 overflow-y-auto px-2 py-2 text-sm">
      {% set _tints = ['bg-white/[0.02]', 'bg-white/[0.05]', 'bg-white/[0.03]', 'bg-white/[0.06]', 'bg-white/[0.04]', 'bg-white/[0.06]', 'bg-white/[0.03]'] %}
      {% for s in control_nav %}
      <div class="mb-1 overflow-hidden rounded-lg {{ _tints[loop.index0 % (_tints | length)] }}">
        <button type="button" @click="open = (open === '{{ s.key }}' ? '' : '{{ s.key }}')"
                class="flex w-full items-center gap-2 px-3 py-2 text-left text-[11px] font-semibold uppercase tracking-wider text-{{ _hue }}-200 hover:text-white"
                :class="open === '{{ s.key }}' && '{{ _side_active }}'">
          <span class="w-4 shrink-0 text-center text-sm">{{ s.icon }}</span>
          <span x-show="sidebar" x-cloak class="flex-1 truncate">{{ s.label }}</span>
          <span x-show="sidebar" x-cloak class="shrink-0 text-[10px] transition-transform"
                :class="open === '{{ s.key }}' && 'rotate-90'">▸</span>
        </button>
        <div x-show="!sidebar || open === '{{ s.key }}'" x-cloak class="space-y-0.5 px-1 pb-2 pt-0.5">
          {% for it in s['items'] %}
          <a href="{{ it.url }}" @click="nav = false"
             class="flex items-center gap-3 rounded-lg px-3 py-1.5 {{ _side_hover }} hover:text-white
                    {{ (_side_active ~ ' font-medium') if control_nav_active_url == it.url else '' }}">
            <span class="w-4 shrink-0 text-center">{{ it.icon }}</span>
            <span x-show="sidebar" x-cloak class="truncate">{{ it.label }}</span>
          </a>
          {% endfor %}
        </div>
      </div>
      {% endfor %}

      {% if not control_active_project and control_is_platform_staff %}
        <div x-show="sidebar" x-cloak class="mt-4 rounded-lg bg-{{ _hue }}-900/60 p-3 text-xs text-slate-400">
          Pick a store from <a href="{{ url('control:stores') }}" class="text-slate-200 underline">Stores</a>
          to manage its catalog, orders and settings.
        </div>
      {% endif %}

      {% if control_active_project %}
      <form method="post" action="{{ url('control:ui_mode_toggle') }}" x-show="sidebar" x-cloak class="mt-2 px-1">
        {{ csrf_input }}
        <input type="hidden" name="next" value="{{ request.get_full_path() }}">
        <button class="w-full rounded-lg px-3 py-1.5 text-left text-xs {{ _side_hover }} hover:text-white">
          {% if control_easy_mode %}⚡ Switch to Expert mode{% else %}✨ Switch to Easy mode{% endif %}
        </button>
      </form>
      {% endif %}
      <form method="post" action="{{ url('control:guide_toggle') }}" x-show="sidebar" x-cloak class="mt-1 px-1">
        {{ csrf_input }}
        <input type="hidden" name="next" value="{{ request.get_full_path() }}">
        <button class="w-full rounded-lg px-3 py-1.5 text-left text-xs {{ _side_hover }} hover:text-white">
          {% if control_show_guides %}🎯 Turn off page guides{% else %}🎯 Turn on page guides{% endif %}
        </button>
      </form>
    </nav>
    {% if request.user.is_superuser %}
    <a href="/sd/" class="border-t {{ _side_border }} px-4 py-3 text-xs hover:text-white">
      <span x-show="sidebar" x-cloak>Django admin /sd/</span>
      <span x-show="!sidebar" x-cloak>⚙</span>
    </a>
    {% endif %}
  </aside>

  {# --- Main --- #}
  <div class="flex min-w-0 flex-1 flex-col">
    <header class="flex h-14 items-center gap-3 border-b border-{{ _hue }}-300 bg-white px-4">
      <button aria-label="Menu"
              @click="window.matchMedia('(min-width:1024px)').matches ? (sidebar = !sidebar) : (nav = !nav, sidebar = true)"
              class="shrink-0 rounded p-1 text-slate-500 hover:bg-slate-100">☰</button>
      <div class="flex min-w-0 flex-1 flex-col justify-center leading-tight">
        {% if control_breadcrumb | length > 1 %}
        <nav aria-label="Breadcrumb" class="flex items-center gap-1 truncate text-[11px] text-slate-400">
          {% for _label, _href in control_breadcrumb %}
          <a href="{{ _href }}" class="shrink-0 hover:text-{{ _hue }}-700 hover:underline">{{ _label }}</a>
          <span class="shrink-0 text-slate-300">›</span>
          {% endfor %}
        </nav>
        {% endif %}
        <h1 class="flex items-center gap-2 text-sm font-semibold text-slate-700">
          <span class="truncate">{% block header_title %}{{ self.page_title() }}{% endblock %}</span>
          {% if _badge %}<span class="shrink-0 rounded bg-{{ _hue }}-100 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-{{ _hue }}-700">{{ _badge }}</span>{% endif %}
          {% if control_active_project %}
          <a href="{{ control_storefront_url or url('control:domains') }}"
             {% if control_storefront_url %}target="_blank" rel="noopener"{% endif %}
             title="{{ 'Open your storefront in a new tab' if control_storefront_url else 'Connect a domain to open your storefront' }}"
             class="shrink-0 inline-flex items-center gap-1 rounded-md bg-emerald-600 px-2 py-0.5 text-[11px] font-semibold text-white hover:bg-emerald-700">
            See your store
            <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M9 7h8v8"/></svg>
          </a>
          {% endif %}
          {% if control_demo_seeded %}
          <form method="post" action="{{ url('control:demo_remove') }}"
                onsubmit="return confirm('Delete all demo products, banners and pages? Anything you added stays.')"
                class="shrink-0 inline">
            {{ csrf_input }}
            <input type="hidden" name="next" value="{{ request.get_full_path() }}">
            <button class="rounded-md bg-red-600 px-2 py-0.5 text-[11px] font-semibold text-white hover:bg-red-700">
              Remove demo content
            </button>
          </form>
          {% endif %}
        </h1>
      </div>

      <div class="flex shrink-0 items-center gap-2 sm:gap-3">
        {# Platform staff need a way back out of a selected store — otherwise
           the session pick sticks forever and the platform-wide dashboard
           (affiliate stats, cross-store billing, etc.) becomes unreachable. #}
        {% if control_active_project and control_is_platform_staff %}
        <form method="post" action="{{ url('control:leave_store') }}" class="hidden sm:block">
          {{ csrf_input }}
          <button class="rounded-lg border border-slate-300 px-3 py-1 text-sm hover:bg-slate-50">Platform overview</button>
        </form>
        {% endif %}
        {# Store switcher — a dropdown for a handful of stores, a link once there are many #}
        {% if control_active_project %}
          {% if control_available_count and control_available_count <= 12 %}
          <form method="post" action="{{ url('control:set_project') }}" class="hidden sm:block">
            {{ csrf_input }}
            <input type="hidden" name="next" value="{{ request.get_full_path() }}">
            <select name="project" onchange="this.form.submit()"
                    class="rounded-lg border border-slate-300 px-2 py-1 text-sm">
              {% for p in control_available_projects %}
              <option value="{{ p.pk }}" {{ 'selected' if p.pk == control_active_project.pk }}>{{ p.name }}</option>
              {% endfor %}
            </select>
          </form>
          {% else %}
          <a href="{{ url('control:stores') }}" class="hidden rounded-lg border border-slate-300 px-3 py-1 text-sm hover:bg-slate-50 sm:block">
            {{ control_active_project.name }} · switch
          </a>
          {% endif %}
        {% elif control_is_platform_staff %}
          <a href="{{ url('control:stores') }}" class="rounded-lg border border-slate-300 px-3 py-1 text-sm hover:bg-slate-50">Choose a store</a>
        {% endif %}

        <div x-data="{ open: false }" class="relative">
          <button @click="open = !open" class="flex items-center gap-2 rounded-lg px-2 py-1 text-sm hover:bg-slate-100">
            <span class="grid h-7 w-7 place-items-center rounded-full bg-slate-900 text-xs text-white">
              {{ (request.user.get_username()[0] | upper) if request.user.is_authenticated else "?" }}
            </span>
            <span class="hidden sm:inline">{{ request.user.get_username() }}</span>
          </button>
          <div x-show="open" x-cloak @click.outside="open = false"
               class="absolute right-0 mt-2 w-40 rounded-lg border border-slate-200 bg-white py-1 text-sm shadow-lg">
            <form method="post" action="{{ url('accounts:logout') }}">
              {{ csrf_input }}
              <button type="submit" class="block w-full px-3 py-2 text-left hover:bg-slate-50">Sign out</button>
            </form>
          </div>
        </div>
      </div>
    </header>

    {% if request.session.get('impersonate_original_user_id') %}
    <div class="flex items-center justify-between bg-amber-100 px-4 py-2 text-sm text-amber-900">
      <span>Impersonating <strong>{{ request.user.get_username() }}</strong></span>
      <form method="post" action="{{ url('control:impersonate_stop') }}">
        {{ csrf_input }}
        <button class="rounded bg-amber-900 px-2 py-1 text-xs font-medium text-white">Stop</button>
      </form>
    </div>
    {% endif %}

    {% if control_demo_seeded %}
    <div class="flex flex-wrap items-center justify-between gap-2 bg-{{ _hue }}-100 px-4 py-2 text-sm text-{{ _hue }}-900">
      <span>This store is showing <strong>demo content</strong> — edit the sample
        products, banners and pages, then swap in your own images where you see
        the grey <span class="font-mono text-xs">1600×900</span> placeholders.</span>
    </div>
    {% endif %}

    {% if control_trial_days_left is not none %}
    <div class="flex flex-wrap items-center justify-between gap-2 bg-amber-100 px-4 py-2 text-sm text-amber-900">
      <span>
        {% if control_trial_days_left == 0 %}Your trial ends today.
        {% elif control_trial_days_left == 1 %}Your trial ends tomorrow.
        {% else %}Your trial ends in {{ control_trial_days_left }} days.{% endif %}
      </span>
      <a href="{{ url('control:store_plan') }}" class="rounded bg-amber-900 px-2 py-1 text-xs font-medium text-white hover:bg-amber-800">
        Upgrade now
      </a>
    </div>
    {% endif %}

    {% if control_needs_2fa_setup %}
    <div class="flex flex-wrap items-center justify-between gap-2 bg-blue-50 px-4 py-2 text-sm text-blue-900">
      <span>Secure your account — set up two-factor authentication before your next sign-in.</span>
      <a href="{{ url('accounts:2fa_setup') }}" class="rounded bg-blue-900 px-2 py-1 text-xs font-medium text-white hover:bg-blue-800">
        Set up now
      </a>
    </div>
    {% endif %}

    {% if control_host_project %}
    <div class="flex flex-wrap items-center justify-between gap-2 bg-amber-100 px-4 py-2 text-sm text-amber-900">
      <span>This domain is <strong>{{ control_host_project.name }}</strong>, but you're managing
        <strong>{{ control_active_project.name }}</strong>.</span>
      <form method="post" action="{{ url('control:store_switch', kwargs={'pk': control_host_project.pk}) }}">
        {{ csrf_input }}
        <input type="hidden" name="next" value="{{ request.get_full_path() }}">
        <button class="rounded bg-amber-900 px-2 py-1 text-xs font-medium text-white">Switch to {{ control_host_project.name }}</button>
      </form>
    </div>
    {% endif %}

    {% if messages %}
    <div class="space-y-1 px-4 pt-4 sm:px-6">
      {% for message in messages %}
      <div class="rounded-lg px-3 py-2 text-sm
                  {{ 'bg-emerald-50 text-emerald-800' if 'success' in message.tags
                     else 'bg-red-50 text-red-700' if 'error' in message.tags
                     else 'bg-amber-50 text-amber-800' if 'warning' in message.tags
                     else 'bg-slate-100 text-slate-700' }}">
        {{ message }}
      </div>
      {% endfor %}
    </div>
    {% endif %}

    <main class="flex-1 p-4 sm:p-6">
      {% block content %}{% endblock %}
    </main>
  </div>
</div>
<style>[x-cloak]{display:none!important}</style>

{% if control_tour_steps %}
<script src="{{ static('site/tour.js') }}"></script>
<div x-data="pageTour({{ control_tour_steps | tojson }})" x-show="active" x-cloak class="fixed inset-0 z-[80]">
  <div class="absolute rounded-lg transition-all duration-300"
       :style="rect ? `top:${rect.top-6}px;left:${rect.left-6}px;width:${rect.width+12}px;height:${rect.height+12}px;box-shadow:0 0 0 9999px rgba(15,23,42,.6);` : 'top:0;left:0;width:0;height:0;box-shadow:0 0 0 9999px rgba(15,23,42,.6);'"
       style="pointer-events:none"></div>
  <div class="absolute w-72 rounded-xl bg-white p-4 shadow-xl ring-1 ring-slate-200" :style="tooltipStyle()">
    <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-400" x-text="`Step ${i + 1} of ${steps.length}`"></p>
    <p class="mt-1 text-sm font-semibold text-slate-800" x-text="step.title"></p>
    <p class="mt-1 text-sm text-slate-600" x-text="step.text"></p>
    <div class="mt-3 flex items-center justify-between">
      <button type="button" @click="finish()" class="text-xs text-slate-400 hover:text-slate-600">Skip</button>
      <div class="flex gap-2">
        <button type="button" x-show="i > 0" @click="back()" class="rounded-lg border border-slate-300 px-3 py-1 text-xs text-slate-600 hover:bg-slate-50">Back</button>
        <button type="button" @click="next()" class="rounded-lg bg-slate-900 px-3 py-1 text-xs font-medium text-white hover:bg-slate-800"
                x-text="i === steps.length - 1 ? 'Done' : 'Next'"></button>
      </div>
    </div>
  </div>
</div>
{% endif %}
{% endblock %}
