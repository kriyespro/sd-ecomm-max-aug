{% extends "control/base_control.jinja" %}
{% from "control/_forms.jinja" import render_form %}
{% block page_title %}{{ "Edit product" if object else "New product" }}{% endblock %}

{% block content %}
<div class="mx-auto max-w-3xl space-y-4">
  <div class="flex flex-wrap items-center gap-2">
    <a href="{{ url('control:product_create') }}"
       class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
      + Add another product
    </a>
    {% if object %}
    <form method="post" action="{{ url('control:product_duplicate', kwargs={'pk': object.pk}) }}">
      {{ csrf_input }}
      <button class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
        Duplicate
      </button>
    </form>
    {% endif %}
    <a href="{{ url('control:product_list') }}" class="ml-auto text-sm text-slate-500 hover:text-slate-800">← All products</a>
  </div>

  {# AI "write it for me" assist — on hold, see navigation.py #}

  <form method="post" enctype="multipart/form-data" class="space-y-4">
    {{ csrf_input }}
    <div class="grid gap-4 rounded-xl bg-white p-6 ring-1 ring-slate-200 md:grid-cols-2">
      {{ render_form(form) }}
    </div>

    {% if size_color_enabled %}
      {% include "control/catalog/_size_color.jinja" %}
    {% endif %}

    {% if not object %}
    <div class="rounded-xl bg-white p-6 ring-1 ring-slate-200">
      <label for="id_images" class="block text-sm font-medium text-slate-700">Images</label>
      <input type="file" id="id_images" name="images" multiple accept="image/*"
             class="mt-1 block w-full text-sm text-slate-600 file:mr-3 file:rounded-md file:border-0 file:bg-slate-100 file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-slate-700 hover:file:bg-slate-200">
      <p class="mt-1 text-xs text-slate-400">Optional — attach photos now, or add them after saving.</p>
    </div>
    {% endif %}

    <p class="text-xs text-slate-400">
      Type, brand, category and tags are optional. Manage them under
      <a href="{{ url('control:product_type_list') }}" class="underline">Types</a>,
      <a href="{{ url('control:brand_list') }}" class="underline">Brands</a>,
      <a href="{{ url('control:category_list') }}" class="underline">Categories</a>,
      <a href="{{ url('control:tag_list') }}" class="underline">Tags</a>.
    </p>
    <div class="flex gap-2">
      <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">Save</button>
      <a href="{{ url('control:product_list') }}" class="rounded-lg px-4 py-2 text-sm text-slate-600 hover:bg-slate-100">Cancel</a>
      {% if object %}
      <a href="{{ url('control:product_delete', kwargs={'pk': object.pk}) }}" class="ml-auto rounded-lg px-4 py-2 text-sm text-red-600 hover:bg-red-50">Delete</a>
      {% endif %}
    </div>
  </form>

  {% if object %}
  {% include "control/catalog/_product_images.jinja" %}
  {% endif %}
</div>

<script>
function aiProductAssist() {
  return {
    brief: '', loading: false, error: '', modelUsed: '',
    async generate() {
      if (!this.brief.trim()) { this.error = 'Describe the product first.'; this.modelUsed = ''; return; }
      this.loading = true; this.error = ''; this.modelUsed = '';
      try {
        const m = document.cookie.match(/(?:^|;\s*)csrftoken=([^;]+)/);
        const res = await fetch("{{ url('control:product_ai_generate') }}", {
          method: 'POST',
          headers: {'Content-Type': 'application/json', 'X-CSRFToken': m ? decodeURIComponent(m[1]) : ''},
          body: JSON.stringify({brief: this.brief}),
        });
        let data;
        try {
          data = await res.json();
        } catch (parseErr) {
          // A gateway/proxy timeout or an unhandled 500 returns an HTML page,
          // not JSON — tell the merchant something more useful than "network error".
          this.error = res.status >= 500
            ? 'AI took too long to respond — try again.'
            : 'Unexpected response — try again.';
          return;
        }
        if (!res.ok) { this.error = data.error || 'AI is busy — try again.'; return; }
        const set = (id, val) => { const el = document.getElementById(id); if (el && val) el.value = val; };
        set('id_title', data.title);
        set('id_short_description', data.short_description);
        set('id_description', data.description);
        set('id_seo_title', data.seo_title);
        set('id_seo_description', data.seo_description);
        set('id_tags', data.tags);
        this.modelUsed = data.model || '';
      } catch (e) {
        this.error = 'Network error — try again.';
      } finally {
        this.loading = false;
      }
    },
  };
}
</script>
{% endblock %}
