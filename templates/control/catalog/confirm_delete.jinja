{% extends "control/base_control.jinja" %}
{% block page_title %}Delete{% endblock %}

{% block content %}
<div class="mx-auto max-w-md rounded-xl bg-white p-6 ring-1 ring-slate-200">
  {% if trash_days %}
  <h2 class="text-sm font-semibold text-slate-700">Move “{{ object }}” to Trash?</h2>
  <p class="mt-2 text-sm text-slate-500">It's hidden from your storefront right away. You can restore it from Trash for {{ trash_days }} days; after that it's deleted for good.</p>
  {% else %}
  <h2 class="text-sm font-semibold text-slate-700">Delete “{{ object }}”?</h2>
  <p class="mt-2 text-sm text-slate-500">This cannot be undone.</p>
  {% endif %}
  <form method="post" class="mt-5 flex gap-2">
    {{ csrf_input }}
    <button class="rounded-lg bg-red-600 px-3 py-2 text-sm font-medium text-white hover:bg-red-700">{{ 'Move to Trash' if trash_days else 'Delete' }}</button>
    <a href="{{ request.META.get('HTTP_REFERER', '/admin/') }}" class="rounded-lg px-3 py-2 text-sm text-slate-600 hover:bg-slate-100">Cancel</a>
  </form>
</div>
{% endblock %}
