{% extends "control/base_control.jinja" %}
{% from "control/_forms.jinja" import render_form %}
{% block page_title %}Import products{% endblock %}

{% block content %}
<div class="mx-auto max-w-3xl space-y-5">

  <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h2 class="text-sm font-semibold text-slate-700">Bulk import from a sheet</h2>
        <p class="mt-1 text-xs text-slate-500">
          One row per product. Upload a <strong>.csv</strong> (Google Sheets:
          File → Download → Comma-separated values) or an <strong>.xlsx</strong> file.
        </p>
      </div>
      <a href="{{ url('control:product_import_sample') }}"
         class="shrink-0 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
        ↓ Sample CSV
      </a>
    </div>

    <form method="post" enctype="multipart/form-data" class="mt-4 space-y-4">
      {{ csrf_input }}
      {{ render_form(form) }}
      <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">
        Import products
      </button>
    </form>
  </div>

  {% if errors %}
  <div class="rounded-xl border border-amber-300 bg-amber-50 p-5">
    <p class="text-sm font-semibold text-amber-800">
      {{ result.ok_rows }} row(s) imported · {{ errors | length }} skipped
    </p>
    <table class="mt-2 w-full text-left text-xs">
      <thead class="text-amber-700"><tr><th class="py-1 pr-3">Row</th><th class="py-1">Problem</th></tr></thead>
      <tbody class="divide-y divide-amber-200/70">
        {% for line, msg in errors %}
        <tr><td class="py-1 pr-3 font-mono">{{ line }}</td><td class="py-1 text-amber-900">{{ msg }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
    <h3 class="text-sm font-semibold text-slate-700">Columns</h3>
    <p class="mt-1 text-xs text-slate-500">
      Only <code class="rounded bg-slate-100 px-1">title</code> is required. Extra
      columns are ignored; missing ones are left unchanged on an update.
    </p>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full text-left text-xs">
        <tbody class="divide-y divide-slate-100">
          <tr><td class="py-1.5 pr-4 font-mono text-slate-700">title</td><td class="py-1.5 text-slate-500">Product name. Required.</td></tr>
          <tr><td class="py-1.5 pr-4 font-mono text-slate-700">sku</td><td class="py-1.5 text-slate-500">Match key for re-imports. Blank → auto-generated.</td></tr>
          <tr><td class="py-1.5 pr-4 font-mono text-slate-700">slug</td><td class="py-1.5 text-slate-500">URL slug. Blank → from the title.</td></tr>
          <tr><td class="py-1.5 pr-4 font-mono text-slate-700">status</td><td class="py-1.5 text-slate-500">active / draft / archived. Blank → the choice above.</td></tr>
          <tr><td class="py-1.5 pr-4 font-mono text-slate-700">price, sale_price, cost_price</td><td class="py-1.5 text-slate-500">Numbers, no currency symbol.</td></tr>
          <tr><td class="py-1.5 pr-4 font-mono text-slate-700">category, brand, type</td><td class="py-1.5 text-slate-500">By name — created automatically if new.</td></tr>
          <tr><td class="py-1.5 pr-4 font-mono text-slate-700">short_description, description</td><td class="py-1.5 text-slate-500">Plain text or simple HTML.</td></tr>
          <tr><td class="py-1.5 pr-4 font-mono text-slate-700">weight, length, width, height</td><td class="py-1.5 text-slate-500">Numbers (kg / cm).</td></tr>
          <tr><td class="py-1.5 pr-4 font-mono text-slate-700">barcode, hsn_sac, tax_class</td><td class="py-1.5 text-slate-500">Free text.</td></tr>
          <tr><td class="py-1.5 pr-4 font-mono text-slate-700">is_featured, is_new_arrival, is_bestseller, search_indexed</td><td class="py-1.5 text-slate-500">yes / no.</td></tr>
          <tr><td class="py-1.5 pr-4 font-mono text-slate-700">tags</td><td class="py-1.5 text-slate-500">Comma-separated inside the cell.</td></tr>
          <tr><td class="py-1.5 pr-4 font-mono text-slate-700">stock</td><td class="py-1.5 text-slate-500">Whole number — set at the default warehouse.</td></tr>
          <tr><td class="py-1.5 pr-4 font-mono text-slate-700">images</td><td class="py-1.5 text-slate-500">Media file names separated by <code class="rounded bg-slate-100 px-1">|</code>. Upload the photos under <a href="{{ url('control:media') }}" class="underline">Catalog → Media</a> first.</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="rounded-xl bg-slate-50 p-4 text-xs text-slate-500 ring-1 ring-slate-200">
    <p class="font-medium text-slate-600">How images work</p>
    <p class="mt-1">
      1. Go to <a href="{{ url('control:media') }}" class="underline">Catalog → Media</a> and
      upload all your product photos at once (drag a whole folder in).
      2. In the sheet's <code class="rounded bg-white px-1">images</code> column, list the
      exact file names, e.g. <code class="rounded bg-white px-1">shoe-1.jpg | shoe-2.jpg</code>.
      3. On import each file is copied onto the product; the first one becomes the primary image.
    </p>
  </div>
</div>
{% endblock %}
