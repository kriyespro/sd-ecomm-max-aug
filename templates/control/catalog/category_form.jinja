{% extends "control/base_control.jinja" %}
{% from "control/_forms.jinja" import render_field %}
{% from "control/_image_crop.jinja" import image_crop_field, image_crop_head, image_crop_scripts %}
{% block page_title %}{{ "Edit category" if object else "New category" }}{% endblock %}

{% block head %}{{ super() }}
{{ image_crop_head() }}
{% endblock %}

{% block content %}
<form method="post" enctype="multipart/form-data" class="mx-auto max-w-2xl space-y-4 rounded-xl bg-white p-6 ring-1 ring-slate-200">
  {{ csrf_input }}
  {% if form.non_field_errors() %}
  <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">{{ form.non_field_errors()|join(' ') }}</div>
  {% endif %}
  {% for field in form.visible_fields() %}
    {% if field.name == 'image' %}
    {{ image_crop_field(
         field, form.instance.image.url if form.instance.image else '',
         'Category image', 320, 213, initial_ratio=1.5,
         help_text='Shown as the tile on the home page — 3:2 shape (e.g. 900×600px). Crop/zoom to fit exactly.'
       ) }}
    {% else %}
    {{ render_field(field) }}
    {% endif %}
  {% endfor %}
  {% for field in form.hidden_fields() %}{{ field }}{% endfor %}
  <div class="flex gap-2 pt-2">
    <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">Save</button>
    <a href="{{ url('control:category_list') }}" class="rounded-lg px-4 py-2 text-sm text-slate-600 hover:bg-slate-100">Cancel</a>
  </div>
</form>

{{ image_crop_scripts() }}
{% endblock %}
