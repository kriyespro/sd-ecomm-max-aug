{# Visual "add an A record" guide for connecting a custom domain.
   Expects: platform_ip (str). Pure inline SVG — no assets, CSP-safe. #}
{% set _ip = platform_ip or '159.195.57.98' %}
<details class="rounded-xl bg-white p-5 ring-1 ring-slate-200" open>
  <summary class="cursor-pointer text-sm font-semibold text-slate-700">
    How to point your domain here (Cloudflare)
  </summary>

  <div class="mt-4 grid gap-5 md:grid-cols-2">
    <ol class="space-y-3 text-sm text-slate-600">
      <li><span class="font-semibold text-slate-800">1.</span> Sign in to Cloudflare, pick your domain, open <span class="font-medium">DNS&nbsp;→&nbsp;Records</span>.</li>
      <li><span class="font-semibold text-slate-800">2.</span> Click <span class="font-medium">Add record</span> and fill it in exactly as shown:</li>
      <li class="font-mono text-xs">
        <div>Type&nbsp;&nbsp;<span class="rounded bg-slate-100 px-1">A</span></div>
        <div class="mt-1">Name&nbsp;&nbsp;<span class="rounded bg-slate-100 px-1">@</span> <span class="font-sans text-slate-400">(root) or a subdomain like <span class="font-mono">shop</span></span></div>
        <div class="mt-1">IPv4&nbsp;&nbsp;<span class="rounded bg-slate-100 px-1">{{ _ip }}</span></div>
        <div class="mt-1">Proxy&nbsp;<span class="rounded bg-amber-100 px-1 text-amber-800">Proxied</span> <span class="font-sans text-slate-400">(orange cloud)</span></div>
      </li>
      <li><span class="font-semibold text-slate-800">3.</span> Save, then come back and click <span class="font-medium">Verify now</span> — or wait a few minutes and it verifies itself.</li>
      <li class="text-xs text-slate-400">Optional: add a second record — Type <span class="font-mono">CNAME</span>, Name <span class="font-mono">www</span>, Target your root domain, Proxied.</li>
    </ol>

    <svg viewBox="0 0 360 300" class="w-full rounded-lg border border-slate-200 bg-slate-50" role="img"
         aria-label="Cloudflare add DNS record form: Type A, Name @, IPv4 {{ _ip }}, Proxy proxied">
      <rect x="0" y="0" width="360" height="300" fill="#f8fafc"/>
      <!-- window chrome -->
      <rect x="16" y="16" width="328" height="268" rx="10" fill="#ffffff" stroke="#e2e8f0"/>
      <circle cx="34" cy="34" r="4" fill="#f87171"/><circle cx="48" cy="34" r="4" fill="#fbbf24"/><circle cx="62" cy="34" r="4" fill="#34d399"/>
      <text x="180" y="38" text-anchor="middle" font-family="ui-sans-serif,system-ui" font-size="11" fill="#94a3b8">Cloudflare · DNS · Add record</text>
      <line x1="16" y1="50" x2="344" y2="50" stroke="#e2e8f0"/>

      <!-- Type -->
      <text x="34" y="80" font-family="ui-sans-serif,system-ui" font-size="10" fill="#64748b">Type</text>
      <rect x="34" y="86" width="88" height="26" rx="6" fill="#ffffff" stroke="#cbd5e1"/>
      <text x="46" y="103" font-family="ui-monospace,monospace" font-size="12" fill="#0f172a">A</text>
      <path d="M104 96 l6 6 6 -6" fill="none" stroke="#94a3b8" stroke-width="1.5"/>

      <!-- Name -->
      <text x="136" y="80" font-family="ui-sans-serif,system-ui" font-size="10" fill="#64748b">Name (required)</text>
      <rect x="136" y="86" width="190" height="26" rx="6" fill="#ffffff" stroke="#cbd5e1"/>
      <text x="148" y="103" font-family="ui-monospace,monospace" font-size="12" fill="#0f172a">@</text>

      <!-- IPv4 -->
      <text x="34" y="140" font-family="ui-sans-serif,system-ui" font-size="10" fill="#64748b">IPv4 address (required)</text>
      <rect x="34" y="146" width="292" height="26" rx="6" fill="#ffffff" stroke="#6366f1"/>
      <text x="46" y="163" font-family="ui-monospace,monospace" font-size="12" fill="#0f172a">{{ _ip }}</text>

      <!-- Proxy status -->
      <text x="34" y="200" font-family="ui-sans-serif,system-ui" font-size="10" fill="#64748b">Proxy status</text>
      <rect x="34" y="208" width="46" height="24" rx="12" fill="#f59e0b"/>
      <circle cx="68" cy="220" r="9" fill="#ffffff"/>
      <text x="90" y="224" font-family="ui-sans-serif,system-ui" font-size="12" fill="#b45309" font-weight="600">Proxied</text>
      <!-- orange cloud -->
      <path d="M250 214 a10 10 0 0 1 19 -3 a8 8 0 0 1 6 15 h-22 a8 8 0 0 1 -3 -12 z" fill="#f59e0b"/>

      <!-- Save button -->
      <rect x="238" y="248" width="88" height="26" rx="6" fill="#0f172a"/>
      <text x="282" y="265" text-anchor="middle" font-family="ui-sans-serif,system-ui" font-size="11" fill="#ffffff">Save</text>
    </svg>
  </div>
</details>
