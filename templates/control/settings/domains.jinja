{% extends "control/base_control.jinja" %}
{% block page_title %}Domains{% endblock %}

{% block content %}
<div class="mx-auto max-w-3xl space-y-6">
  <div>
    <h2 class="text-sm font-semibold text-slate-700">Custom domains · {{ active_project.name }}</h2>
    <p class="mt-1 text-xs text-slate-500">
      Connect a hostname you own. It starts routing traffic to this store only after DNS verification.
    </p>
  </div>

  <form method="post" action="{{ url('control:domain_add') }}" class="flex gap-2 rounded-xl bg-white p-4 ring-1 ring-slate-200">
    {{ csrf_input }}
    <input name="host" required placeholder="shop.yourbrand.com"
           class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
    <button class="whitespace-nowrap rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">Add domain</button>
  </form>

  {% for d in domains %}
  <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="font-mono text-sm font-medium text-slate-800">{{ d.host }}</span>
        {% if d.is_primary %}<span class="rounded bg-slate-900 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-white">Primary</span>{% endif %}
        {% if d.is_verified %}
        <span class="rounded bg-emerald-100 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-emerald-700">Verified</span>
        {% else %}
        <span class="rounded bg-amber-100 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-amber-800">Pending</span>
        {% endif %}
      </div>
      <div class="flex items-center gap-2 text-xs">
        {% if not d.is_verified %}
        <form method="post" action="{{ url('control:domain_verify', kwargs={'pk': d.pk}) }}">
          {{ csrf_input }}<button class="rounded-lg bg-slate-900 px-3 py-1.5 font-medium text-white hover:bg-slate-800">Verify now</button>
        </form>
        {% elif not d.is_primary %}
        <form method="post" action="{{ url('control:domain_primary', kwargs={'pk': d.pk}) }}">
          {{ csrf_input }}<button class="rounded-lg border border-slate-300 px-3 py-1.5 hover:bg-slate-50">Make primary</button>
        </form>
        {% endif %}
        <form method="post" action="{{ url('control:domain_delete', kwargs={'pk': d.pk}) }}"
              onsubmit="return confirm('Remove {{ d.host }}?')">
          {{ csrf_input }}<button class="rounded-lg px-3 py-1.5 text-red-600 hover:bg-red-50">Remove</button>
        </form>
      </div>
    </div>

    {% if not d.is_verified %}
    <div class="mt-4 rounded-lg bg-slate-50 p-4 text-xs text-slate-600">
      <p class="font-semibold text-slate-700">1. Add this DNS record at your registrar:</p>
      <table class="mt-2 w-full text-left font-mono">
        <tr><td class="py-0.5 pr-4 text-slate-400">Type</td><td>TXT</td></tr>
        <tr><td class="py-0.5 pr-4 text-slate-400">Name / Host</td><td class="break-all">{{ d.txt_name }}</td></tr>
        <tr><td class="py-0.5 pr-4 text-slate-400">Value</td><td class="break-all">{{ d.txt_value }}</td></tr>
      </table>
      <p class="mt-3 font-semibold text-slate-700">2. Point the domain at the platform:</p>
      <table class="mt-2 w-full text-left font-mono">
        <tr><td class="py-0.5 pr-4 text-slate-400">Subdomain (shop.…)</td><td>CNAME → {{ app_host.split(':')[0] }}</td></tr>
        <tr><td class="py-0.5 pr-4 text-slate-400">Apex (brand.com)</td><td>A / ALIAS → platform IP</td></tr>
      </table>
      <p class="mt-3">3. Click <span class="font-medium">Verify now</span>. DNS can take a few minutes to propagate.</p>
      {% if d.last_check_error %}<p class="mt-2 text-amber-700">{{ d.last_check_error }}</p>{% endif %}
      {% if d.last_checked_at %}<p class="mt-1 text-slate-400">Last checked {{ d.last_checked_at.strftime('%d %b %H:%M') }}</p>{% endif %}
    </div>
    {% else %}
    <p class="mt-3 text-xs text-slate-400">{% if d.verified_at %}Verified {{ d.verified_at.strftime('%d %b %Y') }}. {% endif %}Live at https://{{ d.host }}/</p>
    {% endif %}
  </div>
  {% else %}
  <p class="rounded-xl bg-white p-8 text-center text-sm text-slate-400 ring-1 ring-slate-200">
    No custom domains yet. Your store is reachable at its platform address.
  </p>
  {% endfor %}
</div>
{% endblock %}
