{% extends "control/base_control.jinja" %}
{% block page_title %}Media{% endblock %}

{% block content %}
<div class="space-y-4">
  <form method="post" action="{{ url('control:media_upload') }}" enctype="multipart/form-data"
        class="space-y-3 rounded-xl bg-white p-4 ring-1 ring-slate-200">
    {{ csrf_input }}
    <div>
      <label class="block text-sm font-medium text-slate-700">Upload images</label>
      <input type="file" name="files" multiple accept="image/*,application/pdf"
             class="mt-1 block w-full text-sm text-slate-600 file:mr-3 file:rounded-md file:border-0 file:bg-slate-100 file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-slate-700 hover:file:bg-slate-200">
      <p class="mt-1 text-xs text-slate-400">Select many files at once — hold ⌘/Ctrl or Shift, or drag a folder in. Bulk-upload product photos here, then reference their file names in the product import sheet.</p>
    </div>
    <div class="flex flex-wrap items-end gap-3">
      <label class="text-xs text-slate-500">Folder
        <input name="folder" class="mt-1 block w-40 rounded-lg border border-slate-300 px-3 py-2 text-sm">
      </label>
      <label class="text-xs text-slate-500">Alt text (optional)
        <input name="alt" class="mt-1 block w-56 rounded-lg border border-slate-300 px-3 py-2 text-sm">
      </label>
      <button class="rounded-lg bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-800">Upload</button>
    </div>
  </form>

  <form method="get" class="flex items-center gap-2">
    <input type="search" name="q" value="{{ q }}" placeholder="Search filename…" class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm">
    <select name="kind" class="rounded-lg border border-slate-300 px-2 py-1.5 text-sm">
      <option value="">All types</option>
      {% for k in ["image", "video", "document", "other"] %}
      <option value="{{ k }}" {{ 'selected' if kind == k }}>{{ k }}</option>
      {% endfor %}
    </select>
    <button class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-50">Filter</button>
  </form>

  <div class="flex items-center gap-3 text-xs">
    <a href="{{ url('control:media') }}" class="{{ 'font-semibold text-slate-900' if not show_trash else 'text-slate-500 hover:text-slate-900' }}">Library</a>
    <a href="{{ url('control:media') }}?trash=1" class="{{ 'font-semibold text-slate-900' if show_trash else 'text-slate-500 hover:text-slate-900' }}">
      Trash{% if trash_count %} ({{ trash_count }}){% endif %}
    </a>
    {% if show_trash %}<span class="ml-auto text-slate-400">Deleted for good {{ trash_retention_days }} days after trashing.</span>{% endif %}
  </div>

  <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-6">
    {% for a in assets %}
    <div class="overflow-hidden rounded-xl bg-white ring-1 ring-slate-200">
      <div class="grid h-28 place-items-center bg-slate-50">
        {% if a.kind == 'image' %}
        <img src="{{ a.thumbnails.get('sm') or a.url }}" alt="{{ a.alt }}" class="h-full w-full object-cover">
        {% else %}
        <span class="text-3xl">📄</span>
        {% endif %}
      </div>
      <div class="p-2 text-xs">
        <p class="truncate font-medium text-slate-700" title="{{ a.original_name }}">{{ a.original_name }}</p>
        <p class="text-slate-400">{{ (a.size / 1024) | round(1) }} KB{% if a.width %} · {{ a.width }}×{{ a.height }}{% endif %}</p>
        <div class="mt-1 flex items-center justify-between">
          <a href="{{ a.url }}" target="_blank" class="text-slate-500 hover:underline">open</a>
          {% if show_trash %}
            {% if can_manage_trash %}
            <span class="flex gap-2">
              <form method="post" action="{{ url('control:media_restore', kwargs={'pk': a.pk}) }}">{{ csrf_input }}<button class="text-slate-600 hover:underline">restore</button></form>
              <form method="post" action="{{ url('control:media_purge', kwargs={'pk': a.pk}) }}" onsubmit="return confirm('Delete this file permanently?')">{{ csrf_input }}<button class="text-red-600 hover:underline">delete forever</button></form>
            </span>
            {% endif %}
          {% elif can_manage_trash %}
          <form method="post" action="{{ url('control:media_delete', kwargs={'pk': a.pk}) }}">
            {{ csrf_input }}
            <button class="text-red-600 hover:underline">trash</button>
          </form>
          {% endif %}
        </div>
      </div>
    </div>
    {% else %}
    <p class="col-span-full py-6 text-center text-sm text-slate-400">No media yet.</p>
    {% endfor %}
  </div>
</div>
{% endblock %}
