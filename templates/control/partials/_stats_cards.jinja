{% if control_is_platform_admin %}
{% set cards = [
  ("Total users", stats.total_users),
  ("Signups today", stats.signups_today),
  ("Active users (7d)", stats.active_users_7d),
  ("Projects", stats.total_projects),
  ("Active projects", stats.active_projects),
  ("Affiliate signups", stats.affiliate_signups),
] %}
{% else %}
{# DGC: platform-growth metrics (signups, affiliate totals) are the
   platform owner's concern, not theirs -- just their own store count and
   team activity, clearly labelled as "your"/"you manage" instead of the
   ambiguous platform-wide-sounding labels above. #}
{% set cards = [
  ("Stores you manage", stats.total_projects),
  ("Active stores", stats.active_projects),
  ("Team members", stats.total_users),
  ("Active team (7d)", stats.active_users_7d),
] %}
{% endif %}
<div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-6">
  {% for label, value in cards %}
  <div class="rounded-xl bg-white p-4 ring-1 ring-slate-200">
    <p class="text-xs font-medium uppercase tracking-wide text-slate-400">{{ label }}</p>
    <p class="mt-1 text-2xl font-semibold text-slate-900">{{ value }}</p>
  </div>
  {% endfor %}
</div>
