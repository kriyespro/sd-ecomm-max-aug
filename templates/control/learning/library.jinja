{% extends "control/base_control.jinja" %}
{% block page_title %}Training{% endblock %}

{% block content %}
<div class="space-y-10">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-sm font-semibold text-slate-700">Training</h2>
      <p class="text-xs text-slate-500">Short videos for your role. Tap one to play.</p>
    </div>
    {% if is_admin_editor %}
    <a href="{{ url('control:learning') }}" class="rounded-lg px-3 py-1.5 text-sm text-slate-600 hover:bg-slate-100">Manage videos</a>
    {% endif %}
  </div>

  {% for topic, videos in groups %}
  <section>
    <h3 class="mb-4 border-l-4 border-slate-800 pl-3 text-base font-semibold text-slate-800">
      {{ topic }}
    </h3>
    <div class="grid gap-5 md:grid-cols-2">
      {% for v in videos %}
      <div x-data="{ play: false }"
           class="overflow-hidden rounded-xl bg-white ring-1 ring-slate-200">
        <div class="relative aspect-video bg-slate-900">
          <template x-if="play">
            <iframe x-ref="frame"
                    class="absolute inset-0 h-full w-full"
                    src="{{ v.embed_url }}?autoplay=1&playsinline=1&rel=0&modestbranding=1&vq=hd1080&hd=1"
                    title="{{ v.title }}"
                    loading="lazy"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allow="autoplay; fullscreen; encrypted-media; picture-in-picture"
                    allowfullscreen></iframe>
          </template>

          <template x-if="!play">
            <button type="button" @click="play = true"
                    class="group absolute inset-0 h-full w-full cursor-pointer">
              {% if v.thumbnail_url %}
              <img src="{{ v.thumbnail_url }}" alt="" loading="lazy"
                   class="h-full w-full object-cover opacity-90 group-hover:opacity-100">
              {% endif %}
              <span class="absolute inset-0 grid place-items-center">
                <span class="grid h-14 w-14 place-items-center rounded-full bg-black/60 text-2xl text-white group-hover:bg-red-600">&#9654;</span>
              </span>
              {% if v.duration_label %}
              <span class="absolute bottom-2 right-2 rounded bg-black/75 px-1.5 py-0.5 text-[11px] text-white">{{ v.duration_label }}</span>
              {% endif %}
            </button>
          </template>
        </div>

        <div class="flex items-start justify-between gap-3 p-3">
          <div>
            <p class="text-sm font-medium text-slate-800">{{ v.title }}</p>
            {% if v.description %}<p class="mt-1 text-xs text-slate-500">{{ v.description }}</p>{% endif %}
          </div>
          <button type="button" x-show="play" x-cloak
                  @click="$refs.frame && $refs.frame.requestFullscreen && $refs.frame.requestFullscreen()"
                  class="shrink-0 rounded-lg border border-slate-300 px-2 py-1 text-xs text-slate-600 hover:bg-slate-50"
                  title="Fullscreen">&#9974; Fullscreen</button>
        </div>
      </div>
      {% endfor %}
    </div>
  </section>
  {% else %}
  <div class="rounded-xl bg-white p-10 text-center text-sm text-slate-400 ring-1 ring-slate-200">
    No training videos for your role yet.
  </div>
  {% endfor %}
</div>
{% endblock %}
