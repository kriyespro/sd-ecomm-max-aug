{% extends "control/base_control.jinja" %}
{% block page_title %}Skins{% endblock %}

{% block content %}
<div class="mx-auto max-w-4xl space-y-4">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h2 class="text-sm font-semibold text-slate-700">Storefront skins</h2>
      <p class="mt-1 text-xs text-slate-500">
        Built-in skins live in <code>templates/shopfront/skins/</code>. Uploaded
        skins run sandboxed and need review. Grant skins to stores under
        <a href="{{ url('control:store_skin_access') }}" class="underline">Store access</a>.
      </p>
    </div>
    <a href="{{ url('control:skin_create') }}" class="rounded-lg bg-slate-900 px-3 py-1.5 text-sm text-white hover:bg-slate-800">Register built-in</a>
  </div>

  <div class="overflow-hidden rounded-xl bg-white ring-1 ring-slate-200">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
        <tr>
          <th class="px-4 py-2">Skin</th>
          <th class="px-4 py-2">Kind</th>
          <th class="px-4 py-2">Status</th>
          <th class="px-4 py-2">Scope</th>
          <th class="px-4 py-2 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {% for s in skins %}
        <tr class="hover:bg-slate-50">
          <td class="px-4 py-3">
            <div class="font-medium text-slate-900">{{ s.label }}</div>
            <div class="font-mono text-xs text-slate-400">{{ s.slug }}</div>
          </td>
          <td class="px-4 py-3 text-xs">
            {% if s.source == 'upload' %}
            <span class="rounded bg-amber-100 px-1.5 py-0.5 font-semibold uppercase tracking-wide text-amber-800">Uploaded</span>
            {% else %}
            <span class="rounded bg-slate-100 px-1.5 py-0.5 font-semibold uppercase tracking-wide text-slate-500">Built-in</span>
            {% endif %}
          </td>
          <td class="px-4 py-3 text-xs">
            {% if s.is_default %}<span class="rounded bg-slate-900 px-1.5 py-0.5 font-semibold uppercase tracking-wide text-white">Default</span>{% endif %}
            {% if s.status == 'approved' and s.is_active %}
            <span class="rounded bg-emerald-100 px-1.5 py-0.5 font-semibold uppercase tracking-wide text-emerald-700">Live</span>
            {% elif s.status == 'pending' %}
            <span class="rounded bg-amber-100 px-1.5 py-0.5 font-semibold uppercase tracking-wide text-amber-800">Pending</span>
            {% elif s.status == 'rejected' %}
            <span class="rounded bg-red-100 px-1.5 py-0.5 font-semibold uppercase tracking-wide text-red-700">Rejected</span>
            {% else %}
            <span class="rounded bg-slate-100 px-1.5 py-0.5 font-semibold uppercase tracking-wide text-slate-500">Off</span>
            {% endif %}
          </td>
          <td class="px-4 py-3 text-xs text-slate-500">
            {{ s.project.name if s.project_id else "Shared" }}
          </td>
          <td class="px-4 py-3">
            <div class="flex flex-wrap items-center justify-end gap-2 text-xs">
              {% if s.source == 'upload' %}
              <a href="{{ url('control:skin_review', kwargs={'pk': s.pk}) }}" class="rounded-lg border border-slate-300 px-2.5 py-1 hover:bg-slate-50">Review</a>
                {% if s.status == 'approved' and s.project_id %}
                <form method="post" action="{{ url('control:skin_promote', kwargs={'pk': s.pk}) }}">
                  {{ csrf_input }}<button class="rounded-lg border border-slate-300 px-2.5 py-1 hover:bg-slate-50">Promote to shared</button>
                </form>
                {% endif %}
              {% else %}
              <a href="{{ url('control:skin_edit', kwargs={'pk': s.pk}) }}" class="text-slate-600 hover:underline">Edit</a>
              {% endif %}
              {% if not s.is_default %}
              <form method="post" action="{{ url('control:skin_toggle', kwargs={'pk': s.pk}) }}">
                {{ csrf_input }}<button class="rounded-lg border border-slate-300 px-2.5 py-1 hover:bg-slate-50">{{ 'Deactivate' if s.is_active else 'Activate' }}</button>
              </form>
                {% if s.is_active and s.status == 'approved' %}
                <form method="post" action="{{ url('control:skin_default', kwargs={'pk': s.pk}) }}">
                  {{ csrf_input }}<button class="rounded-lg border border-slate-300 px-2.5 py-1 hover:bg-slate-50">Make default</button>
                </form>
                {% endif %}
              {% endif %}
            </div>
          </td>
        </tr>
        {% else %}
        <tr><td colspan="5" class="px-4 py-6 text-center text-slate-400">No skins yet.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
