{% extends "control/base_control.jinja" %}
{% block page_title %}Analytics{% endblock %}

{% block content %}
{% set s = summary %}
<div class="space-y-5">
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {% for label, value in [
      ("Sales today", s.sales.today), ("This week", s.sales.week),
      ("This month", s.sales.month), ("All time", s.sales.total)] %}
    <div class="rounded-xl bg-white p-4 ring-1 ring-slate-200">
      <p class="text-xs text-slate-400">{{ label }}</p>
      <p class="mt-1 text-lg font-semibold text-slate-800">{{ active_project.currency }} {{ value }}</p>
    </div>
    {% endfor %}
  </div>

  <div class="grid gap-4 lg:grid-cols-3">
    <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
      <h3 class="text-sm font-semibold text-slate-700">Orders</h3>
      <p class="mt-1 text-xs text-slate-400">{{ s.sales.orders }} paid · AOV {{ active_project.currency }} {{ "%.2f"|format(s.sales.aov|float) }}</p>
      <ul class="mt-3 space-y-1 text-sm">
        {% for st, n in s.orders_by_status.items() %}
        <li class="flex justify-between"><span class="text-slate-500">{{ st }}</span><span class="font-medium">{{ n }}</span></li>
        {% endfor %}
      </ul>
    </div>

    <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
      <h3 class="text-sm font-semibold text-slate-700">Customers</h3>
      <ul class="mt-3 space-y-1 text-sm">
        {% for k, v in s.customers.items() %}
        <li class="flex justify-between"><span class="text-slate-500">{{ k }}</span><span class="font-medium">{{ v }}</span></li>
        {% endfor %}
      </ul>
    </div>

    <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
      <h3 class="text-sm font-semibold text-slate-700">Products</h3>
      <p class="mt-2 text-sm text-slate-500">Total {{ s.products.total }} · low stock {{ s.products.low_stock }} · out of stock {{ s.products.out_of_stock }}</p>
      <h4 class="mt-3 text-xs font-semibold uppercase tracking-wide text-slate-400">Best sellers</h4>
      <ol class="mt-1 list-decimal space-y-1 pl-5 text-sm">
        {% for p in s.products.best_sellers[:5] %}
        <li>{{ p.product_title }} <span class="text-slate-400">×{{ p.qty }}</span></li>
        {% else %}
        <li class="list-none text-slate-400">No sales yet.</li>
        {% endfor %}
      </ol>
    </div>
  </div>

  <div class="grid gap-4 lg:grid-cols-3">
    <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200 lg:col-span-2">
      <h3 class="text-sm font-semibold text-slate-700">Revenue — last 30 days</h3>
      {% if revenue_points %}
      <svg viewBox="0 0 300 100" preserveAspectRatio="none" class="mt-3 h-32 w-full">
        <polyline points="0,96 {{ revenue_points }} 300,96" fill="#0f172a0d" stroke="none"></polyline>
        <polyline points="{{ revenue_points }}" fill="none" stroke="#0f172a" stroke-width="1.5"
                   vector-effect="non-scaling-stroke"></polyline>
      </svg>
      <div class="mt-1 flex justify-between text-[10px] text-slate-400">
        <span>{{ s.revenue_series[0].date }}</span>
        <span>{{ s.revenue_series[-1].date }}</span>
      </div>
      {% else %}
      <p class="mt-3 text-sm text-slate-400">No revenue in range.</p>
      {% endif %}
    </div>

    <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
      <h3 class="text-sm font-semibold text-slate-700">Orders by status</h3>
      {% if status_donut %}
      <div class="mt-3 flex items-center gap-4">
        <svg viewBox="0 0 36 36" class="h-24 w-24 shrink-0 -rotate-90">
          <circle cx="18" cy="18" r="15.9155" fill="none" stroke="#f1f5f9" stroke-width="4"></circle>
          {% for seg in status_donut %}
          <circle cx="18" cy="18" r="15.9155" fill="none" stroke="{{ seg.color }}" stroke-width="4"
                  stroke-dasharray="{{ seg.dasharray }}" stroke-dashoffset="{{ seg.dashoffset }}"></circle>
          {% endfor %}
        </svg>
        <ul class="space-y-1 text-xs">
          {% for seg in status_donut %}
          <li class="flex items-center gap-1.5">
            <span class="h-2 w-2 shrink-0 rounded-full" style="background:{{ seg.color }}"></span>
            <span class="text-slate-500">{{ seg.status }}</span>
            <span class="font-medium text-slate-700">{{ seg.n }}</span>
          </li>
          {% endfor %}
        </ul>
      </div>
      {% else %}
      <p class="mt-3 text-sm text-slate-400">No orders yet.</p>
      {% endif %}
    </div>
  </div>

  <a href="{{ url('control:reports') }}" class="inline-block text-sm text-slate-600 hover:underline">Full reports + CSV export →</a>
</div>
{% endblock %}
