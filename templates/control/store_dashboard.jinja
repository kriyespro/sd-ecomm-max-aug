{% extends "control/base_control.jinja" %}
{% block page_title %}Today{% endblock %}

{% block content %}
{% set t = today %}
<div class="space-y-6">

  <div>
    <h1 class="text-xl font-semibold text-slate-900">{{ greeting }}, {{ request.user.first_name or request.user.get_username() }}</h1>
    <p class="mt-0.5 text-sm text-slate-500">Here's how <span class="font-medium text-slate-700">{{ active_project.name }}</span> is doing today.</p>
  </div>

  {% include "control/partials/_quick_launch.jinja" %}

  {# --- revenue chart + orders by status ------------------------------ #}
  <div class="grid gap-4 lg:grid-cols-3">
    <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200 lg:col-span-2">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold text-slate-700">📈 Revenue — last 30 days</h2>
        <a href="{{ url('control:analytics') }}" class="text-xs text-slate-500 hover:underline">Full analytics →</a>
      </div>
      {% if t.revenue_points %}
      <svg viewBox="0 0 300 100" preserveAspectRatio="none" class="mt-3 h-32 w-full">
        <polyline points="0,96 {{ t.revenue_points }} 300,96" fill="#0f172a0d" stroke="none"></polyline>
        <polyline points="{{ t.revenue_points }}" fill="none" stroke="#0f172a" stroke-width="1.5"
                   vector-effect="non-scaling-stroke"></polyline>
      </svg>
      <div class="mt-1 flex justify-between text-[10px] text-slate-400">
        <span>{{ t.revenue_series[0].date }}</span>
        <span>{{ t.revenue_series[-1].date }}</span>
      </div>
      {% else %}
      <p class="mt-3 text-sm text-slate-400">No revenue in range.</p>
      {% endif %}
    </div>

    <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
      <h2 class="text-sm font-semibold text-slate-700">🧾 Orders by status</h2>
      {% if t.status_donut %}
      <div class="mt-3 flex items-center gap-4">
        <svg viewBox="0 0 36 36" class="h-24 w-24 shrink-0 -rotate-90">
          <circle cx="18" cy="18" r="15.9155" fill="none" stroke="#f1f5f9" stroke-width="4"></circle>
          {% for seg in t.status_donut %}
          <circle cx="18" cy="18" r="15.9155" fill="none" stroke="{{ seg.color }}" stroke-width="4"
                  stroke-dasharray="{{ seg.dasharray }}" stroke-dashoffset="{{ seg.dashoffset }}"></circle>
          {% endfor %}
        </svg>
        <ul class="space-y-1 text-xs">
          {% for seg in t.status_donut %}
          <li class="flex items-center gap-1.5">
            <span class="h-2 w-2 shrink-0 rounded-full" style="background:{{ seg.color }}"></span>
            <span class="text-slate-500">{{ seg.status }}</span>
            <span class="font-medium text-slate-700">{{ seg.n }}</span>
          </li>
          {% endfor %}
        </ul>
      </div>
      {% else %}
      <p class="mt-3 text-sm text-slate-400">No orders yet.</p>
      {% endif %}
    </div>
  </div>

  {# --- top products viewed: today / this week / this month -----------
       The "what's getting looked at" complement to Best sellers ("what's
       getting bought") -- same beacon-driven idea as Live visitors, just a
       running total instead of a live snapshot. #}
  {% macro top_products_card(title, items) %}
  <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
    <h2 class="text-sm font-semibold text-slate-700">👀 {{ title }}</h2>
    {% if items %}
    {% set maxv = items[0].views %}
    <ul class="mt-3 space-y-2">
      {% for p in items %}
      <li>
        <div class="flex items-center justify-between gap-2 text-sm">
          <span class="truncate text-slate-700">{{ p.title }}</span>
          <span class="shrink-0 text-xs font-medium text-slate-500">{{ p.views }} view{{ '' if p.views == 1 else 's' }}</span>
        </div>
        <div class="mt-1 h-1.5 w-full rounded-full bg-slate-100">
          <div class="h-1.5 rounded-full bg-indigo-500" style="width: {{ ((p.views / (maxv or 1)) * 100) | round(1) }}%"></div>
        </div>
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="mt-3 text-sm text-slate-400">No product views recorded yet.</p>
    {% endif %}
  </div>
  {% endmacro %}
  <div class="grid gap-4 lg:grid-cols-3">
    {{ top_products_card("Top products — today", t.top_products_viewed) }}
    {{ top_products_card("Top products — this week", t.top_products_viewed_week) }}
    {{ top_products_card("Top products — this month", t.top_products_viewed_month) }}
  </div>

  {# --- today's numbers: a hero revenue figure + 3 secondary stats ----- #}
  <div data-tour="today-stats" class="grid gap-4 lg:grid-cols-4">
    <div class="rounded-2xl bg-gradient-to-br from-slate-900 to-slate-700 p-5 text-white shadow-md">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-300">💰 Sales today</p>
      <p class="mt-2 text-3xl font-bold tracking-tight">{{ active_project.currency }} {{ t.sales.today }}</p>
    </div>
    <div class="grid grid-cols-3 gap-4 lg:col-span-3">
      {% for label, value in [
        ("This week", t.sales.week), ("This month", t.sales.month), ("All time", t.sales.total)] %}
      <div class="flex flex-col justify-center rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200">
        <p class="text-xs font-medium text-slate-400">{{ label }}</p>
        <p class="mt-1 text-lg font-semibold text-slate-800">{{ active_project.currency }} {{ value }}</p>
      </div>
      {% endfor %}
    </div>
  </div>

  {# --- orders / customers / products (from the full Analytics report) #}
  <div class="grid gap-4 lg:grid-cols-3">
    <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
      <h2 class="text-sm font-semibold text-slate-700">🧾 Orders</h2>
      <p class="mt-1 text-xs text-slate-400">{{ t.sales.orders }} paid · AOV {{ active_project.currency }} {{ "%.2f"|format(t.sales.aov|float) }}</p>
      <ul class="mt-3 space-y-1 text-sm">
        {% for st, n in t.orders_by_status.items() %}
        <li class="flex justify-between"><span class="text-slate-500">{{ st }}</span><span class="font-medium">{{ n }}</span></li>
        {% endfor %}
      </ul>
    </div>

    <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
      <h2 class="text-sm font-semibold text-slate-700">👥 Customers</h2>
      <ul class="mt-3 space-y-1 text-sm">
        {% for label, value in [
          ("Total", t.customers.total), ("New", t.customers.new),
          ("Returning", t.customers.returning), ("VIP", t.customers.vip),
          ("High value", t.customers.high_value), ("Inactive", t.customers.inactive)] %}
        <li class="flex justify-between"><span class="text-slate-500">{{ label }}</span><span class="font-medium text-slate-700">{{ value }}</span></li>
        {% endfor %}
      </ul>
    </div>

    <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
      <h2 class="text-sm font-semibold text-slate-700">📦 Products</h2>
      <p class="mt-2 text-sm text-slate-500">Total {{ t.products.total }} · low stock {{ t.products.low_stock }} · out of stock {{ t.products.out_of_stock }}</p>
      <h3 class="mt-3 text-xs font-semibold uppercase tracking-wide text-slate-400">Best sellers</h3>
      <ol class="mt-1 list-decimal space-y-1 pl-5 text-sm">
        {% for p in t.products.best_sellers[:5] %}
        <li>{{ p.product_title }} <span class="text-slate-400">×{{ p.qty }}</span></li>
        {% else %}
        <li class="list-none text-slate-400">No sales yet.</li>
        {% endfor %}
      </ol>
    </div>
  </div>

  {# --- today's funnel / live visitors ---------------------------------- #}
  <div data-tour="today-funnel" class="grid gap-4 lg:grid-cols-2">
    <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold text-slate-700">🔻 Today's funnel</h2>
        <span class="text-xs font-medium text-slate-500">{{ t.funnel.conversion_rate }}% conversion</span>
      </div>
      <ol class="mt-3 space-y-1.5 text-sm">
        {% for label, value in [
          ("Visitors", t.funnel.visitors), ("Product views", t.funnel.product_views),
          ("Add to cart", t.funnel.add_to_cart), ("Checkout", t.funnel.checkout),
          ("Orders", t.funnel.orders)] %}
        <li class="flex items-center gap-2">
          {% if not loop.first %}<span class="w-4 shrink-0 text-center text-slate-300">↓</span>{% endif %}
          <span class="font-semibold text-slate-900">{{ value }}</span>
          <span class="text-slate-500">{{ label }}</span>
        </li>
        {% endfor %}
      </ol>
      <p class="mt-2 text-[11px] text-slate-400">{{ t.funnel.page_views }} page views today.</p>
    </div>

    <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
      <h2 class="text-sm font-semibold text-slate-700">🟢 Live visitors</h2>
      <div class="mt-3" id="live-visitors" hx-get="{{ url('control:live_visitors_partial') }}"
           hx-trigger="load" hx-swap="outerHTML">
        <p class="text-sm text-slate-400">Loading…</p>
      </div>
    </div>
  </div>

  {# --- traffic source: today / this week / this month ----------------- #}
  {% macro traffic_source_card(title, sources, empty_msg) %}
  <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
    <h2 class="text-sm font-semibold text-slate-700">🌐 {{ title }}</h2>
    <ul class="mt-3 space-y-1.5 text-sm">
      {% for src, n in sources.items() %}
      <li class="flex items-center justify-between">
        <span class="capitalize text-slate-500">{{ src }}</span>
        <span class="font-medium text-slate-700">{{ n }}</span>
      </li>
      {% else %}
      <li class="text-slate-400">{{ empty_msg }}</li>
      {% endfor %}
    </ul>
  </div>
  {% endmacro %}
  <div class="grid gap-4 lg:grid-cols-3">
    {{ traffic_source_card("Traffic source — today", t.funnel.traffic_sources, "No visits recorded yet today.") }}
    {{ traffic_source_card("Traffic source — this week", t.traffic_sources_week, "No visits recorded yet this week.") }}
    {{ traffic_source_card("Traffic source — this month", t.traffic_sources_month, "No visits recorded yet this month.") }}
  </div>

  <div class="grid gap-4 lg:grid-cols-3">
    {# --- needs attention ------------------------------------------- #}
    <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200 lg:col-span-2">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold text-slate-700">⚠️ Needs your attention</h2>
        {% if t.needs_action_count %}
        <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700">{{ t.needs_action_count }}</span>
        {% endif %}
      </div>
      <div class="mt-3 divide-y divide-slate-100">
        {% for o in t.needs_action %}
        <div class="flex items-center justify-between py-2 text-sm">
          <div>
            <a href="{{ url('control:order_detail', kwargs={'pk': o.pk}) }}" class="font-medium text-slate-900 hover:underline">{{ o.number }}</a>
            <span class="ml-2 text-xs text-slate-400">{{ o.get_fulfillment_status_display() }}</span>
          </div>
          <span class="font-medium text-slate-700">{{ o.currency }} {{ o.grand_total }}</span>
        </div>
        {% else %}
        <p class="py-4 text-sm text-slate-400">Nothing waiting on you — every paid order is packed or shipped.</p>
        {% endfor %}
      </div>
      {% if t.needs_action_count > t.needs_action|length %}
      <a href="{{ url('control:order_list') }}" class="mt-2 inline-block text-xs text-slate-500 hover:underline">
        View all {{ t.needs_action_count }} →
      </a>
      {% endif %}
    </div>

    {# --- low stock --------------------------------------------------- #}
    <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold text-slate-700">📦 Low stock</h2>
        {% if t.products.low_stock %}
        <span class="rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-700">{{ t.products.low_stock }}</span>
        {% endif %}
      </div>
      <ul class="mt-3 space-y-2 text-sm">
        {% for item in t.low_stock_items %}
        <li class="flex items-center justify-between">
          <span class="truncate pr-2 text-slate-700">{{ item.product.title }}{% if item.variant %} · {{ item.variant.name }}{% endif %}</span>
          <a href="{{ url('control:inventory_adjust', kwargs={'pk': item.pk}) }}" class="shrink-0 font-medium text-amber-700 hover:underline">{{ item.quantity - item.reserved }} left</a>
        </li>
        {% else %}
        <li class="text-slate-400">Stock levels look healthy.</li>
        {% endfor %}
      </ul>
      {% if t.products.low_stock %}
      <a href="{{ url('control:inventory_list') }}" class="mt-3 inline-block text-xs text-slate-500 hover:underline">View all →</a>
      {% endif %}
    </div>
  </div>

  <div class="grid gap-4 lg:grid-cols-3">
    {# --- recent orders ----------------------------------------------- #}
    <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200 lg:col-span-2">
      <h2 class="text-sm font-semibold text-slate-700">🧾 Recent orders</h2>
      <div class="mt-3 divide-y divide-slate-100">
        {% for o in t.recent_orders %}
        <div class="flex items-center justify-between py-2 text-sm">
          <div>
            <a href="{{ url('control:order_detail', kwargs={'pk': o.pk}) }}" class="font-medium text-slate-900 hover:underline">{{ o.number }}</a>
            <span class="ml-2 text-xs text-slate-400">{{ o.created_at.strftime('%d %b, %H:%M') }}</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="rounded px-2 py-0.5 text-xs bg-slate-100 text-slate-600">{{ o.get_status_display() }}</span>
            <span class="font-medium text-slate-700">{{ o.currency }} {{ o.grand_total }}</span>
          </div>
        </div>
        {% else %}
        <p class="py-4 text-sm text-slate-400">No orders yet.</p>
        {% endfor %}
      </div>
      <a href="{{ url('control:order_list') }}" class="mt-2 inline-block text-xs text-slate-500 hover:underline">All orders →</a>
    </div>

    {# --- best sellers -------------------------------------------------- #}
    <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
      <h2 class="text-sm font-semibold text-slate-700">🏆 Best sellers</h2>
      <p class="mt-1 text-xs text-slate-400">{{ t.products.total }} products · {{ t.products.out_of_stock }} out of stock</p>
      <ol class="mt-3 list-decimal space-y-1 pl-5 text-sm">
        {% for p in t.products.best_sellers[:6] %}
        <li>{{ p.product_title }} <span class="text-slate-400">×{{ p.qty }}</span></li>
        {% else %}
        <li class="list-none text-slate-400">No sales yet.</li>
        {% endfor %}
      </ol>
    </div>
  </div>

</div>
{% endblock %}
