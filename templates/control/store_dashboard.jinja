{% extends "control/base_control.jinja" %}
{% block page_title %}Today{% endblock %}

{% block content %}
{% set t = today %}
<div class="space-y-6">

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {% for label, value in [
      ("Sales today", t.sales.today), ("This week", t.sales.week),
      ("This month", t.sales.month), ("All time", t.sales.total)] %}
    <div class="rounded-xl bg-white p-4 ring-1 ring-slate-200">
      <p class="text-xs text-slate-400">{{ label }}</p>
      <p class="mt-1 text-lg font-semibold text-slate-800">{{ active_project.currency }} {{ value }}</p>
    </div>
    {% endfor %}
  </div>

  <div class="grid gap-4 lg:grid-cols-3">
    {# --- needs attention ------------------------------------------- #}
    <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200 lg:col-span-2">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold text-slate-700">Needs your attention</h2>
        {% if t.needs_action_count %}
        <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700">{{ t.needs_action_count }}</span>
        {% endif %}
      </div>
      <div class="mt-3 divide-y divide-slate-100">
        {% for o in t.needs_action %}
        <div class="flex items-center justify-between py-2 text-sm">
          <div>
            <a href="{{ url('control:order_detail', kwargs={'pk': o.pk}) }}" class="font-medium text-slate-900 hover:underline">{{ o.number }}</a>
            <span class="ml-2 text-xs text-slate-400">{{ o.get_fulfillment_status_display() }}</span>
          </div>
          <span class="font-medium text-slate-700">{{ o.currency }} {{ o.grand_total }}</span>
        </div>
        {% else %}
        <p class="py-4 text-sm text-slate-400">Nothing waiting on you — every paid order is packed or shipped.</p>
        {% endfor %}
      </div>
      {% if t.needs_action_count > t.needs_action|length %}
      <a href="{{ url('control:order_list') }}" class="mt-2 inline-block text-xs text-slate-500 hover:underline">
        View all {{ t.needs_action_count }} →
      </a>
      {% endif %}
    </div>

    {# --- low stock --------------------------------------------------- #}
    <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold text-slate-700">Low stock</h2>
        {% if t.products.low_stock %}
        <span class="rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-700">{{ t.products.low_stock }}</span>
        {% endif %}
      </div>
      <ul class="mt-3 space-y-2 text-sm">
        {% for item in t.low_stock_items %}
        <li class="flex items-center justify-between">
          <span class="truncate pr-2 text-slate-700">{{ item.product.title }}{% if item.variant %} · {{ item.variant.name }}{% endif %}</span>
          <a href="{{ url('control:inventory_adjust', kwargs={'pk': item.pk}) }}" class="shrink-0 font-medium text-amber-700 hover:underline">{{ item.quantity - item.reserved }} left</a>
        </li>
        {% else %}
        <li class="text-slate-400">Stock levels look healthy.</li>
        {% endfor %}
      </ul>
      {% if t.products.low_stock %}
      <a href="{{ url('control:inventory_list') }}" class="mt-3 inline-block text-xs text-slate-500 hover:underline">View all →</a>
      {% endif %}
    </div>
  </div>

  <div class="grid gap-4 lg:grid-cols-3">
    {# --- recent orders ----------------------------------------------- #}
    <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200 lg:col-span-2">
      <h2 class="text-sm font-semibold text-slate-700">Recent orders</h2>
      <div class="mt-3 divide-y divide-slate-100">
        {% for o in t.recent_orders %}
        <div class="flex items-center justify-between py-2 text-sm">
          <div>
            <a href="{{ url('control:order_detail', kwargs={'pk': o.pk}) }}" class="font-medium text-slate-900 hover:underline">{{ o.number }}</a>
            <span class="ml-2 text-xs text-slate-400">{{ o.created_at.strftime('%d %b, %H:%M') }}</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="rounded px-2 py-0.5 text-xs bg-slate-100 text-slate-600">{{ o.get_status_display() }}</span>
            <span class="font-medium text-slate-700">{{ o.currency }} {{ o.grand_total }}</span>
          </div>
        </div>
        {% else %}
        <p class="py-4 text-sm text-slate-400">No orders yet.</p>
        {% endfor %}
      </div>
      <a href="{{ url('control:order_list') }}" class="mt-2 inline-block text-xs text-slate-500 hover:underline">All orders →</a>
    </div>

    {# --- best sellers -------------------------------------------------- #}
    <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
      <h2 class="text-sm font-semibold text-slate-700">Best sellers</h2>
      <p class="mt-1 text-xs text-slate-400">{{ t.products.total }} products · {{ t.products.out_of_stock }} out of stock</p>
      <ol class="mt-3 list-decimal space-y-1 pl-5 text-sm">
        {% for p in t.products.best_sellers[:6] %}
        <li>{{ p.product_title }} <span class="text-slate-400">×{{ p.qty }}</span></li>
        {% else %}
        <li class="list-none text-slate-400">No sales yet.</li>
        {% endfor %}
      </ol>
    </div>
  </div>

  {# --- revenue trend ------------------------------------------------- #}
  <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
    <div class="flex items-center justify-between">
      <h2 class="text-sm font-semibold text-slate-700">Revenue — last 30 days</h2>
      <a href="{{ url('control:analytics') }}" class="text-xs text-slate-500 hover:underline">Full analytics →</a>
    </div>
    <div class="mt-3 flex items-end gap-1" style="height:100px">
      {% set maxrev = (t.revenue_series | map(attribute='revenue') | map('float') | list | max) if t.revenue_series else 1 %}
      {% for pt in t.revenue_series %}
      <div class="flex-1 rounded-t bg-slate-800"
           style="height: {{ ((pt.revenue|float / (maxrev or 1)) * 100) | round(1) }}%"
           title="{{ pt.date }}: {{ active_project.currency }} {{ pt.revenue }}"></div>
      {% else %}
      <p class="text-sm text-slate-400">No revenue in range.</p>
      {% endfor %}
    </div>
  </div>

</div>
{% endblock %}
