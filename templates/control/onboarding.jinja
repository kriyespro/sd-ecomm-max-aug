{% extends "control/base_control.jinja" %}
{% block page_title %}Set up your store{% endblock %}

{% block content %}
<div class="mx-auto max-w-xl space-y-6">
  <div>
    <h1 class="text-lg font-semibold text-slate-800">Welcome — let's set up {{ store.name }}</h1>
    <p class="mt-1 text-sm text-slate-500">
      Two quick things. Your storefront is already live with demo products you can edit right after.
    </p>
  </div>

  <form method="post" class="space-y-6">
    {{ csrf_input }}

    {% if form.non_field_errors() %}
    <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">{{ form.non_field_errors()|join(' ') }}</div>
    {% endif %}

    {# ---- 1. Contact ---- #}
    <div class="rounded-xl border border-slate-200 bg-white p-6">
      <h2 class="text-sm font-semibold text-slate-700">1 · Contact details</h2>
      <p class="mt-1 text-xs text-slate-400">Customers see these in your storefront footer and order emails.</p>
      <div class="mt-4 space-y-4">
        {% for field in [form.contact_email, form.contact_phone, form.address] %}
        <div>
          <label for="{{ field.id_for_label }}" class="block text-sm font-medium text-slate-700">
            {{ field.label }}{% if field.field.required %}<span class="text-red-500">*</span>{% endif %}
          </label>
          {{ field }}
          {% if field.help_text %}<p class="mt-1 text-xs text-slate-400">{{ field.help_text }}</p>{% endif %}
          {% for error in field.errors %}<p class="mt-1 text-xs text-red-600">{{ error }}</p>{% endfor %}
        </div>
        {% endfor %}
      </div>
    </div>

    {# ---- 2. Vertical ---- #}
    <div class="rounded-xl border border-slate-200 bg-white p-6">
      <h2 class="text-sm font-semibold text-slate-700">2 · {{ form.vertical.label }}</h2>
      <p class="mt-1 text-xs text-slate-400">
        Pick the closest fit. Clothing &amp; Fashion stores get a Size &amp; Colour builder on every product.
      </p>
      {% for error in form.vertical.errors %}<p class="mt-1 text-xs text-red-600">{{ error }}</p>{% endfor %}
      <div class="mt-4 grid gap-3 sm:grid-cols-2" x-data="{ v: '{{ form.vertical.value() or '' }}' }">
        {% for value, label in form.vertical.field.choices %}
        <label class="flex cursor-pointer items-start gap-3 rounded-lg border p-3 text-sm hover:border-slate-400"
               :class="v === '{{ value }}' ? 'border-slate-900 bg-slate-50' : 'border-slate-200'">
          <input type="radio" name="{{ form.vertical.html_name }}" value="{{ value }}" x-model="v"
                 class="mt-0.5 h-4 w-4 border-slate-300 text-slate-900 focus:ring-slate-400">
          <span class="font-medium text-slate-700">{{ label }}</span>
        </label>
        {% endfor %}
      </div>
    </div>

    <div class="flex items-center gap-3">
      <button class="rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-slate-800">
        Finish setup
      </button>
      <button form="onboarding-skip" class="text-sm text-slate-400 hover:text-slate-600">Skip for now</button>
    </div>
  </form>

  <form method="post" action="{{ url('control:onboarding_skip') }}" id="onboarding-skip">{{ csrf_input }}</form>
</div>
{% endblock %}
