{% extends "control/base_control.jinja" %}
{% block page_title %}Set up your store{% endblock %}

{% block content %}
<div class="mx-auto max-w-2xl space-y-4">
  <div>
    <h1 class="text-lg font-semibold text-slate-800">Welcome — let's set up {{ store.name }}</h1>
    <p class="mt-1 text-sm text-slate-500">
      One screen, one click. Your storefront is already live with demo products you can edit right after.
    </p>
  </div>

  <form method="post" class="space-y-4">
    {{ csrf_input }}

    {% if form.non_field_errors() %}
    <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">{{ form.non_field_errors()|join(' ') }}</div>
    {% endif %}

    <div class="rounded-xl border border-slate-200 bg-white p-4">
      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <label for="{{ form.store_name.id_for_label }}" class="block text-sm font-medium text-slate-700">
            {{ form.store_name.label }}<span class="text-red-500">*</span>
          </label>
          {{ form.store_name }}
          {% for error in form.store_name.errors %}<p class="mt-1 text-xs text-red-600">{{ error }}</p>{% endfor %}
        </div>

        {% if form.subdomain %}
        <div x-data="{ s: '{{ form.subdomain.value() or '' }}' }">
          <label for="{{ form.subdomain.id_for_label }}" class="block text-sm font-medium text-slate-700">Store web address</label>
          <div class="mt-1 flex items-stretch overflow-hidden rounded-lg border border-slate-300 focus-within:border-slate-500">
            <input id="{{ form.subdomain.id_for_label }}" name="{{ form.subdomain.html_name }}" x-model="s"
                   value="{{ form.subdomain.value() or '' }}"
                   @input="s = s.toLowerCase().replace(/[^a-z0-9-]/g,'')"
                   class="min-w-0 flex-1 bg-white px-3 py-2 text-sm outline-none"
                   autocapitalize="none" autocomplete="off" spellcheck="false">
            <span class="flex items-center bg-slate-50 px-3 text-sm text-slate-500">.{{ base_domain }}</span>
          </div>
          {% for error in form.subdomain.errors %}<p class="mt-1 text-xs text-red-600">{{ error }}</p>{% endfor %}
        </div>
        {% endif %}
      </div>

      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <div>
          <label for="{{ form.contact_email.id_for_label }}" class="block text-sm font-medium text-slate-700">
            {{ form.contact_email.label }}<span class="text-red-500">*</span>
          </label>
          {{ form.contact_email }}
          {% for error in form.contact_email.errors %}<p class="mt-1 text-xs text-red-600">{{ error }}</p>{% endfor %}
        </div>
        <div>
          <label for="{{ form.contact_phone.id_for_label }}" class="block text-sm font-medium text-slate-700">{{ form.contact_phone.label }}</label>
          {{ form.contact_phone }}
          {% for error in form.contact_phone.errors %}<p class="mt-1 text-xs text-red-600">{{ error }}</p>{% endfor %}
        </div>
      </div>
      <p class="mt-1 text-xs text-slate-400">Shown to customers in your storefront footer and on order emails.</p>

      <details class="mt-3 group">
        <summary class="cursor-pointer list-none text-xs font-medium text-slate-500 hover:text-slate-800">
          + Add street address (optional)
        </summary>
        <div class="mt-3 space-y-3">
          <div>
            <label for="{{ form.address.id_for_label }}" class="block text-sm font-medium text-slate-700">{{ form.address.label }}</label>
            {{ form.address }}
            {% for error in form.address.errors %}<p class="mt-1 text-xs text-red-600">{{ error }}</p>{% endfor %}
          </div>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            {% for field in [form.city, form.state, form.postal_code] %}
            <div>
              <label for="{{ field.id_for_label }}" class="block text-sm font-medium text-slate-700">{{ field.label }}</label>
              {{ field }}
              {% for error in field.errors %}<p class="mt-1 text-xs text-red-600">{{ error }}</p>{% endfor %}
            </div>
            {% endfor %}
          </div>
        </div>
      </details>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-4">
      <h2 class="text-sm font-semibold text-slate-700">{{ form.vertical.label }}</h2>
      {% for error in form.vertical.errors %}<p class="mt-1 text-xs text-red-600">{{ error }}</p>{% endfor %}
      <div class="mt-3 grid gap-2 sm:grid-cols-2" x-data="{ v: '{{ form.vertical.value() or '' }}' }">
        {% for value, label in form.vertical.field.choices %}
        <label class="flex cursor-pointer items-center gap-2 rounded-lg border p-2.5 text-sm hover:border-slate-400"
               :class="v === '{{ value }}' ? 'border-slate-900 bg-slate-50' : 'border-slate-200'">
          <input type="radio" name="{{ form.vertical.html_name }}" value="{{ value }}" x-model="v"
                 class="h-4 w-4 border-slate-300 text-slate-900 focus:ring-slate-400">
          <span class="font-medium text-slate-700">{{ label }}</span>
        </label>
        {% endfor %}
      </div>
      <p class="mt-2 text-xs text-slate-400">
        Clothing &amp; Fashion / Jewellery pick the size builder automatically for every product.
      </p>
    </div>

    <div class="flex items-center gap-3">
      <button class="rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-slate-800">
        Finish setup
      </button>
      <button form="onboarding-skip" class="text-sm text-slate-400 hover:text-slate-600">Skip for now</button>
    </div>
  </form>

  <form method="post" action="{{ url('control:onboarding_skip') }}" id="onboarding-skip">{{ csrf_input }}</form>
</div>
{% endblock %}
