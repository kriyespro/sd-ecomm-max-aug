{% extends "control/base_control.jinja" %}
{% block page_title %}Live stores{% endblock %}

{% block content %}
<div class="mb-4 flex flex-wrap items-center gap-2 text-sm">
  {% for key, label in [('', 'All'), ('pending', 'Pending'), ('approved', 'Approved'), ('rejected', 'Rejected')] %}
  <a href="{{ url('control:showcase_list') }}{% if key %}?status={{ key }}{% endif %}"
     class="rounded-lg px-3 py-1.5 font-medium ring-1 ring-inset
       {% if status == key %}bg-slate-900 text-white ring-slate-900{% else %}bg-white text-slate-600 ring-slate-200 hover:bg-slate-50{% endif %}">
    {{ label }}{% if key == 'pending' and pending_count %} ({{ pending_count }}){% endif %}
  </a>
  {% endfor %}
</div>

<div class="space-y-4">
  {% for p in projects %}
  <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="min-w-0">
        <p class="font-semibold text-slate-900">{{ p.name }}
          <span class="ml-2 rounded-full px-2 py-0.5 text-xs font-semibold
            {% if p.showcase_status == 'approved' %}bg-emerald-50 text-emerald-700
            {% elif p.showcase_status == 'rejected' %}bg-rose-50 text-rose-700
            {% else %}bg-amber-50 text-amber-700{% endif %}">{{ p.get_showcase_status_display() }}</span>
        </p>
        <p class="mt-0.5 text-sm text-slate-500">
          {% if p.public_url %}<a href="{{ p.public_url }}" target="_blank" rel="noopener" class="underline">{{ p.primary_domain }}</a>{% else %}no domain{% endif %}
        </p>
        <p class="mt-2 text-xs text-slate-400">
          Submitted {{ p.showcase_submitted_at.strftime('%d %b %Y') if p.showcase_submitted_at else '—' }}
          {% if p.showcase_reviewed_at %} · reviewed by {{ p.showcase_reviewed_by.email if p.showcase_reviewed_by else '—' }} on {{ p.showcase_reviewed_at.strftime('%d %b %Y') }}{% endif %}
        </p>
        {% if p.showcase_review_note %}
        <p class="mt-2 text-sm text-slate-700">Note: {{ p.showcase_review_note }}</p>
        {% endif %}
      </div>
      {% if p.showcase_status == 'pending' %}
      <div class="flex shrink-0 gap-2">
        <form method="post" action="{{ url('control:showcase_review', kwargs={'pk': p.pk}) }}">
          {{ csrf_input }}
          <input type="hidden" name="decision" value="approve">
          <button class="rounded-lg bg-emerald-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-emerald-500">Approve</button>
        </form>
        <form method="post" action="{{ url('control:showcase_review', kwargs={'pk': p.pk}) }}"
              onsubmit="return confirm('Reject this listing?')">
          {{ csrf_input }}
          <input type="hidden" name="decision" value="reject">
          <button class="rounded-lg bg-white px-3 py-1.5 text-sm font-medium text-rose-600 ring-1 ring-inset ring-rose-200 hover:bg-rose-50">Reject</button>
        </form>
      </div>
      {% endif %}
    </div>
  </div>
  {% else %}
  <div class="rounded-xl bg-white p-10 text-center text-sm text-slate-400 ring-1 ring-slate-200">
    No submissions{% if status %} with status "{{ status }}"{% endif %}.
  </div>
  {% endfor %}
</div>
{% endblock %}
