{% extends "control/base_control.jinja" %}
{% block page_title %}Live stores{% endblock %}

{% block content %}
<form method="post" action="{{ url('control:showcase_add') }}"
      class="mb-4 flex flex-wrap items-center gap-2 rounded-xl bg-white p-3 ring-1 ring-slate-200">
  {{ csrf_input }}
  <label class="text-sm font-medium text-slate-700">Add a store directly</label>
  <select name="project" required class="rounded-lg border border-slate-300 px-2 py-1.5 text-sm">
    <option value="">Choose a store…</option>
    {% for p in addable_projects %}
    <option value="{{ p.pk }}">{{ p.name }} ({{ p.primary_domain }})</option>
    {% endfor %}
  </select>
  <button class="rounded-lg bg-slate-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-800">Add to Live Stores</button>
  <p class="w-full text-xs text-slate-400">Skips owner submission — goes straight to Approved.</p>
</form>

<div class="mb-4 flex flex-wrap items-center gap-2 text-sm">
  {% for key, label in [('', 'All'), ('pending', 'Pending'), ('approved', 'Approved'), ('rejected', 'Rejected')] %}
  <a href="{{ url('control:showcase_list') }}{% if key %}?status={{ key }}{% endif %}"
     class="rounded-lg px-3 py-1.5 font-medium ring-1 ring-inset
       {% if status == key %}bg-slate-900 text-white ring-slate-900{% else %}bg-white text-slate-600 ring-slate-200 hover:bg-slate-50{% endif %}">
    {{ label }}{% if key == 'pending' and pending_count %} ({{ pending_count }}){% endif %}
  </a>
  {% endfor %}
</div>

<div class="overflow-x-auto rounded-xl bg-white ring-1 ring-slate-200">
  <table class="w-full text-left text-sm">
    <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
      <tr>
        <th class="px-4 py-2">Store</th>
        <th class="px-4 py-2">Status</th>
        <th class="px-4 py-2">Submitted</th>
        <th class="px-4 py-2">Reviewed</th>
        <th class="px-4 py-2 text-right">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      {% for p in projects %}
      <tr class="hover:bg-slate-50">
        <td class="px-4 py-2">
          <span class="font-medium text-slate-900">{{ p.name }}</span>
          <span class="block text-xs text-slate-400">
            {% if p.public_url %}<a href="{{ p.public_url }}" target="_blank" rel="noopener" class="hover:underline">{{ p.primary_domain }}</a>{% else %}no domain{% endif %}
          </span>
          {% if p.showcase_review_note %}<span class="block text-xs text-slate-500">Note: {{ p.showcase_review_note }}</span>{% endif %}
        </td>
        <td class="px-4 py-2">
          <span class="rounded-full px-2 py-0.5 text-xs font-semibold
            {% if p.showcase_status == 'approved' %}bg-emerald-50 text-emerald-700
            {% elif p.showcase_status == 'rejected' %}bg-rose-50 text-rose-700
            {% else %}bg-amber-50 text-amber-700{% endif %}">{{ p.get_showcase_status_display() }}</span>
        </td>
        <td class="px-4 py-2 text-slate-500">{{ p.showcase_submitted_at.strftime('%d %b %Y') if p.showcase_submitted_at else '—' }}</td>
        <td class="px-4 py-2 text-slate-500">
          {% if p.showcase_reviewed_at %}{{ p.showcase_reviewed_by.email if p.showcase_reviewed_by else '—' }}<br><span class="text-xs">{{ p.showcase_reviewed_at.strftime('%d %b %Y') }}</span>{% else %}—{% endif %}
        </td>
        <td class="px-4 py-2 text-right whitespace-nowrap">
          {% if p.showcase_status == 'pending' %}
          <form method="post" action="{{ url('control:showcase_review', kwargs={'pk': p.pk}) }}" class="inline">
            {{ csrf_input }}
            <input type="hidden" name="decision" value="approve">
            <button class="rounded-lg bg-emerald-600 px-2.5 py-1 text-xs font-medium text-white hover:bg-emerald-500">Approve</button>
          </form>
          <form method="post" action="{{ url('control:showcase_review', kwargs={'pk': p.pk}) }}" class="ml-1 inline"
                onsubmit="return confirm('Reject this listing?')">
            {{ csrf_input }}
            <input type="hidden" name="decision" value="reject">
            <button class="rounded-lg bg-white px-2.5 py-1 text-xs font-medium text-rose-600 ring-1 ring-inset ring-rose-200 hover:bg-rose-50">Reject</button>
          </form>
          {% elif p.showcase_status == 'approved' %}
          <form method="post" action="{{ url('control:showcase_remove', kwargs={'pk': p.pk}) }}" class="inline"
                onsubmit="return confirm('Remove {{ p.name }} from Live Stores?')">
            {{ csrf_input }}
            <button class="rounded-lg bg-white px-2.5 py-1 text-xs font-medium text-rose-600 ring-1 ring-inset ring-rose-200 hover:bg-rose-50">Remove</button>
          </form>
          {% endif %}
        </td>
      </tr>
      {% else %}
      <tr><td colspan="5" class="px-4 py-8 text-center text-sm text-slate-400">
        No submissions{% if status %} with status "{{ status }}"{% endif %}.
      </td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
