{% extends "control/base_control.jinja" %}
{% from "control/_forms.jinja" import render_form %}
{% block page_title %}{{ customer.full_name or customer.email }}{% endblock %}

{% block content %}
<div class="space-y-4">
  <a href="{{ url('control:customers') }}" class="text-sm text-slate-500 hover:underline">← Customers</a>

  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h2 class="text-lg font-semibold text-slate-800">{{ customer.full_name or customer.email }}</h2>
      <p class="text-sm text-slate-500">{{ customer.email }}{% if customer.phone %} · {{ customer.phone }}{% endif %} · {{ customer.get_segment_display() }}</p>
    </div>
    <div class="flex gap-2">
      <form method="post" action="{{ url('control:customer_resync', kwargs={'pk': customer.pk}) }}">
        {{ csrf_input }}
        <button class="rounded-lg px-3 py-1.5 text-sm text-slate-600 hover:bg-slate-100">Recalc stats</button>
      </form>
      {% if customer.is_blocked %}
      <form method="post" action="{{ url('control:customer_unblock', kwargs={'pk': customer.pk}) }}">
        {{ csrf_input }}<button class="rounded-lg bg-emerald-600 px-3 py-1.5 text-sm text-white hover:bg-emerald-700">Unblock</button>
      </form>
      {% else %}
      <form method="post" action="{{ url('control:customer_block', kwargs={'pk': customer.pk}) }}">
        {{ csrf_input }}<button class="rounded-lg bg-red-600 px-3 py-1.5 text-sm text-white hover:bg-red-700">Block</button>
      </form>
      {% endif %}
    </div>
  </div>

  <div class="grid gap-4 lg:grid-cols-3">
    <div class="lg:col-span-2 space-y-4">
      <div class="grid grid-cols-3 gap-2 sm:gap-4">
        <div class="rounded-xl bg-white p-3 text-center ring-1 ring-slate-200 sm:p-4">
          <p class="text-xs text-slate-400">Orders</p><p class="text-base font-semibold sm:text-lg">{{ customer.orders_count }}</p>
        </div>
        <div class="rounded-xl bg-white p-3 text-center ring-1 ring-slate-200 sm:p-4">
          <p class="text-xs text-slate-400">Total spent</p><p class="break-all text-base font-semibold sm:text-lg">{{ customer.total_spent }}</p>
        </div>
        <div class="rounded-xl bg-white p-3 text-center ring-1 ring-slate-200 sm:p-4">
          <p class="text-xs text-slate-400">Last order</p><p class="text-sm font-semibold">{{ customer.last_order_at.strftime("%b %d, %Y") if customer.last_order_at else "—" }}</p>
        </div>
      </div>

      <div class="overflow-x-auto rounded-xl bg-white ring-1 ring-slate-200">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
            <tr><th class="px-4 py-2">Order</th><th class="px-4 py-2">Date</th><th class="px-4 py-2">Status</th><th class="px-4 py-2">Payment</th><th class="px-4 py-2 text-right">Total</th></tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {% for o in orders %}
            <tr>
              <td class="px-4 py-2"><a href="{{ url('control:order_detail', kwargs={'pk': o.pk}) }}" class="font-medium text-slate-900 hover:underline">{{ o.number }}</a></td>
              <td class="px-4 py-2 text-slate-500">{{ (o.placed_at or o.created_at).strftime("%b %d") }}</td>
              <td class="px-4 py-2 text-slate-600">{{ o.get_status_display() }}</td>
              <td class="px-4 py-2 text-slate-600">{{ o.get_payment_status_display() }}</td>
              <td class="px-4 py-2 text-right font-medium">{{ o.currency }} {{ o.grand_total }}</td>
            </tr>
            {% else %}
            <tr><td colspan="5" class="px-4 py-6 text-center text-slate-400">No orders.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
        <h3 class="text-sm font-semibold text-slate-700">Addresses</h3>
        <div class="mt-2 grid gap-2 sm:grid-cols-2">
          {% for a in customer.addresses.all() %}
          <div class="rounded-lg border border-slate-200 p-3 text-sm text-slate-600">
            <p class="font-medium text-slate-700">{{ a.label or a.city }}</p>
            <p>{{ a.line1 }}{% if a.line2 %}, {{ a.line2 }}{% endif %}</p>
            <p>{{ a.city }}, {{ a.state }} {{ a.postal_code }} · {{ a.country }}</p>
          </div>
          {% else %}
          <p class="text-sm text-slate-400">No saved addresses.</p>
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="space-y-4">
      <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
        <h3 class="text-sm font-semibold text-slate-700">Profile &amp; notes</h3>
        <form method="post" action="{{ url('control:customer_edit', kwargs={'pk': customer.pk}) }}" class="mt-3 space-y-3">
          {{ csrf_input }}
          {{ render_form(form) }}
          <button class="w-full rounded-lg bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-800">Save</button>
        </form>
      </div>
      {% if customer.tags %}
      <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200 text-sm">
        <h3 class="font-semibold text-slate-700">Tags</h3>
        <p class="mt-1 text-slate-500">{{ customer.tags | join(', ') }}</p>
      </div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
