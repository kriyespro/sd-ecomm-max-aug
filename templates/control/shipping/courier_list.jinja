{% extends "control/base_control.jinja" %}
{% block page_title %}Courier accounts{% endblock %}

{% block content %}
<div class="space-y-4">
  <div class="flex items-center justify-between">
    <h2 class="text-sm font-semibold text-slate-700">Courier accounts · {{ active_project.name }}</h2>
    <a href="{{ url('control:courier_config_create') }}" class="rounded-lg bg-slate-900 px-3 py-1.5 text-sm text-white hover:bg-slate-800">Add courier</a>
  </div>

  <p class="text-xs text-slate-400">
    Add your own Shiprocket or Delhivery account here so shipments book automatically.
    Until you do, orders still ship fine — they just fall back to manual (you type the
    tracking number by hand on the order page).
  </p>

  <div class="overflow-x-auto rounded-xl bg-white ring-1 ring-slate-200">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
        <tr><th class="px-4 py-2">Courier</th>
          <th class="px-4 py-2">Enabled</th><th class="px-4 py-2">Mode</th>
          <th class="px-4 py-2"></th></tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {% for c in configs %}
        <tr class="hover:bg-slate-50">
          <td class="px-4 py-2 font-medium text-slate-800">{{ c.get_courier_display() }}</td>
          <td class="px-4 py-2">
            <span class="rounded px-2 py-0.5 text-xs {{ 'bg-emerald-100 text-emerald-700' if c.is_enabled else 'bg-slate-200 text-slate-600' }}">
              {{ "on" if c.is_enabled else "off" }}</span>
          </td>
          <td class="px-4 py-2 text-slate-500">{{ "test" if c.is_test_mode else "live" }}</td>
          <td class="px-4 py-2 text-right"><a href="{{ url('control:courier_config_edit', kwargs={'pk': c.pk}) }}" class="text-slate-600 hover:underline">Edit</a></td>
        </tr>
        {% else %}
        <tr><td colspan="4" class="px-4 py-6 text-center text-slate-400">No courier accounts yet — shipments use manual tracking until you add one.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
