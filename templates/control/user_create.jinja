{% extends "control/base_control.jinja" %}
{% from "control/_forms.jinja" import render_form %}
{% block page_title %}New user{% endblock %}

{% block content %}
<div class="max-w-lg space-y-4">
  <a href="{{ url('control:users') }}" class="text-sm text-slate-500 hover:underline">← Users</a>

  <form method="post" class="space-y-4 rounded-xl bg-white p-6 ring-1 ring-slate-200">
    {{ csrf_input }}
    <div>
      <h2 class="text-sm font-semibold text-slate-700">Create a user</h2>
      <p class="mt-1 text-xs text-slate-400">
        The user is not emailed — share the password with them directly. Add
        them to a store from that store’s page.
      </p>
    </div>
    {{ render_form(form) }}
    <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">
      Create user
    </button>
  </form>
</div>
{% endblock %}
