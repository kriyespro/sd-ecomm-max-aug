{% extends "control/base_control.jinja" %}
{% from "control/_forms.jinja" import render_field %}
{% from "control/_image_crop.jinja" import image_crop_field, image_crop_head, image_crop_scripts %}
{% block page_title %}Store profile{% endblock %}

{% block head %}{{ super() }}
{{ image_crop_head() }}
{% endblock %}

{% block content %}

{# ---- Demo content (top of page — quick access) ---- #}
<div class="mx-auto mb-6 max-w-2xl space-y-4">
  {% if control_demo_seeded %}
  <div class="rounded-xl border border-slate-200 bg-white p-6">
    <h2 class="text-sm font-semibold text-slate-700">Demo content</h2>
    <p class="mt-1 text-xs text-slate-500">
      This store is showing the sample catalogue. Removing it deletes only the
      seeded rows — anything you added stays.
    </p>
    <form method="post" action="{{ url('control:demo_remove') }}" class="mt-3"
          onsubmit="return confirm('Remove the demo products, banners and pages?')">
      {{ csrf_input }}
      <input type="hidden" name="next" value="{{ request.path }}">
      <button class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
        Remove demo content
      </button>
    </form>
  </div>
  {% endif %}

  <div class="rounded-xl border border-red-300 bg-red-50 p-6" x-data="{ c: '' }">
    <h2 class="text-sm font-semibold text-red-800">Reset store &amp; import demo content</h2>
    <p class="mt-1 text-xs leading-relaxed text-red-700">
      <strong>Permanently deletes</strong> every product, category, brand,
      banner, page, FAQ, menu, review and shopping cart in
      <strong>{{ active_project.name }}</strong>, then loads a fresh set of
      editable demo content. Orders, customers, coupons and settings are kept.
      This cannot be undone.
    </p>
    <form method="post" action="{{ url('control:demo_import') }}" class="mt-4 flex flex-wrap items-end gap-2"
          onsubmit="return this.confirm.value === 'DELETE'">
      {{ csrf_input }}
      <input type="hidden" name="next" value="{{ request.path }}">
      <label class="text-xs font-medium text-red-800">
        Type <span class="rounded bg-red-100 px-1 font-mono">DELETE</span> to confirm
        <input name="confirm" x-model="c" autocomplete="off" placeholder="DELETE"
               class="mt-1 block w-44 rounded-lg border border-red-300 bg-white px-3 py-2 text-sm outline-none focus:border-red-500">
      </label>
      <button type="submit" :disabled="c !== 'DELETE'"
              class="rounded-lg bg-red-700 px-4 py-2 text-sm font-medium text-white hover:bg-red-800 disabled:cursor-not-allowed disabled:opacity-40">
        Wipe &amp; import demo
      </button>
    </form>
  </div>
</div>

<form method="post" enctype="multipart/form-data" id="store-profile-form"
      class="mx-auto max-w-2xl space-y-4 rounded-xl bg-white p-6 ring-1 ring-slate-200">
  {{ csrf_input }}
  <div>
    <h2 class="text-sm font-semibold text-slate-700">Store profile · {{ active_project.name }}</h2>
    <p class="mt-1 text-xs text-slate-400">
      Logo, contact details and the address shown in your storefront footer.
    </p>
  </div>

  {% if form.non_field_errors() %}
  <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">{{ form.non_field_errors()|join(' ') }}</div>
  {% endif %}

  {# ---- Logo field with crop ---- #}
  {{ image_crop_field(
       form.logo,
       form.instance.logo.url if form.instance.logo else '',
       'Your logo', 320, 96,
       ratio_choices=[('Free', 'NaN', 'free'), ('1:1', '1', '1'), ('16:9', '1.7777', '16-9'), ('3:1', '3', '3'), ('4:1', '4', '4')],
       help_text='PNG or SVG with a transparent background works best. Raster images open a cropper; the final logo is stored at up to 512 px.'
     ) }}

  {# ---- Remaining fields ---- #}
  {% for field in form.visible_fields() %}
    {% if field.name != 'logo' %}{{ render_field(field) }}{% endif %}
  {% endfor %}
  {% for field in form.hidden_fields() %}{{ field }}{% endfor %}

  <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">
    Save store profile
  </button>
</form>

{{ image_crop_scripts() }}
{% endblock %}
