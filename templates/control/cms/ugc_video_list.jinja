{% extends "control/base_control.jinja" %}
{% block page_title %}Shorts / videos{% endblock %}

{% block content %}
<div class="rounded-xl bg-white ring-1 ring-slate-200">
  <div class="flex items-center justify-between border-b border-slate-200 p-4">
    <div>
      <h2 class="text-sm font-semibold text-slate-700">Shorts / videos · {{ active_project.name }}</h2>
      <p class="mt-1 text-xs text-slate-500">Short vertical videos shown in the storefront's "Shorts" reel — upload a clip or paste a YouTube link.</p>
    </div>
    <a href="{{ url('control:cms_ugc_video_create') }}" class="rounded-lg bg-slate-900 px-3 py-1.5 text-sm text-white hover:bg-slate-800">New video</a>
  </div>
  <div class="overflow-x-auto"><table class="w-full text-left text-sm min-w-[36rem]">
    <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
      <tr><th class="px-4 py-2"></th><th class="px-4 py-2">Caption</th><th class="px-4 py-2">Source</th><th class="px-4 py-2">Added by</th><th class="px-4 py-2">Active</th><th class="px-4 py-2 text-right">Actions</th></tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      {% for v in videos %}
      <tr class="hover:bg-slate-50">
        <td class="px-4 py-2">
          {% if v.thumbnail_url %}
          <img src="{{ v.thumbnail_url }}" alt="" class="h-10 w-8 rounded object-cover ring-1 ring-slate-200">
          {% else %}
          <div class="flex h-10 w-8 items-center justify-center rounded bg-slate-900 text-[10px] text-white">▶</div>
          {% endif %}
        </td>
        <td class="px-4 py-2"><a href="{{ url('control:cms_ugc_video_edit', kwargs={'pk': v.pk}) }}" class="font-medium text-slate-900 hover:underline">{{ v.caption or "(no caption)" }}</a></td>
        <td class="px-4 py-2 text-slate-500">{{ v.get_source_display() }}</td>
        <td class="px-4 py-2 text-slate-500">{{ v.added_by.email if v.added_by else "—" }}</td>
        <td class="px-4 py-2"><span class="rounded px-2 py-0.5 text-xs {{ 'bg-emerald-100 text-emerald-700' if v.is_active else 'bg-slate-200 text-slate-600' }}">{{ 'yes' if v.is_active else 'no' }}</span></td>
        <td class="px-4 py-2 text-right">
          <a href="{{ url('control:cms_ugc_video_edit', kwargs={'pk': v.pk}) }}" class="text-slate-600 hover:underline">Edit</a>
          <a href="{{ url('control:cms_ugc_video_delete', kwargs={'pk': v.pk}) }}" class="ml-2 text-red-600 hover:underline">Delete</a>
        </td>
      </tr>
      {% else %}
      <tr><td colspan="6" class="px-4 py-6 text-center text-slate-400">No videos yet.</td></tr>
      {% endfor %}
    </tbody>
  </table></div>
</div>
{% endblock %}
