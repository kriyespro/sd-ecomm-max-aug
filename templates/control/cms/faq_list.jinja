{% extends "control/base_control.jinja" %}
{% block page_title %}FAQs{% endblock %}

{% block content %}
<div class="rounded-xl bg-white ring-1 ring-slate-200">
  <div class="flex items-center justify-between border-b border-slate-200 p-4">
    <h2 class="text-sm font-semibold text-slate-700">FAQs · {{ active_project.name }}</h2>
    <a href="{{ url('control:cms_faq_create') }}" class="rounded-lg bg-slate-900 px-3 py-1.5 text-sm text-white hover:bg-slate-800">New FAQ</a>
  </div>
  <table class="w-full text-left text-sm">
    <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
      <tr><th class="px-4 py-2">Question</th><th class="px-4 py-2">Group</th><th class="px-4 py-2">Order</th><th class="px-4 py-2">Active</th><th class="px-4 py-2 text-right">Actions</th></tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      {% for f in faqs %}
      <tr class="hover:bg-slate-50">
        <td class="px-4 py-2"><a href="{{ url('control:cms_faq_edit', kwargs={'pk': f.pk}) }}" class="font-medium text-slate-900 hover:underline">{{ f.question }}</a></td>
        <td class="px-4 py-2 text-slate-500">{{ f.group or "—" }}</td>
        <td class="px-4 py-2 text-slate-500">{{ f.order }}</td>
        <td class="px-4 py-2 text-slate-500">{{ "yes" if f.is_active else "no" }}</td>
        <td class="px-4 py-2 text-right">
          <a href="{{ url('control:cms_faq_edit', kwargs={'pk': f.pk}) }}" class="text-slate-600 hover:underline">Edit</a>
          <a href="{{ url('control:cms_faq_delete', kwargs={'pk': f.pk}) }}" class="ml-2 text-red-600 hover:underline">Delete</a>
        </td>
      </tr>
      {% else %}
      <tr><td colspan="5" class="px-4 py-6 text-center text-slate-400">No FAQs.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
