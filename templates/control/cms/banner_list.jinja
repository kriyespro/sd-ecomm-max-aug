{% extends "control/base_control.jinja" %}
{% block page_title %}Banners{% endblock %}

{% block content %}
<div class="rounded-xl bg-white ring-1 ring-slate-200">
  <div class="flex items-center justify-between border-b border-slate-200 p-4">
    <h2 class="text-sm font-semibold text-slate-700">Banners · {{ active_project.name }}</h2>
    <a href="{{ url('control:cms_banner_create') }}" class="rounded-lg bg-slate-900 px-3 py-1.5 text-sm text-white hover:bg-slate-800">New banner</a>
  </div>
  <div class="overflow-x-auto"><table class="w-full text-left text-sm min-w-[36rem]">
    <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
      <tr><th class="px-4 py-2">Name</th><th class="px-4 py-2">Placement</th><th class="px-4 py-2">Window</th><th class="px-4 py-2">Live</th><th class="px-4 py-2 text-right">Actions</th></tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      {% for b in banners %}
      <tr class="hover:bg-slate-50">
        <td class="px-4 py-2"><a href="{{ url('control:cms_banner_edit', kwargs={'pk': b.pk}) }}" class="font-medium text-slate-900 hover:underline">{{ b.name }}</a></td>
        <td class="px-4 py-2 text-slate-500">{{ b.get_placement_display() }}</td>
        <td class="px-4 py-2 text-xs text-slate-400">{{ b.starts_at.strftime("%b %d") if b.starts_at else "—" }} → {{ b.ends_at.strftime("%b %d") if b.ends_at else "—" }}</td>
        <td class="px-4 py-2"><span class="rounded px-2 py-0.5 text-xs {{ 'bg-emerald-100 text-emerald-700' if b.is_live else 'bg-slate-200 text-slate-600' }}">{{ 'yes' if b.is_live else 'no' }}</span></td>
        <td class="px-4 py-2 text-right">
          <a href="{{ url('control:cms_banner_edit', kwargs={'pk': b.pk}) }}" class="text-slate-600 hover:underline">Edit</a>
          <a href="{{ url('control:cms_banner_delete', kwargs={'pk': b.pk}) }}" class="ml-2 text-red-600 hover:underline">Delete</a>
        </td>
      </tr>
      {% else %}
      <tr><td colspan="5" class="px-4 py-6 text-center text-slate-400">No banners.</td></tr>
      {% endfor %}
    </tbody>
  </table></div>
</div>
{% endblock %}
