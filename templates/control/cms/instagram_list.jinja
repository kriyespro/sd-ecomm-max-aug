{% extends "control/base_control.jinja" %}
{% from "control/_forms.jinja" import render_form %}
{% block page_title %}Instagram feed{% endblock %}

{% block content %}
<div class="space-y-4">
  <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
    <h2 class="text-sm font-semibold text-slate-700">Pull images from Instagram</h2>
    <p class="mt-1 text-xs text-slate-500">
      Paste public post URLs — one per line. We fetch each post's image and add it
      to the feed. Private posts and reels sometimes can't be read; upload those
      manually below. Nothing is auto-synced.
    </p>
    <form method="post" action="{{ url('control:cms_instagram_fetch') }}" class="mt-3 space-y-3">
      {{ csrf_input }}
      {{ render_form(fetch_form) }}
      <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">Fetch images</button>
    </form>
  </div>

  <div class="rounded-xl bg-white ring-1 ring-slate-200">
    <div class="flex items-center justify-between border-b border-slate-200 p-4">
      <h2 class="text-sm font-semibold text-slate-700">Feed · {{ items|length }} image(s)</h2>
      <a href="{{ url('control:cms_instagram_create') }}" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50">Upload manually</a>
    </div>
    <div class="grid grid-cols-3 gap-3 p-4 sm:grid-cols-5">
      {% for it in items %}
      <div class="overflow-hidden rounded-lg ring-1 ring-slate-200">
        <div class="aspect-square bg-slate-50">
          {% if it.image %}<img src="{{ it.image.url }}" alt="{{ it.caption }}" class="h-full w-full object-cover">{% endif %}
        </div>
        <div class="flex items-center justify-between p-2 text-xs">
          <span class="rounded px-1.5 py-0.5 {{ 'bg-emerald-100 text-emerald-700' if it.is_active else 'bg-slate-200 text-slate-600' }}">{{ 'live' if it.is_active else 'hidden' }}</span>
          <span>
            <a href="{{ url('control:cms_instagram_edit', kwargs={'pk': it.pk}) }}" class="text-slate-600 hover:underline">Edit</a>
            <a href="{{ url('control:cms_instagram_delete', kwargs={'pk': it.pk}) }}" class="ml-1 text-red-600 hover:underline">✕</a>
          </span>
        </div>
      </div>
      {% else %}
      <p class="col-span-full py-6 text-center text-sm text-slate-400">No images yet.</p>
      {% endfor %}
    </div>
  </div>
</div>
{% endblock %}
