{% extends "control/base_control.jinja" %}
{% block page_title %}Menus{% endblock %}

{% block content %}
<div class="rounded-xl bg-white ring-1 ring-slate-200">
  <div class="flex items-center justify-between border-b border-slate-200 p-4">
    <h2 class="text-sm font-semibold text-slate-700">Menus · {{ active_project.name }}</h2>
    <a href="{{ url('control:cms_menu_create') }}" class="rounded-lg bg-slate-900 px-3 py-1.5 text-sm text-white hover:bg-slate-800">New menu</a>
  </div>
  <div class="overflow-x-auto"><table class="w-full text-left text-sm min-w-[36rem]">
    <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
      <tr><th class="px-4 py-2">Name</th><th class="px-4 py-2">Location</th><th class="px-4 py-2">Items</th><th class="px-4 py-2">Active</th><th class="px-4 py-2 text-right">Actions</th></tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      {% for m in menus %}
      <tr class="hover:bg-slate-50">
        <td class="px-4 py-2"><a href="{{ url('control:cms_menu_detail', kwargs={'pk': m.pk}) }}" class="font-medium text-slate-900 hover:underline">{{ m.name }}</a></td>
        <td class="px-4 py-2 text-slate-500">{{ m.get_location_display() }}</td>
        <td class="px-4 py-2 text-slate-500">{{ m.item_count }}</td>
        <td class="px-4 py-2 text-slate-500">{{ "yes" if m.is_active else "no" }}</td>
        <td class="px-4 py-2 text-right">
          <a href="{{ url('control:cms_menu_detail', kwargs={'pk': m.pk}) }}" class="text-slate-600 hover:underline">Items</a>
          <a href="{{ url('control:cms_menu_edit', kwargs={'pk': m.pk}) }}" class="ml-2 text-slate-600 hover:underline">Edit</a>
          <a href="{{ url('control:cms_menu_delete', kwargs={'pk': m.pk}) }}" class="ml-2 text-red-600 hover:underline">Delete</a>
        </td>
      </tr>
      {% else %}
      <tr><td colspan="5" class="px-4 py-6 text-center text-slate-400">No menus.</td></tr>
      {% endfor %}
    </tbody>
  </table></div>
</div>
{% endblock %}
