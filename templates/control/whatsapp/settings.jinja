{% extends "control/base_control.jinja" %}
{% from "control/_forms.jinja" import render_form %}
{% block page_title %}WhatsApp{% endblock %}

{% block content %}
<div class="mx-auto max-w-2xl space-y-6">

  <div class="rounded-xl bg-white p-6 ring-1 ring-slate-200">
    <div class="flex items-center justify-between">
      <h2 class="text-sm font-semibold text-slate-700">WhatsApp · {{ active_project.name }}</h2>
      {% if account and account.is_active %}
      <span class="rounded bg-emerald-100 px-2 py-0.5 text-xs text-emerald-700">connected</span>
      {% elif account %}
      <span class="rounded bg-amber-100 px-2 py-0.5 text-xs text-amber-700">not verified</span>
      {% else %}
      <span class="rounded bg-slate-200 px-2 py-0.5 text-xs text-slate-600">off</span>
      {% endif %}
    </div>
    <p class="mt-1 text-xs text-slate-500">
      A free add-on: order confirmation / shipped / delivered messages go out over
      WhatsApp too, using templates you approve in your own Meta account. You run
      your own Meta app + WhatsApp Business number; Meta bills you directly.
    </p>
    {% if account and account.is_active %}
    <p class="mt-3 text-sm text-slate-700">
      <strong>{{ account.display_phone }}</strong>
      {% if account.verified_name %}· {{ account.verified_name }}{% endif %}
    </p>
    {% endif %}
    {% if account and account.last_error %}
    <p class="mt-2 rounded bg-red-50 px-3 py-2 text-xs text-red-700">{{ account.last_error }}</p>
    {% endif %}
  </div>

  <form method="post" class="space-y-4 rounded-xl bg-white p-6 ring-1 ring-slate-200">
    {{ csrf_input }}
    <h3 class="text-sm font-semibold text-slate-700">{{ "Update" if account else "Connect" }} credentials</h3>
    {{ render_form(form) }}
    <p class="text-xs text-slate-400">Saving re-checks the number with Meta.</p>
    <div class="flex gap-2 pt-1">
      <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">Save &amp; verify</button>
      {% if account %}
      <button formaction="{{ url('control:whatsapp_disconnect') }}" formnovalidate
              class="ml-auto rounded-lg px-4 py-2 text-sm text-red-600 hover:bg-red-50">Disconnect</button>
      {% endif %}
    </div>
  </form>

  {% if account %}
  <div class="rounded-xl bg-white p-6 ring-1 ring-slate-200 space-y-3">
    <h3 class="text-sm font-semibold text-slate-700">Webhook</h3>
    <p class="text-xs text-slate-500">
      In your Meta app → WhatsApp → Configuration, set the callback URL and verify
      token below, then subscribe to the <code>messages</code> field.
    </p>
    <dl class="space-y-2 text-sm">
      <div><dt class="text-xs uppercase text-slate-400">Callback URL</dt>
        <dd class="font-mono break-all text-slate-700">{{ webhook_url }}</dd></div>
      <div><dt class="text-xs uppercase text-slate-400">Verify token</dt>
        <dd class="font-mono break-all text-slate-700">{{ account.verify_token }}</dd></div>
    </dl>
  </div>

  <form method="post" action="{{ url('control:whatsapp_test') }}"
        class="flex flex-wrap items-end gap-2 rounded-xl bg-white p-6 ring-1 ring-slate-200">
    {{ csrf_input }}
    <div class="flex-1">
      <label class="block text-sm font-medium text-slate-700">Send a test</label>
      <p class="text-xs text-slate-400">Sends Meta's <code>hello_world</code> template.</p>
      <input name="to" placeholder="919876543210" required
             class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
    </div>
    <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">Send test</button>
  </form>

  <div class="rounded-xl bg-white ring-1 ring-slate-200">
    <div class="flex items-center justify-between px-4 py-3">
      <h3 class="text-sm font-semibold text-slate-700">Recent messages</h3>
      <a href="{{ url('control:notification_settings') }}" class="text-xs text-slate-500 hover:underline">Edit WhatsApp templates →</a>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
          <tr><th class="px-4 py-2">When</th><th class="px-4 py-2">To</th>
            <th class="px-4 py-2">Template</th><th class="px-4 py-2">Status</th></tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {% for m in messages_recent %}
          <tr>
            <td class="px-4 py-2 text-slate-500">{{ m.created_at.strftime('%d %b %H:%M') }}</td>
            <td class="px-4 py-2 font-mono text-slate-600">{{ m.to_number }}</td>
            <td class="px-4 py-2 text-slate-600">{{ m.template_name or m.kind }}</td>
            <td class="px-4 py-2">
              <span class="rounded px-2 py-0.5 text-xs {{ 'bg-red-100 text-red-700' if m.status == 'failed' else 'bg-slate-100 text-slate-600' }}">{{ m.status }}</span>
              {% if m.error %}<span class="ml-1 text-xs text-red-500">{{ m.error }}</span>{% endif %}
            </td>
          </tr>
          {% else %}
          <tr><td colspan="4" class="px-4 py-6 text-center text-slate-400">Nothing sent yet.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% endif %}

</div>
{% endblock %}
