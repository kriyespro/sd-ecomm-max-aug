{% extends "control/crm/base_crm.jinja" %}
{% block page_title %}Training{% endblock %}
{% block crm_title %}Training{% endblock %}
{% block crm_sub %}Add who you trained, ask for training, or confirm — the super admin assigns trainers.{% endblock %}
{% block crm_actions %}<button type="button" onclick="document.getElementById('newform').classList.toggle('hidden')" class="rounded-full bg-pink-600 px-3.5 py-1 text-[13px] font-medium text-white hover:bg-pink-700">＋ New entry</button>{% endblock %}

{% macro pill(t) %}
<span class="whitespace-nowrap rounded-full px-2 py-0.5 text-[11px] font-medium
  {{ {'requested': 'bg-sky-50 text-sky-700', 'assigned': 'bg-violet-50 text-violet-700', 'pending': 'bg-amber-50 text-amber-800', 'confirmed': 'bg-emerald-50 text-emerald-700', 'rejected': 'bg-rose-50 text-rose-700'}[t.status] }}">{{ t.get_status_display() }}</span>
{% endmacro %}

{% block crm_body %}
{% if waiting_for_me %}<div class="rounded-xl bg-violet-50 px-3 py-2 text-[13px] text-violet-800 ring-1 ring-violet-200">🧑‍🏫 {{ waiting_for_me }} {{ 'person is' if waiting_for_me == 1 else 'people are' }} waiting for you to train them — tap <b>Mark trained</b> when done.</div>{% endif %}
{% if to_confirm %}<div class="rounded-xl bg-amber-50 px-3 py-2 text-[13px] text-amber-800 ring-1 ring-amber-200">✅ {{ to_confirm }} training{{ '' if to_confirm == 1 else 's' }} waiting for <b>your</b> confirmation.</div>{% endif %}

<form id="newform" method="post" action="{{ url('control:crm_training_create') }}" class="cf hidden rounded-2xl bg-white px-3 py-3 shadow-sm ring-1 ring-pink-200"
      x-data="{ mode: '{{ 'request' if is_admin else 'trained_student' }}', student: '', forUser: '' }">
  {{ csrf_input }}
  <input type="hidden" name="mode" :value="mode">
  <div class="mb-3 flex flex-wrap gap-1.5 text-[12px]">
    {% for v, lab in [("trained_student", "🧑‍🏫 I trained someone"), ("trained_by", "🎓 I was trained by…"), ("request", "🙋 Wants training")] %}
    <button type="button" @click="mode = '{{ v }}'" :class="mode === '{{ v }}' ? 'bg-pink-600 text-white ring-pink-600' : 'bg-white text-pink-800 ring-pink-200 hover:bg-pink-50'" class="rounded-full px-3 py-1 font-medium ring-1">{{ lab }}</button>
    {% endfor %}
  </div>

  <div class="grid grid-cols-2 gap-x-2.5 gap-y-2 sm:grid-cols-4">
    {# I trained someone #}
    <div x-show="mode === 'trained_student'" data-field="student" class="space-y-1"><label class="block">Student</label>
      <select name="student" x-model="student" class="block w-full rounded-lg border border-slate-300 bg-white">
        <option value="">Choose…</option>
        {% for p in people %}<option value="{{ p.pk }}">{{ p.get_full_name() or p.email }}</option>{% endfor %}
        <option value="__new">➕ New person (no login yet)</option></select></div>
    {# I was trained by #}
    <div x-show="mode === 'trained_by'" x-cloak data-field="trainer" class="space-y-1"><label class="block">Trained by</label>
      <select name="trainer" class="block w-full rounded-lg border border-slate-300 bg-white">
        <option value="">Choose trainer…</option>
        {% for p in people %}<option value="{{ p.pk }}">{{ p.get_full_name() or p.email }}</option>{% endfor %}</select></div>
    {# wants training #}
    <div x-show="mode === 'request'" x-cloak data-field="for_user" class="space-y-1"><label class="block">Who needs training</label>
      <select name="for_user" x-model="forUser" class="block w-full rounded-lg border border-slate-300 bg-white">
        <option value="">Me</option>
        {% if is_admin %}{% for p in people %}<option value="{{ p.pk }}">{{ p.get_full_name() or p.email }}</option>{% endfor %}{% endif %}
        <option value="__new">➕ Someone new (no login yet)</option></select></div>

    {# new person (shared) #}
    <template x-if="(mode === 'trained_student' && student === '__new') || (mode === 'request' && forUser === '__new')">
      <div class="contents">
        <div data-field="student_name" class="space-y-1"><label class="block">Name</label><input name="student_name" maxlength="120" placeholder="Full name" class="block w-full rounded-lg border border-slate-300"></div>
        <div data-field="student_phone" class="space-y-1"><label class="block">Phone</label><input name="student_phone" maxlength="20" inputmode="tel" placeholder="Optional" class="block w-full rounded-lg border border-slate-300"></div>
      </div>
    </template>

    <div data-field="topic" class="space-y-1"><label class="block" x-text="mode === 'request' ? 'What training' : 'Topic'">Topic</label>
      <input name="topic" maxlength="160" placeholder="e.g. Store setup (optional)" class="block w-full rounded-lg border border-slate-300"></div>
    <div x-show="mode !== 'request'" data-field="trained_on" class="space-y-1"><label class="block">Date</label>
      <input type="date" name="trained_on" value="{{ today }}" class="block w-full rounded-lg border border-slate-300"></div>
  </div>
  <p class="mt-2 text-[11px] text-slate-500">
    <span x-show="mode === 'trained_student'">Your student confirms it. A new person has no login, so a platform admin verifies it.</span>
    <span x-show="mode === 'trained_by'" x-cloak>Your trainer gets a request to confirm.</span>
    <span x-show="mode === 'request'" x-cloak>The super admin assigns a trainer — nobody can self-claim. Only confirmed trainings count on the board.</span>
  </p>
  <div class="mt-3 flex items-center gap-2">
    <button class="rounded-lg bg-pink-600 px-4 py-1.5 text-[13px] font-medium text-white hover:bg-pink-700">Save</button>
    <button type="button" onclick="document.getElementById('newform').classList.add('hidden')" class="text-xs text-slate-500 hover:underline">Cancel</button>
  </div>
</form>

<div class="overflow-x-auto rounded-2xl bg-white shadow-sm ring-1 ring-pink-100">
  <table class="w-full text-left text-[13px]">
    <thead class="bg-pink-50/70 text-[11px] uppercase tracking-wide text-pink-500"><tr>
      <th class="px-3 py-2">Date</th><th class="px-3 py-2">Student</th><th class="px-3 py-2">Trainer</th>
      <th class="hidden px-3 py-2 sm:table-cell">Topic</th><th class="px-3 py-2">Status</th><th class="px-3 py-2"></th></tr></thead>
    <tbody class="divide-y divide-pink-50">
      {% for t in logs %}
      <tr class="hover:bg-pink-50/40">
        <td class="whitespace-nowrap px-3 py-1.5 text-slate-500">{{ t.trained_on }}</td>
        <td class="px-3 py-1.5 font-medium text-slate-800">{{ t.student_label }}{% if not t.trainee_id and t.student_phone %} <span class="text-[11px] font-normal text-slate-400">{{ t.student_phone }}</span>{% endif %}{% if not t.trainee_id %} <span class="rounded bg-slate-100 px-1 text-[10px] font-normal text-slate-500">no login</span>{% endif %}</td>
        <td class="px-3 py-1.5">{{ (t.trainer.get_full_name() or t.trainer.email) if t.trainer else '—' }}</td>
        <td class="hidden px-3 py-1.5 text-slate-500 sm:table-cell">{{ t.topic }}</td>
        <td class="px-3 py-1.5">{{ pill(t) }}</td>
        <td class="whitespace-nowrap px-3 py-1.5 text-right">
          {% if t.can_assign %}
          <form method="post" action="{{ url('control:crm_training_assign', kwargs={'pk': t.pk}) }}" class="inline-flex items-center gap-1">{{ csrf_input }}
            <select name="trainer" class="h-6 rounded-md border border-slate-200 py-0 pl-1.5 pr-6 text-[11px]">
              {% for p in people %}{% if p.pk != t.trainee_id %}<option value="{{ p.pk }}" {{ 'selected' if p.pk == t.trainer_id }}>{{ p.get_full_name() or p.email }}</option>{% endif %}{% endfor %}</select>
            <button class="h-6 rounded-md bg-pink-600 px-2 text-[11px] font-medium text-white hover:bg-pink-700">{{ 'Reassign' if t.trainer_id else 'Assign' }}</button></form>
          {% endif %}
          {% if t.can_mark %}
          <form method="post" action="{{ url('control:crm_training_trained', kwargs={'pk': t.pk}) }}" class="inline">{{ csrf_input }}
            <button class="rounded-md bg-violet-600 px-2 py-0.5 text-[11px] font-medium text-white hover:bg-violet-700">✔ Mark trained</button></form>
          {% endif %}
          {% if t.can_confirm %}
          <form method="post" action="{{ url('control:crm_training_respond', kwargs={'pk': t.pk}) }}" class="inline">{{ csrf_input }}
            <button name="action" value="confirm" class="text-[11px] font-medium text-emerald-700 hover:underline">Confirm</button>
            <button name="action" value="reject" class="ml-1.5 text-[11px] text-rose-600 hover:underline">Reject</button></form>
          {% endif %}
          {% if t.can_cancel %}
          <form method="post" action="{{ url('control:crm_training_cancel', kwargs={'pk': t.pk}) }}" class="ml-1.5 inline">{{ csrf_input }}
            <button class="text-[11px] text-slate-400 hover:text-rose-600 hover:underline" title="Cancel this request">✕</button></form>
          {% endif %}
        </td>
      </tr>
      {% else %}
      <tr><td colspan="6" class="px-4 py-6 text-center text-slate-400">No training logged yet — use “＋ New entry”.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
