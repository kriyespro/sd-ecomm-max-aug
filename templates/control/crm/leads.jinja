{% extends "control/crm/base_crm.jinja" %}
{% from "control/_forms.jinja" import render_form %}
{% from "control/crm/_crm.jinja" import empty, status_select %}
{% set _n = page_obj.paginator.count if page_obj else leads|length %}
{% block page_title %}Leads{% endblock %}
{% block crm_title %}Leads{% endblock %}
{% block crm_sub %}· {{ _n }} {{ 'archived ' if archived_view }}lead{{ 's' if _n != 1 }}{% if not is_admin %} assigned to you{% endif %}{% endblock %}
{% block crm_actions %}
<div class="inline-flex rounded-full bg-white p-0.5 ring-1 ring-pink-100">
  <a href="{{ url('control:crm_leads') }}?view=list" class="rounded-full bg-pink-600 px-3 py-1 text-xs font-medium text-white">☰ List</a>
  <a href="{{ url('control:crm_lead_board') }}" class="rounded-full px-3 py-1 text-xs font-medium text-pink-800 hover:bg-pink-50">▦ Board</a>
</div>
<button type="button" onclick="document.getElementById('addlead').classList.toggle('hidden')" class="rounded-full bg-pink-600 px-3.5 py-1 text-[13px] font-medium text-white hover:bg-pink-700">＋ Add lead</button>
{% endblock %}

{% block crm_body %}
<form id="addlead" method="post" action="{{ url('control:crm_lead_create') }}" class="hidden rounded-2xl bg-white px-3 py-3 shadow-sm ring-1 ring-pink-200">
  <style>
    #addlead [data-field] label{font-size:11px;font-weight:600;color:#9d174d;text-transform:uppercase;letter-spacing:.03em}
    #addlead input:not([type=checkbox]),#addlead select,#addlead textarea{margin-top:2px;padding:.3rem .5rem;font-size:13px}
    #addlead [data-field=notes]{grid-column:1/-1}
  </style>
  {{ csrf_input }}
  <div class="grid grid-cols-2 gap-x-2.5 gap-y-2 sm:grid-cols-3 lg:grid-cols-4">
    {{ render_form(form) }}
    {% if is_admin %}<div class="space-y-1" data-field="assigned_to"><label class="block">Assign to</label>
      <select name="assigned_to" class="block w-full rounded-lg border border-slate-300 bg-white"><option value="">Me</option>
        {% for p in people %}<option value="{{ p.pk }}">{{ p.get_full_name() or p.email }}</option>{% endfor %}</select></div>{% endif %}
  </div>
  <div class="mt-3 flex items-center gap-2">
    <button class="rounded-lg bg-pink-600 px-4 py-1.5 text-[13px] font-medium text-white hover:bg-pink-700">Save lead</button>
    <button type="button" onclick="document.getElementById('addlead').classList.add('hidden')" class="text-xs text-slate-500 hover:underline">Cancel</button>
  </div>
</form>

{# One-row filter toolbar #}
<form class="flex flex-wrap items-center gap-1 text-[11px] leading-none">
  <input name="q" value="{{ g.get('q','') }}" placeholder="🔍 Search name, phone, business" class="h-7 min-w-[9rem] flex-1 rounded-md border border-slate-200 px-2 py-0 text-[11px] focus:border-pink-400 focus:outline-none focus:ring-1 focus:ring-pink-400">
  <select name="status" class="h-7 rounded-md border border-slate-200 py-0 pl-1.5 pr-6 text-[11px]"><option value="">Any status</option>
    {% for v, l in statuses %}<option value="{{ v }}" {{ 'selected' if g.get('status') == v }}>{{ l }}</option>{% endfor %}</select>
  {% if is_admin %}<select name="assignee" class="h-7 rounded-md border border-slate-200 py-0 pl-1.5 pr-6 text-[11px]"><option value="">Anyone</option><option value="none" {{ 'selected' if g.get('assignee') == 'none' }}>Unassigned</option>
    {% for p in people %}<option value="{{ p.pk }}" {{ 'selected' if g.get('assignee') == p.pk|string }}>{{ p.get_full_name() or p.email }}</option>{% endfor %}</select>{% endif %}
  <label class="inline-flex h-7 items-center gap-1 rounded-md bg-white px-2 text-slate-600 ring-1 ring-slate-200"><input type="checkbox" name="due" value="1" class="h-3 w-3 rounded border-pink-300 text-pink-600" {{ 'checked' if g.get('due') }}> Due</label>
  <label class="inline-flex h-7 items-center gap-1 rounded-md bg-white px-2 text-slate-600 ring-1 ring-slate-200"><input type="checkbox" name="archived" value="1" class="h-3 w-3 rounded border-pink-300 text-pink-600" {{ 'checked' if g.get('archived') }}> 🗄 Archived</label>
  <button class="h-7 rounded-md bg-pink-50 px-2.5 text-[11px] font-medium text-pink-800 ring-1 ring-pink-200 hover:bg-pink-100">Filter</button>
  {% if g.get('q') or g.get('status') or g.get('assignee') or g.get('due') or g.get('archived') %}<a href="{{ url('control:crm_leads') }}" class="text-[11px] text-slate-500 underline">Clear</a>{% endif %}
</form>

{% if is_admin and unassigned_count and not archived_view %}
<form method="post" action="{{ url('control:crm_lead_distribute') }}" class="flex flex-wrap items-center gap-x-3 gap-y-1.5 rounded-xl bg-amber-50 px-3 py-2 text-[12px] ring-1 ring-amber-200">
  {{ csrf_input }}<input type="hidden" name="next" value="{{ request.get_full_path() }}">
  <span class="font-semibold text-amber-900">⚠ {{ unassigned_count }} unassigned</span>
  <span class="text-amber-800/80">share evenly between:</span>
  {% for p in dgcs %}
  <label class="inline-flex cursor-pointer items-center gap-1 rounded-full bg-white px-2.5 py-1 text-slate-700 ring-1 ring-amber-200"><input type="checkbox" name="assignees" value="{{ p.pk }}" checked class="h-3.5 w-3.5 rounded border-amber-300 text-pink-600"> {{ p.first_name or p.email }}</label>
  {% else %}<span class="text-amber-800">No DGCs yet.</span>{% endfor %}
  <button class="ml-auto rounded-lg bg-pink-600 px-3 py-1.5 font-medium text-white hover:bg-pink-700">Share {{ unassigned_count }} evenly</button>
</form>
{% endif %}

<form method="post" action="{{ url('control:crm_lead_assign') }}" x-data="{ n: 0 }"
      @change="n = $el.querySelectorAll('input[name=ids]:checked').length">
  {{ csrf_input }}
  <div class="overflow-x-auto rounded-2xl bg-white shadow-sm ring-1 ring-pink-100">
    <table class="w-full text-left text-[13px]">
      <thead class="bg-pink-50/70 text-[11px] uppercase tracking-wide text-pink-500"><tr>
        <th class="w-8 px-3 py-2"><input type="checkbox" title="Select all" class="rounded border-pink-300 text-pink-600"
          @change="$el.closest('table').querySelectorAll('input[name=ids]').forEach(c => c.checked = $el.checked); n = $el.checked ? $el.closest('table').querySelectorAll('input[name=ids]').length : 0"></th>
        <th class="px-3 py-2">Lead</th><th class="px-3 py-2">Status</th>
        {% if is_admin %}<th class="hidden px-3 py-2 sm:table-cell">Owner</th>{% endif %}
        <th class="hidden px-3 py-2 sm:table-cell">Follow-up</th><th class="px-3 py-2"></th></tr></thead>
      <tbody class="divide-y divide-pink-50">
        {% for l in leads %}
        {# Row itself stays plain — only the status badge is colored (see
           status_select's STATUS_COLOR); no row-wide tint, no reordering. #}
        <tr class="hover:bg-pink-50/40">
          <td class="px-3 py-1.5"><input type="checkbox" name="ids" value="{{ l.pk }}" class="rounded border-pink-300 text-pink-600"></td>
          <td class="px-3 py-1.5">
            <a class="hover:text-pink-700" href="{{ url('control:crm_lead', kwargs={'pk': l.pk}) }}">{{ l.name }}</a>
            <span class="hidden text-xs text-slate-400 sm:inline">{% if l.business %}· {{ l.business }}{% endif %}{% if l.city %} · {{ l.city }}{% endif %}{% if l.phone %} · {{ l.phone }}{% endif %}</span>
            <div class="text-[11px] text-slate-400 sm:hidden">{{ l.business or "" }}{% if l.business and l.city %} · {% endif %}{{ l.city or "" }}{% if l.phone %}{% if l.business or l.city %} · {% endif %}{{ l.phone }}{% endif %}
              {% if l.next_follow_up %}<span class="{{ 'font-medium text-rose-600' if l.next_follow_up <= today else 'text-amber-700' }}">⏰ {{ l.next_follow_up.strftime("%d %b") }}</span>{% endif %}</div>
          </td>
          <td class="px-3 py-1.5">{{ status_select(l) }}</td>
          {% if is_admin %}<td class="hidden px-3 py-1.5 text-slate-500 sm:table-cell">{{ (l.assigned_to.get_full_name() or l.assigned_to.email) if l.assigned_to else "—" }}</td>{% endif %}
          <td class="hidden whitespace-nowrap px-3 py-1.5 sm:table-cell {{ 'font-medium text-rose-600' if l.next_follow_up and l.next_follow_up <= today else 'text-slate-500' }}">{{ l.next_follow_up or "—" }}</td>
          <td class="whitespace-nowrap px-2 py-1.5 text-right sm:px-3">
            {% if l.phone %}<a href="tel:{{ l.phone }}" data-call-lead="{{ l.pk }}" data-call-name="{{ l.name }}" title="Call" class="inline-block rounded-full bg-pink-600 px-3.5 py-2 text-sm text-white hover:bg-pink-700 sm:px-2 sm:py-0.5 sm:text-xs">📞</a>
            <a href="https://wa.me/{{ l.wa_number }}" target="_blank" rel="noopener" title="WhatsApp" class="inline-block rounded-full bg-emerald-50 px-3.5 py-2 text-sm ring-1 ring-emerald-200 hover:bg-emerald-100 sm:px-2 sm:py-0.5 sm:text-xs">💬</a>{% endif %}</td>
        </tr>
        {% else %}
        <tr><td colspan="7" class="p-3">{{ empty("🗄" if archived_view else "📭", "Nothing archived." if archived_view else "No leads here yet.", "Archived leads show up here and can be restored." if archived_view else "Add one with the button above" ~ (" or import a CSV below." if is_admin else ", or ask the super admin to assign some to you.")) }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {# Floating bulk bar — only when something is ticked #}
  <input type="hidden" name="next" value="{{ request.get_full_path() }}">
  <div x-show="n > 0" x-cloak x-transition
       class="sticky bottom-3 z-10 mx-auto mt-3 flex w-fit max-w-full flex-wrap items-center gap-2 rounded-full bg-pink-900 py-1.5 pl-4 pr-1.5 text-[13px] text-white shadow-lg">
    <span><b x-text="n"></b> selected</span>
    {% if is_admin and not archived_view %}
    <span class="text-pink-300">→ give to</span>
    <select name="assignee" class="rounded-full border-0 bg-white py-1 pl-3 pr-8 text-[13px] text-slate-800 focus:ring-2 focus:ring-pink-300">
      {% for p in people %}<option value="{{ p.pk }}">{{ p.get_full_name() or p.email }}</option>{% endfor %}</select>
    <button class="rounded-full bg-pink-500 px-4 py-1 font-semibold text-white hover:bg-pink-400">Assign</button>
    <button formaction="{{ url('control:crm_lead_distribute') }}" title="Split the ticked leads evenly across all DGCs" class="rounded-full bg-white/15 px-3 py-1 font-semibold text-white ring-1 ring-white/30 hover:bg-white/25">⚖ Spread evenly</button>
    {% endif %}
    {% if not archived_view %}
    <span class="text-pink-300">· set status</span>
    <select name="status" class="rounded-full border-0 bg-white py-1 pl-3 pr-8 text-[13px] text-slate-800 focus:ring-2 focus:ring-pink-300">
      {% for v, lab in editable_statuses %}<option value="{{ v }}">{{ lab }}</option>{% endfor %}</select>
    <button formaction="{{ url('control:crm_lead_bulk_status') }}" class="rounded-full bg-pink-500 px-4 py-1 font-semibold text-white hover:bg-pink-400">Set</button>
    {% endif %}
    {% if archived_view %}
    <button formaction="{{ url('control:crm_lead_archive') }}" name="action" value="restore" class="rounded-full bg-emerald-500 px-4 py-1 font-semibold text-white hover:bg-emerald-400">↩ Restore</button>
    {% else %}
    <button formaction="{{ url('control:crm_lead_archive') }}" name="action" value="archive" class="rounded-full bg-white/15 px-4 py-1 font-semibold text-white ring-1 ring-white/30 hover:bg-white/25">🗄 Archive</button>
    {% endif %}
  </div>
</form>

<form id="import" method="post" action="{{ url('control:crm_lead_import') }}" enctype="multipart/form-data" class="flex flex-wrap items-center gap-2 rounded-xl border border-dashed border-pink-200 bg-pink-50/40 px-3 py-2 text-[13px]">
  {{ csrf_input }}<span class="font-medium text-pink-900">📥 Import CSV</span><span class="text-xs text-slate-500">columns: name, phone, business, city, source</span>
  <a href="{{ url('control:crm_lead_import_sample') }}" class="rounded-lg bg-white px-2.5 py-1 text-xs font-medium text-pink-800 ring-1 ring-pink-200 hover:bg-pink-50">⬇ Download sample CSV</a>
  <input type="file" name="file" accept=".csv" required class="text-xs">
  {% if is_admin %}<label class="inline-flex items-center gap-1 text-[11px] text-pink-900"><input type="checkbox" name="spread" value="1" class="h-3.5 w-3.5 rounded border-pink-300 text-pink-600"> Split evenly among all DGCs</label><select name="assignee" class="h-7 rounded-md border border-pink-200 bg-white py-0 pl-1.5 pr-6 text-[11px]"><option value="">or give all to…</option>{% for p in people %}<option value="{{ p.pk }}">{{ p.get_full_name() or p.email }}</option>{% endfor %}</select>{% else %}<span class="text-[11px] text-slate-500">added to your own list</span>{% endif %}
  <button class="rounded-lg bg-pink-600 px-3 py-1 font-medium text-white hover:bg-pink-700">Import</button>
</form>
{% if page_obj and page_obj.has_other_pages() %}<div class="flex gap-3 text-sm text-pink-700">{% if page_obj.has_previous() %}<a href="?{{ qs }}page={{ page_obj.previous_page_number() }}">← Prev</a>{% endif %}{% if page_obj.has_next() %}<a href="?{{ qs }}page={{ page_obj.next_page_number() }}">Next →</a>{% endif %}</div>{% endif %}


{% endblock %}
