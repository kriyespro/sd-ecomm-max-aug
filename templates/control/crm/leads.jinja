{% extends "control/crm/base_crm.jinja" %}
{% from "control/_forms.jinja" import render_form %}
{% from "control/crm/_crm.jinja" import empty %}
{% block page_title %}Leads{% endblock %}
{% block crm_title %}Leads{% endblock %}
{% block crm_sub %}{{ page_obj.paginator.count if page_obj else leads|length }} lead(s){% if not is_admin %} assigned to you{% endif %}{% endblock %}
{% block crm_actions %}<button type="button" onclick="document.getElementById('addlead').classList.toggle('hidden')" class="rounded-full bg-pink-600 px-4 py-1.5 text-sm font-medium text-white hover:bg-pink-700">＋ Add lead</button>{% endblock %}

{% block crm_body %}
<form id="addlead" method="post" action="{{ url('control:crm_lead_create') }}" class="hidden space-y-3 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-pink-200">
  {{ csrf_input }}{{ render_form(form) }}
  {% if is_admin %}<label class="block text-sm font-medium text-slate-700">Assign to
    <select name="assigned_to" class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">Me</option>
      {% for p in people %}<option value="{{ p.pk }}">{{ p.get_full_name() or p.email }}</option>{% endfor %}</select></label>{% endif %}
  <button class="rounded-xl bg-pink-600 px-4 py-2 text-sm font-medium text-white hover:bg-pink-700">Save lead</button>
</form>

<form class="flex flex-wrap items-center gap-2 text-sm">
  <input name="q" value="{{ g.get('q','') }}" placeholder="🔍 Name, phone, business" class="min-w-0 flex-1 rounded-xl border border-slate-200 px-3 py-2 focus:border-pink-400 focus:outline-none focus:ring-1 focus:ring-pink-400">
  <select name="status" class="rounded-xl border border-slate-200 px-2 py-2"><option value="">Any status</option>
    {% for v, l in statuses %}<option value="{{ v }}" {{ 'selected' if g.get('status') == v }}>{{ l }}</option>{% endfor %}</select>
  {% if is_admin %}<select name="assignee" class="rounded-xl border border-slate-200 px-2 py-2"><option value="">Anyone</option><option value="none" {{ 'selected' if g.get('assignee') == 'none' }}>Unassigned</option>
    {% for p in people %}<option value="{{ p.pk }}" {{ 'selected' if g.get('assignee') == p.pk|string }}>{{ p.get_full_name() or p.email }}</option>{% endfor %}</select>{% endif %}
  <label class="flex items-center gap-1 text-slate-600"><input type="checkbox" name="due" value="1" {{ 'checked' if g.get('due') }}> Due</label>
  <button class="rounded-xl bg-pink-50 px-4 py-2 font-medium text-pink-800 ring-1 ring-pink-200 hover:bg-pink-100">Filter</button>
</form>

<form method="post" action="{{ url('control:crm_lead_assign') }}">
  {{ csrf_input }}<input type="hidden" name="next" value="{{ request.get_full_path() }}">
  {% if is_admin and leads %}
  <div class="mb-2 flex flex-wrap items-center gap-2 rounded-xl bg-pink-50 p-2 text-sm">
    <span class="text-pink-800">Give ticked leads to</span>
    <select name="assignee" class="rounded-lg border border-pink-200 bg-white px-2 py-1">{% for p in people %}<option value="{{ p.pk }}">{{ p.get_full_name() or p.email }}</option>{% endfor %}</select>
    <button class="rounded-lg bg-pink-600 px-3 py-1 font-medium text-white hover:bg-pink-700">Assign</button>
  </div>{% endif %}
  <div class="overflow-x-auto rounded-2xl bg-white shadow-sm ring-1 ring-pink-100">
    <table class="w-full text-left text-sm">
      <thead class="bg-pink-50/70 text-xs uppercase tracking-wide text-pink-500"><tr>
        {% if is_admin %}<th class="px-3 py-3"></th>{% endif %}<th class="px-3 py-3">Lead</th>
        <th class="px-3 py-3">Status</th>{% if is_admin %}<th class="px-3 py-3">Owner</th>{% endif %}<th class="px-3 py-3">Follow-up</th><th class="px-3 py-3"></th></tr></thead>
      <tbody class="divide-y divide-pink-50">
        {% for l in leads %}
        <tr class="hover:bg-pink-50/40">
          {% if is_admin %}<td class="px-3 py-3"><input type="checkbox" name="ids" value="{{ l.pk }}" class="rounded border-pink-300 text-pink-600"></td>{% endif %}
          <td class="px-3 py-3"><a class="font-medium text-slate-800 hover:text-pink-700" href="{{ url('control:crm_lead', kwargs={'pk': l.pk}) }}">{{ l.name }}</a>
            <div class="text-xs text-slate-400">{{ l.business }}{% if l.city %} · {{ l.city }}{% endif %}</div></td>
          <td class="px-3 py-3"><span class="rounded-full bg-pink-50 px-2.5 py-0.5 text-xs text-pink-800">{{ l.get_status_display() }}</span></td>
          {% if is_admin %}<td class="px-3 py-3 text-slate-500">{{ l.assigned_to.get_full_name() or l.assigned_to.email if l.assigned_to else "—" }}</td>{% endif %}
          <td class="px-3 py-3 {{ 'text-rose-600 font-medium' if l.next_follow_up and l.next_follow_up <= today else 'text-slate-500' }}">{{ l.next_follow_up or "—" }}</td>
          <td class="px-3 py-3 text-right whitespace-nowrap">
            {% if l.phone %}<a href="tel:{{ l.phone }}" title="Call" class="rounded-full bg-pink-600 px-2.5 py-1 text-xs text-white hover:bg-pink-700">📞</a>
            <a href="https://wa.me/{{ l.wa_number }}" target="_blank" rel="noopener" title="WhatsApp" class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs ring-1 ring-emerald-200 hover:bg-emerald-100">💬</a>{% endif %}</td>
        </tr>
        {% else %}
        <tr><td colspan="6" class="p-4">{{ empty("📭", "No leads here yet.", "Add one with the button above" ~ (" or import a CSV below." if is_admin else ", or ask the super admin to assign some to you.")) }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</form>

{% if is_admin %}
<form method="post" action="{{ url('control:crm_lead_import') }}" enctype="multipart/form-data" class="flex flex-wrap items-center gap-2 rounded-2xl border border-dashed border-pink-200 bg-pink-50/40 p-4 text-sm">
  {{ csrf_input }}<span class="font-medium text-pink-900">📥 Import CSV</span><span class="text-xs text-slate-500">name, phone, business, city, source</span>
  <input type="file" name="file" accept=".csv" required class="text-xs">
  <select name="assignee" class="rounded-lg border border-pink-200 bg-white px-2 py-1"><option value="">Unassigned</option>{% for p in people %}<option value="{{ p.pk }}">{{ p.get_full_name() or p.email }}</option>{% endfor %}</select>
  <button class="rounded-lg bg-pink-600 px-3 py-1 font-medium text-white hover:bg-pink-700">Import</button>
</form>{% endif %}
{% if page_obj and page_obj.has_other_pages() %}<div class="flex gap-3 text-sm text-pink-700">{% if page_obj.has_previous() %}<a href="?{{ qs }}page={{ page_obj.previous_page_number() }}">← Prev</a>{% endif %}{% if page_obj.has_next() %}<a href="?{{ qs }}page={{ page_obj.next_page_number() }}">Next →</a>{% endif %}</div>{% endif %}
{% endblock %}
