{% extends "control/crm/base_crm.jinja" %}
{% from "control/_forms.jinja" import render_form %}
{% block page_title %}{{ 'Edit' if obj else 'New' }} template{% endblock %}
{% block crm_title %}{{ 'Edit' if obj else 'New' }} template{% endblock %}
{% block crm_actions %}<a href="{{ url('control:crm_templates') }}" class="rounded-full bg-white px-3 py-1 text-xs font-medium text-pink-800 ring-1 ring-pink-100 hover:bg-pink-50">← Templates</a>{% endblock %}
{% block crm_body %}
<form method="post" class="cf mx-auto max-w-xl space-y-3 rounded-2xl bg-white px-4 py-4 shadow-sm ring-1 ring-pink-100">
  {{ csrf_input }}{{ render_form(form) }}
  <p class="text-[11px] text-slate-400">Placeholders: {name} {first_name} {business} {city} {dgc}</p>
  <div class="flex items-center gap-2">
    <button class="rounded-lg bg-pink-600 px-4 py-1.5 text-[13px] font-medium text-white hover:bg-pink-700">Save</button>
    <a href="{{ url('control:crm_templates') }}" class="text-xs text-slate-500 hover:underline">Cancel</a>
    {% if obj %}<button formaction="{{ url('control:crm_template_delete', kwargs={'pk': obj.pk}) }}" formnovalidate onclick="return confirm('Delete this template?')" class="ml-auto text-xs text-rose-600 hover:underline">Delete</button>{% endif %}
  </div>
</form>
{% endblock %}
