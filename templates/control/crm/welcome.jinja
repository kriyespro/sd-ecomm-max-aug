{% extends "control/crm/base_crm.jinja" %}
{% set pl = possible.plan %}
{% set cv = possible.cv %}
{% set hero = possible.hero %}
{% block page_title %}Welcome{% endblock %}
{% block crm_title %}Welcome, {{ first_name }} 👋{% endblock %}
{% block crm_sub %}· this is what your calls can become{% endblock %}
{% block crm_actions %}{% if not preview %}<a href="{{ url('control:crm_my_day') }}" class="rounded-full bg-pink-600 px-4 py-1.5 text-[13px] font-semibold text-white shadow-sm hover:bg-pink-700">▶ Start calling</a>{% endif %}{% endblock %}

{% block crm_body %}
{% macro bar(label, shown, pct, tone="pink", note="") %}
<div class="mb-2">
  <div class="flex items-baseline justify-between text-[12px]"><span class="text-slate-600">{{ label }}</span><b class="text-slate-800">{{ shown }}</b></div>
  <div class="mt-0.5 h-3 rounded-full bg-slate-100"><div class="h-3 rounded-full {{ {'pink': 'bg-pink-400', 'deep': 'bg-pink-600', 'green': 'bg-emerald-500', 'amber': 'bg-amber-400'}[tone] }}" style="width: {{ pct }}%"></div></div>
  {% if note %}<div class="mt-0.5 text-[10px] text-slate-400">{{ note }}</div>{% endif %}
</div>
{% endmacro %}
{% set tones = ['pink', 'pink', 'deep', 'green'] %}

{% if preview %}
<div class="flex flex-wrap items-center justify-between gap-2 rounded-xl bg-amber-50 px-3 py-2 text-[12px] text-amber-900 ring-1 ring-amber-200">
  <span>👀 Previewing <b>{{ preview.get_full_name() or preview.email }}</b>'s welcome page — exactly what they see.</span>
  <a href="{{ url('control:crm_person', kwargs={'pk': preview.pk}) }}" class="font-medium underline">← their profile &amp; percentages</a>
</div>
{% endif %}

{# ── HERO: 100 calls at the DGC's own percentage ───────────────────────── #}
<section class="overflow-hidden rounded-2xl bg-gradient-to-br from-pink-50 via-white to-emerald-50 shadow-sm ring-1 ring-pink-100">
  <div class="grid gap-4 p-4 md:grid-cols-2 md:p-5">
    <div>
      <p class="text-[11px] font-semibold uppercase tracking-wide text-pink-500">The simple truth</p>
      <h2 class="mt-1 text-2xl font-bold leading-tight text-slate-900 md:text-3xl">
        100 calls @ {{ hero.overall }}%
        <span class="block text-emerald-600">= {{ hero.paid }} paid client{{ '' if hero.paid == '1' else 's' }}</span>
        <span class="block text-emerald-700">= {{ hero.value_label }} for you</span>
      </h2>
      <p class="mt-2 text-[13px] text-slate-600">That is what a normal 100 calls turn into when you <b>call properly, meet, show the demo, help the client understand the product and follow up every time.</b></p>
      <div class="mt-3 flex flex-wrap gap-1.5 text-[11px]">
        <span class="rounded-full bg-white px-2.5 py-1 text-pink-800 ring-1 ring-pink-200" title="Share of calls that become a meeting or demo">{{ possible.c[0] }}% meet / demo</span>
        <span class="rounded-full bg-white px-2.5 py-1 text-pink-800 ring-1 ring-pink-200" title="Share of meetings that start a trial">{{ possible.c[1] }}% start a trial</span>
        <span class="rounded-full bg-white px-2.5 py-1 text-pink-800 ring-1 ring-pink-200" title="Share of trials that become paying clients">{{ possible.c[2] }}% become paid</span>
        <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-emerald-800 ring-1 ring-emerald-200">{{ cv.pct_label }}% of the DGC price</span>
      </div>
      <p class="mt-1.5 text-[10px] text-slate-400">{% if possible.funnel_custom or cv.pct_custom %}These percentages were set for you by your admin.{% else %}These are the team's standard percentages; your admin can set your own.{% endif %}</p>
    </div>
    <div class="rounded-xl bg-white p-3.5 ring-1 ring-pink-100">
      <h3 class="mb-2 text-[12px] font-semibold text-pink-900">📞 What 100 calls give you</h3>
      {% for r in hero.bars %}{{ bar(r.label, r.n, r.pct, tones[loop.index0]) }}{% endfor %}
      <div class="mt-2 rounded-lg bg-emerald-600 px-3 py-2 text-center text-[13px] font-semibold text-white">{{ hero.paid }} paid × {{ cv.total_label }} = {{ hero.value_label }}</div>
    </div>
  </div>
</section>

{# ── what ONE client is worth ───────────────────────────────────────────── #}
<section class="rounded-2xl bg-white p-3.5 shadow-sm ring-1 ring-emerald-200">
  <h3 class="mb-2 text-[13px] font-semibold text-pink-900">💰 What one paid client is worth to you</h3>
  <div class="flex flex-wrap items-center gap-x-2 gap-y-1.5 text-[13px]">
    <span class="rounded-lg bg-pink-50 px-2.5 py-1.5 text-pink-900"><b>{{ cv.pct_label }}%</b> of the {{ cv.yearly_label }} yearly {{ 'DGC price' if cv.on_dgc_price else 'plan price' }} = <b>{{ cv.commission_label }}</b></span>
    <span class="text-slate-400">+</span>
    {% if preview %}
    <span class="rounded-lg bg-amber-50 px-2.5 py-1.5 text-amber-900 ring-1 ring-amber-200">their service charge <b>{{ cv.own_label }}</b></span>
    {% else %}
    <form method="post" action="{{ url('control:crm_my_service_charge') }}" class="inline-flex items-center gap-1 rounded-lg bg-amber-50 px-2 py-1 ring-1 ring-amber-200">
      {{ csrf_input }}<input type="hidden" name="next" value="{{ url('control:crm_welcome') }}">
      <label class="text-[12px] text-amber-900" for="svc-charge">your service charge ₹</label>
      <input id="svc-charge" name="service_charge" inputmode="numeric" value="{{ cv.own if cv.has_own else '' }}" placeholder="0"
             class="h-8 w-24 rounded-md border border-amber-200 bg-white px-2 text-[13px] font-semibold text-slate-800 focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400">
      <button class="h-8 rounded-md bg-amber-500 px-2.5 text-[12px] font-semibold text-white hover:bg-amber-600">Save</button>
    </form>
    {% endif %}
    <span class="text-slate-400">=</span>
    <span class="rounded-lg bg-emerald-600 px-3 py-1.5 font-semibold text-white">{{ cv.total_label }} per client</span>
  </div>
  <p class="mt-2 text-[11px] text-slate-500">
    {% if cv.has_own %}The {{ cv.own_label }} service charge is yours on top of the commission, so every number on this page is the full value per client.
    {% elif not preview %}<b class="text-amber-700">Add your own service charge</b> — what you charge a client for setup, product entry or training — and every number below becomes your full value per client.{% endif %}
    Counted on the smallest plan, so a bigger plan is worth more. The commission is worked out on the <b>DGC price</b>, not the public price. These are estimates.</p>
</section>

{# ── what if I do this today ────────────────────────────────────────────── #}
<section>
  <h3 class="mb-2 text-[14px] font-semibold text-slate-800">If you do this today… <span class="text-[12px] font-normal text-slate-500">and what it adds up to this month</span></h3>
  <div class="grid gap-3 lg:grid-cols-3">
    {% for sc in possible.scenarios %}
    <div class="rounded-2xl bg-white p-3.5 shadow-sm ring-1 ring-pink-100">
      <div class="flex items-center gap-2">
        <span class="text-2xl">{{ sc.icon }}</span>
        <p class="text-[13px] leading-tight text-slate-700">{{ sc.verb }} <b class="text-lg text-pink-700">{{ sc.n }}</b> people today</p>
      </div>
      <div class="mt-3">{% for r in sc.chain %}{{ bar(r.label, r.n, r.pct, tones[loop.index0 + (0 if sc.kind == 'calls' else 1)]) }}{% endfor %}</div>
      <div class="rounded-lg bg-emerald-50 px-3 py-2 text-[12px] text-emerald-900 ring-1 ring-emerald-100">
        Today: ≈ <b>{{ sc.paid }}</b> paid client{{ '' if sc.paid == '1' else 's' }} = <b class="text-sm">{{ sc.today_label }}</b>
      </div>
      <div class="mt-1.5 rounded-lg bg-pink-600 px-3 py-2 text-[12px] text-white">
        Every working day for {{ sc.days }} days: ≈ <b>{{ sc.month_clients }}</b> clients = <b class="text-sm">{{ sc.month_label }}</b> this month
      </div>
    </div>
    {% endfor %}
  </div>
  <p class="mt-1.5 text-[11px] text-slate-500">Meeting someone and giving them a demo are the same step in the funnel. “This month” just repeats the day across {{ possible.month.days }} working days, if your percentages hold.</p>
</section>

{# ── where I am now + what is already in my panel ───────────────────────── #}
<div class="grid gap-3 md:grid-cols-2">
  <div class="rounded-2xl bg-white p-3.5 shadow-sm ring-1 ring-pink-100">
    <h3 class="mb-2 text-[12px] font-semibold text-pink-900">⏱ Where you are today</h3>
    {{ bar("Calls made", possible.progress.done ~ " / " ~ possible.progress.target, possible.progress.pct, 'green' if possible.progress.pct >= 100 else 'deep') }}
    <p class="text-[12px] text-slate-600">
      {% if possible.progress.done == 0 %}Not started yet — the first call is the hardest. 📞
      {% elif possible.progress.left %}Your {{ possible.progress.done }} call{{ '' if possible.progress.done == 1 else 's' }} already put ≈ <b>{{ possible.progress.paid_so_far }}</b> paid client{{ '' if possible.progress.paid_so_far == '1' else 's' }} in the making.
        <b>{{ possible.progress.left }} more</b> could add ≈ <b class="text-emerald-700">{{ possible.progress.left_paid }}</b>.
      {% else %}🎉 Plan complete — ≈ <b class="text-emerald-700">{{ possible.progress.value_so_far_label }}</b> in the making. Follow up on every one of them.{% endif %}
    </p>
  </div>
  <div class="rounded-2xl bg-white p-3.5 shadow-sm ring-1 ring-pink-100">
    <h3 class="mb-2 text-[12px] font-semibold text-pink-900">📋 Leads in your panel <span class="font-normal text-slate-400">· {{ possible.leads.total }} open</span></h3>
    {% if possible.leads.total %}
    {% for r in possible.leads.stages if r.n %}{{ bar(r.label, r.n, r.bar, 'pink', r.pct ~ "% chance each") }}{% endfor %}
    <p class="text-[11px] text-slate-500">≈ <b>{{ possible.leads.expected }}</b> paid client{{ '' if possible.leads.expected == '1' else 's' }} — worth at least <b class="text-emerald-700">{{ possible.leads.value_label }}</b> to you at the smallest plan.
      {% if possible.leads.untouched %}<b class="text-rose-600">{{ possible.leads.untouched }} not called yet</b> — start there.{% endif %}</p>
    {% else %}<p class="text-[12px] text-slate-500">No open leads yet. When a lead comes in it shows here with what it could be worth.</p>{% endif %}
  </div>
</div>

{# ── the habit + go ─────────────────────────────────────────────────────── #}
<section class="rounded-2xl bg-white px-4 py-3.5 shadow-sm ring-1 ring-pink-100">
  <p class="text-[13px] font-semibold text-pink-900">The habit that wins</p>
  <div class="mt-2 flex flex-wrap items-center gap-1.5 text-[12px]">
    <span class="rounded-full bg-pink-600 px-2.5 py-1 font-medium text-white">① Call</span><span class="text-pink-300">›</span>
    <span class="rounded-full bg-pink-500 px-2.5 py-1 font-medium text-white">② Meet / demo</span><span class="text-pink-300">›</span>
    <span class="rounded-full bg-emerald-500 px-2.5 py-1 font-medium text-white">③ Help them understand the product</span><span class="text-pink-300">›</span>
    <span class="rounded-full bg-emerald-600 px-2.5 py-1 font-medium text-white">④ Follow up — every time</span>
  </div>
  <p class="mt-2 text-[12px] text-slate-500">Every paid client is worth at least <b class="text-emerald-700">{{ cv.total_label }}</b> to you
    ({{ cv.pct_label }}% of {{ cv.yearly_label }}{% if cv.has_own %} + your {{ cv.own_label }} service charge{% endif %}).
    Clients stay and renew when they understand the product — so the demo and the follow-up are the real work.</p>
  {% if not preview %}
  <div class="mt-3"><a href="{{ url('control:crm_my_day') }}" class="inline-flex rounded-xl bg-pink-600 px-5 py-3 text-[14px] font-semibold text-white shadow-sm hover:bg-pink-700">▶ Start with your first call</a></div>
  {% endif %}
</section>
{% endblock %}
