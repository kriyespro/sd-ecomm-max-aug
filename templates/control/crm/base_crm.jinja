{% extends "control/base_control.jinja" %}
{# Shared CRM shell: soft-pink header band + one tab bar for the whole module,
   so the sidebar only needs a single CRM entry. Child pages fill crm_title,
   crm_sub, crm_actions and crm_body. #}
{% set _un = request.resolver_match.url_name if request.resolver_match else "" %}
{% set _adm = request.user.is_superuser or (request.user.profile and request.user.profile.is_platform_admin) %}
{% set _tabs = [
  ("Board", "crm_board", "crm_board", true, "📊"),
  ("My day", "crm_my_day", "crm_my_day", false, "☀️"),
  ("Leads", "crm_leads", "crm_lead", false, "📞"),
  ("Tasks", "crm_tasks", "crm_task", false, "✅"),
  ("Money", "crm_collections", "crm_collection", false, "💰"),
  ("Training", "crm_training", "crm_training", false, "🎓"),
  ("Store work", "crm_work", "crm_work", false, "🛠"),
] %}

{% block content %}
<div class="space-y-5">
  <div class="rounded-2xl bg-gradient-to-r from-pink-50 via-rose-50 to-white px-3 py-3 ring-1 ring-pink-100 sm:px-4">
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
      <div class="flex min-w-0 flex-wrap items-baseline gap-x-2">
        <h1 class="text-base font-semibold text-pink-900">{% block crm_title %}CRM{% endblock %}</h1>
        <p class="text-xs text-pink-700/70">{% block crm_sub %}{% endblock %}</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">{% block crm_actions %}{% endblock %}</div>
    </div>
    <nav class="-mx-1 mt-2.5 flex gap-1 overflow-x-auto px-1 pb-0.5" aria-label="CRM sections">
      {% for label, name, prefix, admin_only, icon in _tabs %}
      {% if _adm or not admin_only %}
      {% set on = _un.startswith(prefix) %}
      <a href="{{ url('control:' ~ name) }}"
         class="shrink-0 rounded-full px-3 py-1 text-[13px] font-medium transition {{ 'bg-pink-600 text-white shadow-sm' if on else 'bg-white/70 text-pink-800 ring-1 ring-pink-100 hover:bg-white' }}">
        <span class="mr-1">{{ icon }}</span>{{ label }}</a>
      {% endif %}
      {% endfor %}
    </nav>
  </div>
  {% block crm_body %}{% endblock %}
</div>
{% endblock %}
