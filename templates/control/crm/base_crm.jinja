{% extends "control/base_control.jinja" %}
{# Shared CRM shell: soft-pink header band + one tab bar for the whole module,
   so the sidebar only needs a single CRM entry. Child pages fill crm_title,
   crm_sub, crm_actions and crm_body. #}
{% set _un = request.resolver_match.url_name if request.resolver_match else "" %}
{% set _adm = request.user.is_superuser or (request.user.profile and request.user.profile.is_platform_admin) %}
{% set _tabs = [
  ("Board", "crm_board", "crm_board", true, "📊"),
  ("My day", "crm_my_day", "crm_my_day", false, "☀️"),
  ("Leads", "crm_leads", "crm_lead", false, "📞"),
  ("Tasks", "crm_tasks", "crm_task", false, "✅"),
  ("Money", "crm_collections", "crm_collection", false, "💰"),
  ("Training", "crm_training", "crm_training", false, "🎓"),
  ("Store work", "crm_work", "crm_work", false, "🛠"),
  ("Insights", "crm_insights", "crm_insights", false, "📈"),
] %}

{% block content %}
<style>
  .cf [data-field] > label{font-size:11px;font-weight:600;color:#9d174d;text-transform:uppercase;letter-spacing:.03em}
  .cf input:not([type=checkbox]):not([type=radio]):not([type=file]),.cf select,.cf textarea{margin-top:2px;padding:.3rem .5rem;font-size:13px}
  .cf [data-field=note],.cf [data-field=notes],.cf [data-field=detail]{grid-column:1/-1}
  .cf textarea{min-height:0}
</style>
<div class="-mx-2 space-y-3 sm:-mx-3">
  <div class="rounded-2xl bg-gradient-to-r from-pink-50 via-rose-50 to-white px-3 py-3 ring-1 ring-pink-100 sm:px-4">
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
      <div class="flex min-w-0 flex-wrap items-baseline gap-x-2">
        <h1 class="text-base font-semibold text-pink-900">{% block crm_title %}CRM{% endblock %}</h1>
        <p class="text-xs text-pink-700/70">{% block crm_sub %}{% endblock %}</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">{% block crm_actions %}{% endblock %}</div>
    </div>
    <nav class="-mx-1 mt-2.5 flex gap-1 overflow-x-auto px-1 pb-0.5" aria-label="CRM sections">
      {% for label, name, prefix, admin_only, icon in _tabs %}
      {% if _adm or not admin_only %}
      {% set on = _un.startswith(prefix) %}
      <a href="{{ url('control:' ~ name) }}"
         class="shrink-0 rounded-full px-3 py-1 text-[13px] font-medium transition {{ 'bg-pink-600 text-white shadow-sm' if on else 'bg-white/70 text-pink-800 ring-1 ring-pink-100 hover:bg-white' }}">
        <span class="mr-1">{{ icon }}</span>{{ label }}</a>
      {% endif %}
      {% endfor %}
    </nav>
  </div>
  {% block crm_body %}{% endblock %}

  {# ── shared plumbing: token for fetch calls, toast, call-return sheet ── #}
  <div hidden>{{ csrf_input }}</div>

  <div x-data="{ m: '', ok: false, tm: null }"
       x-init="window.__crmToast = (t, good) => { m = t; ok = !!good; clearTimeout(tm); tm = setTimeout(() => m = '', 3500) }">
    <div x-show="m" x-cloak x-transition class="fixed bottom-4 left-1/2 z-[60] max-w-[90vw] -translate-x-1/2 rounded-full px-4 py-2 text-sm text-white shadow-lg"
         :class="ok ? 'bg-slate-800' : 'bg-rose-600'" x-text="m"></div>
  </div>

  {# After a phone call: when the DGC comes back to the page, ask how it went — one tap logs it #}
  <div x-data="callSheet()" x-cloak @crm-call-return.window="open($event.detail)"
       data-log-url="{{ url('control:crm_log') }}" data-lead-url="{{ url('control:crm_lead', kwargs={'pk': 0}) }}">
    <div x-show="show" x-transition.opacity class="fixed inset-0 z-40 bg-slate-900/30" @click="dismiss()"></div>
    <div x-show="show" x-transition role="dialog" aria-label="Log the call"
         class="fixed inset-x-0 bottom-0 z-50 rounded-t-2xl bg-white p-4 shadow-2xl ring-1 ring-pink-100 sm:inset-x-auto sm:bottom-4 sm:right-4 sm:w-96 sm:rounded-2xl"
         style="padding-bottom: max(1rem, env(safe-area-inset-bottom))">
      <p class="text-sm font-semibold text-slate-800">How did the call with <span class="text-pink-700" x-text="p.name || 'the lead'"></span> go?</p>
      <div class="mt-3 grid grid-cols-2 gap-2">
        <button type="button" @click="log('connected')" :disabled="busy" class="rounded-xl bg-emerald-600 px-3 py-3 text-sm font-medium text-white hover:bg-emerald-700">✅ Spoke to them</button>
        <button type="button" @click="log('no_answer')" :disabled="busy" class="rounded-xl bg-white px-3 py-3 text-sm font-medium text-slate-700 ring-1 ring-slate-300 hover:bg-slate-50">📵 No answer</button>
        <button type="button" @click="log('not_reachable')" :disabled="busy" class="rounded-xl bg-white px-3 py-3 text-sm font-medium text-slate-700 ring-1 ring-slate-300 hover:bg-slate-50">🚫 Unreachable</button>
        <button type="button" @click="log('call_back')" :disabled="busy" class="rounded-xl bg-amber-100 px-3 py-3 text-sm font-medium text-amber-900 ring-1 ring-amber-200 hover:bg-amber-200">🔁 Call back later</button>
        <button type="button" @click="log('not_interested')" :disabled="busy" class="col-span-2 rounded-xl bg-rose-50 px-3 py-3 text-sm font-medium text-rose-700 ring-1 ring-rose-200 hover:bg-rose-100">👎 Not interested</button>
      </div>
      <div class="mt-3 flex items-center justify-between text-xs">
        <button type="button" @click="dismiss()" class="text-slate-500 hover:underline">Not now</button>
        <a :href="leadUrl()" class="text-pink-700 hover:underline">Open lead for more →</a>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  // ---- 1) status dropdowns (list, My day, lead page): save on change --------
  document.addEventListener('change', async function (ev) {
    var sel = ev.target.closest && ev.target.closest('select[data-lead]');
    if (!sel) return;
    var prev = sel.dataset.prev, next = sel.value;
    if (prev === next) return;
    var tok = document.querySelector('input[name=csrfmiddlewaretoken]');
    var fd = new FormData();
    fd.append('status', next);
    fd.append('csrfmiddlewaretoken', tok ? tok.value : '');
    sel.disabled = true;
    try {
      var r = await fetch(sel.dataset.url, { method: 'POST', body: fd, credentials: 'same-origin' });
      if (!r.ok) {
        var msg = 'Could not change the status.';
        try { msg = (await r.json()).error || msg; } catch (e) {}
        throw new Error(msg);
      }
      sel.dataset.prev = next;
      var lost = next === 'lost';
      sel.classList.toggle('bg-slate-100', lost); sel.classList.toggle('text-slate-600', lost);
      sel.classList.toggle('bg-pink-50', !lost); sel.classList.toggle('text-pink-800', !lost);
      var f = sel.parentElement && sel.parentElement.querySelector('[data-flash]');
      if (f) { f.style.opacity = 1; setTimeout(function () { f.style.opacity = 0; }, 1400); }
      if (window.__crmToast) window.__crmToast('Status saved ✓', true);
    } catch (e) {
      sel.value = prev;
      if (window.__crmToast) window.__crmToast(e.message || 'Could not change the status.');
    } finally { sel.disabled = false; }
  });

  // ---- 2) remember a started call; on return, offer one-tap logging --------
  var KEY = 'crmPendingCall', TTL = 30 * 60 * 1000, MIN_AWAY = 4000;
  function read() { try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) { return null; } }
  function write(v) { try { localStorage.setItem(KEY, JSON.stringify(v)); } catch (e) {} }
  function clear() { try { localStorage.removeItem(KEY); } catch (e) {} }

  document.addEventListener('click', function (ev) {
    var a = ev.target.closest && ev.target.closest('a[data-call-lead]');
    if (!a) return;
    write({ id: a.dataset.callLead, name: a.dataset.callName || '', t: Date.now(), left: 0 });
  });

  function maybeAsk() {
    var p = read();
    if (!p) return;
    if (Date.now() - p.t > TTL) { clear(); return; }
    if (p.left && Date.now() - p.left >= MIN_AWAY) {
      window.dispatchEvent(new CustomEvent('crm-call-return', { detail: { id: p.id, name: p.name } }));
    }
  }
  document.addEventListener('visibilitychange', function () {
    var p = read();
    if (document.visibilityState === 'hidden') {
      if (p && !p.left) { p.left = Date.now(); write(p); }
    } else { setTimeout(maybeAsk, 250); }
  });
  window.addEventListener('pageshow', function () { setTimeout(maybeAsk, 400); });

  // ---- 2b) offline queue: calls logged with no signal are sent later ---------
  var QKEY = 'crmLogQueue', QMAX = 50, QTTL = 3 * 24 * 3600 * 1000;
  function qread() { try { return JSON.parse(localStorage.getItem(QKEY) || '[]'); } catch (e) { return []; } }
  function qwrite(v) { try { localStorage.setItem(QKEY, JSON.stringify(v.slice(-QMAX))); } catch (e) {} }
  function queueLog(item) { var q = qread(); q.push(item); qwrite(q); }
  var flushing = false;
  async function flushQueue() {
    if (flushing) return;
    var q = qread();
    if (!q.length) return;
    var logUrl = (document.querySelector('[data-log-url]') || {}).dataset;
    if (!logUrl || !logUrl.logUrl) return;
    flushing = true;
    var sent = 0, keep = [], stop = false;
    for (var i = 0; i < q.length; i++) {
      var it = q[i];
      if (stop) { keep.push(it); continue; }
      if (Date.now() - Date.parse(it.at) > QTTL) continue;          // too old: drop
      var tok = document.querySelector('input[name=csrfmiddlewaretoken]');
      var fd = new FormData();
      fd.append('kind', 'call'); fd.append('outcome', it.outcome); fd.append('lead', it.lead);
      fd.append('at', it.at); fd.append('csrfmiddlewaretoken', tok ? tok.value : '');
      try {
        var r = await fetch(logUrl.logUrl, { method: 'POST', body: fd, credentials: 'same-origin', headers: { 'HX-Request': 'true' } });
        if (r.ok) { sent++; }
        else if (r.status === 403 || r.status >= 500) { keep.push(it); stop = true; }   // signed out / server down: try later
        /* 400/404: the lead is gone — drop it */
      } catch (e) { keep.push(it); stop = true; }                                      // still offline
    }
    qwrite(keep);
    flushing = false;
    if (sent) {
      if (window.__crmToast) window.__crmToast('Synced ' + sent + ' call' + (sent > 1 ? 's' : '') + ' logged offline ✓', true);
      if (/\/crm\/(my-day\/|leads\/\d+\/)/.test(location.pathname)) setTimeout(function () { location.reload(); }, 900);
    }
  }
  window.addEventListener('online', function () { setTimeout(flushQueue, 500); });
  window.addEventListener('pageshow', function () { setTimeout(flushQueue, 1500); });
  document.addEventListener('DOMContentLoaded', function () { setTimeout(flushQueue, 2000); });

  // ---- 3) the sheet's logic ------------------------------------------------
  document.addEventListener('alpine:init', function () {
    Alpine.data('callSheet', function () {
      return {
        show: false, busy: false, p: { id: null, name: '' },
        open: function (d) { this.p = d; this.show = true; },
        leadUrl: function () { return this.$root.dataset.leadUrl.replace('/0/', '/' + this.p.id + '/'); },
        dismiss: function () { clear(); this.show = false; },
        log: async function (outcome) {
          if (this.busy) return;
          this.busy = true;
          var tok = document.querySelector('input[name=csrfmiddlewaretoken]');
          var fd = new FormData();
          fd.append('kind', 'call'); fd.append('outcome', outcome); fd.append('lead', this.p.id);
          fd.append('csrfmiddlewaretoken', tok ? tok.value : '');
          try {
            var r = await fetch(this.$root.dataset.logUrl, { method: 'POST', body: fd, credentials: 'same-origin', headers: { 'HX-Request': 'true' } });
            if (!r.ok) { var he = new Error('http'); he.http = true; throw he; }
            clear(); this.show = false;
            if (window.__crmToast) window.__crmToast('Call logged ✓', true);
            if (/\/crm\/(my-day\/|leads\/\d+\/)/.test(location.pathname)) setTimeout(function () { location.reload(); }, 600);
          } catch (e) {
            var offline = !e.http || (typeof navigator !== 'undefined' && navigator.onLine === false);
            if (offline) {
              queueLog({ outcome: outcome, lead: this.p.id, at: new Date().toISOString() });
              clear(); this.show = false;
              if (window.__crmToast) window.__crmToast('No signal — saved. It will send when you are back online ✓', true);
            } else if (window.__crmToast) { window.__crmToast('Could not log that — try again.'); }
          } finally { this.busy = false; }
        },
      };
    });
  });
})();
</script>
{% endblock %}
