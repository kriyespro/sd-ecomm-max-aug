{% extends "control/crm/base_crm.jinja" %}
{% block page_title %}Daily targets{% endblock %}
{% block crm_title %}Daily targets{% endblock %}
{% block crm_sub %}Default goals shown as progress bars on the board and My day.{% endblock %}

{% block crm_body %}
<form method="post" class="mx-auto max-w-md space-y-3 rounded-2xl bg-white shadow-sm p-5 ring-1 ring-pink-100">
  {{ csrf_input }}
  <h3 class="text-sm font-semibold text-slate-700">Default daily target for every DGC / staff</h3>
  {% for key, label in metrics %}
  <label class="block text-sm text-slate-700">{{ label }}
    <input type="number" min="0" name="{{ key }}" value="{{ defaults[key] }}" class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></label>
  {% endfor %}
  <button class="rounded-lg bg-pink-600 px-4 py-2 text-sm text-white">Save</button>
</form>
{% endblock %}
