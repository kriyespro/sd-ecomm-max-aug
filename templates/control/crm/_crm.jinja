{% macro range_tabs(ranges, current, extra="") %}
<div class="inline-flex rounded-full bg-white p-0.5 ring-1 ring-pink-100">
  {% for key, label in ranges %}
  <a href="?range={{ key }}{{ extra }}" class="rounded-full px-3 py-1 text-xs font-medium {{ 'bg-pink-600 text-white' if key == current else 'text-pink-800 hover:bg-pink-50' }}">{{ label }}</a>
  {% endfor %}
</div>
{% endmacro %}

{% macro tile(label, value, sub="", tone="pink") %}
<div class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-pink-100">
  <div class="text-xs font-medium uppercase tracking-wide text-pink-400">{{ label }}</div>
  <div class="mt-1 text-2xl font-semibold {{ 'text-emerald-600' if tone == 'green' else 'text-pink-700' }}">{{ value }}</div>
  {% if sub %}<div class="mt-0.5 text-xs text-slate-500">{{ sub }}</div>{% endif %}
</div>
{% endmacro %}

{% macro bar(done, target) %}
{% if target %}
{% set pct = [100, (done * 100 // target)] | min %}
<div class="mt-1 h-1.5 w-20 rounded-full bg-pink-100"><div class="h-1.5 rounded-full {{ 'bg-emerald-500' if pct >= 100 else 'bg-pink-500' }}" style="width: {{ pct }}%"></div></div>
{% endif %}
{% endmacro %}

{% macro empty(icon, title, hint) %}
<div class="rounded-2xl border border-dashed border-pink-200 bg-pink-50/40 px-6 py-10 text-center">
  <div class="text-3xl">{{ icon }}</div>
  <p class="mt-2 text-sm font-medium text-slate-700">{{ title }}</p>
  <p class="mt-1 text-xs text-slate-500">{{ hint }}</p>
</div>
{% endmacro %}

{# One-tap logger for My day: tap how it went and it saves. Follow-up and note are
   optional and folded away ABOVE the buttons (they are read when you tap, so they
   have to be set first — default is "Auto", so most calls never open them).
   csrf must be passed in — macros can't see csrf_input. #}
{% macro outcome_buttons(lead, next, csrf, compact=false) %}
<form method="post" action="{{ url('control:crm_log') }}" class="space-y-2.5">
  {{ csrf }}
  {% if lead %}<input type="hidden" name="lead" value="{{ lead.pk }}">{% endif %}
  <input type="hidden" name="next" value="{{ next }}">
  <input type="hidden" name="kind" value="call">

  <details class="group rounded-lg bg-slate-50 px-2.5 py-1.5 text-[12px]">
    <summary class="cursor-pointer list-none text-slate-500">⏰ Follow-up: <b class="text-slate-700">automatic</b> <span class="text-pink-700 group-open:hidden">· change / add a note</span></summary>
    <div class="mt-2 flex flex-wrap items-center gap-1.5">
      {% for v, l in [("", "Automatic"), ("1", "Tomorrow"), ("3", "In 3 days"), ("7", "Next week")] %}
      <label class="cursor-pointer"><input type="radio" name="follow_in" value="{{ v }}" class="peer sr-only" {{ 'checked' if v == '' }}>
        <span class="inline-block rounded-full px-2.5 py-1 text-pink-800 ring-1 ring-pink-200 peer-checked:bg-pink-600 peer-checked:text-white peer-checked:ring-pink-600">{{ l }}</span></label>
      {% endfor %}
    </div>
    <input name="note" maxlength="300" placeholder="Add a note (optional)" class="mt-2 block w-full rounded-md border border-slate-200 bg-white px-2.5 py-1.5 text-[12px] focus:border-pink-400 focus:outline-none focus:ring-1 focus:ring-pink-400">
    <p class="mt-1 text-[10px] text-slate-400">Set these before you tap a result below.</p>
  </details>

  <p class="text-[13px] font-semibold text-slate-800">How did it go?</p>
  <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
    {% for outcome, label, cls in [
        ("connected", "✅ Spoke to them", "bg-emerald-600 text-white hover:bg-emerald-700"),
        ("no_answer", "📵 No answer", "bg-white text-slate-700 ring-1 ring-slate-300 hover:bg-slate-50"),
        ("not_reachable", "🚫 Unreachable", "bg-white text-slate-700 ring-1 ring-slate-300 hover:bg-slate-50"),
        ("call_back", "🔁 Call back later", "bg-amber-100 text-amber-900 ring-1 ring-amber-200 hover:bg-amber-200"),
        ("not_interested", "👎 Not interested", "bg-rose-50 text-rose-700 ring-1 ring-rose-200 hover:bg-rose-100")] %}
    <button type="submit" name="outcome" value="{{ outcome }}" class="rounded-xl px-2.5 py-3 text-[13px] font-medium transition {{ cls }}">{{ label }}</button>
    {% endfor %}
    <button type="submit" name="kind" value="demo" class="rounded-xl bg-pink-600 px-2.5 py-3 text-[13px] font-medium text-white transition hover:bg-pink-700">🖥 Demo given</button>
  </div>
</form>
{% endmacro %}

{% macro contact_buttons(lead, compact=false) %}
<div class="flex flex-wrap gap-1.5">
  {% if lead.phone %}
  <a href="tel:{{ lead.phone }}" data-call-lead="{{ lead.pk }}" data-call-name="{{ lead.name }}" class="inline-flex items-center gap-1.5 {{ 'rounded-lg px-3.5 py-2 text-xs sm:px-3 sm:py-1.5' if compact else 'rounded-xl px-4 py-2.5 text-sm' }} bg-pink-600 font-semibold text-white shadow-sm hover:bg-pink-700">📞 Call {{ lead.phone }}</a>
  <a href="https://wa.me/{{ lead.wa_number }}" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 {{ 'rounded-lg px-2.5 py-1.5 text-xs' if compact else 'rounded-xl px-3 py-2.5 text-sm' }} bg-emerald-50 font-medium text-emerald-700 ring-1 ring-emerald-200 hover:bg-emerald-100">💬 WhatsApp</a>
  {% else %}<span class="text-sm text-slate-400">No phone number on this lead</span>{% endif %}
</div>
{% endmacro %}


{# Lead-page logger: pick what happened -> optional follow-up/note -> one Save.
   (My day keeps outcome_buttons: there one tap = one logged call, for speed.) #}
{% macro log_form(lead, next, csrf) %}
<form method="post" action="{{ url('control:crm_log') }}" class="space-y-3"
      x-data="{ choice: '', follow: '',
        get kind() { return this.choice.split('|')[0] }, get outcome() { return this.choice.split('|')[1] || '' },
        hints: {
          'call|connected': 'You spoke to them. No follow-up unless you pick one below.',
          'call|no_answer': 'Auto follow-up: tomorrow (unless you pick another).',
          'call|not_reachable': 'Auto follow-up: in 2 days (unless you pick another).',
          'call|call_back': 'Auto follow-up: tomorrow (unless you pick another).',
          'call|not_interested': 'This will mark the lead Lost and take it off your queue.',
          'demo|done': 'Demo counted. Lead moves to Demo done.',
          'whatsapp|done': 'WhatsApp counted. No follow-up unless you pick one below.' },
        labels: { 'call|connected': 'Spoke to them', 'call|no_answer': 'No answer', 'call|not_reachable': 'Unreachable',
          'call|call_back': 'Call back later', 'call|not_interested': 'Not interested', 'demo|done': 'Demo given', 'whatsapp|done': 'WhatsApp sent' } }">
  {{ csrf }}
  <input type="hidden" name="lead" value="{{ lead.pk }}">
  <input type="hidden" name="next" value="{{ next }}">
  <input type="hidden" name="kind" :value="kind">
  <input type="hidden" name="outcome" :value="outcome">

  <div>
    <p class="mb-1.5 text-[11px] font-semibold uppercase tracking-wide text-pink-700"><span class="mr-1 rounded-full bg-pink-600 px-1.5 py-0.5 text-white">1</span> What happened?</p>
    <p class="mb-1 text-[11px] text-slate-400">Phone call</p>
    <div class="flex flex-wrap gap-1.5">
      {% for v, label, tone in [
          ("call|connected", "✅ Spoke to them", "emerald"), ("call|no_answer", "📵 No answer", "slate"),
          ("call|not_reachable", "🚫 Unreachable", "slate"), ("call|call_back", "🔁 Call back later", "amber"),
          ("call|not_interested", "👎 Not interested", "rose")] %}
      <label class="cursor-pointer"><input type="radio" value="{{ v }}" x-model="choice" class="peer sr-only">
        <span class="block rounded-lg px-2.5 py-1.5 text-xs font-medium ring-1 transition
          {{ {'emerald': 'text-emerald-800 ring-emerald-200 hover:bg-emerald-50 peer-checked:bg-emerald-600 peer-checked:text-white peer-checked:ring-emerald-600',
              'slate': 'text-slate-700 ring-slate-300 hover:bg-slate-50 peer-checked:bg-slate-700 peer-checked:text-white peer-checked:ring-slate-700',
              'amber': 'text-amber-900 ring-amber-200 hover:bg-amber-50 peer-checked:bg-amber-500 peer-checked:text-white peer-checked:ring-amber-500',
              'rose': 'text-rose-700 ring-rose-200 hover:bg-rose-50 peer-checked:bg-rose-600 peer-checked:text-white peer-checked:ring-rose-600'}[tone] }}">{{ label }}</span></label>
      {% endfor %}
    </div>
    <p class="mb-1 mt-2 text-[11px] text-slate-400">Something else</p>
    <div class="flex flex-wrap gap-1.5">
      {% for v, label in [("demo|done", "🖥 Demo given"), ("whatsapp|done", "💬 WhatsApp sent")] %}
      <label class="cursor-pointer"><input type="radio" value="{{ v }}" x-model="choice" class="peer sr-only">
        <span class="block rounded-lg px-2.5 py-1.5 text-xs font-medium text-pink-800 ring-1 ring-pink-200 transition hover:bg-pink-50 peer-checked:bg-pink-600 peer-checked:text-white peer-checked:ring-pink-600">{{ label }}</span></label>
      {% endfor %}
    </div>
    <p class="mt-2 min-h-[1rem] text-[11px] text-slate-500" x-text="hints[choice] || 'Pick one to continue.'"></p>
  </div>

  <div x-show="choice" x-cloak x-transition>
    <p class="mb-1.5 text-[11px] font-semibold uppercase tracking-wide text-pink-700"><span class="mr-1 rounded-full bg-pink-600 px-1.5 py-0.5 text-white">2</span> Remind me to follow up <span class="font-normal normal-case text-slate-400">(optional)</span></p>
    <div class="flex flex-wrap gap-1.5 text-xs">
      {% for v, l in [("", "Automatic"), ("1", "Tomorrow"), ("3", "In 3 days"), ("7", "Next week")] %}
      <label class="cursor-pointer"><input type="radio" name="follow_in" value="{{ v }}" x-model="follow" class="peer sr-only" {{ 'checked' if v == '' }}>
        <span class="inline-block rounded-full px-3 py-1 text-pink-800 ring-1 ring-pink-200 peer-checked:bg-pink-600 peer-checked:text-white peer-checked:ring-pink-600">{{ l }}</span></label>
      {% endfor %}
    </div>
    <input name="note" maxlength="300" placeholder="Add a note (optional)" class="mt-2 block w-full rounded-lg border border-slate-200 px-2.5 py-1.5 text-xs focus:border-pink-400 focus:outline-none focus:ring-1 focus:ring-pink-400">
  </div>

  <div>
    <p class="mb-1.5 text-[11px] font-semibold uppercase tracking-wide text-pink-700"><span class="mr-1 rounded-full bg-pink-600 px-1.5 py-0.5 text-white">3</span> Save</p>
    <button :disabled="!choice" :class="choice ? 'bg-pink-600 hover:bg-pink-700 text-white' : 'bg-slate-100 text-slate-400 cursor-not-allowed'"
            class="w-full rounded-lg px-3 py-2 text-[13px] font-semibold transition">
      <span x-text="choice ? 'Save — ' + labels[choice] : 'Save'"></span></button>
  </div>
</form>
{% endmacro %}


{# One status dropdown for every screen. Saves instantly through the shared
   handler in base_crm (move endpoint: history entry, won guard, per-user
   access). Won deals are a locked badge — they keep the create-store flow.
   NOTE: keep the option list in step with LeadStatus (a test checks it). #}
{# One fixed color per pipeline stage — the "win ladder" (new -> ... -> won),
   always on, no sorting or row-tinting attached to it, just this one badge.
   Kept in step with the identical STATUS_COLOR map inlined in base_crm.jinja's
   change handler, so a live status change recolors to the exact shade a page
   reload would show. #}
{% set STATUS_COLOR = {
  "new": "bg-slate-100 text-slate-700",
  "contacted": "bg-sky-50 text-sky-800",
  "interested": "bg-amber-50 text-amber-800",
  "demo_booked": "bg-violet-50 text-violet-800",
  "demo_done": "bg-indigo-50 text-indigo-800",
  "negotiating": "bg-orange-100 text-orange-800",
  "won": "bg-emerald-50 text-emerald-700",
  "lost": "bg-rose-50 text-rose-700",
} %}

{% macro status_select(lead, big=false) %}
{% if lead.status == 'won' %}
<span class="whitespace-nowrap rounded-full bg-emerald-50 px-2 py-0.5 text-[11px] font-medium text-emerald-700" title="Won deals are locked">🎉 Won</span>
{% else %}
<span class="inline-flex items-center gap-1">
  <select data-lead="{{ lead.pk }}" data-prev="{{ lead.status }}" data-url="{{ url('control:crm_lead_move', kwargs={'pk': lead.pk}) }}" aria-label="Change status of {{ lead.name }}"
          class="{{ 'h-9 text-[13px]' if big else 'h-9 text-[13px] sm:h-6 sm:text-[11px]' }} cursor-pointer rounded-full border-0 py-0 pl-3 pr-8 font-medium focus:ring-1 focus:ring-pink-400 sm:pl-2 sm:pr-6 {{ STATUS_COLOR[lead.status] }}">
    {% for v, lab in [("new", "New"), ("contacted", "Contacted"), ("interested", "Interested"), ("demo_booked", "Demo booked"), ("demo_done", "Demo done"), ("negotiating", "Negotiating"), ("lost", "Lost")] %}
    <option value="{{ v }}" {{ 'selected' if lead.status == v }}>{{ lab }}</option>
    {% endfor %}
  </select>
  <span data-flash class="text-[11px] text-emerald-600 opacity-0 transition-opacity">✓</span>
</span>
{% endif %}
{% endmacro %}
