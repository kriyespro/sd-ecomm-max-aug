{# "What's possible" — simple coaching numbers for a DGC. Plain CSS bars, no chart library.
   Open by default at the start of the day (no calls yet), folded once they're working. #}
{% set pl = possible.plan %}
{% set cv = possible.cv %}
{% macro bar(label, shown, pct, tone="pink", note="") %}
<div class="mb-1.5">
  <div class="flex items-baseline justify-between text-[12px]"><span class="text-slate-600">{{ label }}</span><b class="text-slate-800">{{ shown }}</b></div>
  <div class="mt-0.5 h-2.5 rounded-full bg-slate-100"><div class="h-2.5 rounded-full {{ {'pink': 'bg-pink-400', 'deep': 'bg-pink-600', 'green': 'bg-emerald-500', 'amber': 'bg-amber-400'}[tone] }}" style="width: {{ pct }}%"></div></div>
  {% if note %}<div class="mt-0.5 text-[10px] text-slate-400">{{ note }}</div>{% endif %}
</div>
{% endmacro %}

<details id="possible" {{ 'open' if possible.progress.done == 0 }} class="group rounded-2xl bg-gradient-to-r from-pink-50 via-white to-emerald-50 shadow-sm ring-1 ring-pink-100">
  <summary class="flex cursor-pointer list-none items-start justify-between gap-3 px-3.5 py-3">
    <p class="text-[13px] leading-snug text-slate-700">
      <span class="font-semibold text-pink-900">🎯 What's possible today</span> —
      make <b>{{ pl.calls }} calls</b> → about <b>{{ pl.meets }}</b> meetings/demos → <b>{{ pl.trials }}</b> trials →
      <b class="text-emerald-700">{{ pl.paid }} paid client{{ '' if pl.paid == '1' else 's' }}</b>,
      worth about <b class="text-emerald-700">{{ pl.value_label }}</b> to you
      <span class="text-slate-500">({{ cv.total_label }} per client)</span>.
    </p>
    <span class="mt-0.5 shrink-0 text-[11px] text-pink-700"><span class="group-open:hidden">show charts ▾</span><span class="hidden group-open:inline">hide ▴</span></span>
  </summary>

  <div class="border-t border-pink-100 px-3.5 pb-3.5 pt-3">
    <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">

      {# 0 — what ONE client is worth: commission on the yearly plan + the DGC's own charge #}
      <div class="rounded-xl bg-white p-3 ring-1 ring-emerald-200 md:col-span-2 xl:col-span-3">
        <h4 class="mb-2 text-[12px] font-semibold text-pink-900">💰 What one paid client is worth to you</h4>
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1.5 text-[13px]">
          <span class="rounded-lg bg-pink-50 px-2.5 py-1.5 text-pink-900"><b>{{ cv.pct_label }}%</b> of the {{ cv.yearly_label }} yearly plan = <b>{{ cv.commission_label }}</b></span>
          <span class="text-slate-400">+</span>
          <form method="post" action="{{ url('control:crm_my_service_charge') }}" class="inline-flex items-center gap-1 rounded-lg bg-amber-50 px-2 py-1 ring-1 ring-amber-200">
            {{ csrf_input }}
            <label class="text-[12px] text-amber-900" for="svc-charge">your service charge ₹</label>
            <input id="svc-charge" name="service_charge" inputmode="numeric" value="{{ cv.own if cv.has_own else '' }}" placeholder="0"
                   class="h-8 w-24 rounded-md border border-amber-200 bg-white px-2 text-[13px] font-semibold text-slate-800 focus:border-amber-400 focus:outline-none focus:ring-1 focus:ring-amber-400">
            <button class="h-8 rounded-md bg-amber-500 px-2.5 text-[12px] font-semibold text-white hover:bg-amber-600">Save</button>
          </form>
          <span class="text-slate-400">=</span>
          <span class="rounded-lg bg-emerald-600 px-3 py-1.5 font-semibold text-white">{{ cv.total_label }} per client</span>
        </div>
        <p class="mt-2 text-[11px] text-slate-500">
          {% if cv.has_own %}Your own charge of <b>{{ cv.own_label }}</b> is added on top of the commission, so every number below is your full value per client.
          {% else %}<b class="text-amber-700">Add your own service charge</b> — whatever you charge a client for setup, product entry or training — and every number below shows your full value per client.{% endif %}
          Counted at the smallest plan, so a bigger plan is worth more. Estimates only.</p>
      </div>

      {# 1 — the funnel, per 100 calls #}
      <div class="rounded-xl bg-white p-3 ring-1 ring-pink-100">
        <h4 class="mb-2 text-[12px] font-semibold text-pink-900">📞 Every 100 calls</h4>
        {% for r in possible.per100 %}{{ bar(r.label, r.n, r.pct, ['pink', 'pink', 'deep', 'green'][loop.index0]) }}{% endfor %}
        <p class="mt-1 text-[11px] text-slate-500">That is <b>{{ possible.overall_pct }}%</b> — when you follow up properly every time ({{ possible.c[0] }}% → {{ possible.c[1] }}% → {{ possible.c[2] }}%).</p>
      </div>

      {# 2 — today's plan #}
      <div class="rounded-xl bg-white p-3 ring-1 ring-pink-100">
        <h4 class="mb-2 text-[12px] font-semibold text-pink-900">🗓 Your plan for today</h4>
        {% for r in pl.rows %}{{ bar(r.label, r.n_label, r.pct, ['pink', 'pink', 'deep', 'green'][loop.index0]) }}{% endfor %}
        <p class="mt-1 text-[11px] text-slate-500">≈ <b class="text-emerald-700">{{ pl.value_label }}</b> in total — {{ pl.paid }} client{{ '' if pl.paid == '1' else 's' }} × {{ cv.total_label }}.</p>
      </div>

      {# 3 — where you are right now #}
      <div class="rounded-xl bg-white p-3 ring-1 ring-pink-100">
        <h4 class="mb-2 text-[12px] font-semibold text-pink-900">⏱ Where you are now</h4>
        {{ bar("Calls made", possible.progress.done ~ " / " ~ possible.progress.target, possible.progress.pct, 'green' if possible.progress.pct >= 100 else 'deep') }}
        <p class="text-[12px] text-slate-600">
          {% if possible.progress.done == 0 %}Not started yet — the first call is the hardest. 📞
          {% elif possible.progress.left %}Your {{ possible.progress.done }} call{{ '' if possible.progress.done == 1 else 's' }} already put ≈ <b>{{ possible.progress.paid_so_far }}</b> paid client{{ '' if possible.progress.paid_so_far == '1' else 's' }} in the making.
            <b>{{ possible.progress.left }} more</b> could add ≈ <b class="text-emerald-700">{{ possible.progress.left_paid }}</b>.
          {% else %}🎉 Plan complete — that is ≈ <b class="text-emerald-700">{{ possible.progress.value_so_far_label }}</b> in the making. Follow up on every one of them.{% endif %}
        </p>
      </div>

      {# 4 — what's already in my panel #}
      <div class="rounded-xl bg-white p-3 ring-1 ring-pink-100">
        <h4 class="mb-2 text-[12px] font-semibold text-pink-900">📋 Leads in your panel <span class="font-normal text-slate-400">· {{ possible.leads.total }} open</span></h4>
        {% if possible.leads.total %}
        {% for r in possible.leads.stages if r.n %}{{ bar(r.label, r.n, r.bar, 'pink', r.pct ~ "% chance each") }}{% endfor %}
        <p class="mt-1 text-[11px] text-slate-500">≈ <b>{{ possible.leads.expected }}</b> paid client{{ '' if possible.leads.expected == '1' else 's' }} — worth at least <b class="text-emerald-700">{{ possible.leads.value_label }}</b> to you at the smallest plan.
          {% if possible.leads.untouched %}<b class="text-rose-600">{{ possible.leads.untouched }} not called yet</b> — start there.{% endif %}</p>
        {% else %}<p class="text-[12px] text-slate-500">No open leads yet. When a lead comes in it shows here with what it could be worth.</p>{% endif %}
      </div>

      {# 5 — do it every day for a month #}
      <div class="rounded-xl bg-white p-3 ring-1 ring-pink-100 md:col-span-2 xl:col-span-2">
        <h4 class="mb-2 text-[12px] font-semibold text-pink-900">📈 Do this every working day <span class="font-normal text-slate-400">· what you would have built by each week</span></h4>
        <div class="flex items-end gap-3">
          {% for w in possible.month.weeks %}
          <div class="flex-1 text-center">
            <div class="mb-1 text-[11px] font-semibold text-emerald-700">{{ w.value_label }}</div>
            <div class="flex h-20 items-end"><div class="w-full rounded-t-lg bg-gradient-to-t from-pink-500 to-emerald-400" style="height: {{ w.pct }}%"></div></div>
            <div class="mt-1 text-[10px] text-slate-500">Week {{ w.week }} · ≈ {{ w.clients_label }} clients</div>
          </div>
          {% endfor %}
        </div>
        <p class="mt-2 text-[11px] text-slate-500">{{ possible.month.days }} working days × {{ pl.calls }} calls ≈ <b>{{ possible.month.clients }}</b> paid clients ≈ <b class="text-emerald-700">{{ possible.month.value_label }}</b> to you in total — if the funnel holds.</p>
      </div>
    </div>

    {# the habit #}
    <div class="mt-3 rounded-xl bg-white/80 px-3 py-2.5 ring-1 ring-pink-100">
      <p class="text-[12px] font-semibold text-pink-900">The habit that wins</p>
      <div class="mt-1.5 flex flex-wrap items-center gap-1.5 text-[12px]">
        <span class="rounded-full bg-pink-600 px-2.5 py-1 font-medium text-white">① Call</span><span class="text-pink-300">›</span>
        <span class="rounded-full bg-pink-500 px-2.5 py-1 font-medium text-white">② Meet / demo</span><span class="text-pink-300">›</span>
        <span class="rounded-full bg-emerald-500 px-2.5 py-1 font-medium text-white">③ Help them understand the product</span><span class="text-pink-300">›</span>
        <span class="rounded-full bg-emerald-600 px-2.5 py-1 font-medium text-white">④ Follow up — every time</span>
      </div>
      <p class="mt-1.5 text-[11px] text-slate-500">Every paid client is worth at least <b class="text-emerald-700">{{ cv.total_label }}</b> to you
        ({{ cv.pct_label }}% of {{ cv.yearly_label }}{% if cv.has_own %} + your {{ cv.own_label }} service charge{% endif %}).
        Clients stay and renew when they understand the product, so the demo and the follow-up are the work.</p>
    </div>
  </div>
</details>
