{% extends "control/crm/base_crm.jinja" %}
{% from "control/_forms.jinja" import render_form %}
{% block page_title %}Tasks{% endblock %}
{% block crm_title %}Tasks{% endblock %}
{% block crm_sub %}Things the super admin hands out — tick them off as you go.{% endblock %}

{% block crm_actions %}{% if is_admin %}<button type="button" onclick="document.getElementById('newform').classList.toggle('hidden')" class="rounded-full bg-pink-600 px-3.5 py-1 text-[13px] font-medium text-white hover:bg-pink-700">＋ New task</button>{% endif %}{% endblock %}

{% block crm_body %}
<div class="space-y-3">
  {% if is_admin %}
  <form id="newform" method="post" action="{{ url('control:crm_task_create') }}" class="cf hidden rounded-2xl bg-white px-3 py-3 shadow-sm ring-1 ring-pink-200">
  {{ csrf_input }}
    <div class="grid grid-cols-2 gap-x-2.5 gap-y-2 sm:grid-cols-4">
      {{ render_form(form) }}
    </div>
  <div class="mt-3 flex items-center gap-2">
    <button class="rounded-lg bg-pink-600 px-4 py-1.5 text-[13px] font-medium text-white hover:bg-pink-700">Assign task</button>
    <button type="button" onclick="document.getElementById('newform').classList.add('hidden')" class="text-xs text-slate-500 hover:underline">Cancel</button>
  </div>
</form>
  {% endif %}
  <div class="overflow-x-auto rounded-2xl bg-white shadow-sm ring-1 ring-pink-100">
    <table class="w-full text-left text-sm">
      <thead class="bg-pink-50/70 text-xs uppercase tracking-wide text-pink-500"><tr><th class="px-4 py-2">Task</th><th class="px-3 py-2">For</th><th class="px-3 py-2">Due</th><th></th></tr></thead>
      <tbody class="divide-y divide-pink-50">
        {% for t in tasks %}
        <tr><td class="px-4 py-2"><div class="font-medium text-slate-800">{{ t.title }}</div>{% if t.lead %}<a class="text-xs text-slate-400 hover:underline" href="{{ url('control:crm_lead', kwargs={'pk': t.lead_id}) }}">{{ t.lead.name }}</a>{% endif %}</td>
          <td class="px-3 py-2 text-slate-500">{{ t.assignee.get_full_name() or t.assignee.email }}</td>
          <td class="px-3 py-2 text-slate-500">{{ t.due_on or "—" }}</td>
          <td class="px-3 py-2 text-right"><form method="post" action="{{ url('control:crm_task_done', kwargs={'pk': t.pk}) }}">{{ csrf_input }}<button class="text-xs text-emerald-700 hover:underline">Mark done</button></form></td></tr>
        {% else %}<tr><td colspan="4" class="px-4 py-6 text-center text-slate-400">No open tasks.</td></tr>{% endfor %}
      </tbody>
    </table>
  </div>
  {% if done %}<details class="text-sm text-slate-500"><summary>Recently done</summary>{% for t in done %}<div class="py-0.5">✓ {{ t.title }} — {{ t.assignee.get_full_name() or t.assignee.email }}</div>{% endfor %}</details>{% endif %}
</div>
{% endblock %}
