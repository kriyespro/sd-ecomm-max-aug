{% extends "control/crm/base_crm.jinja" %}
{% from "control/_forms.jinja" import render_form %}
{% block page_title %}Money collected{% endblock %}
{% block crm_title %}Money collected{% endblock %}
{% block crm_sub %}Subscription invoices appear automatically. Cash / UPI you take offline counts once verified.{% endblock %}

{% block crm_actions %}<button type="button" onclick="document.getElementById('newform').classList.toggle('hidden')" class="rounded-full bg-pink-600 px-3.5 py-1 text-[13px] font-medium text-white hover:bg-pink-700">＋ Enter collection</button>{% endblock %}

{% block crm_body %}
<div class="space-y-3">
<form id="newform" method="post" action="{{ url('control:crm_collection_create') }}" enctype="multipart/form-data" class="cf hidden rounded-2xl bg-white px-3 py-3 shadow-sm ring-1 ring-pink-200">
  {{ csrf_input }}
    <div class="grid grid-cols-2 gap-x-2.5 gap-y-2 sm:grid-cols-3 lg:grid-cols-4">
      {{ render_form(form) }}
    </div>
    <p class="mt-2 text-[11px] text-slate-500">Counts on the board once a platform admin verifies it. Subscription invoices appear here automatically.</p>
  <div class="mt-3 flex items-center gap-2">
    <button class="rounded-lg bg-pink-600 px-4 py-1.5 text-[13px] font-medium text-white hover:bg-pink-700">Submit</button>
    <button type="button" onclick="document.getElementById('newform').classList.add('hidden')" class="text-xs text-slate-500 hover:underline">Cancel</button>
  </div>
</form>
  <div class="flex gap-2 text-sm"><a href="?" class="text-slate-500 hover:underline">All</a>{% for v, l in statuses %}<a href="?status={{ v }}" class="text-slate-500 hover:underline">{{ l }}</a>{% endfor %}</div>
  <div class="overflow-x-auto rounded-2xl bg-white shadow-sm ring-1 ring-pink-100">
    <table class="w-full text-left text-sm">
      <thead class="bg-pink-50/70 text-xs uppercase tracking-wide text-pink-500"><tr><th class="px-4 py-2">Date</th><th class="px-3 py-2">By</th><th class="px-3 py-2">₹</th><th class="px-3 py-2">Mode</th><th class="px-3 py-2">Ref</th><th class="px-3 py-2">Status</th>{% if is_admin %}<th></th>{% endif %}</tr></thead>
      <tbody class="divide-y divide-pink-50">
        {% for c in collections %}
        <tr><td class="px-4 py-2">{{ c.collected_on }}</td><td class="px-3 py-2">{{ c.collected_by.get_full_name() or c.collected_by.email }}</td>
          <td class="px-3 py-2 font-medium">₹{{ c.amount }}</td><td class="px-3 py-2">{{ c.get_mode_display() }}{% if c.project %}<div class="text-xs text-slate-400">{{ c.project.name }}</div>{% endif %}</td>
          <td class="px-3 py-2 font-mono text-xs">{{ c.reference }}{% if c.proof %} <a href="{{ c.proof.url }}" target="_blank" class="underline">proof</a>{% endif %}</td>
          <td class="px-3 py-2"><span class="rounded px-2 py-0.5 text-xs {{ 'bg-emerald-100 text-emerald-700' if c.status == 'verified' else ('bg-red-100 text-red-700' if c.status == 'rejected' else 'bg-amber-100 text-amber-700') }}">{{ c.get_status_display() }}</span></td>
          {% if is_admin %}<td class="px-3 py-2 text-right">{% if c.status == 'unverified' %}
            <form method="post" action="{{ url('control:crm_collection_verify', kwargs={'pk': c.pk}) }}" class="inline">{{ csrf_input }}
              <button name="action" value="verify" class="text-xs text-emerald-700 hover:underline">Verify</button>
              <button name="action" value="reject" class="ml-2 text-xs text-red-600 hover:underline">Reject</button></form>{% endif %}</td>{% endif %}</tr>
        {% else %}<tr><td colspan="7" class="px-4 py-6 text-center text-slate-400">Nothing yet.</td></tr>{% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
