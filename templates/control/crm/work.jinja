{% extends "control/crm/base_crm.jinja" %}
{% from "control/_forms.jinja" import render_form %}
{% block page_title %}Store work{% endblock %}
{% block crm_title %}Store work{% endblock %}
{% block crm_sub %}Product entry and maintenance. Anyone can request; only the super admin assigns.{% endblock %}

{% block crm_actions %}<button type="button" onclick="document.getElementById('newform').classList.toggle('hidden')" class="rounded-full bg-pink-600 px-3.5 py-1 text-[13px] font-medium text-white hover:bg-pink-700">＋ Request work</button>{% endblock %}

{% block crm_body %}
<div class="space-y-3">
<form id="newform" method="post" action="{{ url('control:crm_work_create') }}" class="cf hidden rounded-2xl bg-white px-3 py-3 shadow-sm ring-1 ring-pink-200">
  {{ csrf_input }}
    {% set _projects = form.fields.project.queryset %}
    <div class="grid grid-cols-1 gap-x-2.5 gap-y-2 sm:grid-cols-12">
      <div class="sm:col-span-4" data-field="project"><label class="block">Store</label>
        <select name="project" required class="block w-full rounded-lg border border-slate-300 bg-white">
          <option value="">Choose store…</option>
          {% for p in _projects %}<option value="{{ p.pk }}" {{ 'selected' if loop.length == 1 }}>{{ p.name }}</option>{% endfor %}
        </select></div>
      <div class="sm:col-span-3" data-field="kind"><label class="block">What</label>
        <div class="mt-0.5 flex gap-1">
          {% for v, l in form.fields.kind.choices %}
          <label class="flex-1 cursor-pointer"><input type="radio" name="kind" value="{{ v }}" class="peer sr-only" {{ 'checked' if loop.first }}>
            <span class="block rounded-lg px-2 py-1.5 text-center text-[12px] normal-case tracking-normal text-pink-800 ring-1 ring-pink-200 peer-checked:bg-pink-600 peer-checked:text-white peer-checked:ring-pink-600">{{ l }}</span></label>
          {% endfor %}
        </div></div>
      <div class="sm:col-span-5" data-field="note"><label class="block">Details (optional)</label>
        <input name="note" maxlength="1000" placeholder="e.g. Add 40 products with photos" class="block w-full rounded-lg border border-slate-300"></div>
    </div>
    <p class="mt-2 text-[11px] text-slate-500">The super admin assigns it to a DGC — nobody can self-claim.</p>
  <div class="mt-3 flex items-center gap-2">
    <button class="rounded-lg bg-pink-600 px-4 py-1.5 text-[13px] font-medium text-white hover:bg-pink-700">Send request</button>
    <button type="button" onclick="document.getElementById('newform').classList.add('hidden')" class="text-xs text-slate-500 hover:underline">Cancel</button>
  </div>
</form>

  <div class="overflow-x-auto rounded-2xl bg-white shadow-sm ring-1 ring-pink-100">
    <table class="w-full text-left text-sm">
      <thead class="bg-pink-50/70 text-xs uppercase tracking-wide text-pink-500"><tr><th class="px-4 py-2">Store</th><th class="px-3 py-2">Work</th><th class="px-3 py-2">From</th><th class="px-3 py-2">Status</th><th></th></tr></thead>
      <tbody class="divide-y divide-pink-50">
        {% for r in requests %}
        <tr><td class="px-4 py-2 font-medium text-slate-800">{{ r.project.name }}<div class="text-xs font-normal text-slate-400">{{ r.note }}</div></td>
          <td class="px-3 py-2">{{ r.get_kind_display() }}</td>
          <td class="px-3 py-2 text-slate-500">{{ (r.requested_by.get_full_name() or r.requested_by.email) if r.requested_by else "—" }}</td>
          <td class="px-3 py-2">{{ r.get_status_display() }}{% if r.assigned_to %} → {{ r.assigned_to.get_full_name() or r.assigned_to.email }}{% endif %}</td>
          <td class="px-3 py-2 text-right">
            {% if r.status == 'open' and is_admin %}
            <form method="post" action="{{ url('control:crm_work_assign', kwargs={'pk': r.pk}) }}" class="flex justify-end gap-1">{{ csrf_input }}
              <select name="assignee" class="rounded-lg border border-slate-300 px-2 py-1 text-xs">{% for p in dgcs %}<option value="{{ p.pk }}">{{ p.get_full_name() or p.email }}</option>{% endfor %}</select>
              <button class="rounded-lg bg-pink-600 px-2 py-1 text-xs text-white">Assign</button></form>
            {% elif r.status == 'assigned' and (is_admin or r.assigned_to_id == request.user.pk) %}
            <form method="post" action="{{ url('control:crm_work_done', kwargs={'pk': r.pk}) }}">{{ csrf_input }}<button class="text-xs text-emerald-700 hover:underline">Mark done</button></form>{% endif %}
          </td></tr>
        {% else %}<tr><td colspan="5" class="px-4 py-6 text-center text-slate-400">No requests.</td></tr>{% endfor %}
      </tbody>
    </table>
  </div>

  <div class="rounded-2xl bg-white shadow-sm p-4 ring-1 ring-pink-100">
    <h3 class="mb-2 text-sm font-semibold text-slate-700">Active access {{ "(all)" if is_admin else "(mine)" }}</h3>
    {% for a in assignments %}
    <div class="flex items-center justify-between border-b border-slate-100 py-1.5 text-sm">
      <span>{{ a.assignee.get_full_name() or a.assignee.email }} → {{ a.project.name }} <span class="text-xs text-slate-400">· {{ a.get_scope_display() }}</span></span>
      {% if is_admin %}<form method="post" action="{{ url('control:crm_work_revoke', kwargs={'pk': a.pk}) }}">{{ csrf_input }}<button class="text-xs text-red-600 hover:underline">Remove access</button></form>{% endif %}
    </div>{% else %}<p class="text-sm text-slate-400">None.</p>{% endfor %}
  </div>
</div>
{% endblock %}
