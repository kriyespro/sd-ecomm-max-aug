{% extends "control/crm/base_crm.jinja" %}
{% from "control/_forms.jinja" import render_form %}
{% from "control/crm/_crm.jinja" import log_form, contact_buttons, empty, status_select %}
{% block page_title %}{{ lead.name }}{% endblock %}
{% block crm_title %}{{ lead.name }}{% endblock %}
{% block crm_sub %}{{ lead.business or "—" }}{% if lead.city %} · {{ lead.city }}{% endif %}{% if lead.assigned_to %} · owner {{ lead.assigned_to.get_full_name() or lead.assigned_to.email }}{% endif %}{% endblock %}
{% block crm_actions %}
<span class="inline-flex items-center gap-1 text-[11px] text-pink-800">Status {{ status_select(lead, true) }}</span>
<form method="post" action="{{ url('control:crm_lead_archive') }}" class="inline">{{ csrf_input }}
  <input type="hidden" name="ids" value="{{ lead.pk }}"><input type="hidden" name="next" value="{{ url('control:crm_leads') }}{{ '?archived=1' if lead.is_archived else '' }}">
  {% if lead.is_archived %}<button name="action" value="restore" class="rounded-full bg-emerald-600 px-3 py-1 text-xs font-medium text-white hover:bg-emerald-700">↩ Restore</button>
  {% else %}<button name="action" value="archive" class="rounded-full bg-white px-3 py-1 text-xs font-medium text-pink-800 ring-1 ring-pink-100 hover:bg-pink-50">🗄 Archive</button>{% endif %}
</form>
<a href="{{ url('control:crm_leads') }}" class="rounded-full bg-white px-3 py-1 text-xs font-medium text-pink-800 ring-1 ring-pink-100 hover:bg-pink-50">← All leads</a>{% endblock %}

{% block crm_body %}
{% if lead.is_archived %}<div class="rounded-2xl bg-slate-100 px-3 py-2 text-sm text-slate-700 ring-1 ring-slate-200">🗄 This lead is archived — hidden from your list, board and queue. Use Restore to bring it back.</div>{% endif %}
{# Pipeline stepper: tap a stage to move the lead #}
{% set _stages = [("new","New"),("contacted","Contacted"),("interested","Interested"),("demo_booked","Demo booked"),("demo_done","Demo done"),("negotiating","Negotiating")] %}
<form method="post" action="{{ url('control:crm_lead_status', kwargs={'pk': lead.pk}) }}" class="hidden gap-1 overflow-x-auto rounded-2xl bg-white p-2 shadow-sm ring-1 ring-pink-100 sm:flex">
  {{ csrf_input }}
  {% for v, l in _stages %}
  <button name="status" value="{{ v }}" class="shrink-0 rounded-xl px-3 py-2 text-xs font-medium {{ 'bg-pink-600 text-white' if lead.status == v else 'text-pink-800 hover:bg-pink-50' }}">{{ l }}</button>
  {% endfor %}
  <button name="status" value="lost" class="ml-auto shrink-0 rounded-xl px-3 py-2 text-xs font-medium {{ 'bg-rose-600 text-white' if lead.status == 'lost' else 'text-rose-600 hover:bg-rose-50' }}">Lost</button>
</form>
{% if lead.status == 'won' %}<div class="rounded-2xl bg-emerald-50 p-3 text-sm font-medium text-emerald-800 ring-1 ring-emerald-200">🎉 Won — store created from this lead.</div>{% endif %}

<div class="grid items-start gap-3 md:grid-cols-2 xl:grid-cols-3">
  {# 1 — log this contact #}
  <div class="space-y-3 rounded-2xl bg-white p-3.5 shadow-sm ring-1 ring-pink-100">
    <h3 class="text-sm font-semibold text-pink-900">Log this contact</h3>
    {{ contact_buttons(lead, true) }}
    {% if wa_links %}
    <details class="rounded-lg bg-emerald-50/50 px-2.5 py-1.5 ring-1 ring-emerald-100">
      <summary class="cursor-pointer text-[12px] font-medium text-emerald-800">💬 Send a WhatsApp message…</summary>
      <div class="mt-1.5 flex flex-wrap gap-1.5">
        {% for w in wa_links %}<a href="{{ w.url }}" target="_blank" rel="noopener" title="{{ w.text }}" class="rounded-full bg-white px-2.5 py-1 text-[12px] text-emerald-800 ring-1 ring-emerald-200 hover:bg-emerald-100">{{ w.title }}</a>{% endfor %}
      </div>
      <p class="mt-1 text-[10px] text-slate-400">Opens WhatsApp with the message ready — you just press send.</p>
    </details>
    {% endif %}
    {{ log_form(lead, url('control:crm_lead', kwargs={'pk': lead.pk}), csrf_input) }}
    {% if lead.is_open %}
    <form method="post" action="{{ url('control:crm_lead_won', kwargs={'pk': lead.pk}) }}" class="border-t border-pink-50 pt-3">{{ csrf_input }}
      <button class="w-full rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-700">🎉 Deal won — create the store</button></form>
    {% endif %}
    {% if lead.next_follow_up %}<div class="rounded-lg bg-amber-50 px-2.5 py-1.5 text-xs text-amber-800 ring-1 ring-amber-200">⏰ Follow-up {{ lead.next_follow_up }}</div>{% endif %}
    {% if lead.is_open %}
    <form method="post" action="{{ url('control:crm_lead_demo', kwargs={'pk': lead.pk}) }}" class="border-t border-pink-50 pt-3">
      {{ csrf_input }}
      <p class="mb-1 text-[11px] font-semibold uppercase tracking-wide text-pink-700">🖥 Book a demo{% if demo_label %} <span class="font-normal normal-case text-violet-700">· {{ demo_label }}</span>{% endif %}</p>
      <div class="flex gap-1.5">
        <input type="datetime-local" name="when" value="{{ demo_value }}" class="min-w-0 flex-1 rounded-lg border border-slate-200 px-2 py-1.5 text-xs">
        <button class="rounded-lg bg-violet-600 px-3 text-xs font-medium text-white hover:bg-violet-700">{{ 'Reschedule' if demo_value else 'Book' }}</button>
        {% if demo_value %}<button name="when" value="" class="rounded-lg px-2 text-xs text-slate-500 ring-1 ring-slate-200 hover:bg-slate-50" title="Clear the demo time">✕</button>{% endif %}
      </div>
      <p class="mt-1 text-[10px] text-slate-400">India time. Moves the lead to “Demo booked” and shows on your My day.</p>
    </form>
    {% endif %}
    {% for sc in scripts %}
    <details class="rounded-lg bg-slate-50 px-2.5 py-1.5 ring-1 ring-slate-100">
      <summary class="cursor-pointer text-[12px] font-medium text-slate-700">📖 {{ sc.title }}</summary>
      <p class="mt-1 whitespace-pre-line text-[12px] text-slate-600">{{ sc.text }}</p>
    </details>
    {% endfor %}
  </div>

  {# 2 — history #}
  <div class="rounded-2xl bg-white p-3.5 shadow-sm ring-1 ring-pink-100">
    <h3 class="mb-1 text-sm font-semibold text-pink-900">History</h3>
    <div class="max-h-96 overflow-y-auto">
      {% for a in activities %}
      <div class="flex items-start justify-between gap-2 border-b border-pink-50 py-1.5 text-[13px]">
        <span>{{ a.get_kind_display() }}{% if a.outcome %} <span class="text-slate-500">· {{ a.get_outcome_display() }}</span>{% endif %}{% if a.note %}<span class="block text-xs text-slate-500">{{ a.note }}</span>{% endif %}</span>
        <span class="shrink-0 text-right text-[11px] leading-tight text-slate-400">{{ a.actor.get_full_name() or a.actor.email }}<br>{{ (a.occurred_at|ist).strftime("%d %b %H:%M") }}</span></div>
      {% else %}<p class="py-2 text-sm text-slate-400">Nothing logged yet — make the first call. 📞</p>{% endfor %}
    </div>
  </div>

  {# 3 — edit details (always open) #}
  <div class="rounded-2xl bg-white p-3.5 shadow-sm ring-1 ring-pink-100 md:col-span-2 xl:col-span-1">
    <h3 class="mb-2 text-sm font-semibold text-pink-900">Edit details</h3>
    <form method="post" class="cf">{{ csrf_input }}
      <div class="grid grid-cols-2 gap-x-2.5 gap-y-2">{{ render_form(form) }}</div>
      <button class="mt-3 rounded-lg bg-pink-600 px-4 py-1.5 text-[13px] font-medium text-white hover:bg-pink-700">Save</button>
    </form>
  </div>
</div>
{% endblock %}
