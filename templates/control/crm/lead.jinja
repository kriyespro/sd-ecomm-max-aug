{% extends "control/crm/base_crm.jinja" %}
{% from "control/_forms.jinja" import render_form %}
{% from "control/crm/_crm.jinja" import outcome_buttons, contact_buttons, empty %}
{% block page_title %}{{ lead.name }}{% endblock %}
{% block crm_title %}{{ lead.name }}{% endblock %}
{% block crm_sub %}{{ lead.business or "—" }}{% if lead.city %} · {{ lead.city }}{% endif %}{% if lead.assigned_to %} · owner {{ lead.assigned_to.get_full_name() or lead.assigned_to.email }}{% endif %}{% endblock %}
{% block crm_actions %}<a href="{{ url('control:crm_leads') }}" class="rounded-full bg-white px-3 py-1 text-xs font-medium text-pink-800 ring-1 ring-pink-100 hover:bg-pink-50">← All leads</a>{% endblock %}

{% block crm_body %}
{# Pipeline stepper: tap a stage to move the lead #}
{% set _stages = [("new","New"),("contacted","Contacted"),("interested","Interested"),("demo_booked","Demo booked"),("demo_done","Demo done"),("negotiating","Negotiating")] %}
<form method="post" action="{{ url('control:crm_lead_status', kwargs={'pk': lead.pk}) }}" class="flex gap-1 overflow-x-auto rounded-2xl bg-white p-2 shadow-sm ring-1 ring-pink-100">
  {{ csrf_input }}
  {% for v, l in _stages %}
  <button name="status" value="{{ v }}" class="shrink-0 rounded-xl px-3 py-2 text-xs font-medium {{ 'bg-pink-600 text-white' if lead.status == v else 'text-pink-800 hover:bg-pink-50' }}">{{ l }}</button>
  {% endfor %}
  <button name="status" value="lost" class="ml-auto shrink-0 rounded-xl px-3 py-2 text-xs font-medium {{ 'bg-rose-600 text-white' if lead.status == 'lost' else 'text-rose-600 hover:bg-rose-50' }}">Lost</button>
</form>
{% if lead.status == 'won' %}<div class="rounded-2xl bg-emerald-50 p-3 text-sm font-medium text-emerald-800 ring-1 ring-emerald-200">🎉 Won — store created from this lead.</div>{% endif %}

<div class="grid items-start gap-3 md:grid-cols-2 xl:grid-cols-3">
  {# 1 — log this contact #}
  <div class="space-y-3 rounded-2xl bg-white p-3.5 shadow-sm ring-1 ring-pink-100">
    <h3 class="text-sm font-semibold text-pink-900">Log this contact</h3>
    {{ contact_buttons(lead, true) }}
    {{ outcome_buttons(lead, url('control:crm_lead', kwargs={'pk': lead.pk}), csrf_input, true) }}
    {% if lead.is_open %}
    <form method="post" action="{{ url('control:crm_lead_won', kwargs={'pk': lead.pk}) }}" class="border-t border-pink-50 pt-3">{{ csrf_input }}
      <button class="w-full rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-700">🎉 Deal won — create the store</button></form>
    {% endif %}
    {% if lead.next_follow_up %}<div class="rounded-lg bg-amber-50 px-2.5 py-1.5 text-xs text-amber-800 ring-1 ring-amber-200">⏰ Follow-up {{ lead.next_follow_up }}</div>{% endif %}
  </div>

  {# 2 — history #}
  <div class="rounded-2xl bg-white p-3.5 shadow-sm ring-1 ring-pink-100">
    <h3 class="mb-1 text-sm font-semibold text-pink-900">History</h3>
    <div class="max-h-96 overflow-y-auto">
      {% for a in activities %}
      <div class="flex items-start justify-between gap-2 border-b border-pink-50 py-1.5 text-[13px]">
        <span>{{ a.get_kind_display() }}{% if a.outcome %} <span class="text-slate-500">· {{ a.get_outcome_display() }}</span>{% endif %}{% if a.note %}<span class="block text-xs text-slate-500">{{ a.note }}</span>{% endif %}</span>
        <span class="shrink-0 text-right text-[11px] leading-tight text-slate-400">{{ a.actor.get_full_name() or a.actor.email }}<br>{{ a.occurred_at.strftime("%d %b %H:%M") }}</span></div>
      {% else %}<p class="py-2 text-sm text-slate-400">Nothing logged yet — make the first call. 📞</p>{% endfor %}
    </div>
  </div>

  {# 3 — edit details (always open) #}
  <div class="rounded-2xl bg-white p-3.5 shadow-sm ring-1 ring-pink-100 md:col-span-2 xl:col-span-1">
    <h3 class="mb-2 text-sm font-semibold text-pink-900">Edit details</h3>
    <form method="post" class="cf">{{ csrf_input }}
      <div class="grid grid-cols-2 gap-x-2.5 gap-y-2">{{ render_form(form) }}</div>
      <button class="mt-3 rounded-lg bg-pink-600 px-4 py-1.5 text-[13px] font-medium text-white hover:bg-pink-700">Save</button>
    </form>
  </div>
</div>
{% endblock %}
