{% extends "control/crm/base_crm.jinja" %}
{% from "control/crm/_crm.jinja" import range_tabs, tile, bar, empty %}
{% block page_title %}CRM board{% endblock %}
{% block crm_title %}Team board{% endblock %}
{% block crm_sub %}{{ range_label }} · {{ start }}{% if end != start %} → {{ end }}{% endif %}{% endblock %}
{% block crm_actions %}{{ range_tabs(ranges, range_key, ("" if active_only else "&active=0")) }}<a href="{{ url('control:crm_targets') }}" class="rounded-full bg-white px-3 py-1 text-xs font-medium text-pink-800 ring-1 ring-pink-100 hover:bg-pink-50">🎯 Targets</a>{% endblock %}

{% block crm_body %}
{% macro stat(label, value, sub="", tone="pink") %}
<div class="px-3 py-2">
  <div class="text-[10px] font-semibold uppercase tracking-wide text-pink-400">{{ label }}</div>
  <div class="text-lg font-semibold leading-tight {{ 'text-emerald-600' if tone == 'green' else 'text-pink-700' }}">{{ value }}</div>
  {% if sub %}<div class="truncate text-[10px] leading-tight text-slate-500">{{ sub }}</div>{% endif %}
</div>
{% endmacro %}
<div class="grid grid-cols-3 divide-x divide-y divide-pink-50 overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-pink-100 sm:divide-y-0 xl:grid-cols-6">
  {{ stat("Calls", totals.calls, totals.connected ~ " spoke · " ~ totals.connect_pct ~ "%") }}
  {{ stat("Demos", totals.demos) }}
  {{ stat("Trained", totals.trained, "confirmed") }}
  {{ stat("Collection", "₹" ~ totals.collection, ("+₹" ~ totals.collection_pending ~ " unverified") if totals.collection_pending else "verified", "green") }}
  {{ stat("Products", totals.products, totals.store_work ~ " store jobs") }}
  {{ stat("Won today", extras.won_today) }}
</div>

{% set _todo = extras.overdue_follow_ups or extras.unverified or extras.pending_training or extras.open_requests or extras.training_requests %}
{% if _todo %}
<div class="flex flex-wrap items-center gap-1.5 rounded-xl bg-white px-3 py-2 shadow-sm ring-1 ring-pink-100 text-[12px]">
  <span class="mr-1 text-[11px] font-semibold uppercase tracking-wide text-pink-700">Needs you</span>
  {% if extras.open_requests %}<a href="{{ url('control:crm_work') }}" class="rounded-full bg-pink-600 px-2.5 py-1 font-medium text-white hover:bg-pink-700">🛠 Assign {{ extras.open_requests }} store-work request{{ 's' if extras.open_requests != 1 }}</a>{% endif %}
  {% if extras.training_requests %}<a href="{{ url('control:crm_training') }}" class="rounded-full bg-pink-600 px-2.5 py-1 font-medium text-white hover:bg-pink-700">🙋 Assign a trainer to {{ extras.training_requests }} request{{ 's' if extras.training_requests != 1 }}</a>{% endif %}
  {% if extras.unverified %}<a href="{{ url('control:crm_collections') }}?status=unverified" class="rounded-full bg-amber-50 px-2.5 py-1 text-amber-800 ring-1 ring-amber-200 hover:bg-amber-100">💰 Verify {{ extras.unverified }} collection{{ 's' if extras.unverified != 1 }}</a>{% endif %}
  {% if extras.pending_training %}<a href="{{ url('control:crm_training') }}" class="rounded-full bg-amber-50 px-2.5 py-1 text-amber-800 ring-1 ring-amber-200 hover:bg-amber-100">🎓 {{ extras.pending_training }} training awaiting confirmation</a>{% endif %}
  {% if extras.overdue_follow_ups %}<a href="{{ url('control:crm_leads') }}?view=list&due=1" class="rounded-full bg-rose-50 px-2.5 py-1 text-rose-700 ring-1 ring-rose-200 hover:bg-rose-100">⏰ {{ extras.overdue_follow_ups }} overdue follow-up{{ 's' if extras.overdue_follow_ups != 1 }}</a>{% endif %}
</div>
{% endif %}

<div class="overflow-x-auto rounded-2xl bg-white shadow-sm ring-1 ring-pink-100">
  <table class="w-full text-left text-[13px]">
    <thead class="bg-pink-50/70 text-[11px] uppercase tracking-wide text-pink-500">
      <tr><th class="px-3 py-2">Person</th><th class="px-3 py-2">Calls</th><th class="px-3 py-2">Spoke</th>
        <th class="px-3 py-2">Demos</th><th class="px-3 py-2">Trained</th><th class="px-3 py-2">Trained others</th>
        <th class="px-3 py-2">Products</th><th class="px-3 py-2">Collection</th></tr>
    </thead>
    <tbody class="divide-y divide-pink-50">
      {% for r in rows %}
      <tr class="hover:bg-pink-50/40">
        <td class="px-3 py-2 font-medium text-slate-800">{{ r.name }}</td>
        <td class="px-3 py-2">{{ r.calls }}{% if range_key == 'today' %}{{ bar(r.calls, r.targets.calls) }}{% endif %}</td>
        <td class="px-3 py-2 text-slate-500">{{ r.connected }}</td>
        <td class="px-3 py-2">{{ r.demos }}{% if range_key == 'today' %}{{ bar(r.demos, r.targets.demos) }}{% endif %}</td>
        <td class="px-3 py-2">{{ r.trained }}</td>
        <td class="px-3 py-2">{{ r.trained_others }}</td>
        <td class="px-3 py-2">{{ r.products }}</td>
        <td class="px-3 py-2">₹{{ r.collection }}{% if r.collection_pending %} <span class="text-xs text-amber-600">(+₹{{ r.collection_pending }})</span>{% endif %}</td>
      </tr>
      {% else %}
      <tr><td colspan="8" class="p-4">{{ empty("👥", "No activity in this period.", "Nobody has logged calls, demos or money yet. Use Show everyone to see the whole team.") }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
<p class="text-xs text-slate-400">
  {% if active_only %}Showing people with activity · <a class="text-pink-700 underline" href="?range={{ range_key }}&active=0">Show everyone</a>{% else %}Showing everyone · <a class="text-pink-700 underline" href="?range={{ range_key }}">Hide people with no activity</a>{% endif %}
</p>
{% endblock %}
