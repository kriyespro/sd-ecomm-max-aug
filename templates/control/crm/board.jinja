{% extends "control/crm/base_crm.jinja" %}
{% from "control/crm/_crm.jinja" import range_tabs, tile, bar, empty %}
{% block page_title %}CRM board{% endblock %}
{% block crm_title %}Team board{% endblock %}
{% block crm_sub %}{{ range_label }} · {{ start }}{% if end != start %} → {{ end }}{% endif %}{% endblock %}
{% block crm_actions %}{{ range_tabs(ranges, range_key, ("" if active_only else "&active=0")) }}{% endblock %}

{% block crm_body %}
{% macro stat(label, value, sub="", tone="pink") %}
<div class="px-3 py-2">
  <div class="text-[10px] font-semibold uppercase tracking-wide text-pink-400">{{ label }}</div>
  <div class="text-lg font-semibold leading-tight {{ 'text-emerald-600' if tone == 'green' else 'text-pink-700' }}">{{ value }}</div>
  {% if sub %}<div class="truncate text-[10px] leading-tight text-slate-500">{{ sub }}</div>{% endif %}
</div>
{% endmacro %}
<div class="grid grid-cols-3 divide-x divide-y divide-pink-50 overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-pink-100 sm:divide-y-0 xl:grid-cols-6">
  {{ stat("Calls", totals.calls, totals.connected ~ " spoke · " ~ totals.connect_pct ~ "%") }}
  {{ stat("Demos", totals.demos) }}
  {{ stat("Trained", totals.trained, "confirmed") }}
  {{ stat("Collection", "₹" ~ totals.collection, ("+₹" ~ totals.collection_pending ~ " unverified") if totals.collection_pending else "verified", "green") }}
  {{ stat("Products", totals.products, totals.store_work ~ " store jobs") }}
  {{ stat("Won today", extras.won_today) }}
</div>

{# ── pipeline: one row, each stage links to its leads ─────────────────── #}
<div class="flex flex-wrap items-center gap-1 rounded-xl bg-white px-2.5 py-1.5 text-[12px] shadow-sm ring-1 ring-pink-100">
  <span class="mr-1 text-[10px] font-semibold uppercase tracking-wide text-pink-400">Pipeline</span>
  {% for v, lab, n in pipeline.stages %}
  <a href="{{ url('control:crm_leads') }}?view=list&status={{ v }}" class="rounded-full px-2 py-0.5 text-slate-600 hover:bg-pink-50">{{ lab }} <b class="{{ 'text-pink-700' if n else 'text-slate-300' }}">{{ n }}</b></a>{% if not loop.last %}<span class="text-pink-200">›</span>{% endif %}
  {% endfor %}
  <span class="mx-1 text-pink-100">|</span>
  <a href="{{ url('control:crm_leads') }}?view=list&status=won" class="rounded-full px-2 py-0.5 text-emerald-700 hover:bg-emerald-50">🎉 Won <b>{{ pipeline.won }}</b></a>
  {% if pipeline.unassigned %}<a href="{{ url('control:crm_leads') }}?view=list&assignee=none" class="rounded-full bg-amber-50 px-2 py-0.5 font-medium text-amber-800 ring-1 ring-amber-200 hover:bg-amber-100">⚠ {{ pipeline.unassigned }} unassigned — share out</a>{% endif %}
  {% if extras.overdue_follow_ups %}<a href="{{ url('control:crm_leads') }}?view=list&due=1" class="rounded-full bg-rose-50 px-2 py-0.5 font-medium text-rose-700 ring-1 ring-rose-200 hover:bg-rose-100">⏰ {{ extras.overdue_follow_ups }} overdue</a>{% endif %}
</div>

{# ── momentum: 14-day trend, three small multiples, one question each ──────
   ("is the team keeping up the pace" — a different question from the range
   tiles above, which only answer "how much so far"). Sequential: one hue
   per chart, since each is a single series over time — color carries no
   identity here. Every bar shows its value as a visible label where there's
   room, plus a native title (exact date + value) everywhere, so nothing is
   hover-only. #}
<div class="grid gap-3 md:grid-cols-3">
  {% macro trend_card(title, total, sub, rows, key, bg_class, unit) %}
  <div class="rounded-2xl bg-white p-3.5 shadow-sm ring-1 ring-pink-100">
    <div class="flex items-baseline justify-between">
      <h3 class="text-[11px] font-semibold uppercase tracking-wide text-pink-400">{{ title }}</h3>
      <span class="text-[10px] text-slate-400">{{ sub }}</span>
    </div>
    <div class="text-xl font-semibold leading-tight text-slate-800">{{ total }}</div>
    <div class="mt-2 flex h-16 items-end gap-[3px]">
      {% for r in rows %}
      {% set shown = r.collection_label if key == 'collection' else (r[key] ~ unit) %}
      <div tabindex="0" title="{{ r.label }} ({{ r.dow }}): {{ shown }}"
           class="group flex h-full flex-1 flex-col-reverse items-center focus:outline-none">
        <div class="w-full rounded-t {{ bg_class if r[key] else 'bg-slate-100' }} transition-opacity group-hover:opacity-80 group-focus:opacity-80"
             style="height: {{ r[key ~ '_pct'] }}%; min-height: 2px;"></div>
      </div>
      {% endfor %}
    </div>
    <div class="mt-1 flex justify-between text-[9px] text-slate-300"><span>{{ rows[0].label }}</span><span>{{ rows[-1].label }}</span></div>
  </div>
  {% endmacro %}
  {{ trend_card("📞 Calls / day", trend.calls_total, "avg " ~ trend.calls_avg ~ "/day", trend.rows, "calls", "bg-pink-500", " calls") }}
  {{ trend_card("🖥 Demos / day", trend.demos_total, "last 14 days", trend.rows, "demos", "bg-violet-500", " demos") }}
  {{ trend_card("💰 Collected / day", trend.collection_total, "verified, last 14 days", trend.rows, "collection", "bg-emerald-600", "") }}
</div>

{# ── leaderboard + funnel: two glanceable bar charts side by side ────────── #}
<div class="grid gap-3 lg:grid-cols-2">
  <div class="rounded-2xl bg-white p-3.5 shadow-sm ring-1 ring-pink-100">
    <h3 class="mb-2 text-[12px] font-semibold uppercase tracking-wide text-pink-400">🏆 Leaderboard <span class="font-normal normal-case text-slate-400">· calls, {{ range_label|lower }}</span></h3>
    {% if leaderboard %}
    <div class="space-y-1.5">
      {% for r in leaderboard %}
      <div class="group" tabindex="0" title="{{ r.name }}: {{ r.calls }} calls">
        <div class="mb-0.5 flex items-center justify-between text-[12px]"><span class="truncate text-slate-700">{{ r.name }}</span><b class="text-slate-800">{{ r.calls }}</b></div>
        <div class="h-2.5 w-full rounded-full bg-pink-50"><div class="h-2.5 rounded-full {{ r.bg }} transition-opacity group-hover:opacity-80 group-focus:opacity-80" style="width: {{ r.pct }}%"></div></div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <p class="py-4 text-center text-[12px] text-slate-400">No calls logged in this period yet.</p>
    {% endif %}
  </div>

  <div class="rounded-2xl bg-white p-3.5 shadow-sm ring-1 ring-pink-100">
    <h3 class="mb-2 text-[12px] font-semibold uppercase tracking-wide text-pink-400">🪜 Pipeline <span class="font-normal normal-case text-slate-400">· open leads by stage</span></h3>
    <div class="space-y-1.5">
      {% for s in funnel_chart.stages %}
      <div class="group" tabindex="0" title="{{ s.label }}: {{ s.n }} lead{{ '' if s.n == 1 else 's' }}">
        <div class="mb-0.5 flex items-center justify-between text-[12px]"><span class="text-slate-700">{{ s.label }}</span><b class="text-slate-800">{{ s.n }}</b></div>
        <div class="h-2.5 w-full rounded-full bg-pink-50"><div class="h-2.5 rounded-full {{ s.bg }} transition-opacity group-hover:opacity-80 group-focus:opacity-80" style="width: {{ s.pct }}%"></div></div>
      </div>
      {% endfor %}
    </div>
    {% if funnel_chart.lost %}<p class="mt-2 border-t border-pink-50 pt-2 text-[11px] text-slate-400">+ <a href="{{ url('control:crm_leads') }}?view=list&status=lost" class="underline hover:text-rose-600">{{ funnel_chart.lost }} lost</a> (not shown — outside the ladder)</p>{% endif %}
  </div>
</div>

{# ── inbox: everything waiting on you, actionable right here ──────────── #}
{% macro panel_head(icon, title, section, href) %}
<div class="mb-1 flex items-center justify-between">
  <h3 class="text-[13px] font-semibold text-pink-900">{{ icon }} {{ title }} <span class="ml-1 rounded-full bg-pink-100 px-1.5 text-[11px] text-pink-800">{{ section.total }}</span></h3>
  {% if section.more %}<a href="{{ href }}" class="text-[11px] text-pink-700 hover:underline">+{{ section.more }} more →</a>{% endif %}
</div>
{% endmacro %}
{% set _here = request.get_full_path() %}
{% set _any = inbox.collections.total or inbox.work.total or inbox.training_requests.total or inbox.trainings.total %}
{% if _any %}
<div class="grid gap-3 lg:grid-cols-2">
  {% if inbox.collections.total %}
  <div class="rounded-2xl bg-white px-3.5 py-3 shadow-sm ring-1 ring-amber-200">
    {{ panel_head("💰", "Verify collections", inbox.collections, url('control:crm_collections') ~ '?status=unverified') }}
    {% for c in inbox.collections.rows %}
    <form method="post" action="{{ url('control:crm_collection_verify', kwargs={'pk': c.pk}) }}" class="flex flex-wrap items-center justify-between gap-x-2 gap-y-1 border-t border-amber-50 py-1.5 text-[12px]">
      {{ csrf_input }}<input type="hidden" name="next" value="{{ _here }}">
      <span class="min-w-0"><b>{{ c.collected_by.get_full_name() or c.collected_by.email }}</b> · ₹{{ c.amount }} · {{ c.get_mode_display() }}
        <span class="font-mono text-[11px] text-slate-500">{{ c.reference }}</span>{% if c.proof %} <a href="{{ c.proof.url }}" target="_blank" rel="noopener" class="text-pink-700 underline">proof</a>{% endif %}
        {% if c.project %}<span class="text-slate-400">· {{ c.project.name }}</span>{% endif %}</span>
      <span class="flex shrink-0 gap-1"><button name="action" value="verify" class="rounded-md bg-emerald-600 px-2.5 py-1 font-medium text-white hover:bg-emerald-700">✓ Verify</button>
        <button name="action" value="reject" class="rounded-md bg-white px-2 py-1 text-rose-600 ring-1 ring-rose-200 hover:bg-rose-50">✕</button></span>
    </form>
    {% endfor %}
  </div>
  {% endif %}

  {% if inbox.work.total %}
  <div class="rounded-2xl bg-white px-3.5 py-3 shadow-sm ring-1 ring-pink-200">
    {{ panel_head("🛠", "Assign store work", inbox.work, url('control:crm_work')) }}
    {% for r in inbox.work.rows %}
    <form method="post" action="{{ url('control:crm_work_assign', kwargs={'pk': r.pk}) }}" class="flex flex-wrap items-center justify-between gap-x-2 gap-y-1 border-t border-pink-50 py-1.5 text-[12px]">
      {{ csrf_input }}<input type="hidden" name="next" value="{{ _here }}">
      <span class="min-w-0"><b>{{ r.project.name }}</b> · {{ r.get_kind_display() }}{% if r.requested_by %} <span class="text-slate-400">· from {{ r.requested_by.get_full_name() or r.requested_by.email }}</span>{% endif %}
        {% if r.note %}<span class="block truncate text-[11px] text-slate-500">{{ r.note }}</span>{% endif %}</span>
      <span class="flex shrink-0 gap-1"><select name="assignee" class="h-8 rounded-md border border-slate-200 py-0 pl-2 pr-7 text-[12px]">{% for p in dgcs %}<option value="{{ p.pk }}">{{ p.get_full_name() or p.email }}</option>{% endfor %}</select>
        <button class="h-8 rounded-md bg-pink-600 px-3 font-medium text-white hover:bg-pink-700">Assign</button></span>
    </form>
    {% endfor %}
  </div>
  {% endif %}

  {% if inbox.training_requests.total %}
  <div class="rounded-2xl bg-white px-3.5 py-3 shadow-sm ring-1 ring-pink-200">
    {{ panel_head("🙋", "Assign a trainer", inbox.training_requests, url('control:crm_training')) }}
    {% for t in inbox.training_requests.rows %}
    <form method="post" action="{{ url('control:crm_training_assign', kwargs={'pk': t.pk}) }}" class="flex flex-wrap items-center justify-between gap-x-2 gap-y-1 border-t border-pink-50 py-1.5 text-[12px]">
      {{ csrf_input }}<input type="hidden" name="next" value="{{ _here }}">
      <span class="min-w-0"><b>{{ t.student_label }}</b> wants training{% if t.topic %} <span class="text-slate-500">· {{ t.topic }}</span>{% endif %}{% if not t.trainee_id %} <span class="rounded bg-slate-100 px-1 text-[10px] text-slate-500">no login</span>{% endif %}</span>
      <span class="flex shrink-0 gap-1"><select name="trainer" class="h-8 rounded-md border border-slate-200 py-0 pl-2 pr-7 text-[12px]">{% for p in people %}{% if p.pk != t.trainee_id %}<option value="{{ p.pk }}">{{ p.get_full_name() or p.email }}</option>{% endif %}{% endfor %}</select>
        <button class="h-8 rounded-md bg-pink-600 px-3 font-medium text-white hover:bg-pink-700">Assign</button></span>
    </form>
    {% endfor %}
  </div>
  {% endif %}

  {% if inbox.trainings.total %}
  <div class="rounded-2xl bg-white px-3.5 py-3 shadow-sm ring-1 ring-amber-200">
    {{ panel_head("🎓", "Confirm trainings", inbox.trainings, url('control:crm_training')) }}
    {% for t in inbox.trainings.rows %}
    <form method="post" action="{{ url('control:crm_training_respond', kwargs={'pk': t.pk}) }}" class="flex flex-wrap items-center justify-between gap-x-2 gap-y-1 border-t border-amber-50 py-1.5 text-[12px]">
      {{ csrf_input }}<input type="hidden" name="next" value="{{ _here }}">
      <span class="min-w-0"><b>{{ t.student_label }}</b> trained by <b>{{ (t.trainer.get_full_name() or t.trainer.email) if t.trainer else '—' }}</b>{% if t.topic %} <span class="text-slate-500">· {{ t.topic }}</span>{% endif %}{% if not t.trainee_id %} <span class="rounded bg-slate-100 px-1 text-[10px] text-slate-500">no login</span>{% endif %}</span>
      <span class="flex shrink-0 gap-1"><button name="action" value="confirm" class="rounded-md bg-emerald-600 px-2.5 py-1 font-medium text-white hover:bg-emerald-700">✓ Confirm</button>
        <button name="action" value="reject" class="rounded-md bg-white px-2 py-1 text-rose-600 ring-1 ring-rose-200 hover:bg-rose-50">✕</button></span>
    </form>
    {% endfor %}
  </div>
  {% endif %}
</div>
{% endif %}

<div class="overflow-x-auto rounded-2xl bg-white shadow-sm ring-1 ring-pink-100">
  <table class="w-full text-left text-[13px]">
    <thead class="bg-pink-50/70 text-[11px] uppercase tracking-wide text-pink-500">
      <tr><th class="px-3 py-2">Person</th><th class="hidden px-3 py-2 sm:table-cell">Active</th><th class="px-3 py-2">Calls</th><th class="px-3 py-2">Spoke</th>
        <th class="px-3 py-2">Demos</th><th class="px-3 py-2">Trained</th><th class="px-3 py-2">Trained others</th>
        <th class="px-3 py-2">Products</th><th class="px-3 py-2">Collection</th></tr>
    </thead>
    <tbody class="divide-y divide-pink-50">
      {% for r in rows %}
      <tr class="hover:bg-pink-50/40">
        <td class="px-3 py-2 font-medium"><a href="{{ url('control:crm_person', kwargs={'pk': r.user.pk}) }}" class="text-slate-800 hover:text-pink-700">{{ r.name }}</a></td>
        <td class="hidden whitespace-nowrap px-3 py-2 text-[12px] sm:table-cell {{ 'text-slate-400' if not r.last_active else ('text-emerald-600' if r.last_active_label in ('just now',) or 'm ago' in r.last_active_label else 'text-slate-500') }}">{{ r.last_active_label }}</td>
        <td class="px-3 py-2">{{ r.calls }}{% if range_key == 'today' %}{{ bar(r.calls, r.targets.calls) }}{% endif %}</td>
        <td class="px-3 py-2 text-slate-500">{{ r.connected }}</td>
        <td class="px-3 py-2">{{ r.demos }}{% if range_key == 'today' %}{{ bar(r.demos, r.targets.demos) }}{% endif %}</td>
        <td class="px-3 py-2">{{ r.trained }}</td>
        <td class="px-3 py-2">{{ r.trained_others }}</td>
        <td class="px-3 py-2">{{ r.products }}</td>
        <td class="px-3 py-2">₹{{ r.collection }}{% if r.collection_pending %} <span class="text-xs text-amber-600">(+₹{{ r.collection_pending }})</span>{% endif %}</td>
      </tr>
      {% else %}
      <tr><td colspan="9" class="p-4">{{ empty("👥", "No activity in this period.", "Nobody has logged calls, demos or money yet. Use Show everyone to see the whole team.") }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
<p class="text-xs text-slate-400">
  {% if active_only %}Showing people with activity · <a class="text-pink-700 underline" href="?range={{ range_key }}&active=0">Show everyone</a>{% else %}Showing everyone · <a class="text-pink-700 underline" href="?range={{ range_key }}">Hide people with no activity</a>{% endif %}
</p>
{% endblock %}
