{% extends "control/base_control.jinja" %}
{% from "control/_forms.jinja" import render_form %}
{% block page_title %}New stock record{% endblock %}

{% block content %}
<form method="post" class="mx-auto max-w-lg space-y-4 rounded-xl bg-white p-6 ring-1 ring-slate-200">
  {{ csrf_input }}
  {{ render_form(form) }}
  <p class="text-xs text-slate-400">Leave variant blank for simple products. Initial quantity is recorded as a “Purchase / restock” movement.</p>
  <div class="flex gap-2 pt-2">
    <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">Create</button>
    <a href="{{ url('control:inventory_list') }}" class="rounded-lg px-4 py-2 text-sm text-slate-600 hover:bg-slate-100">Cancel</a>
  </div>
</form>
{% endblock %}
