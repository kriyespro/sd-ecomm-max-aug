{% extends "control/base_control.jinja" %}
{% block page_title %}Stock history{% endblock %}

{% block content %}
<div class="space-y-4">
  <a href="{{ url('control:inventory_list') }}" class="text-sm text-slate-500 hover:underline">← Inventory</a>

  <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
    <h2 class="text-sm font-semibold text-slate-700">
      {{ item.product.title }}{% if item.variant %} · {{ item.variant }}{% endif %}
      <span class="text-slate-400">@ {{ item.warehouse.name }}</span>
    </h2>
    <p class="mt-1 text-sm text-slate-500">
      On hand {{ item.quantity }} · reserved {{ item.reserved }} · available {{ item.available }}
    </p>
  </div>

  <div class="overflow-x-auto rounded-xl bg-white ring-1 ring-slate-200">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
        <tr>
          <th class="px-4 py-2">When</th><th class="px-4 py-2">Reason</th>
          <th class="px-4 py-2 text-right">Qty Δ</th><th class="px-4 py-2 text-right">Resv Δ</th>
          <th class="px-4 py-2 text-right">On hand after</th>
          <th class="px-4 py-2">Reference</th><th class="px-4 py-2">By</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {% for m in movements %}
        <tr>
          <td class="px-4 py-2 text-slate-500">{{ m.created_at.strftime("%b %d %H:%M") }}</td>
          <td class="px-4 py-2">{{ m.get_reason_display() }}{% if m.note %} <span class="text-slate-400">— {{ m.note }}</span>{% endif %}</td>
          <td class="px-4 py-2 text-right {{ 'text-emerald-600' if m.quantity_delta > 0 else 'text-red-600' if m.quantity_delta < 0 else 'text-slate-400' }}">{{ "%+d"|format(m.quantity_delta) if m.quantity_delta else "—" }}</td>
          <td class="px-4 py-2 text-right text-slate-500">{{ "%+d"|format(m.reserved_delta) if m.reserved_delta else "—" }}</td>
          <td class="px-4 py-2 text-right">{{ m.quantity_after }}</td>
          <td class="px-4 py-2 text-slate-400">{{ m.reference or "—" }}</td>
          <td class="px-4 py-2 text-slate-500">{{ m.actor.get_username() if m.actor else "system" }}</td>
        </tr>
        {% else %}
        <tr><td colspan="7" class="px-4 py-6 text-center text-slate-400">No movements.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
