{% extends "control/base_control.jinja" %}
{% block page_title %}Choose store{% endblock %}

{% block content %}
<div class="mx-auto max-w-lg rounded-xl bg-white p-6 ring-1 ring-slate-200">
  <h2 class="text-sm font-semibold text-slate-700">Choose a store to work on</h2>
  {% if projects and projects|length %}
  <ul class="mt-4 divide-y divide-slate-100">
    {% for p in projects %}
    <li class="flex items-center justify-between py-3">
      <div>
        <p class="font-medium text-slate-900">{{ p.name }}</p>
        <p class="text-xs text-slate-400">{{ p.primary_domain or "no domain" }} · {{ p.get_status_display() }}</p>
      </div>
      <form method="post" action="{{ url('control:set_project') }}">
        {{ csrf_input }}
        <input type="hidden" name="project" value="{{ p.pk }}">
        <button class="rounded-lg bg-slate-900 px-3 py-1.5 text-sm text-white hover:bg-slate-800">Open</button>
      </form>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="mt-4 text-sm text-slate-500">
    No stores yet. Create one in the <a href="/sd/projects/project/add/" class="underline">Django admin</a>.
  </p>
  {% endif %}
</div>
{% endblock %}
