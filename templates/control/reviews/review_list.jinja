{% extends "control/base_control.jinja" %}
{% block page_title %}Reviews{% endblock %}

{% block content %}
<div class="space-y-4">
  <div class="flex items-center justify-between">
    <h2 class="text-sm font-semibold text-slate-700">
      Reviews · {{ active_project.name }}
      {% if pending_count %}<span class="ml-2 rounded-full bg-amber-100 px-2 py-0.5 text-xs text-amber-800">{{ pending_count }} pending</span>{% endif %}
    </h2>
    <div class="flex gap-1">
      {% for value, label in status_choices %}
      <a href="?status={{ value }}" class="rounded-lg px-3 py-1.5 text-sm {{ 'bg-slate-900 text-white' if status == value else 'text-slate-600 hover:bg-slate-100' }}">{{ label }}</a>
      {% endfor %}
    </div>
  </div>

  {% for r in reviews %}
  <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
    <div class="flex items-start justify-between">
      <div>
        <p class="text-sm font-semibold text-slate-800">
          {{ "★" * r.rating }}<span class="text-slate-300">{{ "★" * (5 - r.rating) }}</span>
          <span class="ml-2 text-slate-600">{{ r.title or "(no title)" }}</span>
        </p>
        <p class="mt-0.5 text-xs text-slate-400">
          {{ r.author_name }} · {{ r.author_email }} · on
          <a href="{{ url('control:product_edit', kwargs={'pk': r.product.pk}) }}" class="hover:underline">{{ r.product.title }}</a>
          {% if r.is_verified_purchase %} · <span class="text-emerald-600">verified purchase</span>{% endif %}
        </p>
      </div>
      <span class="rounded px-2 py-0.5 text-xs {{ 'bg-emerald-100 text-emerald-700' if r.status == 'approved' else 'bg-red-100 text-red-700' if r.status == 'rejected' else 'bg-amber-100 text-amber-800' }}">{{ r.get_status_display() }}</span>
    </div>
    {% if r.body %}<p class="mt-2 text-sm text-slate-600">{{ r.body }}</p>{% endif %}
    {% if r.admin_reply %}<p class="mt-2 rounded-lg bg-slate-50 p-2 text-sm text-slate-600"><span class="font-medium">Reply:</span> {{ r.admin_reply }}</p>{% endif %}

    <form method="post" action="{{ url('control:review_moderate', kwargs={'pk': r.pk}) }}" class="mt-3 flex flex-wrap items-center gap-2">
      {{ csrf_input }}
      <input type="text" name="reply" placeholder="Optional public reply" class="flex-1 rounded-lg border border-slate-300 px-2 py-1.5 text-sm">
      {% if r.status != 'approved' %}<button name="status" value="approved" class="rounded-lg bg-emerald-600 px-3 py-1.5 text-sm text-white hover:bg-emerald-700">Approve</button>{% endif %}
      {% if r.status != 'rejected' %}<button name="status" value="rejected" class="rounded-lg bg-red-600 px-3 py-1.5 text-sm text-white hover:bg-red-700">Reject</button>{% endif %}
    </form>
  </div>
  {% else %}
  <div class="rounded-xl bg-white p-6 text-center text-sm text-slate-400 ring-1 ring-slate-200">No reviews in this state.</div>
  {% endfor %}
</div>
{% endblock %}
