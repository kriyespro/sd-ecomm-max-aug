{% extends "control/base_control.jinja" %}
{% from "control/_forms.jinja" import render_form %}
{% block page_title %}Reset password{% endblock %}

{% block content %}
<div class="max-w-lg space-y-4">
  <a href="{{ url('control:user_detail', kwargs={'pk': target.pk}) }}" class="text-sm text-slate-500 hover:underline">← {{ target.get_username() }}</a>

  <form method="post" class="space-y-4 rounded-xl bg-white p-6 ring-1 ring-slate-200">
    {{ csrf_input }}
    <div>
      <h2 class="text-sm font-semibold text-slate-700">Set a new password</h2>
      <p class="mt-1 text-xs text-slate-400">
        for <span class="font-medium text-slate-600">{{ target.get_full_name() or target.get_username() }}</span>
        ({{ target.email or "no email" }}). The user is not notified — share the new password with them directly.
      </p>
    </div>
    {{ render_form(form) }}
    <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">
      Update password
    </button>
  </form>
</div>
{% endblock %}
