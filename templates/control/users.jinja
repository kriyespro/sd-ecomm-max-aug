{% extends "control/base_control.jinja" %}

{% block page_title %}Users{% endblock %}

{% block content %}
<div class="rounded-xl bg-white ring-1 ring-slate-200">
  <div class="border-b border-slate-200 p-4">
    <input type="search" name="q" value="{{ q }}"
           placeholder="Search username, email, name…"
           hx-get="{{ url('control:users') }}"
           hx-trigger="input changed delay:300ms, search"
           hx-target="#user-rows"
           hx-swap="innerHTML"
           class="w-full max-w-md rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-slate-900 focus:outline-none">
  </div>
  <table class="w-full text-left text-sm">
    <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
      <tr>
        <th class="px-4 py-2">User</th>
        <th class="px-4 py-2">Email</th>
        <th class="px-4 py-2">Joined</th>
        <th class="px-4 py-2">Status</th>
        <th class="px-4 py-2 text-right">Actions</th>
      </tr>
    </thead>
    <tbody id="user-rows" class="divide-y divide-slate-100">
      {% include "control/partials/_user_rows.jinja" %}
    </tbody>
  </table>
</div>
{% endblock %}
