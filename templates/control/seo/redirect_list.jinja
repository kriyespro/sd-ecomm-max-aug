{% extends "control/base_control.jinja" %}
{% block page_title %}Redirects{% endblock %}

{% block content %}
<div class="rounded-xl bg-white ring-1 ring-slate-200">
  <div class="flex items-center justify-between border-b border-slate-200 p-4">
    <h2 class="text-sm font-semibold text-slate-700">Redirects · {{ active_project.name }}</h2>
    <div class="flex gap-2">
      <a href="{{ url('control:seo_settings') }}" class="rounded-lg px-3 py-1.5 text-sm text-slate-600 hover:bg-slate-100">← SEO</a>
      <a href="{{ url('control:seo_redirect_create') }}" class="rounded-lg bg-slate-900 px-3 py-1.5 text-sm text-white hover:bg-slate-800">New redirect</a>
    </div>
  </div>
  <div class="overflow-x-auto"><table class="w-full text-left text-sm min-w-[36rem]">
    <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
      <tr><th class="px-4 py-2">From</th><th class="px-4 py-2">To</th><th class="px-4 py-2">Code</th><th class="px-4 py-2">Active</th><th class="px-4 py-2">Hits</th><th class="px-4 py-2 text-right">Actions</th></tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      {% for r in redirects %}
      <tr class="hover:bg-slate-50">
        <td class="px-4 py-2 font-mono text-xs">{{ r.from_path }}</td>
        <td class="px-4 py-2 font-mono text-xs text-slate-500">{{ r.to_path }}</td>
        <td class="px-4 py-2 text-slate-500">{{ r.status_code }}</td>
        <td class="px-4 py-2 text-slate-500">{{ "yes" if r.is_active else "no" }}</td>
        <td class="px-4 py-2 text-slate-500">{{ r.hits }}</td>
        <td class="px-4 py-2 text-right">
          <a href="{{ url('control:seo_redirect_edit', kwargs={'pk': r.pk}) }}" class="text-slate-600 hover:underline">Edit</a>
          <a href="{{ url('control:seo_redirect_delete', kwargs={'pk': r.pk}) }}" class="ml-2 text-red-600 hover:underline">Delete</a>
        </td>
      </tr>
      {% else %}
      <tr><td colspan="6" class="px-4 py-6 text-center text-slate-400">No redirects.</td></tr>
      {% endfor %}
    </tbody>
  </table></div>
</div>
{% endblock %}
