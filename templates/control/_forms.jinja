{% set _INPUT = "mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm transition focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500 disabled:bg-slate-50 disabled:text-slate-400" %}
{% set _WIDGET_CLS = {
  "checkbox": "h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-2 focus:ring-slate-400",
  "select": _INPUT ~ " pr-8",
  "selectmultiple": _INPUT ~ " min-h-32",
  "textarea": _INPUT,
  "clearablefileinput": "mt-1 block w-full text-sm text-slate-600 file:mr-3 file:rounded-md file:border-0 file:bg-slate-100 file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-slate-700 hover:file:bg-slate-200",
} %}

{% macro render_field(field) %}
{% set wt = field.widget_type %}
<div class="space-y-1">
  {% if wt != 'checkbox' %}
  <label for="{{ field.id_for_label }}" class="block text-sm font-medium text-slate-700">
    {{ field.label }}{% if field.field.required %}<span class="text-red-500">*</span>{% endif %}
  </label>
  {% endif %}
  <div class="{{ 'flex items-center gap-2' if wt == 'checkbox' else '' }}">
    {{ field.as_widget(attrs={"class": _WIDGET_CLS.get(wt, _INPUT)}) }}
    {% if wt == 'checkbox' %}
    <label for="{{ field.id_for_label }}" class="text-sm text-slate-700">{{ field.label }}</label>
    {% endif %}
  </div>
  {% if field.help_text %}<p class="text-xs text-slate-400">{{ field.help_text }}</p>{% endif %}
  {% for error in field.errors %}<p class="text-xs text-red-600">{{ error }}</p>{% endfor %}
</div>
{% endmacro %}

{% macro render_form(form) %}
  {% if form.non_field_errors() %}
  <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">{{ form.non_field_errors()|join(' ') }}</div>
  {% endif %}
  {% for field in form.visible_fields() %}
    {{ render_field(field) }}
  {% endfor %}
  {% for field in form.hidden_fields() %}{{ field }}{% endfor %}
{% endmacro %}
