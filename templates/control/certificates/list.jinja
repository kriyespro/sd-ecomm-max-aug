{% extends "control/base_control.jinja" %}
{% block page_title %}Certificates{% endblock %}

{% block content %}
<div class="space-y-4">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 class="text-sm font-semibold text-slate-700">Certificates · {{ active_project.name }}</h2>
    <a href="{{ url('control:certificate_create') }}" class="rounded-lg bg-slate-900 px-3 py-1.5 text-sm text-white hover:bg-slate-800">Add certificate</a>
  </div>

  <p class="max-w-2xl text-xs text-slate-500">
    Upload a JPG/PNG scan of each lab certificate. A verification code is minted
    automatically. Customers verify it at
    <a href="{{ verify_url }}" target="_blank" class="underline">{{ verify_url }}</a>
    — a “Verify certificate” link is added to your storefront footer once you add
    the first one.
  </p>

  <form method="get" class="flex gap-2">
    <input name="q" value="{{ q }}" placeholder="Search code, title, lab number, gem…"
           class="w-72 rounded-lg border border-slate-300 px-3 py-1.5 text-sm">
    <button class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-50">Search</button>
  </form>

  <div class="overflow-x-auto rounded-xl bg-white ring-1 ring-slate-200">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
        <tr><th class="px-4 py-2">Code</th><th class="px-4 py-2">Title</th>
          <th class="px-4 py-2">Gem</th><th class="px-4 py-2">Lab #</th>
          <th class="px-4 py-2">Public</th><th class="px-4 py-2"></th></tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {% for c in certificates %}
        <tr class="hover:bg-slate-50">
          <td class="px-4 py-2 font-mono font-medium text-slate-800">{{ c.code }}</td>
          <td class="px-4 py-2 text-slate-700">{{ c.title }}</td>
          <td class="px-4 py-2 text-slate-500">{{ c.gem_type or "—" }}</td>
          <td class="px-4 py-2 text-slate-500">{{ c.lab_number or "—" }}</td>
          <td class="px-4 py-2">
            <span class="rounded px-2 py-0.5 text-xs {{ 'bg-emerald-100 text-emerald-700' if c.is_public else 'bg-slate-200 text-slate-600' }}">
              {{ "yes" if c.is_public else "no" }}</span>
          </td>
          <td class="px-4 py-2 text-right"><a href="{{ url('control:certificate_edit', kwargs={'pk': c.pk}) }}" class="text-slate-600 hover:underline">Edit</a></td>
        </tr>
        {% else %}
        <tr><td colspan="6" class="px-4 py-6 text-center text-slate-400">No certificates yet.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {% if is_paginated %}
  <div class="flex gap-2 text-sm">
    {% if page_obj.has_previous() %}<a href="?q={{ q }}&page={{ page_obj.previous_page_number() }}" class="rounded border px-3 py-1">Prev</a>{% endif %}
    <span class="px-3 py-1 text-slate-500">Page {{ page_obj.number }} / {{ page_obj.paginator.num_pages }}</span>
    {% if page_obj.has_next() %}<a href="?q={{ q }}&page={{ page_obj.next_page_number() }}" class="rounded border px-3 py-1">Next</a>{% endif %}
  </div>
  {% endif %}
</div>
{% endblock %}
