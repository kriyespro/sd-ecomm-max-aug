{% extends "control/base_control.jinja" %}
{% block page_title %}Backup &amp; restore{% endblock %}

{% block content %}
<div class="mx-auto max-w-2xl space-y-4">
  <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
    <h2 class="text-sm font-semibold text-slate-700">Download a backup</h2>
    <p class="mt-1 text-xs text-slate-500">
      A portable <code>.zip</code> of your catalogue (products, categories,
      brands, variants, images), pages, banners, menus, theme and store
      profile. Orders, customers, coupons and settings are not included.
    </p>
    <a href="{{ url('control:owner_backup_download') }}"
       class="mt-3 inline-block rounded-lg bg-slate-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-800">Download backup</a>
  </div>

  <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
    <h2 class="text-sm font-semibold text-slate-700">Restore from a backup</h2>
    <p class="mt-1 text-xs text-slate-500">
      Replaces every product, category, page, banner and menu in this store
      with the contents of the file. Orders and customers are kept. <b>There is
      no undo.</b>
    </p>
    <form method="post" action="{{ url('control:owner_backup_restore') }}"
          enctype="multipart/form-data" class="mt-3 space-y-2">
      {{ csrf_input }}
      <input type="file" name="backup" accept=".zip" required
             class="block w-full text-xs text-slate-600 file:mr-3 file:rounded-lg file:border-0 file:bg-slate-100 file:px-3 file:py-1.5 file:text-xs file:font-medium hover:file:bg-slate-200">
      <input name="confirm_name" placeholder="Type “{{ active_project.name }}” to confirm"
             class="w-full rounded-lg border border-slate-300 px-3 py-1.5 text-sm focus:border-slate-900 focus:outline-none">
      <button class="rounded-lg border border-red-300 bg-red-50 px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-100">
        Wipe &amp; restore
      </button>
    </form>
  </div>
</div>
{% endblock %}
