{% extends "control/base_control.jinja" %}
{% block page_title %}Backup &amp; restore{% endblock %}

{% block content %}
<div class="mx-auto max-w-2xl space-y-4">
  {% if include_sensitive %}
  <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
    <div class="flex items-start justify-between gap-3">
      <div>
        <h2 class="text-sm font-semibold text-slate-700">Automatic backups</h2>
        <p class="mt-1 text-xs text-slate-500">
          A full backup of this store — catalogue, CMS, theme, customers,
          orders and payments — taken automatically once a day (between
          midnight and 6am IST). The last {{ retention_days }} are kept;
          older ones are removed.
        </p>
      </div>
      <form method="post" action="{{ url('control:owner_backup_auto_toggle') }}" class="shrink-0">
        {{ csrf_input }}
        <label class="flex items-center gap-2 text-sm text-slate-700">
          <input type="checkbox" name="auto_backup" onchange="this.form.submit()"
                 {{ 'checked' if auto_backup_enabled }}
                 class="h-4 w-4 rounded border-slate-300">
          Automatic backup
        </label>
      </form>
    </div>
    {% if auto_snapshots %}
    <div class="mt-3 overflow-x-auto"><table class="w-full text-left text-sm">
      <thead class="text-xs uppercase tracking-wide text-slate-400">
        <tr><th class="py-1 pr-4">Taken</th><th class="py-1 pr-4">Size</th><th class="py-1"></th></tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {% for snap in auto_snapshots %}
        <tr>
          <td class="py-1.5 pr-4">{{ snap.created_at.strftime('%d %b %Y, %H:%M') }}</td>
          <td class="py-1.5 pr-4 text-slate-500">{{ (snap.size_bytes / 1024 / 1024) | round(1) }} MB</td>
          <td class="py-1.5 text-right whitespace-nowrap">
            <a href="{{ url('control:owner_backup_snapshot_download', kwargs={'pk': snap.pk}) }}"
               class="text-xs font-medium text-slate-600 hover:underline">Download</a>
            <form method="post" action="{{ url('control:owner_backup_snapshot_restore', kwargs={'pk': snap.pk}) }}"
                  class="ml-3 inline"
                  onsubmit="return confirm('Restore this store to its {{ snap.created_at.strftime('%d %b %Y, %H:%M') }} backup? Everything since then is overwritten. There is no undo.')">
              {{ csrf_input }}
              <button class="text-xs font-medium text-red-600 hover:underline">Restore</button>
            </form>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table></div>
    {% elif auto_backup_enabled %}
    <p class="mt-3 text-xs text-slate-400">No automatic backup yet — the first one runs within 24 hours.</p>
    {% else %}
    <p class="mt-3 text-xs text-slate-400">Off — check "Automatic backup" above to start daily backups.</p>
    {% endif %}
  </div>
  {% endif %}

  <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
    <h2 class="text-sm font-semibold text-slate-700">Download a backup</h2>
    {% if include_sensitive %}
    <p class="mt-1 text-xs text-slate-500">
      A portable <code>.zip</code> of your catalogue (products, categories,
      brands, variants, images), pages, banners, menus, theme, store profile —
      <b>and</b> your customers, orders and payment records. Coupons and
      settings are not included.
    </p>
    {% else %}
    <p class="mt-1 text-xs text-slate-500">
      A portable <code>.zip</code> of your catalogue (products, categories,
      brands, variants, images), pages, banners, menus, theme and store
      profile. Orders, customers, coupons and settings are not included.
    </p>
    {% endif %}
    <a href="{{ url('control:owner_backup_download') }}"
       class="mt-3 inline-block rounded-lg bg-slate-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-800">Download backup</a>
  </div>

  <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
    <h2 class="text-sm font-semibold text-slate-700">Restore from a backup</h2>
    {% if include_sensitive %}
    <p class="mt-1 text-xs text-slate-500">
      Replaces every product, category, page, banner and menu in this store
      with the contents of the file. If the file is one of <b>this store's own</b>
      backups, your customers, orders and payment records are replaced too —
      a backup from a different store never touches those, only its
      catalogue/CMS/theme. <b>There is no undo.</b>
    </p>
    {% else %}
    <p class="mt-1 text-xs text-slate-500">
      Replaces every product, category, page, banner and menu in this store
      with the contents of the file. Orders and customers are kept. <b>There is
      no undo.</b>
    </p>
    {% endif %}
    <form method="post" action="{{ url('control:owner_backup_restore') }}"
          enctype="multipart/form-data" class="mt-3 space-y-2">
      {{ csrf_input }}
      <input type="file" name="backup" accept=".zip" required
             class="block w-full text-xs text-slate-600 file:mr-3 file:rounded-lg file:border-0 file:bg-slate-100 file:px-3 file:py-1.5 file:text-xs file:font-medium hover:file:bg-slate-200">
      <input name="confirm_name" placeholder="Type “{{ active_project.name }}” to confirm"
             class="w-full rounded-lg border border-slate-300 px-3 py-1.5 text-sm focus:border-slate-900 focus:outline-none">
      <button class="rounded-lg border border-red-300 bg-red-50 px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-100">
        Wipe &amp; restore
      </button>
    </form>
  </div>
</div>
{% endblock %}
