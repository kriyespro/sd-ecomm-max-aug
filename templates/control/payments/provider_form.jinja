{% extends "control/base_control.jinja" %}
{% from "control/_forms.jinja" import render_form %}
{% block page_title %}Payment provider{% endblock %}

{% block content %}
<form method="post" enctype="multipart/form-data" class="mx-auto max-w-lg space-y-4 rounded-xl bg-white p-6 ring-1 ring-slate-200">
  {{ csrf_input }}
  {{ render_form(form) }}
  <p class="text-xs text-slate-400">
    COD needs no credentials. Direct UPI: add your UPI ID (and optionally your QR image) — customers pay you directly, then you confirm each payment from the order page. Razorpay webhook URL:
    <code>/payments/webhook/razorpay/</code> on your store domain.
  </p>
  <div class="flex gap-2 pt-2">
    <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">Save</button>
    <a href="{{ url('control:payment_providers') }}" class="rounded-lg px-4 py-2 text-sm text-slate-600 hover:bg-slate-100">Cancel</a>
  </div>
</form>
<script>
(function () {
  // PaymentProviderForm renders every provider's fields on one page (Key
  // ID/secret, UPI ID/payee/QR) — only show the ones the selected provider
  // actually uses, instead of handing every store owner all of them at once.
  var sel = document.getElementById("{{ form.provider.id_for_label }}");
  if (!sel) return;
  var groups = { razorpay: ["key_id", "key_secret"], upi: ["upi_id", "payee_name", "qr_image"] };
  var special = groups.razorpay.concat(groups.upi);
  function apply() {
    var val = sel.value;
    special.forEach(function (name) {
      var el = document.querySelector('[data-field="' + name + '"]');
      if (!el) return;
      var show = (groups.razorpay.indexOf(name) !== -1 && val === "razorpay") ||
                 (groups.upi.indexOf(name) !== -1 && val === "upi");
      el.classList.toggle("hidden", !show);
    });
  }
  sel.addEventListener("change", apply);
  apply();
})();
</script>
{% endblock %}
