{% extends "control/base_control.jinja" %}
{% block page_title %}Reconcile{% endblock %}

{% block content %}
<div class="space-y-4">
  <a href="{{ url('control:payment_providers') }}" class="text-sm text-slate-500 hover:underline">← Payments</a>
  <h2 class="text-sm font-semibold text-slate-700">Payment reconciliation · {{ active_project.name }}</h2>

  <div class="rounded-xl bg-white ring-1 ring-slate-200">
    {% if mismatches %}
    <div class="overflow-x-auto"><table class="w-full text-left text-sm min-w-[36rem]">
      <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
        <tr><th class="px-4 py-2">Order</th><th class="px-4 py-2">Issue</th></tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {% for order, issue in mismatches %}
        <tr>
          <td class="px-4 py-2"><a href="{{ url('control:order_detail', kwargs={'pk': order.pk}) }}" class="font-medium text-slate-900 hover:underline">{{ order.number }}</a></td>
          <td class="px-4 py-2 text-red-600">{{ issue }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table></div>
    {% else %}
    <p class="p-6 text-center text-sm text-emerald-700">All orders reconcile with their payments.</p>
    {% endif %}
  </div>
</div>
{% endblock %}
