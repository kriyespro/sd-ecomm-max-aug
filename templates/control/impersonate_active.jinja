{% extends "base.jinja" %}

{% block title %}Impersonating{% endblock %}

{% block body %}
<div class="flex min-h-screen items-center justify-center px-4">
  <div class="w-full max-w-md rounded-2xl bg-white p-8 text-center shadow-sm ring-1 ring-slate-200">
    <p class="text-sm text-slate-500">You are impersonating</p>
    <p class="mt-1 text-lg font-semibold">{{ request.user.get_username() }}</p>
    {% if target_is_staff %}
    <p class="mt-4 text-sm text-slate-500">
      Continue into Mission Control to see exactly what this user sees.
    </p>
    <a href="{{ url('control:dashboard') }}"
       class="mt-6 block w-full rounded-lg bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-800">
      Continue to Mission Control
    </a>
    {% else %}
    <p class="mt-4 text-sm text-slate-500">
      This account has no Mission Control access — a storefront view for a
      customer account arrives in a later phase. For now, use this session
      to exercise the user's data, then stop.
    </p>
    {% endif %}
    <form method="post" action="{{ url('control:impersonate_stop') }}" class="mt-3">
      {{ csrf_input }}
      <button class="w-full rounded-lg {{ 'border border-slate-300 text-slate-700 hover:bg-slate-50' if target_is_staff else 'bg-slate-900 text-white hover:bg-slate-800' }} px-3 py-2 text-sm font-medium">
        Stop impersonating
      </button>
    </form>
  </div>
</div>
{% endblock %}
