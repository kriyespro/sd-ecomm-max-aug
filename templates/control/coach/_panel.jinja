{# Daily coach: store score, streak, today's checklist, platform messages + tip.
   Re-rendered by htmx (hx-swap outerHTML) when a manual task is ticked. #}
{% set sc = coach_score %}
{# Full class strings (not 'bg-' ~ hue) so Tailwind's content scan keeps them. #}
{% set _tones = {
  "emerald": {"border": "border-emerald-400", "text": "text-emerald-600", "dot": "bg-emerald-500", "hex": "#10b981"},
  "sky":     {"border": "border-sky-400",     "text": "text-sky-600",     "dot": "bg-sky-500",     "hex": "#0ea5e9"},
  "amber":   {"border": "border-amber-400",   "text": "text-amber-600",   "dot": "bg-amber-500",   "hex": "#f59e0b"},
  "rose":    {"border": "border-rose-400",    "text": "text-rose-600",    "dot": "bg-rose-500",    "hex": "#f43f5e"},
} %}
{% set tn = _tones["emerald" if sc.score >= 75 else "sky" if sc.score >= 55 else "amber" if sc.score >= 30 else "rose"] %}
{% set stroke = tn.hex %}
<section id="coach-panel" hx-headers='{"X-CSRFToken": "{{ csrf_token }}"}' class="space-y-4">

  {# --- platform messages (superadmin) --- #}
  {% for it in coach_messages %}
  {% set m = it.mission %}
  <div class="rounded-2xl bg-indigo-600 p-4 text-white shadow-sm">
    <p class="text-sm font-semibold">{{ m.icon }} {{ m.title }}</p>
    {% if m.detail %}<p class="mt-1 text-xs leading-relaxed text-indigo-100">{{ m.detail }}</p>{% endif %}
    {% if it.cta %}<a href="{{ it.cta[1] }}" class="mt-2 inline-block rounded-lg bg-white/15 px-2.5 py-1 text-xs font-semibold hover:bg-white/25">{{ it.cta[0] }} →</a>{% endif %}
  </div>
  {% endfor %}

  {# --- store score --- #}
  <div class="rounded-2xl border-t-4 {{ tn.border }} bg-white p-5 shadow-sm ring-1 ring-slate-200">
    <div class="flex items-center gap-4">
      <div class="relative h-24 w-24 shrink-0">
        <svg viewBox="0 0 36 36" class="h-24 w-24 -rotate-90">
          <circle cx="18" cy="18" r="15.9155" fill="none" stroke="#f1f5f9" stroke-width="3.5"></circle>
          <circle cx="18" cy="18" r="15.9155" fill="none" stroke="{{ stroke }}" stroke-width="3.5"
                  stroke-linecap="round" stroke-dasharray="{{ sc.score }} 100"></circle>
        </svg>
        <div class="absolute inset-0 grid place-items-center text-center">
          <div><p class="text-2xl font-bold leading-none text-slate-900">{{ sc.score }}</p>
            <p class="text-[10px] text-slate-400">/ 100</p></div>
        </div>
      </div>
      <div class="min-w-0">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Store score</p>
        <p class="text-lg font-semibold {{ tn.text }}">{{ sc.tier }}</p>
        <p class="mt-0.5 text-xs text-slate-500">
          {% if coach_streak %}🔥 {{ coach_streak }}-day streak{% else %}No streak yet — do one task today{% endif %}
        </p>
      </div>
    </div>

    <ul class="mt-4 space-y-2">
      {% for p in sc.parts %}
      <li title="{{ p.hint }}">
        <div class="flex justify-between text-[11px] text-slate-500">
          <span>{{ p.label }}</span><span class="font-medium text-slate-700">{{ p.score }}/{{ p.max }}</span>
        </div>
        <div class="mt-0.5 h-1.5 rounded-full bg-slate-100">
          <div class="h-1.5 rounded-full" style="width: {{ (p.score / p.max * 100) | round }}%; background: {{ stroke }}"></div>
        </div>
      </li>
      {% endfor %}
    </ul>
    {% if sc.boost %}
    <p class="mt-3 rounded-lg bg-slate-50 px-3 py-2 text-xs text-slate-600">⚡ <span class="font-semibold">Quickest boost · {{ sc.boost_label }}:</span> {{ sc.boost }}</p>
    {% endif %}

    <div class="mt-3 flex items-center justify-between border-t border-slate-100 pt-3">
      <div class="flex gap-1" title="Last 7 days — filled when you finished a task">
        {% for d in coach_week %}
        <span class="h-2.5 w-2.5 rounded-full {{ tn.dot if d.done else 'bg-slate-200' }}" title="{{ d.day.strftime('%a %d %b') }}"></span>
        {% endfor %}
      </div>
      <p class="text-[11px] text-slate-400">
        Last activity: {% if coach_last %}{{ coach_last_ago }} ago{% else %}none yet{% endif %}
      </p>
    </div>
  </div>

  {# --- today's checklist --- #}
  <div data-tour="coach-checklist" class="rounded-2xl border-t-4 border-slate-800 bg-white p-5 shadow-sm ring-1 ring-slate-200">
    <div class="flex items-center justify-between">
      <h2 class="text-sm font-semibold text-slate-700">✅ Today's to-do</h2>
      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">{{ coach_done }}/{{ coach_total }} · {{ coach_points }} pts</span>
    </div>
    {% if coach_total %}
    <div class="mt-2 h-1.5 rounded-full bg-slate-100">
      <div class="h-1.5 rounded-full bg-slate-800 transition-all" style="width: {{ (coach_done / coach_total * 100) | round }}%"></div>
    </div>
    {% if coach_done == coach_total %}
    <p class="mt-3 rounded-lg bg-emerald-50 px-3 py-2 text-xs font-medium text-emerald-700">🎉 All done for today — see you tomorrow!</p>
    {% endif %}
    <ul class="mt-3 divide-y divide-slate-100">
      {% for r in coach_rows %}
      {% set m = r.mission %}
      <li class="flex items-start gap-3 py-2.5">
        {% if r.auto %}
        <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-md border {{ 'border-emerald-500 bg-emerald-500 text-white' if r.done else 'border-slate-300 text-transparent' }} text-xs" title="Ticks itself when you do it">✓</span>
        {% else %}
        <button type="button" hx-post="{{ url('control:coach_toggle', kwargs={'pk': m.pk}) }}" hx-target="#coach-panel" hx-swap="outerHTML"
                aria-label="{{ 'Mark not done' if r.done else 'Mark done' }}"
                class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-md border text-xs {{ 'border-emerald-500 bg-emerald-500 text-white' if r.done else 'border-slate-300 text-transparent hover:border-slate-500' }}">✓</button>
        {% endif %}
        <div class="min-w-0 flex-1">
          <p class="text-sm {{ 'text-slate-400 line-through' if r.done else 'font-medium text-slate-800' }}">{{ m.icon }} {{ m.title }}</p>
          {% if not r.done and m.detail %}<p class="mt-0.5 text-xs leading-relaxed text-slate-500">{{ m.detail }}</p>{% endif %}
          {% if r.auto and r.target > 1 %}
          <div class="mt-1.5 flex items-center gap-2">
            <div class="h-1 flex-1 rounded-full bg-slate-100"><div class="h-1 rounded-full bg-emerald-500" style="width: {{ (r.progress / r.target * 100) | round }}%"></div></div>
            <span class="text-[11px] text-slate-400">{{ r.progress }}/{{ r.target }}</span>
          </div>
          {% endif %}
          {% if r.cta and not r.done %}
          <a href="{{ r.cta[1] }}" class="mt-1.5 inline-block text-xs font-medium text-indigo-700 hover:underline">{{ r.cta[0] }} →</a>
          {% endif %}
        </div>
        <span class="shrink-0 text-[11px] text-slate-400">+{{ m.points }}</span>
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="mt-3 text-sm text-slate-400">No tasks today.</p>
    {% endif %}
  </div>

  {# --- tip of the day --- #}
  {% if coach_tip %}
  {% set tip = coach_tip.mission %}
  <div class="rounded-2xl bg-amber-50 p-4 ring-1 ring-amber-200">
    <p class="text-sm font-semibold text-amber-900">{{ tip.icon }} {{ tip.title }}</p>
    {% if tip.detail %}<p class="mt-1 text-xs leading-relaxed text-amber-800">{{ tip.detail }}</p>{% endif %}
    {% if coach_tip.cta %}<a href="{{ coach_tip.cta[1] }}" class="mt-2 inline-block text-xs font-semibold text-amber-900 hover:underline">{{ coach_tip.cta[0] }} →</a>{% endif %}
  </div>
  {% endif %}
</section>
