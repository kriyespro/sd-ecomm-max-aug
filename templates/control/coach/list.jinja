{% extends "control/base_control.jinja" %}
{% block page_title %}Daily coach{% endblock %}

{% block content %}
<div class="space-y-4">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 class="text-sm font-semibold text-slate-700">Daily coach — tasks, tips &amp; messages</h2>
    <div class="flex gap-2">
      <a href="{{ url('control:coach_create') }}?kind=message" class="rounded-lg px-3 py-1.5 text-sm text-slate-600 hover:bg-slate-100">+ Message</a>
      <a href="{{ url('control:coach_create') }}?kind=tip" class="rounded-lg px-3 py-1.5 text-sm text-slate-600 hover:bg-slate-100">+ Tip</a>
      <a href="{{ url('control:coach_create') }}?kind=task" class="rounded-lg bg-slate-900 px-3 py-1.5 text-sm text-white hover:bg-slate-800">+ Task</a>
    </div>
  </div>
  <p class="text-xs text-slate-500">
    Store owners and managers see these in the right-hand panel of their dashboard.
    <strong>Tasks</strong> form the daily checklist (auto ones tick themselves),
    <strong>messages</strong> are pinned notices (set an end date), and <strong>tips</strong>
    rotate one per day.
  </p>

  <div class="overflow-x-auto rounded-xl bg-white ring-1 ring-slate-200">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
        <tr><th class="px-4 py-2">Type</th><th class="px-4 py-2">Title</th><th class="px-4 py-2">Completes</th>
          <th class="px-4 py-2">Shows</th><th class="px-4 py-2">Done today</th><th class="px-4 py-2">Live</th><th class="px-4 py-2"></th></tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {% for m in missions %}
        <tr class="hover:bg-slate-50">
          <td class="px-4 py-2 text-slate-500">{{ m.get_kind_display() }}</td>
          <td class="px-4 py-2 font-medium text-slate-800">{{ m.icon }} {{ m.title }}</td>
          <td class="px-4 py-2 text-slate-500">{% if m.kind == 'task' %}{{ 'Auto · ' ~ m.auto_key ~ (' ×' ~ m.target if m.target > 1 else '') if m.auto_key else 'Owner ticks' }}{% else %}—{% endif %}</td>
          <td class="px-4 py-2 text-xs text-slate-400">{{ m.starts_on or 'now' }} → {{ m.ends_on or 'no end' }}</td>
          <td class="px-4 py-2 text-slate-500">{% if m.kind == 'task' %}{{ m.done_today }} <span class="text-xs text-slate-400">({{ m.done_week }} this week)</span>{% else %}—{% endif %}</td>
          <td class="px-4 py-2">
            <span class="rounded px-2 py-0.5 text-xs {{ 'bg-emerald-100 text-emerald-700' if m.is_active else 'bg-slate-200 text-slate-600' }}">{{ "yes" if m.is_active else "no" }}</span>
          </td>
          <td class="px-4 py-2 text-right"><a href="{{ url('control:coach_edit', kwargs={'pk': m.pk}) }}" class="text-slate-600 hover:underline">Edit</a></td>
        </tr>
        {% else %}
        <tr><td colspan="7" class="px-4 py-6 text-center text-slate-400">Nothing yet.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
