{% extends "control/base_control.jinja" %}
{% from "control/_forms.jinja" import render_form %}
{% block page_title %}{{ store.name }}{% endblock %}

{% block content %}
<div class="mx-auto max-w-3xl space-y-5">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <a href="{{ url('control:stores') }}" class="text-xs text-slate-400 hover:underline">← Stores</a>
      <h2 class="text-xl font-semibold text-slate-900">{{ store.name }}</h2>
      <p class="text-xs text-slate-500">{{ store.primary_domain or 'no domain yet' }} · {{ store.currency }}</p>
    </div>
    <form method="post" action="{{ url('control:store_switch', kwargs={'pk': store.pk}) }}">
      {{ csrf_input }}
      <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">Work on this store</button>
    </form>
  </div>

  {# plan #}
  <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
    <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-400">Subscription</p>
    {% if subscription %}
    <p class="mt-1 text-sm text-slate-800">
      {{ subscription.plan.name }} · {{ subscription.period }} ·
      <span class="rounded px-1.5 py-0.5 text-[10px] font-semibold uppercase
        {{ 'bg-emerald-100 text-emerald-700' if subscription.status in ('active','trialing') else 'bg-amber-100 text-amber-800' if subscription.status == 'past_due' else 'bg-red-100 text-red-700' }}">{{ subscription.status }}</span>
    </p>
    <p class="mt-0.5 text-xs text-slate-400">
      {% if subscription.status == 'trialing' %}Trial ends {{ subscription.trial_end.strftime('%d %b %Y') }}{% else %}Renews {{ subscription.current_period_end.strftime('%d %b %Y') }}{% endif %}
      {% if subscription.manager_id %} · manager {{ subscription.manager.email }}{% endif %}
    </p>
    {% else %}<p class="mt-1 text-sm text-slate-400">No subscription.</p>{% endif %}
    {% if is_admin and manager_form %}
    <form method="post" action="{{ url('control:store_manager_assign', kwargs={'pk': store.pk}) }}"
          class="mt-3 flex flex-wrap items-end gap-2 border-t border-slate-100 pt-3">
      {{ csrf_input }}
      <div class="w-64">{{ render_form(manager_form) }}</div>
      <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">Assign</button>
    </form>
    {% endif %}
  </div>

  {# details to relay to the owner #}
  <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
    <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-400">Share with the owner</p>
    <dl class="mt-2 grid gap-x-4 gap-y-1 text-sm sm:grid-cols-3">
      <dt class="text-slate-400">Store URL</dt>
      <dd class="sm:col-span-2 break-all">{{ store_url }}</dd>
      <dt class="text-slate-400">Mission Control</dt>
      <dd class="sm:col-span-2 break-all">{{ control_login_url }}</dd>
      <dt class="text-slate-400">Owner login</dt>
      <dd class="sm:col-span-2 break-all">
        {% if owner_membership %}
          {{ owner_membership.user.email }}
          {% if not owner_membership.user.has_usable_password() %}
          — no password set yet,
          <a href="{{ url('control:user_set_password', kwargs={'pk': owner_membership.user.pk}) }}" class="text-amber-600 underline">set one</a>
          {% else %}
          — their existing password
          {% endif %}
        {% else %}<span class="text-slate-400">No owner yet.</span>{% endif %}
      </dd>
    </dl>
    <p class="mt-2 text-xs text-slate-400">Copy these to an email or chat message for the owner — nothing is sent automatically.</p>
  </div>

  {# members #}
  <div class="rounded-xl bg-white ring-1 ring-slate-200">
    <div class="border-b border-slate-200 p-4 text-sm font-semibold text-slate-700">Team</div>
    <div class="overflow-x-auto"><table class="w-full text-left text-sm min-w-[36rem]">
      <tbody class="divide-y divide-slate-100">
        {% for m in members %}
        <tr>
          <td class="px-4 py-2">
            <span class="font-medium text-slate-800">{{ m.user.get_full_name() or m.user.get_username() }}</span>
            <span class="block text-xs text-slate-400">{{ m.user.email }}</span>
          </td>
          <td class="px-4 py-2">
            <span class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-semibold uppercase text-slate-600">{{ m.get_role_display() }}</span>
            {% if not m.user.has_usable_password() %}<a href="{{ url('control:user_set_password', kwargs={'pk': m.user.pk}) }}" class="ml-1 text-[10px] text-amber-600 underline">set password</a>{% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table></div>
    <form method="post" action="{{ url('control:store_member_add', kwargs={'pk': store.pk}) }}"
          class="flex flex-wrap items-end gap-2 border-t border-slate-200 p-4">
      {{ csrf_input }}
      <input name="email" type="email" required placeholder="person@email.com"
             class="min-w-[14rem] flex-1 rounded-lg border border-slate-300 px-3 py-2 text-sm">
      <input name="name" placeholder="Name (if new)" class="w-40 rounded-lg border border-slate-300 px-3 py-2 text-sm">
      <input name="password" type="password" autocomplete="new-password" placeholder="Password (if new)"
             class="w-44 rounded-lg border border-slate-300 px-3 py-2 text-sm">
      <select name="role" class="rounded-lg border border-slate-300 px-2 py-2 text-sm">
        {% for val, label in role_choices %}<option value="{{ val }}">{{ label }}</option>{% endfor %}
      </select>
      <button class="rounded-lg bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-800">Add</button>
    </form>
  </div>

  <p class="text-xs text-slate-400">
    Catalog, orders, inventory and store settings live inside the store —
    click <span class="font-medium">Work on this store</span> above.
  </p>

  {% if is_superuser %}
  <div class="rounded-xl border border-red-200 bg-red-50 p-5">
    <p class="text-[11px] font-semibold uppercase tracking-wide text-red-700">Danger zone</p>

    <div class="mt-3 flex flex-wrap items-center justify-between gap-2 border-b border-red-100 pb-3">
      <div>
        <p class="text-sm font-medium text-slate-800">
          {% if store.status == 'archived' %}This store is archived{% else %}Archive this store{% endif %}
        </p>
        <p class="text-xs text-slate-500">
          {% if store.status == 'archived' %}Its storefront is offline. Mission Control still works for the owner.{% else %}Closes the storefront to visitors. Reversible — nothing is deleted.{% endif %}
        </p>
      </div>
      {% if store.status == 'archived' %}
      <form method="post" action="{{ url('control:store_unarchive', kwargs={'pk': store.pk}) }}">
        {{ csrf_input }}
        <button class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Unarchive</button>
      </form>
      {% else %}
      <form method="post" action="{{ url('control:store_archive', kwargs={'pk': store.pk}) }}">
        {{ csrf_input }}
        <button class="rounded-lg border border-red-300 bg-white px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-100">Archive</button>
      </form>
      {% endif %}
    </div>

    <div class="mt-3">
      <p class="text-sm font-medium text-slate-800">Delete this store</p>
      <p class="text-xs text-slate-500">
        Permanently deletes {{ store.name }} and everything in it — products, orders,
        customers, everything. There is no undo.
      </p>
      <form method="post" action="{{ url('control:store_delete', kwargs={'pk': store.pk}) }}"
            class="mt-2 flex flex-wrap items-center gap-2"
            onsubmit="return confirm('Permanently delete {{ store.name }}? This cannot be undone.');">
        {{ csrf_input }}
        <input name="confirm_name" required placeholder="Type “{{ store.name }}” to confirm"
               class="min-w-[16rem] flex-1 rounded-lg border border-red-300 px-3 py-2 text-sm">
        <button class="rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700">Delete forever</button>
      </form>
    </div>
  </div>
  {% endif %}
</div>
{% endblock %}
