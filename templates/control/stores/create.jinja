{% extends "control/base_control.jinja" %}
{% from "control/_forms.jinja" import render_field %}
{% block page_title %}New store{% endblock %}

{% set _INPUT = "block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm transition focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500" %}

{% block content %}
<form method="post" class="mx-auto max-w-2xl space-y-5 rounded-xl bg-white p-6 ring-1 ring-slate-200">
  {{ csrf_input }}
  <div>
    <h2 class="text-sm font-semibold text-slate-700">Create a store</h2>
    <p class="mt-1 text-xs text-slate-500">
      Creates the store, its owner account, and a trial subscription. Set an
      owner password below so a new owner can sign in right away; an existing
      account keeps its current login.
    </p>
  </div>

  {% if form.non_field_errors() %}
  <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">{{ form.non_field_errors()|join(' ') }}</div>
  {% endif %}

  {% for field in form.visible_fields() %}
    {% if field.name == 'subdomain' and base_domain %}
    <div class="space-y-1">
      <label for="{{ field.id_for_label }}" class="block text-sm font-medium text-slate-700">{{ field.label }}</label>
      <div class="mt-1 flex">
        {{ field.as_widget(attrs={"class": _INPUT ~ " rounded-r-none", "placeholder": "your-store"}) }}
        <span class="inline-flex items-center whitespace-nowrap rounded-r-lg border border-l-0 border-slate-300 bg-slate-50 px-3 text-sm text-slate-500">.{{ base_domain }}</span>
      </div>
      {% if field.help_text %}<p class="text-xs text-slate-400">{{ field.help_text }}</p>{% endif %}
      {% for error in field.errors %}<p class="text-xs text-red-600">{{ error }}</p>{% endfor %}
    </div>
    {% else %}
    {{ render_field(field) }}
    {% endif %}
  {% endfor %}
  {% for field in form.hidden_fields() %}{{ field }}{% endfor %}

  <div class="flex gap-2 pt-1">
    <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">Create store</button>
    <a href="{{ url('control:stores') }}" class="rounded-lg px-4 py-2 text-sm text-slate-600 hover:bg-slate-100">Cancel</a>
  </div>
</form>

{% if base_domain %}
<script>
(function () {
  var name = document.getElementById("id_name");
  var sub = document.getElementById("id_subdomain");
  if (!name || !sub) return;
  var edited = sub.value.trim() !== "";
  sub.addEventListener("input", function () { edited = true; });
  function slugify(v) {
    return (v || "").toLowerCase().replace(/[^a-z0-9-]+/g, "-")
      .replace(/-{2,}/g, "-").replace(/^-|-$/g, "").slice(0, {{ form.fields.subdomain.max_length }});
  }
  name.addEventListener("input", function () {
    if (!edited) sub.value = slugify(name.value);
  });
})();
</script>
{% endif %}
{% endblock %}
