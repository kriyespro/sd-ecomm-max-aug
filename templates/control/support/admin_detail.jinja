{% extends "control/base_control.jinja" %}
{% from "control/_forms.jinja" import render_form %}
{% block page_title %}{{ ticket.subject }}{% endblock %}

{% set status_badge = {
  'open':        'bg-sky-100 text-sky-700',
  'in_progress': 'bg-amber-100 text-amber-700',
  'planned':     'bg-indigo-100 text-indigo-700',
  'resolved':    'bg-emerald-100 text-emerald-700',
  'closed':      'bg-slate-200 text-slate-600',
} %}

{% block content %}
<div class="grid gap-4 lg:grid-cols-3">
  <div class="space-y-4 lg:col-span-2">
    <a href="{{ url('control:support_queue') }}" class="text-xs text-slate-500 hover:underline">&larr; Support tickets</a>

    <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h2 class="text-base font-semibold text-slate-800">{{ ticket.subject }}</h2>
          <p class="mt-1 text-xs text-slate-400">
            {{ ticket.get_kind_display() }} &middot; {{ ticket.project.name }}
            &middot; {{ ticket.get_created_by_role_display() }} {{ ticket.created_by.email if ticket.created_by else '' }}
            &middot; opened {{ ticket.created_at.strftime('%d %b %Y') }}
          </p>
        </div>
        <span class="rounded px-2 py-0.5 text-xs {{ status_badge.get(ticket.status, 'bg-slate-200 text-slate-600') }}">{{ ticket.get_status_display() }}</span>
      </div>
      <p class="mt-4 whitespace-pre-wrap text-sm text-slate-700">{{ ticket.description }}</p>
      {% if ticket.kind == 'feature_request' %}
      <p class="mt-3 text-xs font-semibold text-slate-500">{{ vote_count }} vote{{ 's' if vote_count != 1 }}</p>
      {% endif %}
    </div>

    <div class="space-y-3">
      {% for m in thread %}
      <div class="rounded-xl p-4 ring-1 {{ 'bg-amber-50 ring-amber-200' if m.is_internal_note else ('bg-slate-900 text-white ring-slate-900' if m.author_role == 'admin' else 'bg-white ring-slate-200') }}">
        <p class="text-xs {{ 'text-amber-700' if m.is_internal_note else ('text-slate-300' if m.author_role == 'admin' else 'text-slate-400') }}">
          {% if m.is_internal_note %}Internal note{% elif m.author_role == 'admin' %}Platform team{% else %}{{ m.author.get_full_name() or m.author.email if m.author else 'Someone' }}{% endif %}
          &middot; {{ m.created_at.strftime('%d %b, %H:%M') }}
        </p>
        <p class="mt-1 whitespace-pre-wrap text-sm {{ 'text-amber-900' if m.is_internal_note else ('' if m.author_role == 'admin' else 'text-slate-700') }}">{{ m.body }}</p>
      </div>
      {% endfor %}
    </div>

    <form method="post" action="{{ url('control:support_queue_reply', kwargs={'pk': ticket.pk}) }}"
          class="space-y-3 rounded-xl bg-white p-4 ring-1 ring-slate-200">
      {{ csrf_input }}
      {{ render_form(reply_form) }}
      <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">Send</button>
    </form>
  </div>

  <div class="space-y-4">
    <form method="post" action="{{ url('control:support_queue_update', kwargs={'pk': ticket.pk}) }}"
          class="space-y-3 rounded-xl bg-white p-4 ring-1 ring-slate-200">
      {{ csrf_input }}
      <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Triage</h3>
      {{ render_form(update_form) }}
      <button class="w-full rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">Update</button>
    </form>
  </div>
</div>
{% endblock %}
