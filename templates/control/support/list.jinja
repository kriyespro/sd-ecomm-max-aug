{% extends "control/base_control.jinja" %}
{% block page_title %}Support & ideas{% endblock %}

{% set status_badge = {
  'open':        'bg-sky-100 text-sky-700',
  'in_progress': 'bg-amber-100 text-amber-700',
  'planned':     'bg-indigo-100 text-indigo-700',
  'resolved':    'bg-emerald-100 text-emerald-700',
  'closed':      'bg-slate-200 text-slate-600',
} %}

{% block content %}
<div class="mx-auto max-w-4xl space-y-10">

  {# ---------------------------------------------------- feature requests #}
  <section class="space-y-3">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-sm font-semibold text-slate-700">Feature requests</h2>
        <p class="text-xs text-slate-500">Platform-wide board — every store sees it. Vote on an existing idea instead of filing a duplicate.</p>
      </div>
      <a href="{{ url('control:support_create') }}?kind=feature_request"
         class="rounded-lg bg-slate-900 px-3 py-1.5 text-sm text-white hover:bg-slate-800">New idea</a>
    </div>

    <div class="divide-y divide-slate-100 rounded-xl bg-white ring-1 ring-slate-200">
      {% for t in ideas %}
      <div class="flex items-center gap-4 px-4 py-3">
        <form method="post" action="{{ url('control:support_vote', kwargs={'pk': t.pk}) }}">
          {{ csrf_input }}
          <input type="hidden" name="next" value="{{ url('control:support') }}">
          <button type="submit"
                  class="flex w-12 flex-col items-center rounded-lg py-1 text-xs font-semibold ring-1 {{ 'bg-slate-900 text-white ring-slate-900' if t.pk in voted_ids else 'text-slate-600 ring-slate-200 hover:bg-slate-50' }}">
            <span>&#9650;</span><span>{{ t.vote_count }}</span>
          </button>
        </form>
        <div class="min-w-0 flex-1">
          <a href="{{ url('control:support_detail', kwargs={'pk': t.pk}) }}" class="truncate text-sm font-medium text-slate-800 hover:underline">{{ t.subject }}</a>
          <p class="mt-0.5 text-xs text-slate-400">Requested by {{ t.project.name }} &middot; {{ t.created_at.strftime('%d %b %Y') }}</p>
        </div>
        <span class="rounded px-2 py-0.5 text-xs {{ status_badge.get(t.status, 'bg-slate-200 text-slate-600') }}">{{ t.get_status_display() }}</span>
      </div>
      {% else %}
      <p class="px-4 py-6 text-center text-sm text-slate-400">No feature requests yet — be the first.</p>
      {% endfor %}
    </div>
  </section>

  {# --------------------------------------------------------- own tickets #}
  <section class="space-y-3">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-sm font-semibold text-slate-700">Your tickets</h2>
        <p class="text-xs text-slate-500">Bugs, support and billing questions — private to {{ active_project.name }} and the platform team.</p>
      </div>
      <a href="{{ url('control:support_create') }}"
         class="rounded-lg px-3 py-1.5 text-sm text-slate-600 ring-1 ring-slate-300 hover:bg-slate-50">New ticket</a>
    </div>

    <div class="overflow-x-auto rounded-xl bg-white ring-1 ring-slate-200">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
          <tr><th class="px-4 py-2">Subject</th><th class="px-4 py-2">Type</th>
            <th class="px-4 py-2">Status</th><th class="px-4 py-2">Opened</th></tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {% for t in my_tickets %}
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-2"><a href="{{ url('control:support_detail', kwargs={'pk': t.pk}) }}" class="font-medium text-slate-800 hover:underline">{{ t.subject }}</a></td>
            <td class="px-4 py-2 text-slate-500">{{ t.get_kind_display() }}</td>
            <td class="px-4 py-2"><span class="rounded px-2 py-0.5 text-xs {{ status_badge.get(t.status, 'bg-slate-200 text-slate-600') }}">{{ t.get_status_display() }}</span></td>
            <td class="px-4 py-2 text-slate-400">{{ t.created_at.strftime('%d %b %Y') }}</td>
          </tr>
          {% else %}
          <tr><td colspan="4" class="px-4 py-6 text-center text-slate-400">No tickets yet.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
</div>
{% endblock %}
