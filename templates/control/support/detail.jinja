{% extends "control/base_control.jinja" %}
{% from "control/_forms.jinja" import render_form %}
{% block page_title %}{{ ticket.subject }}{% endblock %}

{% set status_badge = {
  'open':        'bg-sky-100 text-sky-700',
  'in_progress': 'bg-amber-100 text-amber-700',
  'planned':     'bg-indigo-100 text-indigo-700',
  'resolved':    'bg-emerald-100 text-emerald-700',
  'closed':      'bg-slate-200 text-slate-600',
} %}

{% block content %}
<div class="mx-auto max-w-2xl space-y-4">
  <a href="{{ url('control:support') }}" class="text-xs text-slate-500 hover:underline">&larr; Support &amp; ideas</a>

  <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
    <div class="flex items-start justify-between gap-3">
      <div>
        <h2 class="text-base font-semibold text-slate-800">{{ ticket.subject }}</h2>
        <p class="mt-1 text-xs text-slate-400">
          {{ ticket.get_kind_display() }} &middot; opened {{ ticket.created_at.strftime('%d %b %Y') }}
          {% if ticket.is_global %}&middot; requested by {{ ticket.project.name }}{% endif %}
        </p>
      </div>
      <span class="rounded px-2 py-0.5 text-xs {{ status_badge.get(ticket.status, 'bg-slate-200 text-slate-600') }}">{{ ticket.get_status_display() }}</span>
    </div>
    <p class="mt-4 whitespace-pre-wrap text-sm text-slate-700">{{ ticket.description }}</p>

    {% if ticket.kind == 'feature_request' %}
    <form method="post" action="{{ url('control:support_vote', kwargs={'pk': ticket.pk}) }}" class="mt-4">
      {{ csrf_input }}
      <input type="hidden" name="next" value="{{ url('control:support_detail', kwargs={'pk': ticket.pk}) }}">
      <button type="submit"
              class="rounded-lg px-3 py-1.5 text-xs font-semibold ring-1 {{ 'bg-slate-900 text-white ring-slate-900' if has_voted else 'text-slate-600 ring-slate-200 hover:bg-slate-50' }}">
        &#9650; {{ vote_count }} vote{{ 's' if vote_count != 1 }}{{ ' — you voted' if has_voted }}
      </button>
    </form>
    {% endif %}
  </div>

  <div class="space-y-3">
    {% for m in thread %}
    <div class="rounded-xl p-4 ring-1 {{ 'bg-slate-900 text-white ring-slate-900' if m.author_role == 'admin' else 'bg-white ring-slate-200' }}">
      <p class="text-xs {{ 'text-slate-300' if m.author_role == 'admin' else 'text-slate-400' }}">
        {{ 'Platform team' if m.author_role == 'admin' else (m.author.get_full_name() or m.author.email if m.author else 'Someone') }}
        &middot; {{ m.created_at.strftime('%d %b, %H:%M') }}
      </p>
      <p class="mt-1 whitespace-pre-wrap text-sm {{ '' if m.author_role == 'admin' else 'text-slate-700' }}">{{ m.body }}</p>
    </div>
    {% endfor %}
  </div>

  <form method="post" action="{{ url('control:support_reply', kwargs={'pk': ticket.pk}) }}"
        class="space-y-3 rounded-xl bg-white p-4 ring-1 ring-slate-200">
    {{ csrf_input }}
    {{ render_form(reply_form) }}
    <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">Reply</button>
    {% if ticket.is_closed %}
    <p class="text-xs text-slate-400">This ticket is {{ ticket.get_status_display()|lower }} — replying reopens it.</p>
    {% endif %}
  </form>
</div>
{% endblock %}
