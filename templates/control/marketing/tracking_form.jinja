{% extends "control/base_control.jinja" %}
{% from "control/_forms.jinja" import render_form %}
{% block page_title %}Tracking{% endblock %}

{% block content %}
<form method="post" class="mx-auto max-w-lg space-y-4 rounded-xl bg-white p-6 ring-1 ring-slate-200">
  {{ csrf_input }}
  {{ render_form(form) }}
  <p class="text-xs text-slate-400">
    Find the Pixel ID and Conversions API token in Meta
    <a class="underline" href="https://business.facebook.com/events_manager2" target="_blank" rel="noopener">Events Manager</a>.
    The token is write-only here — leave it blank when editing to keep the saved one.
  </p>
  <div class="flex gap-2 pt-2">
    <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">Save</button>
    <a href="{{ url('control:tracking') }}" class="rounded-lg px-4 py-2 text-sm text-slate-600 hover:bg-slate-100">Cancel</a>
    {% if object %}
    <button formaction="{{ url('control:tracking_delete', kwargs={'pk': object.pk}) }}"
            formnovalidate
            class="ml-auto rounded-lg px-4 py-2 text-sm text-red-600 hover:bg-red-50">Remove</button>
    {% endif %}
  </div>
</form>
{% endblock %}
