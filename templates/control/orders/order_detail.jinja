{% extends "control/base_control.jinja" %}
{% block page_title %}Order {{ order.number }}{% endblock %}

{% macro addr(a) %}
  {% if a and a.get('name') %}
    <p class="font-medium text-slate-700">{{ a.get('name') }}</p>
    <p>{{ a.get('line1') }}{% if a.get('line2') %}, {{ a.get('line2') }}{% endif %}</p>
    <p>{{ a.get('city') }}{% if a.get('state') %}, {{ a.get('state') }}{% endif %} {{ a.get('postal_code') }}</p>
    <p>{{ a.get('country') }}</p>
    {% if a.get('phone') %}<p class="text-slate-400">{{ a.get('phone') }}</p>{% endif %}
  {% else %}
    <p class="text-slate-400">—</p>
  {% endif %}
{% endmacro %}

{% block content %}
<div class="space-y-4">
  <a href="{{ url('control:order_list') }}" class="text-sm text-slate-500 hover:underline">← Orders</a>

  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h2 class="text-lg font-semibold text-slate-800">{{ order.number }}</h2>
      <p class="text-sm text-slate-500">{{ (order.placed_at or order.created_at).strftime("%b %d, %Y %H:%M") }} · {{ order.email }}{% if order.phone %} · {{ order.phone }}{% endif %}</p>
    </div>
    <div class="flex items-center gap-2 text-xs">
      <span class="rounded bg-slate-200 px-2 py-1 text-slate-700">{{ order.get_status_display() }}</span>
      <span class="rounded bg-slate-200 px-2 py-1 text-slate-700">{{ order.get_payment_status_display() }}</span>
      <span class="rounded bg-slate-200 px-2 py-1 text-slate-700">{{ order.get_fulfillment_status_display() }}</span>
    </div>
  </div>

  <div class="grid gap-4 lg:grid-cols-3">
    {# --- Items + totals --- #}
    <div class="lg:col-span-2 space-y-4">
      <div class="overflow-x-auto rounded-xl bg-white ring-1 ring-slate-200">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
            <tr><th class="px-4 py-2">Item</th><th class="px-4 py-2">SKU</th>
              <th class="px-4 py-2 text-right">Unit</th><th class="px-4 py-2 text-right">Qty</th>
              <th class="px-4 py-2 text-right">Fulfilled</th><th class="px-4 py-2 text-right">Total</th></tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {% for i in order.items.all() %}
            <tr>
              <td class="px-4 py-2">{{ i.product_title }}{% if i.variant_name %} <span class="text-slate-400">· {{ i.variant_name }}</span>{% endif %}</td>
              <td class="px-4 py-2 text-slate-500">{{ i.sku or "—" }}</td>
              <td class="px-4 py-2 text-right">{{ i.unit_price }}</td>
              <td class="px-4 py-2 text-right">{{ i.quantity }}</td>
              <td class="px-4 py-2 text-right text-slate-500">{{ i.fulfilled_quantity }}</td>
              <td class="px-4 py-2 text-right font-medium">{{ i.line_total }}</td>
            </tr>
            {% endfor %}
          </tbody>
          <tfoot class="border-t border-slate-200 text-sm">
            <tr><td colspan="5" class="px-4 py-1 text-right text-slate-500">Subtotal</td><td class="px-4 py-1 text-right">{{ order.subtotal }}</td></tr>
            <tr><td colspan="5" class="px-4 py-1 text-right text-slate-500">Discount</td><td class="px-4 py-1 text-right">−{{ order.discount_total }}</td></tr>
            <tr><td colspan="5" class="px-4 py-1 text-right text-slate-500">Tax</td><td class="px-4 py-1 text-right">{{ order.tax_total }}</td></tr>
            <tr><td colspan="5" class="px-4 py-1 text-right text-slate-500">Shipping</td><td class="px-4 py-1 text-right">{{ order.shipping_total }}</td></tr>
            <tr class="font-semibold"><td colspan="5" class="px-4 py-2 text-right">Grand total</td><td class="px-4 py-2 text-right">{{ order.currency }} {{ order.grand_total }}</td></tr>
          </tfoot>
        </table>
      </div>

      {# --- Timeline --- #}
      <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
        <h3 class="text-sm font-semibold text-slate-700">Timeline</h3>
        <ul class="mt-3 space-y-2 text-sm">
          {% for e in events %}
          <li class="flex gap-3">
            <span class="text-slate-400">{{ e.created_at.strftime("%b %d %H:%M") }}</span>
            <span>
              <span class="font-medium text-slate-600">{{ e.get_kind_display() }}</span>
              {% if e.from_value or e.to_value %} · {{ e.from_value or "—" }} → {{ e.to_value }}{% endif %}
              {% if e.note %} <span class="text-slate-500">— {{ e.note }}</span>{% endif %}
              {% if e.actor %}<span class="text-slate-400"> ({{ e.actor.get_username() }})</span>{% endif %}
            </span>
          </li>
          {% else %}
          <li class="text-slate-400">No events.</li>
          {% endfor %}
        </ul>
      </div>
    </div>

    {# --- Sidebar: actions --- #}
    <div class="space-y-4">
      <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200 space-y-3">
        <h3 class="text-sm font-semibold text-slate-700">Actions</h3>

        {% if allowed_transitions %}
        <form method="post" action="{{ url('control:order_status', kwargs={'pk': order.pk}) }}" class="space-y-2">
          {{ csrf_input }}
          <select name="to_status" class="w-full rounded-lg border border-slate-300 px-2 py-2 text-sm">
            {% for s in allowed_transitions %}<option value="{{ s }}">{{ s }}</option>{% endfor %}
          </select>
          <input type="text" name="note" placeholder="Note (optional)" class="w-full rounded-lg border border-slate-300 px-2 py-2 text-sm">
          <button class="w-full rounded-lg bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-800">Change status</button>
        </form>
        {% endif %}

        {% if order.fulfillment_status != 'fulfilled' %}
        <form method="post" action="{{ url('control:order_fulfill', kwargs={'pk': order.pk}) }}">
          {{ csrf_input }}
          <button class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm hover:bg-slate-50">Fulfil &amp; consume stock</button>
        </form>
        {% endif %}
      </div>

      {# --- Payments --- #}
      <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200 space-y-3">
        <h3 class="text-sm font-semibold text-slate-700">Payments</h3>

        {% for p in payments %}
        <div class="rounded-lg border border-slate-200 p-3 text-sm">
          <div class="flex items-center justify-between">
            <span class="font-medium text-slate-700">{{ p.get_provider_display() }}</span>
            <span class="rounded px-2 py-0.5 text-xs {{ 'bg-emerald-100 text-emerald-700' if p.status == 'paid' else 'bg-amber-100 text-amber-700' if 'refund' in p.status else 'bg-slate-200 text-slate-600' }}">{{ p.get_status_display() }}</span>
          </div>
          <p class="mt-1 text-slate-500">{{ p.currency }} {{ p.amount }}{% if p.amount_refunded %} · refunded {{ p.amount_refunded }}{% endif %}</p>
          {% if p.provider_payment_id %}<p class="text-xs text-slate-400">{{ p.provider_payment_id }}</p>{% endif %}
          {% if p.error_message %}<p class="text-xs text-red-600">{{ p.error_message }}</p>{% endif %}

          {% if p.status in ['pending', 'authorized', 'created'] %}
          <form method="post" action="{{ url('control:order_pay_capture', kwargs={'pk': order.pk, 'payment_pk': p.pk}) }}" class="mt-2">
            {{ csrf_input }}
            <button class="w-full rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-emerald-700">Mark collected / capture</button>
          </form>
          {% endif %}

          {% if p.refundable_amount and p.refundable_amount > 0 %}
          <form method="post" action="{{ url('control:order_pay_refund', kwargs={'pk': order.pk, 'payment_pk': p.pk}) }}" class="mt-2 space-y-1">
            {{ csrf_input }}
            <input type="text" name="amount" placeholder="Amount (blank = full {{ p.refundable_amount }})" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-xs">
            <input type="text" name="reason" placeholder="Reason" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-xs">
            <button class="w-full rounded-lg border border-slate-300 px-3 py-1.5 text-xs hover:bg-slate-50">Refund</button>
          </form>
          {% endif %}

          {% for r in p.refunds.all() %}
          <p class="mt-1 text-xs text-slate-400">↩ {{ r.amount }} · {{ r.get_status_display() }}{% if r.reason %} — {{ r.reason }}{% endif %}</p>
          {% endfor %}
        </div>
        {% else %}
        <p class="text-xs text-slate-400">No payments yet.</p>
        {% endfor %}

        {% if order.payment_status != 'paid' %}
        <div class="space-y-2 border-t border-slate-200 pt-3">
          {% for c in enabled_providers %}
          {% if c.provider in ['cod', 'manual'] %}
          <form method="post" action="{{ url('control:order_pay_offline', kwargs={'pk': order.pk}) }}">
            {{ csrf_input }}
            <input type="hidden" name="provider" value="{{ c.provider }}">
            <input type="hidden" name="mark_collected" value="{{ '1' if c.provider == 'manual' else '0' }}">
            <button class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm hover:bg-slate-50">
              Record {{ c.label }}{{ ' (paid)' if c.provider == 'manual' else ' (confirm order)' }}
            </button>
          </form>
          {% else %}
          <form method="post" action="{{ url('control:order_pay_initiate', kwargs={'pk': order.pk}) }}">
            {{ csrf_input }}
            <input type="hidden" name="provider" value="{{ c.provider }}">
            <button class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm hover:bg-slate-50">Initiate {{ c.label }}</button>
          </form>
          {% endif %}
          {% else %}
          <p class="text-xs text-slate-400">No enabled providers. <a href="{{ url('control:payment_providers') }}" class="underline">Configure</a></p>
          {% endfor %}
        </div>
        {% endif %}
      </div>

      <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200 space-y-3">
        <h3 class="text-sm font-semibold text-slate-700">Shipping</h3>

        {% if order.shipping_method and order.shipping_method.get('name') %}
        <p class="text-sm text-slate-600">
          {{ order.shipping_method.get('name') }} · {{ order.currency }} {{ order.shipping_total }}
          <span class="text-slate-400">({{ order.shipping_method.get('min_days') }}–{{ order.shipping_method.get('max_days') }} days)</span>
        </p>
        {% endif %}

        {% if order.status not in ['delivered', 'cancelled', 'refunded', 'failed'] %}
        <form method="post" action="{{ url('control:order_shipping_set', kwargs={'pk': order.pk}) }}" class="space-y-2 text-sm">
          {{ csrf_input }}
          <select name="method" class="w-full rounded-lg border border-slate-300 px-2 py-2">
            {% for method, quote in shipping_methods %}
            <option value="{{ method.pk }}">{{ method.name }} — {{ order.currency }} {{ quote }} ({{ method.estimate_label() }})</option>
            {% else %}
            <option disabled>No method matches this address</option>
            {% endfor %}
          </select>
          <label class="flex items-center gap-2 text-xs text-slate-500">
            <input type="checkbox" name="cod" value="1"> quote with COD fee
          </label>
          {% if shipping_methods %}
          <button class="w-full rounded-lg border border-slate-300 px-3 py-2 hover:bg-slate-50">Set shipping method</button>
          {% endif %}
        </form>
        {% endif %}

        {% for s in shipments %}
        <div class="rounded-lg border border-slate-200 p-3 text-sm">
          <div class="flex items-center justify-between">
            <span class="font-medium text-slate-700">{{ s.carrier or "manual" }}</span>
            <span class="rounded px-2 py-0.5 text-xs {{ 'bg-emerald-100 text-emerald-700' if s.status == 'delivered' else 'bg-slate-200 text-slate-600' }}">{{ s.get_status_display() }}</span>
          </div>
          {% if s.tracking_number %}<p class="mt-1 text-slate-500">{{ s.tracking_number }}</p>{% endif %}
          {% if s.estimated_delivery %}<p class="text-xs text-slate-400">ETA {{ s.estimated_delivery }}</p>{% endif %}
          <form method="post" action="{{ url('control:order_shipment_status', kwargs={'pk': order.pk, 'shipment_pk': s.pk}) }}" class="mt-2 flex gap-1">
            {{ csrf_input }}
            <select name="status" class="flex-1 rounded-lg border border-slate-300 px-2 py-1 text-xs">
              {% for value, label in shipment_statuses %}
              <option value="{{ value }}" {{ 'selected' if value == s.status }}>{{ label }}</option>
              {% endfor %}
            </select>
            <button class="rounded-lg border border-slate-300 px-2 py-1 text-xs hover:bg-slate-50">Update</button>
          </form>
          {% for e in s.events.all() %}
          <p class="mt-1 text-xs text-slate-400">{{ e.occurred_at.strftime("%b %d %H:%M") if e.occurred_at }} · {{ e.get_status_display() or e.description }}{% if e.location %} — {{ e.location }}{% endif %}</p>
          {% endfor %}
        </div>
        {% endfor %}

        {% if order.fulfillment_status != 'unfulfilled' or order.status in ['packed', 'processing', 'confirmed'] %}
        <form method="post" action="{{ url('control:order_shipment_create', kwargs={'pk': order.pk}) }}" class="space-y-2 border-t border-slate-200 pt-3 text-sm">
          {{ csrf_input }}
          <input type="text" name="carrier" placeholder="Carrier (blank = manual)" class="w-full rounded-lg border border-slate-300 px-2 py-2">
          <input type="text" name="tracking_number" placeholder="Tracking #" class="w-full rounded-lg border border-slate-300 px-2 py-2">
          <button class="w-full rounded-lg border border-slate-300 px-3 py-2 hover:bg-slate-50">Create shipment</button>
        </form>
        {% endif %}
      </div>

      <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200 text-sm text-slate-600">
        <h3 class="text-sm font-semibold text-slate-700">Ship to</h3>
        <div class="mt-2">{{ addr(order.shipping_address) }}</div>
        <h3 class="mt-4 text-sm font-semibold text-slate-700">Bill to</h3>
        <div class="mt-2">{{ addr(order.billing_address) }}</div>
      </div>

      <div class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
        <h3 class="text-sm font-semibold text-slate-700">Admin notes</h3>
        {% if order.admin_note %}<pre class="mt-2 whitespace-pre-wrap text-xs text-slate-500">{{ order.admin_note }}</pre>{% endif %}
        {% if order.customer_note %}<p class="mt-2 text-xs text-slate-500"><span class="font-medium">Customer:</span> {{ order.customer_note }}</p>{% endif %}
        <form method="post" action="{{ url('control:order_note', kwargs={'pk': order.pk}) }}" class="mt-3 space-y-2">
          {{ csrf_input }}
          <textarea name="text" rows="2" placeholder="Add note…" class="w-full rounded-lg border border-slate-300 px-2 py-2 text-sm"></textarea>
          <button class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm hover:bg-slate-50">Add note</button>
        </form>
      </div>
    </div>
  </div>
</div>
{% endblock %}
