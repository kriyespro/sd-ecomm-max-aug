{% set status_class = {
  "pending": "bg-slate-200 text-slate-600",
  "confirmed": "bg-blue-100 text-blue-700",
  "processing": "bg-blue-100 text-blue-700",
  "packed": "bg-indigo-100 text-indigo-700",
  "shipped": "bg-indigo-100 text-indigo-700",
  "delivered": "bg-emerald-100 text-emerald-700",
  "cancelled": "bg-red-100 text-red-700",
  "failed": "bg-red-100 text-red-700",
  "returned": "bg-amber-100 text-amber-700",
  "refunded": "bg-amber-100 text-amber-700",
} %}
{% set pay_class = {
  "paid": "bg-emerald-100 text-emerald-700",
  "pending": "bg-slate-200 text-slate-600",
  "authorized": "bg-blue-100 text-blue-700",
  "failed": "bg-red-100 text-red-700",
  "refunded": "bg-amber-100 text-amber-700",
  "partially_refunded": "bg-amber-100 text-amber-700",
} %}
{% for o in orders %}
<tr class="hover:bg-slate-50">
  <td class="px-4 py-2">
    <a href="{{ url('control:order_detail', kwargs={'pk': o.pk}) }}" class="font-medium text-slate-900 hover:underline">{{ o.number }}</a>
  </td>
  <td class="px-4 py-2 text-slate-500">{{ (o.placed_at or o.created_at).strftime("%b %d %H:%M") }}</td>
  <td class="px-4 py-2 text-slate-600">{{ o.email }}</td>
  <td class="px-4 py-2"><span class="rounded px-2 py-0.5 text-xs {{ status_class.get(o.status, 'bg-slate-200 text-slate-600') }}">{{ o.get_status_display() }}</span></td>
  <td class="px-4 py-2"><span class="rounded px-2 py-0.5 text-xs {{ pay_class.get(o.payment_status, 'bg-slate-200 text-slate-600') }}">{{ o.get_payment_status_display() }}</span></td>
  <td class="px-4 py-2 text-slate-500">{{ o.get_fulfillment_status_display() }}</td>
  <td class="px-4 py-2 text-right font-medium">{{ o.currency }} {{ o.grand_total }}</td>
</tr>
{% else %}
<tr><td colspan="7" class="px-4 py-6 text-center text-slate-400">No orders found.</td></tr>
{% endfor %}
{% if page_obj and page_obj.has_other_pages() %}
<tr>
  <td colspan="7" class="px-4 py-3 text-center text-xs text-slate-500">
    {% if page_obj.has_previous() %}
    <a class="hover:underline" href="?page={{ page_obj.previous_page_number() }}&q={{ q }}&status={{ status }}&payment={{ payment }}">← Prev</a>
    {% endif %}
    <span class="mx-2">Page {{ page_obj.number }} / {{ page_obj.paginator.num_pages }}</span>
    {% if page_obj.has_next() %}
    <a class="hover:underline" href="?page={{ page_obj.next_page_number() }}&q={{ q }}&status={{ status }}&payment={{ payment }}">Next →</a>
    {% endif %}
  </td>
</tr>
{% endif %}
