{% extends "control/base_control.jinja" %}
{% block page_title %}Orders{% endblock %}

{% block content %}
<div class="rounded-xl bg-white ring-1 ring-slate-200">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 p-4">
    <h2 class="text-sm font-semibold text-slate-700">Orders · {{ active_project.name }}</h2>
    <div class="flex flex-wrap items-center gap-2">
      <input type="search" name="q" value="{{ q }}" placeholder="Order # or email…"
             hx-get="{{ url('control:order_list') }}"
             hx-trigger="input changed delay:300ms, search"
             hx-target="#order-rows" hx-swap="innerHTML"
             hx-include="[name='status'],[name='payment']"
             class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm">
      <select data-tour="order-filters" name="status"
              hx-get="{{ url('control:order_list') }}"
              hx-trigger="change" hx-target="#order-rows" hx-swap="innerHTML"
              hx-include="[name='q'],[name='payment']"
              class="rounded-lg border border-slate-300 px-2 py-1.5 text-sm">
        <option value="">All status</option>
        {% for value, label in status_choices %}
        <option value="{{ value }}" {{ 'selected' if status == value }}>{{ label }}</option>
        {% endfor %}
      </select>
      <select name="payment"
              hx-get="{{ url('control:order_list') }}"
              hx-trigger="change" hx-target="#order-rows" hx-swap="innerHTML"
              hx-include="[name='q'],[name='status']"
              class="rounded-lg border border-slate-300 px-2 py-1.5 text-sm">
        <option value="">All payments</option>
        {% for value, label in payment_choices %}
        <option value="{{ value }}" {{ 'selected' if payment == value }}>{{ label }}</option>
        {% endfor %}
      </select>
      {% if can_export_orders %}
      <a href="{{ url('control:order_export') }}?q={{ q|urlencode }}&status={{ status|urlencode }}&payment={{ payment|urlencode }}"
         class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Export CSV</a>
      {% endif %}
    </div>
  </div>
  {% if can_manage_orders %}
  <div class="flex items-center gap-3 border-b border-slate-200 px-4 py-2 text-xs">
    <a href="{{ url('control:order_list') }}" class="{{ 'font-semibold text-slate-900' if not archived else 'text-slate-500 hover:text-slate-900' }}">Active</a>
    <a href="{{ url('control:order_list') }}?archived=1" class="{{ 'font-semibold text-slate-900' if archived else 'text-slate-500 hover:text-slate-900' }}">Archived</a>
  </div>
  <form id="bulk-archive-form" method="post" action="{{ url('control:order_bulk_archive') }}"
        class="flex flex-wrap items-center gap-2 border-b border-slate-200 px-4 py-2 text-xs">
    {{ csrf_input }}
    <input type="hidden" name="next" value="{{ request.get_full_path() }}">
    <span id="bulk-selected-count" class="text-slate-400">0 selected</span>
    {% if archived %}
    <button name="action" value="unarchive" class="rounded-lg border border-slate-300 px-2.5 py-1 text-slate-600 hover:bg-slate-50" onclick="return document.querySelectorAll('.bulk-row-check:checked').length > 0">Unarchive selected</button>
    {% else %}
    <button name="action" value="archive" class="rounded-lg border border-slate-300 px-2.5 py-1 text-slate-600 hover:bg-slate-50" onclick="return document.querySelectorAll('.bulk-row-check:checked').length > 0">Archive selected</button>
    {% endif %}
  </form>
  {% endif %}
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
        <tr>
          {% if can_manage_orders %}
          <th class="px-4 py-2 w-8"><input type="checkbox" id="bulk-select-all" aria-label="Select all orders" class="h-3.5 w-3.5 rounded border-slate-300"></th>
          {% endif %}
          <th class="px-4 py-2">Order</th><th class="px-4 py-2">Placed</th>
          <th class="px-4 py-2">Customer</th><th class="px-4 py-2">Status</th>
          <th class="px-4 py-2">Payment</th><th class="px-4 py-2">Fulfilment</th>
          <th class="px-4 py-2 text-right">Total</th>
          {% if can_manage_orders %}<th class="px-4 py-2"></th>{% endif %}
        </tr>
      </thead>
      <tbody id="order-rows" class="divide-y divide-slate-100">
        {% include "control/orders/_order_rows.jinja" %}
      </tbody>
    </table>
  </div>
</div>
{% if can_manage_orders %}
<script>
  document.addEventListener("DOMContentLoaded", function () {
    var container = document.querySelector(".rounded-xl.bg-white.ring-1.ring-slate-200");
    if (!container) return;
    var selectAll = document.getElementById("bulk-select-all");
    var countEl = document.getElementById("bulk-selected-count");
    function updateCount() {
      if (countEl) countEl.textContent = document.querySelectorAll(".bulk-row-check:checked").length + " selected";
    }
    container.addEventListener("change", function (e) {
      if (e.target === selectAll) {
        document.querySelectorAll(".bulk-row-check").forEach(function (cb) { cb.checked = selectAll.checked; });
      }
      updateCount();
    });
    document.body.addEventListener("htmx:afterSwap", updateCount);
    updateCount();
  });
</script>
{% endif %}
{% endblock %}
