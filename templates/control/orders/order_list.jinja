{% extends "control/base_control.jinja" %}
{% block page_title %}Orders{% endblock %}

{% block content %}
<div class="rounded-xl bg-white ring-1 ring-slate-200">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 p-4">
    <h2 class="text-sm font-semibold text-slate-700">Orders · {{ active_project.name }}</h2>
    <div class="flex flex-wrap items-center gap-2">
      <input type="search" name="q" value="{{ q }}" placeholder="Order # or email…"
             hx-get="{{ url('control:order_list') }}"
             hx-trigger="input changed delay:300ms, search"
             hx-target="#order-rows" hx-swap="innerHTML"
             hx-include="[name='status'],[name='payment']"
             class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm">
      <select name="status"
              hx-get="{{ url('control:order_list') }}"
              hx-trigger="change" hx-target="#order-rows" hx-swap="innerHTML"
              hx-include="[name='q'],[name='payment']"
              class="rounded-lg border border-slate-300 px-2 py-1.5 text-sm">
        <option value="">All status</option>
        {% for value, label in status_choices %}
        <option value="{{ value }}" {{ 'selected' if status == value }}>{{ label }}</option>
        {% endfor %}
      </select>
      <select name="payment"
              hx-get="{{ url('control:order_list') }}"
              hx-trigger="change" hx-target="#order-rows" hx-swap="innerHTML"
              hx-include="[name='q'],[name='status']"
              class="rounded-lg border border-slate-300 px-2 py-1.5 text-sm">
        <option value="">All payments</option>
        {% for value, label in payment_choices %}
        <option value="{{ value }}" {{ 'selected' if payment == value }}>{{ label }}</option>
        {% endfor %}
      </select>
    </div>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-400">
        <tr>
          <th class="px-4 py-2">Order</th><th class="px-4 py-2">Placed</th>
          <th class="px-4 py-2">Customer</th><th class="px-4 py-2">Status</th>
          <th class="px-4 py-2">Payment</th><th class="px-4 py-2">Fulfilment</th>
          <th class="px-4 py-2 text-right">Total</th>
        </tr>
      </thead>
      <tbody id="order-rows" class="divide-y divide-slate-100">
        {% include "control/orders/_order_rows.jinja" %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
