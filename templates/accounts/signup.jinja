{% extends "base.jinja" %}

{% block title %}Start your free trial{% endblock %}

{% block body %}
<div class="flex min-h-screen items-center justify-center px-4 py-10">
  <div class="w-full max-w-sm rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
    <h1 class="text-lg font-semibold">Start your store</h1>
    <p class="mt-1 text-sm text-slate-500">
      {{ trial_days }}-day free trial — no card needed. Cancel anytime.
    </p>

    {% if google_enabled %}
    <a href="{{ url('accounts:google_start') }}{% if plan %}?plan={{ plan }}{% endif %}"
       class="mt-6 flex w-full items-center justify-center gap-3 rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-50">
      <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true">
        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.76h3.57c2.08-1.92 3.28-4.74 3.28-8.09Z"/>
        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.76c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z"/>
        <path fill="#FBBC05" d="M5.84 14.09a6.6 6.6 0 0 1 0-4.18V7.07H2.18a11 11 0 0 0 0 9.86l3.66-2.84Z"/>
        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1A11 11 0 0 0 2.18 7.07l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38Z"/>
      </svg>
      Continue with Google
    </a>
    <p class="mt-3 text-xs text-slate-500">
      We'll ask for your store name and mobile number next.
    </p>
    {% else %}
    <div class="mt-6 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-800">
      Google sign-in isn't configured on this server yet.
    </div>
    {% endif %}

    <p class="mt-6 text-xs text-slate-500">
      Already have an account?
      <a href="{{ url('accounts:login') }}" class="font-medium text-slate-800 hover:underline">Sign in</a>
    </p>
  </div>
</div>
{% endblock %}
