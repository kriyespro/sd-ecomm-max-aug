{% extends "base.jinja" %}

{% block title %}Start your free trial{% endblock %}

{% block body %}
<div class="flex min-h-screen items-center justify-center px-4 py-10">
  <div class="w-full max-w-sm rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
    <h1 class="text-lg font-semibold">Start your store</h1>
    <p class="mt-1 text-sm text-slate-500">
      {{ trial_days }}-day free trial — no card needed. Cancel anytime.
    </p>

    {% if form.non_field_errors() %}
    <div class="mt-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">
      {{ form.non_field_errors()|join(" ") }}
    </div>
    {% endif %}

    <form method="post" class="mt-6 space-y-4">
      {{ csrf_input }}
      {% for field in [form.store_name, form.full_name, form.email, form.password] %}
      <div>
        <label for="{{ field.id_for_label }}" class="block text-sm font-medium">
          {{ field.label }}{% if field.field.required %}<span class="text-red-500">*</span>{% endif %}
        </label>
        {{ field }}
        {% for error in field.errors %}<p class="mt-1 text-xs text-red-600">{{ error }}</p>{% endfor %}
      </div>
      {% endfor %}
      {{ form.plan }}
      <button type="submit"
              class="w-full rounded-lg bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-800">
        Create my store
      </button>
    </form>

    <p class="mt-4 text-xs text-slate-500">
      You'll sign in with your email address. Already have an account?
      <a href="{{ url('accounts:login') }}" class="font-medium text-slate-800 hover:underline">Sign in</a>
    </p>
  </div>
</div>
{% endblock %}
