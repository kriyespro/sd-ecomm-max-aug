{% extends "base.jinja" %}

{% block title %}Set up two-factor authentication{% endblock %}

{% block body %}
<div class="flex min-h-screen items-center justify-center px-4 py-10">
  <div class="w-full max-w-md rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200">

    {% if already_enabled %}
      <h1 class="text-lg font-semibold">Two-factor authentication is on</h1>
      <p class="mt-2 text-sm text-slate-500">Your account already has 2FA enabled.</p>
      <a href="{{ url('control:dashboard') }}" class="mt-6 inline-block rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">Continue to Mission Control</a>

    {% elif enabled %}
      <h1 class="text-lg font-semibold">Two-factor authentication is on</h1>
      <p class="mt-2 text-sm text-slate-500">
        Save these backup codes somewhere safe — each one works once, and this is the only time
        they're shown. Use one if you ever lose access to your authenticator app.
      </p>
      <div class="mt-4 grid grid-cols-2 gap-2 rounded-lg bg-slate-50 p-4 font-mono text-sm text-slate-800">
        {% for code in backup_codes %}
        <div>{{ code }}</div>
        {% endfor %}
      </div>
      <a href="{{ url('control:dashboard') }}" class="mt-6 inline-block rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">I've saved these — continue</a>

    {% else %}
      <h1 class="text-lg font-semibold">Set up two-factor authentication</h1>
      <p class="mt-1 text-sm text-slate-500">
        Required for platform admin accounts. Scan this into Google Authenticator, Authy, or
        any TOTP app — or enter the key manually — then confirm with the 6-digit code it shows.
      </p>

      <div class="mt-4 rounded-lg bg-slate-50 p-4">
        <div class="text-xs uppercase tracking-wide text-slate-400">Manual entry key</div>
        <div class="mt-1 break-all font-mono text-sm text-slate-800">{{ secret }}</div>
        <div class="mt-3 text-xs uppercase tracking-wide text-slate-400">Setup link</div>
        <div class="mt-1 break-all font-mono text-xs text-slate-500">{{ uri }}</div>
      </div>

      {% if form.non_field_errors() or form.code.errors %}
      <div class="mt-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">
        {{ (form.non_field_errors() + form.code.errors)|join(" ") }}
      </div>
      {% endif %}

      <form method="post" class="mt-4 space-y-4">
        {{ csrf_input }}
        <div>
          <label for="id_code" class="block text-sm font-medium">Confirm with a code</label>
          <input id="id_code" name="code" type="text" autocomplete="one-time-code" inputmode="numeric" required
                 class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm tracking-widest focus:border-slate-900 focus:outline-none">
        </div>
        <button type="submit"
                class="w-full rounded-lg bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-800">
          Enable 2FA
        </button>
      </form>
    {% endif %}
  </div>
</div>
{% endblock %}
