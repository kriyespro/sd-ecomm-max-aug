{% extends "storefront/base.jinja" %}
{% block title %}{{ meta.title or product.title }}{% endblock %}

{% block content %}
<a href="{{ url('storefront:home') }}" class="text-sm text-slate-500 hover:underline">&larr; All products</a>

<div class="mt-4 grid gap-8 md:grid-cols-2">
  <div>
    {% set img = product.images.all()|first %}
    <div class="aspect-square overflow-hidden rounded-xl bg-slate-100">
      {% if img %}<img src="{{ img.image.url }}" {% if img.srcset %}srcset="{{ img.srcset }}" sizes="(min-width: 768px) 50vw, 100vw"{% endif %} alt="{{ img.alt or product.title }}" loading="eager" class="h-full w-full object-cover">{% endif %}
    </div>
    {% if product.images.all()|length > 1 %}
    <div class="mt-2 flex gap-2">
      {% for i in product.images.all() %}
      <img src="{{ i.image.url }}" {% if i.srcset %}srcset="{{ i.srcset }}" sizes="64px"{% endif %} loading="lazy" class="h-16 w-16 rounded-lg object-cover ring-1 ring-slate-200">
      {% endfor %}
    </div>
    {% endif %}
  </div>

  <div>
    <h1 class="text-2xl font-semibold">{{ product.title }}</h1>
    {% if product.brand %}<p class="mt-1 text-sm text-slate-500">{{ product.brand.name }}</p>{% endif %}
    <p class="mt-3 text-xl">
      {% if product.on_sale %}
        <span class="text-slate-400 line-through">{{ store.currency }} {{ product.price }}</span>
        <span class="font-semibold">{{ store.currency }} {{ product.current_price }}</span>
      {% else %}
        <span class="font-semibold">{{ store.currency }} {{ product.price }}</span>
      {% endif %}
    </p>
    <p class="mt-1 text-sm text-slate-500">
      {% if product.rating_count %}{{ product.rating_avg }} / 5 · {{ product.rating_count }} review(s){% else %}No reviews yet{% endif %}
    </p>

    {% if product.short_description %}<p class="mt-4 text-sm text-slate-600">{{ product.short_description }}</p>{% endif %}
    {% if product.description %}<div class="mt-3 whitespace-pre-line text-sm text-slate-600">{{ product.description }}</div>{% endif %}

    <form method="post" action="{{ url('storefront:cart_add') }}" class="mt-6 space-y-3">
      {{ csrf_input }}
      <input type="hidden" name="product" value="{{ product.slug }}">
      {% if variants %}
      <div>
        <label class="block text-xs text-slate-400">Option</label>
        <select name="variant" class="mt-1 rounded-lg border border-slate-300 px-2 py-1.5 text-sm">
          {% for v in variants %}
          <option value="{{ v.pk }}">{{ v.name or v.sku }} — {{ store.currency }} {{ v.effective_price }}</option>
          {% endfor %}
        </select>
      </div>
      {% endif %}
      <div class="flex items-center gap-2">
        <input type="number" name="quantity" min="1" value="1" class="w-20 rounded-lg border border-slate-300 px-2 py-1.5 text-sm">
        <button class="rounded-lg btn-brand px-5 py-2 text-sm font-medium text-white">Add to cart</button>
      </div>
    </form>
  </div>
</div>

<section class="mt-12">
  <h2 class="text-sm font-semibold text-slate-700">Reviews</h2>
  <div class="mt-3 space-y-3">
    {% for r in reviews %}
    <div class="rounded-lg bg-white p-4 ring-1 ring-slate-200">
      <p class="text-sm font-medium text-amber-500">{{ "★" * r.rating }}<span class="text-slate-300">{{ "★" * (5 - r.rating) }}</span>
        <span class="ml-2 text-slate-700">{{ r.title }}</span></p>
      {% if r.body %}<p class="mt-1 text-sm text-slate-600">{{ r.body }}</p>{% endif %}
      <p class="mt-1 text-xs text-slate-400">{{ r.author_name }}{% if r.is_verified_purchase %} · verified purchase{% endif %}</p>
      {% if r.admin_reply %}<p class="mt-2 rounded bg-slate-50 p-2 text-xs text-slate-500">Store: {{ r.admin_reply }}</p>{% endif %}
    </div>
    {% else %}
    <p class="text-sm text-slate-400">Be the first to review this product.</p>
    {% endfor %}
  </div>

  <form method="post" action="{{ url('storefront:review_submit', kwargs={'slug': product.slug}) }}"
        class="mt-5 max-w-md space-y-2 rounded-lg bg-white p-4 ring-1 ring-slate-200">
    {{ csrf_input }}
    <h3 class="text-sm font-semibold text-slate-700">Write a review</h3>
    <div class="flex gap-2">
      <input name="author_name" required placeholder="Name" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm">
      <input name="author_email" type="email" required placeholder="Email" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm">
    </div>
    <select name="rating" class="rounded-lg border border-slate-300 px-2 py-1.5 text-sm">
      {% for n in [5, 4, 3, 2, 1] %}<option value="{{ n }}">{{ n }} star{{ 's' if n != 1 }}</option>{% endfor %}
    </select>
    <input name="title" placeholder="Title" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm">
    <textarea name="body" rows="3" placeholder="Your review" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm"></textarea>
    <button class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm hover:bg-slate-50">Submit review</button>
  </form>
</section>
{% endblock %}
