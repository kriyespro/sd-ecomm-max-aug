# Copy to .env. Never commit .env.

# ---------------- Local development ----------------
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# ---------------- Production (Docker) ----------------
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_SECRET_KEY=            # 50+ random chars — `python -c "import secrets;print(secrets.token_urlsafe(64))"`
# DJANGO_ALLOWED_HOSTS=*        # "*" is fine if the edge proxy gates hosts; else comma list
# DJANGO_CSRF_TRUSTED_ORIGINS=https://admin.yourdomain.com,https://*.yourdomain.com

# POSTGRES_DB=sdcommerce
# POSTGRES_USER=sdcommerce
# POSTGRES_PASSWORD=            # required
# POSTGRES_HOST=db             # 'db' inside compose
# POSTGRES_PORT=5432

# REDIS_URL=redis://redis:6379/1          # cache + throttle (db 1)
# CELERY_BROKER_URL=redis://redis:6379/0  # task queue (db 0) — compose sets this

# Behind Cloudflare (or any trusted proxy): rewrite REMOTE_ADDR from
# CF-Connecting-IP so throttling / audit logs see the real visitor.
# Only enable when the origin is reachable ONLY through that proxy.
# DJANGO_TRUST_PROXY_HEADERS=1

# This server's public IP. A store owner who points a custom domain straight
# here (or a Cloudflare-proxied A record to it) is then auto-verified.
# PLATFORM_PUBLIC_IP=203.0.113.10

# The platform's own hostname(s). "/" serves the marketing landing page here
# and these never resolve to a store. Comma-separated; "www." is ignored.
# DJANGO_PLATFORM_HOSTS=mnxstore.com

# Backups (pgbackup service)
# BACKUP_SCHEDULE=@daily
# BACKUP_KEEP_DAYS=7
# BACKUP_KEEP_WEEKS=4
# BACKUP_KEEP_MONTHS=6

# Email
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DJANGO_DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

# Media on object storage (recommended in prod — container media/ is not durable
# across replicas). Leave unset to use the mounted 'media' volume.
# DJANGO_DEFAULT_FILE_STORAGE=storages.backends.s3.S3Storage
# DJANGO_MEDIA_URL=https://cdn.yourdomain.com/media/

# Observability — /metrics returns Prometheus data only with this token in
# the X-Metrics-Token header. Empty = /metrics returns 404.
# DJANGO_METRICS_TOKEN=

# Tuning
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=30
# CELERY_CONCURRENCY=4
# DJANGO_LOG_LEVEL=INFO
# RUN_MIGRATIONS=1             # set 0 on extra replicas
