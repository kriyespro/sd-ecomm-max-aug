# Env for the SECOND, fully isolated platform deployment: mnxstore.com.
# Own DB, own containers, own secrets, own media — zero data shared with the
# shopinaday.com stack (.env.live / .env.prod on this same server).
#
# Deploy from a SEPARATE checkout (e.g. ~/apps/mnxstore) and start with an
# explicit project name so container/volume names never collide with the
# shopinaday "sd-commerce" project running from a different directory:
#   cp .env.mnxstore.example .env   # inside ~/apps/mnxstore
#   docker compose -p mnxstore up -d

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=false

# Generate fresh — NEVER reuse shopinaday's key:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_FRESH_SECRET_KEY

DJANGO_ALLOWED_HOSTS=*
PROJECT_DOMAIN=mnxstore.com
DJANGO_PLATFORM_HOSTS=mnxstore.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://mnxstore.com,https://www.mnxstore.com,https://*.mnxstore.com

# Marketing/legal pages read this everywhere via {{ brand.name }} (nav, footer,
# page titles, meta, logo wordmark) — see apps/core/brand.py.
DJANGO_LEGAL_ENTITY_NAME=mnxstore
# Picks the teal Tailwind bundle (static/site/mnxstore.css) instead of the
# shopinaday indigo one — see apps/core/brand.py Brand.color_theme and
# tools/build_tailwind_site.py. Built into the image automatically (same
# Dockerfile step as shopinaday's), no separate build needed.
DJANGO_PLATFORM_COLOR_THEME=mnxstore

# Distinct DB — shopinaday owns POSTGRES_DB=sdcommerce on this box.
POSTGRES_DB=mnxstore
POSTGRES_USER=mnxstore
POSTGRES_PASSWORD=CHANGE_ME_FRESH_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Resolved inside THIS compose project's own private network — safe even
# though shopinaday's project also has services named "redis"/"db".
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0

DJANGO_TRUST_PROXY_HEADERS=1
DJANGO_SECURE_SSL_REDIRECT=false

DJANGO_METRICS_TOKEN=CHANGE_ME_FRESH_METRICS_TOKEN

DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=no-reply@mnxstore.com

BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=30
DJANGO_LOG_LEVEL=INFO

# Shopinaday owns 8888 on this box — this stack publishes on 8889 instead.
WEB_PORT=8889
RUN_MIGRATIONS=1
DJANGO_HTTPS=true
PLATFORM_PUBLIC_IP=159.195.57.98

# Shopinaday owns /srv/mnx/media — DO NOT point this stack at that path.
MEDIA_DIR=/srv/mnxstore/media
DJANGO_SERVE_MEDIA=false
CELERY_CONCURRENCY=2
WEB_BIND=127.0.0.1
